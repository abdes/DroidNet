<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <Title>Oxygen Editor Shell</Title>
        <Description>The editor's shell: the services every editor part shares, such as the session's histories and each window's document area.</Description>
        <PackageTags>oxygen;gameengine</PackageTags>
        <RootNamespace>Oxygen.Editor.Shell</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)/Documents/src/Documents.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Documents/src/Oxygen.Editor.Documents.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/TimeMachine/src/TimeMachine.csproj" />
    </ItemGroup>

</Project>
