        <DefaultItemExcludes>$(DefaultItemExcludes);UI/**</DefaultItemExcludes>

        <RootNamespace>Oxygen.Editor.ModelEditor.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Moq" />
