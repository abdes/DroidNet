<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ModelEditor.Importing.ImportRunView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:local="using:Oxygen.Editor.ModelEditor.Importing">
    <UserControl.Resources>
        <!--  A section is a BodyStrong header above a card on the flyout's surface, as in Settings.  -->
        <Style x:Key="RunSectionCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>
        <DataTemplate x:Key="PipelineRowTemplate" x:DataType="local:ImportRunPipeline">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Rectangle
                    Width="3"
                    Margin="-9,4,0,4"
                    HorizontalAlignment="Left"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    RadiusX="1"
                    RadiusY="1"
                    Visibility="{x:Bind local:ImportRunView.ShownWhenEither(Workers.IsSet, Queue.IsSet), Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />
                <dnc:NumberBox
                    Grid.Column="1"
                    AutomationProperties.Name="{x:Bind local:ImportRunView.FieldName(Label, Workers.Label)}"
                    LabelPosition="None"
                    Mask="~."
                    NumberValue="{x:Bind Workers.NumberValue, Mode=TwoWay}"
                    Opacity="{x:Bind local:ImportRunView.ValueOpacity(Workers.IsSet), Mode=OneWay}"
                    Style="{StaticResource PropertyNumberBoxStyle}"
                    ToolTipService.ToolTip="{x:Bind Workers.DefaultText}" />
                <dnc:NumberBox
                    Grid.Column="2"
                    AutomationProperties.Name="{x:Bind local:ImportRunView.FieldName(Label, Queue.Label)}"
                    LabelPosition="None"
                    Mask="~."
                    NumberValue="{x:Bind Queue.NumberValue, Mode=TwoWay}"
                    Opacity="{x:Bind local:ImportRunView.ValueOpacity(Queue.IsSet), Mode=OneWay}"
                    Style="{StaticResource PropertyNumberBoxStyle}"
                    ToolTipService.ToolTip="{x:Bind Queue.DefaultText}" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="{x:Bind local:ImportRunView.FieldName(Label, 'Reset')}"
                    Click="OnResetPipeline"
                    Style="{StaticResource QuietActionButtonStyle}"
                    ToolTipService.ToolTip="Reset to the ImportTool's defaults"
                    Visibility="{x:Bind local:ImportRunView.ShownWhenEither(Workers.IsSet, Queue.IsSet), Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Width="380" Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Import run" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The ImportTool's execution settings for this import."
                    TextWrapping="Wrap" />
            </StackPanel>
            <HyperlinkButton
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{x:Bind ViewModel.ResetAllCommand}"
                Content="Reset all" />
        </Grid>

        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Scheduling" />
            <Border Style="{StaticResource RunSectionCard}">
                <StackPanel Spacing="4">
                    <editorcontrols:NumberField
                        Label="{x:Bind ViewModel.Threads.Label}"
                        Mask="~."
                        NumberValue="{x:Bind ViewModel.Threads.NumberValue, Mode=TwoWay}"
                        OverrideState="{x:Bind ViewModel.Threads.OverrideState, Mode=OneWay}"
                        ResetCommand="{x:Bind ViewModel.Threads.ResetCommand}"
                        ResetToolTip="Reset to the ImportTool's default"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Threads.DefaultText}" />
                    <editorcontrols:NumberField
                        Label="{x:Bind ViewModel.JobsAtOnce.Label}"
                        Mask="~."
                        NumberValue="{x:Bind ViewModel.JobsAtOnce.NumberValue, Mode=TwoWay}"
                        OverrideState="{x:Bind ViewModel.JobsAtOnce.OverrideState, Mode=OneWay}"
                        ResetCommand="{x:Bind ViewModel.JobsAtOnce.ResetCommand}"
                        ResetToolTip="Reset to the ImportTool's default"
                        ToolTipService.ToolTip="{x:Bind ViewModel.JobsAtOnce.DefaultText}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Pipelines" />
            <Border Style="{StaticResource RunSectionCard}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Workers" />
                        <TextBlock
                            Grid.Column="2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Queue" />
                    </Grid>
                    <ItemsControl
                        IsTabStop="False"
                        ItemTemplate="{StaticResource PipelineRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Pipelines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
