<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ModelEditor.Importing.ModelImportDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:local="using:Oxygen.Editor.ModelEditor.Importing"
    xmlns:settings="using:Oxygen.Editor.ModelEditor.Settings"
    Width="1000"
    Height="720">
    <UserControl.Resources>
        <!--  The room a scroll view keeps on its right for its scroll bar, so the bar never covers the content.  -->
        <Thickness x:Key="ScrollBarGutter">0,0,16,0</Thickness>
        <!--
            An InfoBar's own message wraps whole words only, so a long identifier or path is clipped; text that can hold
            one is the bar's content instead, which an InfoBar without a title or message shows beside its icon.
        -->
        <Style x:Key="InfoBarText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="FileTemplate" x:DataType="local:ModelImportFile">
            <Grid Padding="0,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DestinationFolder, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <FontIcon
                    Grid.Column="1"
                    FontSize="14"
                    Foreground="{x:Bind local:ModelImportDialogView.StatusBrush(Status), Mode=OneWay}"
                    Glyph="{x:Bind local:ModelImportDialogView.StatusGlyph(Status), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}"
                    Visibility="{x:Bind local:ModelImportDialogView.StatusVisibility(Status), Mode=OneWay}" />
            </Grid>
        </DataTemplate>
        <!--  A finding: its message and the objects it is about, expandable in place.  -->
        <DataTemplate x:Key="DiagnosticTemplate" x:DataType="local:BeforeImportItem">
            <editorcontrols:DiagnosticCard
                Details="{x:Bind Objects}"
                Message="{x:Bind Message}"
                Severity="{x:Bind local:ModelImportDialogView.SeverityOf(Severity)}" />
        </DataTemplate>
        <DataTemplate x:Key="BeforeImportTemplate" x:DataType="local:BeforeImportGroup">
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind FileName}"
                    Visibility="{x:Bind ShowsHeader}" />
                <ItemsControl
                    IsTabStop="False"
                    ItemTemplate="{StaticResource DiagnosticTemplate}"
                    ItemsSource="{x:Bind Items}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        AllowDrop="True"
        Background="Transparent"
        DragOver="OnFilesDragOver"
        Drop="OnFilesDrop">
        <!--  No file yet: one empty state instead of an empty list, an empty panel and an empty Before import.  -->
        <StackPanel
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8B5;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Add models to import" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Add glTF or FBX files, drop them here from File Explorer, or open an import session to import a set of models again."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinWidth="128"
                    Command="{x:Bind ViewModel.AddFilesCommand}"
                    Content="Add files…"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Add files… (Ctrl+O)" />
                <Button
                    MinWidth="128"
                    Command="{x:Bind ViewModel.OpenSessionCommand}"
                    Content="Open session…" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="Workspace" Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <!--  Files: the run's jobs, in order; standard list selection (Ctrl+A, Shift, Ctrl), drag to reorder.  -->
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="FileList"
                    AllowDrop="True"
                    AutomationProperties.Name="Files"
                    CanDragItems="True"
                    CanReorderItems="True"
                    ItemTemplate="{StaticResource FileTemplate}"
                    ItemsSource="{x:Bind ViewModel.Files}"
                    SelectionChanged="OnFileSelectionChanged"
                    SelectionMode="Extended">
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.RevealCommand}" Text="Reveal in File Explorer" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.LocateCommand}" Text="Locate…" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>
                <dnc:ToolBar
                    Grid.Row="1"
                    DefaultLabelPosition="Collapsed"
                    IsCompact="True">
                    <dnc:ToolBarButton
                        Command="{x:Bind ViewModel.AddFilesCommand}"
                        Label="Add files"
                        ToolTipService.ToolTip="Add files… (Ctrl+O)">
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                        <dnc:ToolBarButton.Icon>
                            <FontIconSource Glyph="&#xE710;" />
                        </dnc:ToolBarButton.Icon>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarButton
                        Command="{x:Bind ViewModel.RemoveCommand}"
                        Label="Remove"
                        ToolTipService.ToolTip="Remove (Delete)">
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                        <dnc:ToolBarButton.Icon>
                            <FontIconSource Glyph="&#xE738;" />
                        </dnc:ToolBarButton.Icon>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarSeparator />
                    <dnc:ToolBarButton
                        Command="{x:Bind ViewModel.MoveUpCommand}"
                        Label="Move up"
                        ToolTipService.ToolTip="Move up (Alt+Up)">
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Up" Modifiers="Menu" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                        <dnc:ToolBarButton.Icon>
                            <FontIconSource Glyph="&#xE74A;" />
                        </dnc:ToolBarButton.Icon>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarButton
                        Command="{x:Bind ViewModel.MoveDownCommand}"
                        Label="Move down"
                        ToolTipService.ToolTip="Move down (Alt+Down)">
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Down" Modifiers="Menu" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                        <dnc:ToolBarButton.Icon>
                            <FontIconSource Glyph="&#xE74B;" />
                        </dnc:ToolBarButton.Icon>
                    </dnc:ToolBarButton>
                </dnc:ToolBar>
            </Grid>

            <ctk:GridSplitter
                Grid.Column="1"
                Width="8"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />

            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <editorcontrols:PropertyCard PropertyName="Name" Visibility="{x:Bind ViewModel.IsSingleSelection, Mode=OneWay}">
                        <TextBox AutomationProperties.Name="Name" Text="{x:Bind ViewModel.SelectedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Content folder" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                AutomationProperties.Name="Content folder"
                                PlaceholderText="{x:Bind local:ModelImportDialogView.MixedPlaceholder(ViewModel.IsFolderMixed), Mode=OneWay}"
                                Text="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.BrowseFolderCommand}"
                                Content="Browse…" />
                        </Grid>
                    </editorcontrols:PropertyCard>
                    <!--  What blocks the selected files' import, in words; a taken name can be replaced here.  -->
                    <InfoBar
                        x:Name="ProblemsBar"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasProblems, Mode=OneWay}"
                        Severity="Error">
                        <TextBlock Style="{StaticResource InfoBarText}" Text="{x:Bind ViewModel.Problems, Mode=OneWay}" />
                        <InfoBar.ActionButton>
                            <Button
                                Command="{x:Bind ViewModel.ReplaceCommand}"
                                Content="Replace"
                                ToolTipService.ToolTip="Replace the existing models of these names; each keeps its import record"
                                Visibility="{x:Bind ViewModel.HasNamesToReplace, Mode=OneWay}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        x:Name="ReimportBar"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasReimportNote, Mode=OneWay}"
                        Severity="Informational">
                        <TextBlock Style="{StaticResource InfoBarText}" Text="{x:Bind ViewModel.ReimportNote, Mode=OneWay}" />
                    </InfoBar>
                    <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Replacements, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <InfoBar
                                    IsClosable="False"
                                    IsOpen="True"
                                    Severity="Informational">
                                    <TextBlock Style="{StaticResource InfoBarText}" Text="{x:Bind}" />
                                </InfoBar>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!--
                        The facts: its severity and title are the findings' (most serious one, how many errors and warnings),
                        and its action opens Before import as a light-dismiss flyout (Esc or a click outside closes it).
                    -->
                    <InfoBar
                        x:Name="FactsBar"
                        Title="{x:Bind ViewModel.ReportSummary, Mode=OneWay}"
                        IsClosable="False"
                        IsOpen="{x:Bind local:ModelImportDialogView.HasText(ViewModel.Facts), Mode=OneWay}"
                        Message="{x:Bind ViewModel.Facts, Mode=OneWay}"
                        Severity="{x:Bind local:ModelImportDialogView.BarSeverity(ViewModel.ReportSeverity), Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="ReportButton"
                                Content="Before import"
                                ToolTipService.ToolTip="What the import will leave out or cannot read"
                                Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                                <Setter Property="MaxWidth" Value="480" />
                                                <Setter Property="MaxHeight" Value="560" />
                                                <Setter Property="Padding" Value="16,12,0,12" />
                                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel
                                            Width="420"
                                            Padding="{StaticResource ScrollBarGutter}"
                                            Spacing="8">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Before import" />
                                            <ItemsControl
                                                IsTabStop="False"
                                                ItemTemplate="{StaticResource BeforeImportTemplate}"
                                                ItemsSource="{x:Bind ViewModel.BeforeImport, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="12" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                        Severity="Informational">
                        <TextBlock Style="{StaticResource InfoBarText}" Text="{x:Bind ViewModel.NoticeText, Mode=OneWay}" />
                    </InfoBar>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Severity="Error">
                        <TextBlock Style="{StaticResource InfoBarText}" Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
                    </InfoBar>
                </StackPanel>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Select files to see their settings."
                    Visibility="{x:Bind ViewModel.ShowsSelectionHint, Mode=OneWay}" />

                <ScrollViewer
                    Grid.Row="1"
                    Padding="{StaticResource ScrollBarGutter}"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <settings:ModelImportSettingsPanel ViewModel="{x:Bind ViewModel.Settings}" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
