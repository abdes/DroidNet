<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ModelEditor.Settings.ModelImportSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:pickers="using:Oxygen.Editor.Pickers"
    xmlns:propertyeditors="using:Oxygen.Editor.Controls.PropertyEditors"
    xmlns:settings="using:Oxygen.Editor.ModelEditor.Settings"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <!--  Every row is a property card, as in the Properties pane: label, override bar, reset and qualifier.  -->
        <DataTemplate x:Key="ChoiceRowTemplate" x:DataType="settings:ChoiceRow">
            <editorcontrols:PropertyCard
                OverrideState="{x:Bind OverrideState, Mode=OneWay}"
                PropertyName="{x:Bind Label}"
                Qualifier="{x:Bind Qualifier, Mode=OneWay}"
                ResetCommand="{x:Bind ResetCommand}"
                ResetToolTip="{x:Bind ResetToolTip}">
                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind Label}"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind Options, Mode=OneWay}"
                    PlaceholderText="{x:Bind PlaceholderText, Mode=OneWay}"
                    SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
        </DataTemplate>
        <DataTemplate x:Key="NumberRowTemplate" x:DataType="settings:NumberRow">
            <editorcontrols:NumberField
                ErrorText="{x:Bind ErrorText, Mode=OneWay}"
                HasError="{x:Bind HasError, Mode=OneWay}"
                IsMixed="{x:Bind IsMixed, Mode=OneWay}"
                Label="{x:Bind Label}"
                NumberValue="{x:Bind NumberValue, Mode=TwoWay}"
                OverrideState="{x:Bind OverrideState, Mode=OneWay}"
                Prefix="{x:Bind Prefix}"
                Qualifier="{x:Bind Qualifier, Mode=OneWay}"
                ResetCommand="{x:Bind ResetCommand}"
                ResetToolTip="{x:Bind ResetToolTip}"
                Unit="{x:Bind Unit}" />
        </DataTemplate>
        <DataTemplate x:Key="ToggleRowTemplate" x:DataType="settings:ToggleRow">
            <editorcontrols:ToggleField
                IsOn="{x:Bind Value, Mode=TwoWay}"
                Label="{x:Bind Label}"
                OverrideState="{x:Bind OverrideState, Mode=OneWay}"
                ResetCommand="{x:Bind ResetCommand}"
                ResetToolTip="{x:Bind ResetToolTip}" />
        </DataTemplate>
        <!--  The inspector's material picker: the chosen material's name, its chevron opening the asset picker.  -->
        <DataTemplate x:Key="MaterialRowTemplate" x:DataType="settings:MaterialRow">
            <editorcontrols:PropertyCard
                OverrideState="{x:Bind OverrideState, Mode=OneWay}"
                PropertyName="{x:Bind Material}"
                ResetCommand="{x:Bind ResetCommand}"
                ResetToolTip="{x:Bind ResetToolTip}">
                <pickers:AssetPickerButton
                    AutomationName="{x:Bind Material}"
                    ChoiceInvoked="OnMaterialChoiceInvoked"
                    Label="{x:Bind ButtonLabel, Mode=OneWay}"
                    Model="{x:Bind Choices}" />
            </editorcontrols:PropertyCard>
        </DataTemplate>
        <!--  Node continuity: a vanished anchor, whether a node continues it, and Continue... when none does.  -->
        <DataTemplate x:Key="VanishedAnchorTemplate" x:DataType="settings:VanishedAnchorRow">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        Text="{x:Bind Anchor}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Anchor}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Status}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind FlyoutTitle}"
                    Content="Continue…"
                    Visibility="{x:Bind CanContinue}">
                    <Button.Flyout>
                        <Flyout Opening="OnContinueFlyoutOpening" Placement="LeftEdgeAlignedTop">
                            <StackPanel Width="320" Spacing="8">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind FlyoutTitle}" />
                                <TextBox
                                    AutomationProperties.Name="Find a node"
                                    PlaceholderText="Find a node..."
                                    Text="{x:Bind FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ListView
                                    MaxHeight="280"
                                    AutomationProperties.Name="Nodes of the last import"
                                    ItemsSource="{x:Bind Targets, Mode=OneWay}"
                                    SelectedItem="{x:Bind Chosen, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="settings:ContinueTarget">
                                            <Grid ColumnSpacing="8" Opacity="{x:Bind Opacity}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Anchor}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Note}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Caution, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="OnContinueClicked"
                                        Command="{x:Bind ContinueCommand}"
                                        Content="Continue"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                    <Button Click="OnContinueCancelled" Content="Cancel" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>
        <!--  An anchor new in the last import: clicking it selects its node.  -->
        <DataTemplate x:Key="NewAnchorTemplate" x:DataType="settings:NewAnchorRow">
            <StackPanel>
                <HyperlinkButton
                    Padding="0"
                    Command="{x:Bind SelectCommand}"
                    Content="{x:Bind Anchor}"
                    ToolTipService.ToolTip="Select this node" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Note}" />
            </StackPanel>
        </DataTemplate>
        <!--  A continuity entry: the override bar marks it until Save; the remove button gives the node its own ID again.  -->
        <DataTemplate x:Key="ContinuityEntryTemplate" x:DataType="settings:ContinuityEntryRow">
            <editorcontrols:PropertyCard OverrideState="{x:Bind OverrideState}" PropertyName="{x:Bind Anchor}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind Continues}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Continues}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Bind RemoveToolTip}"
                        Command="{x:Bind RemoveCommand}"
                        Style="{StaticResource QuietActionButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind RemoveToolTip}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </editorcontrols:PropertyCard>
        </DataTemplate>
        <!--  A surface of the selected mesh: whether it renders and casts shadows by default.  -->
        <DataTemplate x:Key="SurfaceDefaultsTemplate" x:DataType="settings:SurfaceDefaultsRow">
            <StackPanel Spacing="2">
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Name}" />
                <editorcontrols:ToggleField
                    IsOn="{x:Bind Visible, Mode=TwoWay}"
                    Label="Visible"
                    OverrideState="{x:Bind VisibleOverride, Mode=OneWay}"
                    ResetCommand="{x:Bind ResetVisibleCommand}"
                    ResetToolTip="{x:Bind ResetToolTip}" />
                <editorcontrols:ToggleField
                    IsOn="{x:Bind CastsShadows, Mode=TwoWay}"
                    Label="Casts shadows"
                    OverrideState="{x:Bind CastsShadowsOverride, Mode=OneWay}"
                    ResetCommand="{x:Bind ResetCastsShadowsCommand}"
                    ResetToolTip="{x:Bind ResetToolTip}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="RowHost" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="4">
        <editorcontrols:PropertiesExpander
            Description="The scene of the file the model is made from"
            Header="Source"
            HeaderIcon="{ui:FontIcon Glyph='&#xE7C3;'}"
            IsExpanded="True"
            Visibility="{x:Bind ViewModel.HasScenes, Mode=OneWay}">
            <editorcontrols:PropertiesExpander.Items>
                <ContentControl
                    Content="{x:Bind ViewModel.Scene}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}" />
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <editorcontrols:PropertiesExpander
            Description="The model's size and orientation"
            Header="Units and axes"
            HeaderIcon="{ui:FontIcon Glyph='&#xE1D9;'}"
            IsExpanded="True">
            <editorcontrols:PropertiesExpander.Items>
                <!--  What the import will do to the model, in Oxygen's space (right-handed, Z up, metres).  -->
                <editorcontrols:PropertyCard PropertyName="Result" Visibility="{x:Bind settings:ModelImportSettingsPanel.ShownWhenSet(ViewModel.ImportResult), Mode=OneWay}">
                    <!--  Caption type: the sentences mostly wrap under the label, so they read as a note, not a value.  -->
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ImportResult, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </editorcontrols:PropertyCard>
                <ContentControl
                    Content="{x:Bind ViewModel.UnitPolicy}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.UnitPolicy.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.UnitScale}"
                    ContentTemplate="{StaticResource NumberRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.UnitScale.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.UpAxis}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.UpAxis.IsVisible, Mode=OneWay}" />
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <editorcontrols:PropertiesExpander
            Description="Normals, tangents and node pivots"
            Header="Geometry"
            HeaderIcon="{ui:FontIcon Glyph='&#xF158;'}"
            IsExpanded="True">
            <editorcontrols:PropertiesExpander.Items>
                <ContentControl
                    Content="{x:Bind ViewModel.Normals}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.Normals.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.SmoothingAngle}"
                    ContentTemplate="{StaticResource NumberRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.SmoothingAngle.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.Tangents}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.Tangents.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.KeepNodePivots}"
                    ContentTemplate="{StaticResource ToggleRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.KeepNodePivots.IsVisible, Mode=OneWay}" />
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <editorcontrols:PropertiesExpander
            Description="The nodes the model keeps"
            Header="Hierarchy"
            HeaderIcon="{ui:FontIcon Glyph='&#xE8B7;'}"
            IsExpanded="True">
            <editorcontrols:PropertiesExpander.Items>
                <ContentControl
                    Content="{x:Bind ViewModel.DropEmptyNodes}"
                    ContentTemplate="{StaticResource ToggleRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.DropEmptyNodes.IsVisible, Mode=OneWay}" />
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <!--  Model Editor only: what the last import reported, and the entries that keep node IDs across DCC changes.  -->
        <editorcontrols:PropertiesExpander
            Description="{x:Bind ViewModel.Continuity.Summary, Mode=OneWay}"
            Header="Node continuity"
            HeaderIcon="{ui:FontIcon Glyph='&#xE71B;'}"
            IsExpanded="True"
            Visibility="{x:Bind settings:ModelImportSettingsPanel.ShownWhen(ViewModel.Continuity), Mode=OneWay}">
            <editorcontrols:PropertiesExpander.Items>
                <StackPanel Spacing="6">
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Continuity.HasVanished, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Vanished in the last import" />
                        <ItemsRepeater ItemTemplate="{StaticResource VanishedAnchorTemplate}" ItemsSource="{x:Bind ViewModel.Continuity.Vanished, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Continuity.HasNew, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="New in the last import" />
                        <ItemsRepeater ItemTemplate="{StaticResource NewAnchorTemplate}" ItemsSource="{x:Bind ViewModel.Continuity.New, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Continuity.HasEntries, Mode=OneWay}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.Continuity.EntriesHeader, Mode=OneWay}" />
                        <ItemsRepeater ItemTemplate="{StaticResource ContinuityEntryTemplate}" ItemsSource="{x:Bind ViewModel.Continuity.Entries, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Continued nodes apply on Save, which reimports."
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Continuity.HasUnsaved, Mode=OneWay}" />
                </StackPanel>
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <editorcontrols:PropertiesExpander
            Description="Size, compression and normal map convention"
            Header="Textures"
            HeaderIcon="{ui:FontIcon Glyph='&#xEB9F;'}"
            IsExpanded="True">
            <editorcontrols:PropertiesExpander.Items>
                <ContentControl
                    Content="{x:Bind ViewModel.MaxTextureSize}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.MaxTextureSize.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.CompressionQuality}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.CompressionQuality.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.FlipNormalGreen}"
                    ContentTemplate="{StaticResource ToggleRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.FlipNormalGreen.IsVisible, Mode=OneWay}" />
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <editorcontrols:PropertiesExpander
            Description="The file's lights and cameras"
            Header="Lights and cameras"
            HeaderIcon="{ui:FontIcon Glyph='&#xE706;'}"
            IsExpanded="True">
            <editorcontrols:PropertiesExpander.Items>
                <ContentControl
                    Content="{x:Bind ViewModel.ImportLights}"
                    ContentTemplate="{StaticResource ToggleRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.ImportLights.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.LightIntensityScale}"
                    ContentTemplate="{StaticResource NumberRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.LightIntensityScale.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.OmittedLightRange}"
                    ContentTemplate="{StaticResource NumberRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.OmittedLightRange.IsVisible, Mode=OneWay}" />
                <ContentControl
                    Content="{x:Bind ViewModel.ImportCameras}"
                    ContentTemplate="{StaticResource ToggleRowTemplate}"
                    Style="{StaticResource RowHost}"
                    Visibility="{x:Bind ViewModel.ImportCameras.IsVisible, Mode=OneWay}" />
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <!--  Materials last: their rows are as many as the file has materials.  -->
        <editorcontrols:PropertiesExpander
            Description="Imported, or a project material the surfaces use instead"
            Header="Materials"
            HeaderIcon="{ui:FontIcon Glyph='&#xE8B9;'}"
            IsExpanded="True"
            Visibility="{x:Bind ViewModel.HasMaterials, Mode=OneWay}">
            <editorcontrols:PropertiesExpander.HeaderActions>
                <Button
                    AutomationProperties.HelpText="For each material still set to Imported, use the project material with exactly the same name, when there is one. Materials you chose are kept, and each one set can be reset."
                    Command="{x:Bind ViewModel.UseProjectMaterialsCommand}"
                    Content="Match by name"
                    ToolTipService.ToolTip="For each material still set to Imported, use the project material with exactly the same name, when there is one. Materials you chose are kept, and each one set can be reset." />
            </editorcontrols:PropertiesExpander.HeaderActions>
            <editorcontrols:PropertiesExpander.Items>
                <!--  Virtualized: a file can have hundreds of materials; only the rows in view are built.  -->
                <ItemsRepeater ItemTemplate="{StaticResource MaterialRowTemplate}" ItemsSource="{x:Bind ViewModel.Materials, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <!--  Model Editor only: the asset defaults of the selected mesh, which every placement starts from.  -->
        <editorcontrols:PropertiesExpander
            Description="The defaults every placement of the model starts from"
            Header="{x:Bind ViewModel.SelectedMesh.Title, Mode=OneWay}"
            HeaderIcon="{ui:FontIcon Glyph='&#xF158;'}"
            IsExpanded="True"
            Visibility="{x:Bind settings:ModelImportSettingsPanel.ShownWhen(ViewModel.SelectedMesh), Mode=OneWay}">
            <editorcontrols:PropertiesExpander.Items>
                <StackPanel Spacing="4">
                    <propertyeditors:LodPolicyEditor Label="LOD policy" Model="{x:Bind ViewModel.SelectedMesh.LevelOfDetail, Mode=OneWay}" />
                    <ItemsRepeater ItemTemplate="{StaticResource SurfaceDefaultsTemplate}" ItemsSource="{x:Bind ViewModel.SelectedMesh.Surfaces, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <!--  Model Editor only: a texture of the selected mesh's materials, overriding the Textures group.  -->
        <editorcontrols:PropertiesExpander
            Description="Overrides the Textures group for one texture"
            Header="Selected texture"
            HeaderIcon="{ui:FontIcon Glyph='&#xEB9F;'}"
            IsExpanded="True"
            Visibility="{x:Bind ViewModel.SelectedTexture.IsVisible, Mode=OneWay}">
            <editorcontrols:PropertiesExpander.Items>
                <editorcontrols:PropertyCard PropertyName="Texture">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Texture"
                        ItemsSource="{x:Bind ViewModel.SelectedTexture.Textures, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedTexture.Texture, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <ContentControl
                    Content="{x:Bind ViewModel.SelectedTexture.MaxTextureSize}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}" />
                <ContentControl
                    Content="{x:Bind ViewModel.SelectedTexture.CompressionQuality}"
                    ContentTemplate="{StaticResource ChoiceRowTemplate}"
                    Style="{StaticResource RowHost}" />
                <ContentControl
                    Content="{x:Bind ViewModel.SelectedTexture.FlipNormalGreen}"
                    ContentTemplate="{StaticResource ToggleRowTemplate}"
                    Style="{StaticResource RowHost}" />
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>

        <TextBlock
            Margin="12,4"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Select one file to choose its scene and materials."
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ShowsSelectOneNote, Mode=OneWay}" />
    </StackPanel>
</UserControl>
