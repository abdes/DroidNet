<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseWinUI>true</UseWinUI>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <RootNamespace>Oxygen.Editor.ModelEditor</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>

        <Title>Oxygen editor model editor.</Title>
        <Description>Oxygen.Editor.ModelEditor is the model family's UI: the Model Editor of model documents, the Import model dialog and its import settings panel.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>oxygen;editor;model-editor;import</PackageTags>
        <PackageReleaseNotes>Initial version.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
        <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
        <PackageReference Include="DryIoc.dll" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Aura\src\Aura.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Controls\InPlaceEdit\src\Controls.InPlaceEdit.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Controls\ToolBars\src\Controls.ToolBars.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Hosting\src\Hosting.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Mvvm\src\Mvvm.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Assets\src\Oxygen.Managed.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\src\Oxygen.Managed.Core.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Assets\src\Oxygen.Editor.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.ContentPipeline\src\Oxygen.Editor.ContentPipeline.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Controls\src\Oxygen.Editor.Controls.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Documents\src\Oxygen.Editor.Documents.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.LivePreview\src\Oxygen.Editor.LivePreview.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Models\src\Oxygen.Editor.Models.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Pickers\src\Oxygen.Editor.Pickers.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Projects\src\Oxygen.Editor.Projects.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Scenes\src\Oxygen.Editor.Scenes.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Shell\src\Oxygen.Editor.Shell.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Viewports\src\Oxygen.Editor.Viewports.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.World\src\Oxygen.Editor.World.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Mvvm.Generators\src\Mvvm.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="$(ProjectsRoot)\Mvvm.Generators.Attributes\src\Mvvm.Generators.Attributes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Oxygen.Editor.ModelEditor.Tests" />
    </ItemGroup>
</Project>
