<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ModelEditor.ModelEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vp="using:Oxygen.Editor.Viewports"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!--  The scene editor's toolbar, with the model's commands where the scene's sit  -->
            <RowDefinition Height="Auto" />
            <!--  The viewport  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <dnc:ToolBar
            Grid.Row="0"
            Margin="4,4,4,0"
            Padding="6"
            VerticalAlignment="Top">
            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.SaveCommand}"
                Label="Save"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Save the import settings and reimport (Ctrl+S)">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE105;" />
                </dnc:ToolBarButton.Icon>
                <dnc:ToolBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </dnc:ToolBarButton.KeyboardAccelerators>
            </dnc:ToolBarButton>

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.ReimportCommand}"
                Label="Reimport"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Reimport the model: its source changed, or its last import failed">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE72C;" />
                </dnc:ToolBarButton.Icon>
            </dnc:ToolBarButton>

            <dnc:ToolBarSeparator />

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.AddToSceneCommand}"
                Label="Add to scene"
                ToolTipService.ToolTip="{x:Bind ViewModel.AddToSceneToolTip, Mode=OneWay}">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE710;" />
                </dnc:ToolBarButton.Icon>
            </dnc:ToolBarButton>

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.BrowseToAssetCommand}"
                Label="Browse to asset"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Browse to the selection's geometry, else the model file (Ctrl+B)">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE8B7;" />
                </dnc:ToolBarButton.Icon>
                <dnc:ToolBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="B" Modifiers="Control" />
                </dnc:ToolBarButton.KeyboardAccelerators>
            </dnc:ToolBarButton>

            <dnc:ToolBarSeparator />

            <!--  The import status, where the scene editor shows the Play status  -->
            <dnc:ToolBarElementHost>
                <TextBlock
                    x:Name="ImportStatus"
                    Margin="6,0"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.ImportStatusText, Mode=OneWay}" />
            </dnc:ToolBarElementHost>

            <dnc:ToolBar.SecondaryItems>
                <dnc:ToolBarButton Label="Settings" ToolBarLabelPosition="Collapsed">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE713;" />
                    </dnc:ToolBarButton.Icon>
                    <dnc:ToolBarButton.Flyout>
                        <Flyout Placement="Bottom">
                            <vp:PreviewSettingsPanel ViewModel="{x:Bind ViewModel.PreviewSettingsPanel}" />
                        </Flyout>
                    </dnc:ToolBarButton.Flyout>
                </dnc:ToolBarButton>
                <dnc:ToolBarButton
                    Command="{x:Bind ViewModel.ResetPreviewCommand}"
                    Label="Reset preview"
                    ToolTipService.ToolTip="Return the preview's sky, sun and exposure to the defaults">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE777;" />
                    </dnc:ToolBarButton.Icon>
                </dnc:ToolBarButton>
            </dnc:ToolBar.SecondaryItems>
        </dnc:ToolBar>

        <!--  The viewport is added here once the engine shows the model  -->
        <Grid x:Name="ViewportHost" Grid.Row="1" />
    </Grid>
</UserControl>
