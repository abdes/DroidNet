<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ModelEditor.ModelEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.ModelEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:Oxygen.Editor.ModelEditor.Settings"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:vp="using:Oxygen.Editor.Viewports"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!--  The scene editor's toolbar, with the model's commands where the scene's sit  -->
            <RowDefinition Height="Auto" />
            <!--  The viewport and, on its right, the import settings panel  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <dnc:ToolBar
            Grid.Row="0"
            Margin="4,4,4,0"
            Padding="6"
            VerticalAlignment="Top">
            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.SaveCommand}"
                Label="Save"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Save the import settings and reimport (Ctrl+S)">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE105;" />
                </dnc:ToolBarButton.Icon>
                <dnc:ToolBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </dnc:ToolBarButton.KeyboardAccelerators>
            </dnc:ToolBarButton>

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.ReimportCommand}"
                Label="Reimport"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Reimport the model: its source changed, or its last import failed">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE72C;" />
                </dnc:ToolBarButton.Icon>
            </dnc:ToolBarButton>

            <dnc:ToolBarSeparator />

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.AddToSceneCommand}"
                Label="Add to scene"
                ToolTipService.ToolTip="{x:Bind ViewModel.AddToSceneToolTip, Mode=OneWay}">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE710;" />
                </dnc:ToolBarButton.Icon>
            </dnc:ToolBarButton>

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.BrowseToAssetCommand}"
                Label="Browse to asset"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Browse to the selection's geometry, else the model file (Ctrl+B)">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE8B7;" />
                </dnc:ToolBarButton.Icon>
                <dnc:ToolBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="B" Modifiers="Control" />
                </dnc:ToolBarButton.KeyboardAccelerators>
            </dnc:ToolBarButton>

            <dnc:ToolBarSeparator />

            <!--  The import status, where the scene editor shows the Play status, and the kept problems' link  -->
            <dnc:ToolBarElementHost>
                <StackPanel
                    Margin="6,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        x:Name="ImportStatus"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ImportStatusText, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="·"
                        Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}" />
                    <HyperlinkButton
                        x:Name="ProblemsLink"
                        Padding="2,0"
                        Command="{x:Bind ViewModel.ShowProblemsCommand}"
                        ToolTipService.ToolTip="Show the problems of the last import in the Problems pane"
                        Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xE7BA;" />
                            <TextBlock Text="{x:Bind ViewModel.ProblemCountText, Mode=OneWay}" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
            </dnc:ToolBarElementHost>

            <dnc:ToolBar.SecondaryItems>
                <dnc:ToolBarButton Label="Settings" ToolBarLabelPosition="Collapsed">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE713;" />
                    </dnc:ToolBarButton.Icon>
                    <dnc:ToolBarButton.Flyout>
                        <Flyout Placement="Bottom">
                            <vp:PreviewSettingsPanel ViewModel="{x:Bind ViewModel.PreviewSettingsPanel}" />
                        </Flyout>
                    </dnc:ToolBarButton.Flyout>
                </dnc:ToolBarButton>
                <dnc:ToolBarButton
                    Command="{x:Bind ViewModel.ResetPreviewCommand}"
                    Label="Reset preview"
                    ToolTipService.ToolTip="Return the preview's sky, sun and exposure to the defaults">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE777;" />
                    </dnc:ToolBarButton.Icon>
                </dnc:ToolBarButton>
            </dnc:ToolBar.SecondaryItems>
        </dnc:ToolBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PanelColumn" Width="{x:Bind local:ModelEditorView.PanelWidthOf(ViewModel.Layout.PanelWidth, ViewModel.Layout.IsPanelCollapsed), Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <!--  The viewport is added here once the engine shows the model  -->
            <Grid x:Name="ViewportHost" Grid.Column="0" />

            <!--  ME-6: the view never approximates unsaved settings  -->
            <InfoBar
                x:Name="LastImportBanner"
                Grid.Column="0"
                Margin="8"
                VerticalAlignment="Top"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsShowingLastImport, Mode=OneWay}"
                Message="Showing the last import. Save to reimport with your settings."
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.SaveCommand}" Content="Save" />
                </InfoBar.ActionButton>
            </InfoBar>

            <sizers:GridSplitter
                Grid.Column="1"
                Width="4"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns"
                Visibility="{x:Bind local:ModelEditorView.CollapsedWhen(ViewModel.Layout.IsPanelCollapsed), Mode=OneWay}" />

            <Grid
                x:Name="SettingsPane"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                SizeChanged="OnSettingsPaneSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="8,4" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="Import settings"
                        Visibility="{x:Bind local:ModelEditorView.CollapsedWhen(ViewModel.Layout.IsPanelCollapsed), Mode=OneWay}" />
                    <ToggleButton
                        x:Name="CollapsePanel"
                        Grid.Column="1"
                        AutomationProperties.Name="Collapse the import settings"
                        IsChecked="{x:Bind ViewModel.Layout.IsPanelCollapsed, Mode=TwoWay}"
                        ToolTipService.ToolTip="Collapse or expand the import settings">
                        <FontIcon FontSize="12" Glyph="&#xE89F;" />
                    </ToggleButton>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="8,0,8,8"
                    Visibility="{x:Bind local:ModelEditorView.CollapsedWhen(ViewModel.Layout.IsPanelCollapsed), Mode=OneWay}">
                    <Grid>
                        <settings:ModelImportSettingsPanel ViewModel="{x:Bind ViewModel.Settings}" Visibility="{x:Bind ViewModel.HasImportSettings, Mode=OneWay}" />
                        <TextBlock
                            Margin="4,8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="This model has no import record. Import it to choose its import settings."
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:ModelEditorView.CollapsedWhen(ViewModel.HasImportSettings), Mode=OneWay}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
