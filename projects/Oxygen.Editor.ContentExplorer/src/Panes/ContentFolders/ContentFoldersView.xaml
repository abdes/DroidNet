<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentExplorer.Panes.ContentFolders.ContentFoldersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.ContentExplorer.Panes.ContentFolders"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DataContext="{x:Bind ViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  Folders are a muted gold; mounted sources use the accent colour and a link badge.  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="FolderAssetBrush" Color="#FFC7B881" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FolderAssetBrush" Color="#FF8C7633" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FolderAssetBrush" Color="#FFC7B881" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="FolderAssetBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <DataTemplate x:Key="FolderThumbnailTemplate">
                <FontIcon Foreground="{ThemeResource FolderAssetBrush}" Glyph="{Binding IconGlyph, Mode=OneWay}" />
            </DataTemplate>

            <DataTemplate x:Key="ProjectRootThumbnailTemplate">
                <FontIcon Foreground="{ThemeResource FolderAssetBrush}" Glyph="&#xE838;" />
            </DataTemplate>

            <DataTemplate x:Key="AuthoringMountThumbnailTemplate">
                <FontIcon Foreground="{ThemeResource FolderAssetBrush}" Glyph="{Binding IconGlyph, Mode=OneWay}" />
            </DataTemplate>

            <DataTemplate x:Key="VirtualFolderMountThumbnailTemplate">
                <Grid>
                    <FontIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="{Binding IconGlyph, Mode=OneWay}" />
                    <Border
                        Margin="0,0,-4,-3"
                        Padding="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="2">
                        <FontIcon
                            FontSize="8"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE71B;" />
                    </Border>
                </Grid>
            </DataTemplate>

            <!--  A mount this machine cannot read keeps its kind's glyph; the row draws it dimmed.  -->
            <DataTemplate x:Key="UnavailableMountThumbnailTemplate">
                <FontIcon Glyph="{Binding IconGlyph, Mode=OneWay}" />
            </DataTemplate>

            <local:ThumbnailTemplateSelector
                x:Key="ThumbnailTemplateSelector"
                AuthoringMountTemplate="{StaticResource AuthoringMountThumbnailTemplate}"
                DefaultTemplate="{StaticResource FolderThumbnailTemplate}"
                FolderTemplate="{StaticResource FolderThumbnailTemplate}"
                ProjectRootTemplate="{StaticResource ProjectRootThumbnailTemplate}"
                UnavailableMountTemplate="{StaticResource UnavailableMountThumbnailTemplate}"
                VirtualFolderMountTemplate="{StaticResource VirtualFolderMountThumbnailTemplate}" />

            <!--  Mounted sources are read-only; the lock says so on the mount row.  -->
            <DataTemplate x:Key="ReadOnlyBadgeTemplate">
                <FontIcon
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Read-only"
                    FontSize="10"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE72E;"
                    ToolTipService.ToolTip="Read-only: mounted and derived content cannot be edited here." />
            </DataTemplate>

            <!--  A source mount a .mounts.json binds on this machine; its folder is beside its name.  -->
            <DataTemplate x:Key="ThisMachineBadgeTemplate">
                <Border
                    Padding="8,1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    CornerRadius="8"
                    ToolTipService.ToolTip="Bound on this machine by .mounts.json, which is not committed.">
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="This machine" />
                </Border>
            </DataTemplate>

            <!--  A mount this machine cannot read: the caution's tooltip says why and what to do.  -->
            <DataTemplate x:Key="UnavailableBadgeTemplate">
                <FontIcon
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{Binding StateToolTip, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;"
                    ToolTipService.ToolTip="{Binding StateToolTip, Mode=OneWay}" />
            </DataTemplate>

            <local:MountBadgeTemplateSelector
                x:Key="MountBadgeTemplateSelector"
                ReadOnlyTemplate="{StaticResource ReadOnlyBadgeTemplate}"
                ThisMachineTemplate="{StaticResource ThisMachineBadgeTemplate}"
                UnavailableTemplate="{StaticResource UnavailableBadgeTemplate}" />
            <!--  ~+~  -->

        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="4,0,0,4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <dnc:DynamicTree
                x:Name="ProjectTree"
                Grid.Row="0"
                IsEnabled="{x:Bind ViewModel.CanChangeMounts, Mode=OneWay}"
                ThumbnailTemplateSelector="{StaticResource ThumbnailTemplateSelector}"
                TrailingContentTemplateSelector="{StaticResource MountBadgeTemplateSelector}"
                TrailingContentWidth="96"
                ViewModel="{x:Bind ViewModel}" />

            <!--  Mount management opens the Content mounts dialog; priority orders cooked sources.  -->
            <Grid
                Grid.Row="1"
                Padding="6,4"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                ColumnSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Mounts"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ManageMountsCommand}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="Add, bind or unmount content sources">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE8F4;" />
                        <TextBlock Text="Mounts" />
                    </StackPanel>
                </Button>
                <ProgressRing
                    Grid.Column="1"
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsApplyingMounts, Mode=OneWay}"
                    ToolTipService.ToolTip="Updating content mounts"
                    Visibility="{x:Bind ViewModel.MountProgressVisibility, Mode=OneWay}" />
                <Button
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Padding="0"
                    AutomationProperties.Name="Content priority"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ContentPriorityCommand}"
                    ToolTipService.ToolTip="Content priority">
                    <FontIcon FontSize="15" Glyph="&#xE9E9;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
