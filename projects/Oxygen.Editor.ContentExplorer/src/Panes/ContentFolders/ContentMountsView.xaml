<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentExplorer.Panes.ContentFolders.ContentMountsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oxygen.Editor.ContentExplorer.Panes.ContentFolders">

    <UserControl.Resources>
        <Style x:Key="MountRowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <!--  The dialog is opened wide (MaxWidth 900); this width keeps every column readable inside it.  -->
    <StackPanel MinWidth="720" Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Project.oxy commits each mount with a relative path or as a placeholder; .mounts.json binds it on this machine. Unmounting removes the registration, never the files."
            TextWrapping="Wrap" />

        <!--  Current mounts: name and committed path, kind, where it is on this machine, and its actions.  -->
        <ItemsControl AutomationProperties.Name="Content mounts" ItemsSource="{x:Bind ViewModel.Mounts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ContentMountRow">
                    <Grid
                        Margin="0,0,0,4"
                        Padding="10,6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="8"
                        CornerRadius="6">
                        <!--  Fixed kind, binding and action columns keep every row's controls aligned.  -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind IsNotRenaming, Mode=OneWay}" />
                            <TextBox
                                AutomationProperties.Name="Rename mount"
                                Text="{x:Bind NameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind IsRenaming, Mode=OneWay}" />
                            <TextBlock
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind CommittedText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind CommittedText}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind KindLabel}" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE7BA;"
                                    Visibility="{x:Bind IsCaution, Mode=OneWay}" />
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind BindingText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind BindingDetail, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind BindingDetail, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="4"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind BindCommand}"
                            Content="{x:Bind BindActionText, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="{x:Bind IsBindButtonVisible, Mode=OneWay}" />
                        <Button
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="{x:Bind ChangeBindingToolTip, Mode=OneWay}"
                            Command="{x:Bind BindCommand}"
                            Style="{StaticResource MountRowButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ChangeBindingToolTip, Mode=OneWay}"
                            Visibility="{x:Bind IsChangeBindingVisible, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE8DA;" />
                        </Button>
                        <Button
                            Grid.Column="5"
                            AutomationProperties.Name="Remove the binding on this machine"
                            Command="{x:Bind RemoveBindingCommand}"
                            Style="{StaticResource MountRowButtonStyle}"
                            ToolTipService.ToolTip="Remove the binding on this machine"
                            Visibility="{x:Bind IsRemoveBindingVisible, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE8CD;" />
                        </Button>
                        <Button
                            Grid.Column="6"
                            AutomationProperties.Name="{x:Bind RenameToolTip, Mode=OneWay}"
                            Command="{x:Bind RenameCommand}"
                            Style="{StaticResource MountRowButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind RenameToolTip, Mode=OneWay}"
                            Visibility="{x:Bind HasActions}">
                            <Grid>
                                <FontIcon
                                    FontSize="14"
                                    Glyph="&#xE70F;"
                                    Visibility="{x:Bind IsNotRenaming, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Glyph="&#xE73E;"
                                    Visibility="{x:Bind IsRenaming, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            Grid.Column="7"
                            AutomationProperties.Name="{x:Bind UnmountToolTip, Mode=OneWay}"
                            Command="{x:Bind UnmountCommand}"
                            Style="{StaticResource MountRowButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind UnmountToolTip, Mode=OneWay}"
                            Visibility="{x:Bind HasActions}">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </Button>
                        <FontIcon
                            Grid.Column="7"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind local:ContentMountRow.LockedToolTip}"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;"
                            ToolTipService.ToolTip="{x:Bind local:ContentMountRow.LockedToolTip}"
                            Visibility="{x:Bind IsLocked}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Add a mount: a known derived location, or any local folder or pak file with its name.  -->
        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Add a mount" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                MinWidth="150"
                Header="Location"
                ItemsSource="{x:Bind ViewModel.Kinds}"
                SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}" />
            <TextBox
                Grid.Column="1"
                Header="Mount point name"
                PlaceholderText="Environment library"
                Text="{x:Bind ViewModel.NewMountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsExternal, Mode=OneWay}" />
            <TextBox
                Grid.Column="2"
                Header="{x:Bind ViewModel.PathHeader, Mode=OneWay}"
                PlaceholderText="{x:Bind ViewModel.PathPlaceholder, Mode=OneWay}"
                Text="{x:Bind ViewModel.NewMountPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsExternal, Mode=OneWay}" />
            <Button
                Grid.Column="3"
                Width="32"
                Height="32"
                Padding="0"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{x:Bind ViewModel.BrowseToolTip, Mode=OneWay}"
                Command="{x:Bind ViewModel.BrowseCommand}"
                ToolTipService.ToolTip="{x:Bind ViewModel.BrowseToolTip, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsExternal, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xED25;" />
            </Button>
        </Grid>
        <local:MountPlacementView Placement="{x:Bind ViewModel.Placement}" Visibility="{x:Bind ViewModel.IsExternal, Mode=OneWay}" />
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddMountCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
                <TextBlock Text="Add mount" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
