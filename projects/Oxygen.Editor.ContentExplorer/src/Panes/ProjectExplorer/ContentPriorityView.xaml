<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentBrowser.ProjectExplorer.ContentPriorityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.ContentBrowser.ProjectExplorer">
    <Grid
        MinWidth="360"
        MaxWidth="600"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Text="Higher entries override lower entries."
                TextWrapping="Wrap" />
            <dnc:ToolBar
                Grid.Column="1"
                DefaultLabelPosition="Collapsed"
                IsCompact="True">
                <dnc:ToolBarButton
                    Command="{x:Bind ViewModel.IncreasePriorityCommand}"
                    Label="Increase priority"
                    ToolTipService.ToolTip="Increase priority">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE70E;" />
                    </dnc:ToolBarButton.Icon>
                </dnc:ToolBarButton>
                <dnc:ToolBarButton
                    Command="{x:Bind ViewModel.DecreasePriorityCommand}"
                    Label="Decrease priority"
                    ToolTipService.ToolTip="Decrease priority">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE70D;" />
                    </dnc:ToolBarButton.Icon>
                </dnc:ToolBarButton>
            </dnc:ToolBar>
        </Grid>
        <ListView
            Grid.Row="1"
            MinHeight="96"
            MaxHeight="320"
            AutomationProperties.Name="Content sources in priority order"
            ItemsSource="{x:Bind ViewModel.Sources}"
            SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ContentPriorityItem">
                    <StackPanel Padding="0,4" ToolTipService.ToolTip="{x:Bind Path}">
                        <TextBlock
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Path}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
