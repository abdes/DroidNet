<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <RootNamespace>Oxygen.Editor.Assets.Integration.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <DroidNetTestTier>Integration</DroidNetTestTier>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Oxygen.Editor.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Projects/testing/Oxygen.Editor.Projects.Testing.csproj" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Moq" />
        <PackageReference Include="Testably.Abstractions" />
        <None Include="$(ProjectsRoot)/Oxygen.Engine/src/Oxygen/Cooker/Test/Assets/Models/static_scalar_triangle.gltf" Link="Fixtures/static_scalar_triangle.gltf" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="../TestSupport/AssetFeeds.cs" Link="TestSupport/AssetFeeds.cs" />
        <Compile Include="../TestSupport/AssetStatusFixture.cs" Link="TestSupport/AssetStatusFixture.cs" />
        <Compile Include="../TestSupport/AssetWorkspace.cs" Link="TestSupport/AssetWorkspace.cs" />
        <Compile Include="../TestSupport/Observer.cs" Link="TestSupport/Observer.cs" />
        <Compile Include="../TestSupport/WorkspaceCookScopeProvider.cs" Link="TestSupport/WorkspaceCookScopeProvider.cs" />
        <Compile Include="$(ProjectsRoot)/Oxygen.Managed.Core/testsupport/TemporaryNativeArtifacts.cs" Link="Support/TemporaryNativeArtifacts.cs" />
    </ItemGroup>

</Project>
