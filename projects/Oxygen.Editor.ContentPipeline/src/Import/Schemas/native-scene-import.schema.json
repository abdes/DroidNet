{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native scene import settings",
  "type": "object",
  "properties": {
    "SchemaVersion": {
      "const": 2
    },
    "Importer": {
      "const": "Oxygen.Cooker.Scene/v1"
    },
    "MountPoint": {
      "type": "string",
      "minLength": 1
    },
    "Name": {
      "type": "string",
      "minLength": 1
    },
    "BundleRoot": {
      "type": "string",
      "minLength": 1
    },
    "PrimaryRelativePath": {
      "type": "string",
      "minLength": 1
    },
    "SourceHash": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "Files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "OutputDirectory": {
      "type": "string",
      "minLength": 1
    },
    "ContentPolicy": {
      "const": "static-scalar"
    },
    "UnitPolicy": {
      "const": "normalize"
    },
    "BakeTransforms": {
      "const": false
    },
    "NormalsPolicy": {
      "const": "generate"
    },
    "TangentsPolicy": {
      "const": "preserve"
    }
  },
  "required": [
    "SchemaVersion",
    "Importer",
    "MountPoint",
    "Name",
    "BundleRoot",
    "PrimaryRelativePath",
    "SourceHash",
    "Files",
    "OutputDirectory",
    "ContentPolicy",
    "UnitPolicy",
    "BakeTransforms",
    "NormalsPolicy",
    "TangentsPolicy"
  ],
  "additionalProperties": false
}
