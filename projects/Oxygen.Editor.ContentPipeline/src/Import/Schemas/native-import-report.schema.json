{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "report_version",
    "session",
    "jobs"
  ],
  "properties": {
    "report_version": {
      "const": "2"
    },
    "session": {
      "type": "object",
      "required": [
        "cooked_root"
      ],
      "properties": {
        "cooked_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "type",
          "status",
          "outputs",
          "diagnostics"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "skipped",
              "not_submitted",
              "cancelled"
            ]
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "size_bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "severity",
                "code",
                "message"
              ],
              "properties": {
                "severity": {
                  "enum": [
                    "info",
                    "warning",
                    "error"
                  ]
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "object_path": {
                  "type": "string"
                },
                "source_path": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
