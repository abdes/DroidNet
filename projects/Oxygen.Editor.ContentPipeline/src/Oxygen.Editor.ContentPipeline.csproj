<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <RootNamespace>Oxygen.Editor.ContentPipeline</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>

        <Title>Oxygen editor content pipeline orchestration.</Title>
        <Description>Oxygen.Editor.ContentPipeline coordinates editor import, cook, index, and inspection workflows using Oxygen.Managed.Assets primitives.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>oxygen;editor;content-pipeline;assets</PackageTags>
        <PackageReleaseNotes>Initial version.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Import\Schemas\*.schema.json" />
        <EmbeddedResource Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Cooker\Tools\Inspector\Schemas\oxygen.cooked-geometries.schema.json"
                          LogicalName="oxygen.cooked-geometries.schema.json" />
        <EmbeddedResource Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Cooker\Import\Schemas\oxygen.material-slot-provenance.schema.json"
                          LogicalName="oxygen.material-slot-provenance.schema.json" />
        <EmbeddedResource Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Cooker\Tools\Inspector\Schemas\oxygen.cooked-scripts.schema.json"
                          LogicalName="oxygen.cooked-scripts.schema.json" />
        <EmbeddedResource Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Cooker\Tools\Inspector\Schemas\oxygen.cooked-inventory.schema.json"
                          LogicalName="oxygen.cooked-inventory.schema.json" />
        <EmbeddedResource Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Cooker\Import\Schemas\oxygen.cooked-dependencies.schema.json"
                          LogicalName="oxygen.cooked-dependencies.schema.json" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <InternalsVisibleTo Include="Oxygen.Editor.ContentPipeline.Unit.Tests" />
        <InternalsVisibleTo Include="Oxygen.Editor.ContentPipeline.Integration.Tests" />
        <InternalsVisibleTo Include="Oxygen.Editor.ContentPipeline.Benchmarks.Tests" />
        <InternalsVisibleTo Include="Oxygen.Editor.ContentPipeline.WorkerProbe" />
        <InternalsVisibleTo Include="Oxygen.Editor.MaterialEditor.Tests" />
        <InternalsVisibleTo Include="Oxygen.Editor.LivePreview.Unit.UI.Tests" />
        <InternalsVisibleTo Include="Oxygen.Editor.Integration.UI.Tests" />
        <InternalsVisibleTo Include="Oxygen.Editor.Benchmarks.UI.Tests" />
        <InternalsVisibleTo Include="Oxygen.Editor.ContentExplorer.UI.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Documents\src\Oxygen.Editor.Documents.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Input\src\Oxygen.Editor.Input.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Scripting\src\Oxygen.Editor.Scripting.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Assets\src\Oxygen.Managed.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\src\Oxygen.Managed.Core.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Projects\src\Oxygen.Editor.Projects.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.World\src\Oxygen.Editor.World.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Schemas\src\Oxygen.Editor.Schemas.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Storage\src\Storage.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\TimeMachine\src\TimeMachine.csproj" />
    </ItemGroup>
</Project>
