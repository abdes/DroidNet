    <ItemGroup>
        <ProjectReference Include="../../testsupport/WorkerProbe/Oxygen.Editor.ContentPipeline.WorkerProbe.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="ErrorLog" />
    </ItemGroup>
    <Target Name="CopyContentWorkerProbe" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <MSBuild Projects="../../testsupport/WorkerProbe/Oxygen.Editor.ContentPipeline.WorkerProbe.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)" RemoveProperties="BuildingInsideVisualStudio;BuildingSolutionFile;CurrentSolutionConfigurationContents;ErrorLog">
            <Output TaskParameter="TargetOutputs" ItemName="_ContentWorkerProbeAssembly" />
        </MSBuild>
        <PropertyGroup>
            <_ContentWorkerProbeDirectory>@(_ContentWorkerProbeAssembly->'%(RootDir)%(Directory)')</_ContentWorkerProbeDirectory>
        </PropertyGroup>
        <ItemGroup>
            <_ContentWorkerProbeFiles Include="$(_ContentWorkerProbeDirectory)*" />
        </ItemGroup>
        <Copy SourceFiles="@(_ContentWorkerProbeFiles)" DestinationFolder="$(OutDir)WorkerProbe" SkipUnchangedFiles="true" />
    </Target>
</Project>
