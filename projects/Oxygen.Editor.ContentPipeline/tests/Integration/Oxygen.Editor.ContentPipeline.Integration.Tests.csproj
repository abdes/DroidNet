        <Compile Include="$(ProjectsRoot)/Oxygen.Editor.ContentPipeline/testsupport/Controlled/ImportAdapterWorkspace.cs" Link="Support/ImportAdapterWorkspace.cs" />
        <Compile Include="$(ProjectsRoot)/Oxygen.Editor.ContentPipeline/testsupport/Controlled/NativeInventoryFixture.Api.cs" Link="Support/NativeInventoryFixture.Api.cs" />
        <Compile Include="$(ProjectsRoot)/Oxygen.Editor.ContentPipeline/testsupport/Controlled/NativeInventoryFixture.cs" Link="Support/NativeInventoryFixture.cs" />
