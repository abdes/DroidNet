{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Geometry Descriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "oxygen.name.schema.json#/definitions/segment"
    },
    "content_hashing": {
      "type": "boolean"
    },
    "bounds": {
      "$ref": "#/definitions/bounds3",
      "description": "Local bounds of the whole geometry, containing every LOD's bounds. Defaults to the union of the LOD bounds."
    },
    "buffers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/buffer_descriptor"
      }
    },
    "lods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/definitions/lod_descriptor"
      }
    },
    "surfaces": {
      "description": "Surface asset defaults, each of a surface the submeshes declare, at most once.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/surface_defaults"
      }
    },
    "lod_policy": {
      "description": "The default LOD policy; absent takes the scene schema's default.",
      "$ref": "oxygen.lod-policy.schema.json#/definitions/lod_policy"
    }
  },
  "required": ["name", "lods"],
  "definitions": {
    "canonical_virtual_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    },
    "canonical_obuf_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+\\.obuf$"
    },
    "canonical_omat_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/(?!.*//)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+\\.omat$"
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "bounds3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "#/definitions/vec3"
        },
        "max": {
          "$ref": "#/definitions/vec3"
        }
      },
      "required": ["min", "max"]
    },
    "view_selector": {
      "oneOf": [
        {
          "const": "__all__"
        },
        {
          "allOf": [
            {
              "$ref": "oxygen.name.schema.json#/definitions/segment"
            },
            {
              "not": {
                "const": "__all__"
              }
            }
          ]
        }
      ]
    },
    "buffer_view_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "oxygen.name.schema.json#/definitions/segment"
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "element_offset": {
          "type": "integer",
          "minimum": 0
        },
        "element_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["name"],
      "allOf": [
        {
          "not": {
            "properties": {
              "name": {
                "const": "__all__"
              }
            },
            "required": ["name"]
          }
        },
        {
          "anyOf": [
            {
              "required": ["byte_offset", "byte_length"]
            },
            {
              "required": ["element_offset", "element_count"]
            }
          ]
        },
        {
          "if": {
            "required": ["byte_offset"]
          },
          "then": {
            "required": ["byte_length"]
          }
        },
        {
          "if": {
            "required": ["byte_length"]
          },
          "then": {
            "required": ["byte_offset"]
          }
        },
        {
          "if": {
            "required": ["element_offset"]
          },
          "then": {
            "required": ["element_count"]
          }
        },
        {
          "if": {
            "required": ["element_count"]
          },
          "then": {
            "required": ["element_offset"]
          }
        }
      ]
    },
    "buffer_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "virtual_path": {
          "$ref": "#/definitions/canonical_obuf_path"
        },
        "usage_flags": {
          "type": "integer",
          "minimum": 0
        },
        "element_stride": {
          "type": "integer",
          "minimum": 0
        },
        "element_format": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "alignment": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "type": "integer",
          "minimum": 0
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/buffer_view_descriptor"
          },
          "uniqueItems": true
        }
      },
      "required": ["uri", "virtual_path"],
      "allOf": [
        {
          "if": {
            "properties": {
              "element_format": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["element_format"]
          },
          "then": {
            "properties": {
              "element_stride": {
                "type": "integer",
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "element_stride": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["element_stride"]
          },
          "then": {
            "properties": {
              "element_format": {
                "type": "integer",
                "maximum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "element_stride": {
                "type": "integer",
                "const": 0
              }
            },
            "required": ["element_stride"]
          },
          "then": {
            "properties": {
              "element_format": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["element_format"]
          }
        }
      ]
    },
    "mesh_buffer_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vb_ref": {
          "$ref": "#/definitions/canonical_obuf_path"
        },
        "ib_ref": {
          "$ref": "#/definitions/canonical_obuf_path"
        }
      },
      "required": ["vb_ref", "ib_ref"]
    },
    "skinning_buffer_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "joint_index_ref": {
          "$ref": "#/definitions/canonical_obuf_path"
        },
        "joint_weight_ref": {
          "$ref": "#/definitions/canonical_obuf_path"
        },
        "inverse_bind_ref": {
          "$ref": "#/definitions/canonical_obuf_path"
        },
        "joint_remap_ref": {
          "$ref": "#/definitions/canonical_obuf_path"
        },
        "skeleton_ref": {
          "$ref": "#/definitions/canonical_virtual_path"
        },
        "joint_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "influences_per_vertex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "flags": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "joint_index_ref",
        "joint_weight_ref",
        "inverse_bind_ref",
        "joint_remap_ref"
      ]
    },
    "sphere_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latitude_segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4294967295
        },
        "longitude_segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4294967295
        }
      }
    },
    "ico_sphere_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subdivision_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "subdivided_cube_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "plane_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_segments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "y_segments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        }
      }
    },
    "cylinder_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4294967295
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        }
      }
    },
    "cone_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4294967295
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        }
      }
    },
    "capsule_params": {
      "type": "object",
      "additionalProperties": false,
      "description": "Centred Z-axis capsule. Height includes both hemispheres and must be at least twice the radius; equality produces a sphere. Defaults are 2 m total height and 1 m diameter.",
      "properties": {
        "hemisphere_segments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Intervals from each pole to its hemisphere equator."
        },
        "radial_segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 256,
          "description": "Intervals around the Z axis."
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38,
          "description": "Total height in metres, including both hemispheres."
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38,
          "description": "Hemisphere and cylinder radius in metres."
        }
      }
    },
    "torus_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "major_segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4294967295
        },
        "minor_segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 4294967295
        },
        "major_radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        },
        "minor_radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        }
      }
    },
    "quad_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3.4028234663852886e38
        }
      }
    },
    "procedural_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator": {
          "type": "string",
          "enum": [
            "Cube",
            "SubdividedCube",
            "ArrowGizmo",
            "Sphere",
            "IcoSphere",
            "Plane",
            "Cylinder",
            "Cone",
            "Capsule",
            "Torus",
            "Quad"
          ]
        },
        "mesh_name": {
          "$ref": "oxygen.name.schema.json#/definitions/segment"
        },
        "params": {
          "type": "object"
        }
      },
      "required": ["generator", "mesh_name"],
      "allOf": [
        {
          "if": {
            "properties": {
              "generator": {
                "enum": ["Cube", "ArrowGizmo"]
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "Sphere"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/sphere_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "Plane"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/plane_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "SubdividedCube"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/subdivided_cube_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "IcoSphere"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/ico_sphere_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "Cylinder"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/cylinder_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "Cone"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/cone_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "Capsule"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/capsule_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "Torus"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/torus_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generator": {
                "const": "Quad"
              }
            },
            "required": ["generator"]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/definitions/quad_params"
              }
            }
          }
        }
      ]
    },
    "submesh_view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "oxygen.name.schema.json#/definitions/segment"
        },
        "view_ref": {
          "$ref": "#/definitions/view_selector"
        },
        "bounds": {
          "$ref": "#/definitions/bounds3",
          "description": "Local bounds of the view's triangles, inside the submesh bounds. Defaults to the submesh bounds."
        }
      },
      "required": ["view_ref"]
    },
    "surface_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "surface_defaults": {
      "description": "The asset defaults of one declared surface; an absent value takes the scene schema's default.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface_id": {
          "$ref": "#/definitions/surface_id"
        },
        "visible": {
          "type": "boolean"
        },
        "casts_shadows": {
          "type": "boolean"
        }
      },
      "required": ["surface_id"]
    },
    "submesh_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface_id": {
          "$ref": "#/definitions/surface_id"
        },
        "name": {
          "$ref": "oxygen.name.schema.json#/definitions/segment"
        },
        "material_ref": {
          "$ref": "#/definitions/canonical_omat_path"
        },
        "bounds": {
          "$ref": "#/definitions/bounds3",
          "description": "Local bounds of the submesh's triangles, inside the LOD bounds. Defaults to the LOD bounds."
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/submesh_view"
          }
        }
      },
      "required": ["surface_id", "material_ref", "views"]
    },
    "lod_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "oxygen.name.schema.json#/definitions/segment"
        },
        "mesh_type": {
          "type": "string",
          "enum": ["standard", "skinned", "procedural"]
        },
        "bounds": {
          "$ref": "#/definitions/bounds3",
          "description": "Local bounds of the LOD's mesh. Required for buffer meshes; a procedural mesh's bounds come from its generator."
        },
        "buffers": {
          "$ref": "#/definitions/mesh_buffer_refs"
        },
        "skinning": {
          "$ref": "#/definitions/skinning_buffer_refs"
        },
        "procedural": {
          "$ref": "#/definitions/procedural_descriptor"
        },
        "submeshes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/submesh_descriptor"
          }
        }
      },
      "required": ["name", "mesh_type", "submeshes"],
      "allOf": [
        {
          "if": {
            "properties": {
              "mesh_type": {
                "const": "standard"
              }
            },
            "required": ["mesh_type"]
          },
          "then": {
            "required": ["buffers", "bounds"],
            "not": {
              "anyOf": [
                {
                  "required": ["skinning"]
                },
                {
                  "required": ["procedural"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mesh_type": {
                "const": "skinned"
              }
            },
            "required": ["mesh_type"]
          },
          "then": {
            "required": ["buffers", "skinning", "bounds"],
            "not": {
              "required": ["procedural"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mesh_type": {
                "const": "procedural"
              }
            },
            "required": ["mesh_type"]
          },
          "then": {
            "required": ["procedural"],
            "properties": {
              "submeshes": {
                "items": {
                  "not": {
                    "required": ["bounds"]
                  },
                  "properties": {
                    "views": {
                      "items": {
                        "not": {
                          "required": ["bounds"]
                        }
                      }
                    }
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": ["buffers"]
                },
                {
                  "required": ["bounds"]
                },
                {
                  "required": ["skinning"]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
