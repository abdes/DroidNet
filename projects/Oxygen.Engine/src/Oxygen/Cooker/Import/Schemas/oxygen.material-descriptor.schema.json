{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Material Descriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "oxygen.name.schema.json#/definitions/segment"
    },
    "domain": {
      "enum": [
        "opaque",
        "alpha_blended",
        "masked",
        "decal",
        "ui",
        "post_process"
      ]
    },
    "alpha_mode": {
      "enum": ["opaque", "masked", "blended"]
    },
    "orm_policy": {
      "enum": ["auto", "force_packed", "force_separate"]
    },
    "ambient_occlusion_mode": {
      "description": "How `parameters.ambient_occlusion` combines with an ambient occlusion texture: `factor` multiplies the sample; `strength` blends from unoccluded to the sample, and is unoccluded without a texture.",
      "enum": ["factor", "strength"],
      "default": "factor"
    },
    "procedural_grid": {
      "$ref": "#/definitions/procedural_grid"
    },
    "parameters": {
      "$ref": "#/definitions/parameters"
    },
    "textures": {
      "$ref": "#/definitions/textures"
    },
    "shaders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/shader_stage"
      }
    }
  },
  "definitions": {
    "float": {
      "type": "number",
      "minimum": -3.4028234663852886e38,
      "maximum": 3.4028234663852886e38
    },
    "non_negative_float": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 3.4028234663852886e38
    },
    "vec2": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/float"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3_01": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vec4_01": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      },
      "minItems": 4,
      "maxItems": 4
    },
    "uv_transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": {
          "$ref": "#/definitions/vec2"
        },
        "offset": {
          "$ref": "#/definitions/vec2"
        },
        "rotation_radians": {
          "$ref": "#/definitions/float"
        }
      }
    },
    "texture_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["virtual_path"],
      "properties": {
        "virtual_path": {
          "allOf": [
            {
              "$ref": "oxygen.reference.schema.json#/definitions/reference"
            },
            {
              "pattern": "\\.otex$"
            }
          ]
        },
        "uv_set": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "uv_transform": {
          "$ref": "#/definitions/uv_transform"
        }
      }
    },
    "textures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_color": {
          "$ref": "#/definitions/texture_binding"
        },
        "normal": {
          "$ref": "#/definitions/texture_binding"
        },
        "metallic": {
          "$ref": "#/definitions/texture_binding"
        },
        "roughness": {
          "$ref": "#/definitions/texture_binding"
        },
        "ambient_occlusion": {
          "$ref": "#/definitions/texture_binding"
        },
        "emissive": {
          "$ref": "#/definitions/texture_binding"
        },
        "specular": {
          "$ref": "#/definitions/texture_binding"
        },
        "sheen_color": {
          "$ref": "#/definitions/texture_binding"
        },
        "clearcoat": {
          "$ref": "#/definitions/texture_binding"
        },
        "clearcoat_normal": {
          "$ref": "#/definitions/texture_binding"
        },
        "transmission": {
          "$ref": "#/definitions/texture_binding"
        },
        "thickness": {
          "$ref": "#/definitions/texture_binding"
        }
      }
    },
    "procedural_grid": {
      "description": "Shades the material with a world-space grid on any surface. Its presence turns the grid on.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spacing": {
          "description": "World units between minor lines, along each axis of a plane.",
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "maximum": 3.4028234663852886e38
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [1.0, 1.0]
        },
        "major_every": {
          "description": "Minor cells per major line.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 10
        },
        "line_thickness": {
          "$ref": "#/definitions/non_negative_float"
        },
        "major_thickness": {
          "$ref": "#/definitions/non_negative_float"
        },
        "axis_thickness": {
          "$ref": "#/definitions/non_negative_float"
        },
        "fade_start": {
          "description": "View distance at which the grid starts to fade.",
          "$ref": "#/definitions/non_negative_float"
        },
        "fade_end": {
          "description": "View distance at which the grid is gone; it does not fade when this is not past fade_start.",
          "$ref": "#/definitions/non_negative_float"
        },
        "minor_color": {
          "$ref": "#/definitions/vec4_01"
        },
        "major_color": {
          "$ref": "#/definitions/vec4_01"
        },
        "axis_color_x": {
          "$ref": "#/definitions/vec4_01"
        },
        "axis_color_y": {
          "$ref": "#/definitions/vec4_01"
        },
        "origin_color": {
          "$ref": "#/definitions/vec4_01"
        }
      }
    },
    "shader_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "source_path", "entry_point"],
      "properties": {
        "stage": {
          "enum": [
            "amplification",
            "mesh",
            "vertex",
            "hull",
            "domain",
            "geometry",
            "pixel",
            "compute",
            "ray_gen",
            "intersection",
            "any_hit",
            "closest_hit",
            "miss",
            "callable"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "defines": {
          "type": "string"
        },
        "shader_hash": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_color": {
          "$ref": "#/definitions/vec4_01"
        },
        "normal_scale": {
          "$ref": "#/definitions/non_negative_float"
        },
        "metalness": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "roughness": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "ambient_occlusion": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "emissive_color": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "minItems": 3,
          "maxItems": 3,
          "default": [1.0, 1.0, 1.0]
        },
        "emissive_intensity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 65504.0,
          "default": 0.0
        },
        "alpha_cutoff": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "ior": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 3.4028234663852886e38
        },
        "specular_factor": {
          "description": "Specular level of dielectrics: F0 = 0.08 x level. 0.5, the default, gives F0 = 0.04; with a specular texture, the level is this factor times the texture's red channel.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5
        },
        "sheen_color_factor": {
          "$ref": "#/definitions/vec3_01"
        },
        "clearcoat_factor": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "clearcoat_roughness": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "transmission_factor": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "thickness_factor": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "attenuation_color": {
          "$ref": "#/definitions/vec3_01"
        },
        "attenuation_distance": {
          "$ref": "#/definitions/non_negative_float"
        },
        "double_sided": {
          "type": "boolean"
        },
        "unlit": {
          "type": "boolean"
        },
        "roughness_as_glossiness": {
          "description": "`roughness` and the roughness texture hold glossiness: the surface's roughness is 1 - roughness x sample.",
          "type": "boolean"
        }
      }
    }
  }
}
