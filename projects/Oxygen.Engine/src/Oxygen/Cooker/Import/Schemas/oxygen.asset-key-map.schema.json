{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Virtual Asset Key Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["virtual_path", "asset_key"],
        "properties": {
          "virtual_path": {
            "type": "string",
            "pattern": "^/[^/\\\\]+(/[^/\\\\]+)+$",
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)|[\\u0000-\\u001f]"
            }
          },
          "asset_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    }
  }
}
