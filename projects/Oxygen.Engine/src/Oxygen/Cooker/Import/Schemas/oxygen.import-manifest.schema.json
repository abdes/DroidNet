    "job_settings": {
      "type": "object",
      "properties": {
        "physics_backend": {
          "type": "string",
          "enum": ["jolt", "physx", "none"]
        },
        "type": {
          "enum": [
            "texture",
            "texture-descriptor",
            "buffer-container",
            "material-descriptor",
            "physics-material-descriptor",
            "collision-shape-descriptor",
            "geometry-descriptor",
            "scene-descriptor",
            "fbx",
            "gltf",
            "model",
            "script",
            "script-sidecar",
            "physics-sidecar",
            "input"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string"
        },
        "derived_from": {
          "description": "For a source in an output folder (a derived file): the mount path of the authored source it derives from, recorded as the producer of what the job cooks.",
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "layer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "mip": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "slice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "required": ["file"],
            "additionalProperties": false
          }
        },
        "output": {
          "type": "string"
        },
        "virtual_path": {
          "type": "string",
          "minLength": 1,
          "description": "Identity of the asset a single-asset job cooks, whose descriptor is written at this virtual path, or of the container a container job cooks, whose products are named under it: an input source (`/Content/Input/Player.input/Jump.oiact`) or a model, whose identity ends in its source file's extension (`/Content/Ship/Ship.glb/Paint.omat`). Required for material, geometry, scene, script, texture, physics material, collision shape, input, glTF and FBX jobs, and refused on the others."
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "intent": {
          "$ref": "#/definitions/texture_intent"
        },
        "color_space": {
          "$ref": "#/definitions/color_space"
        },
        "output_format": {
          "$ref": "#/definitions/texture_format"
        },
        "data_format": {
          "$ref": "#/definitions/texture_format"
        },
        "preset": {
          "$ref": "#/definitions/texture_preset"
        },
        "mip_policy": {
          "$ref": "#/definitions/mip_policy"
        },
        "mip_filter": {
          "$ref": "#/definitions/mip_filter"
        },
        "bc7_quality": {
          "$ref": "#/definitions/bc7_quality"
        },
        "packing_policy": {
          "$ref": "#/definitions/packing_policy"
        },
        "cube_layout": {
          "$ref": "#/definitions/cube_layout"
        },
        "hdr_handling": {
          "$ref": "#/definitions/hdr_handling"
        },
        "exposure_ev": {
          "type": "number"
        },
        "max_mips": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_size": {
          "description": "The largest width or height of the stored texture; a larger source drops its largest mips. Absent: the source size.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "cube_face_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "flip_y": {
          "type": "boolean"
        },
        "flip_normal_green": {
          "type": "boolean"
        },
        "renormalize": {
          "type": "boolean"
        },
        "bake_hdr": {
          "type": "boolean"
        },
        "force_rgba": {
          "type": "boolean"
        },
        "cubemap": {
          "type": "boolean"
        },
        "equirect_to_cube": {
          "type": "boolean"
        },
        "content_flags": {
          "type": "object",
          "properties": {
            "textures": {
              "type": "boolean"
            },
            "materials": {
              "type": "boolean"
            },
            "geometry": {
              "type": "boolean"
            },
            "scene": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "unit_policy": {
          "enum": ["normalize", "preserve", "custom"]
        },
        "unit_scale": {
          "type": "number",
          "minimum": 0.0001
        },
        "omitted_light_range_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4096
        },
        "gltf_scene": {
          "description": "The glTF scene imported as the model scene: its name, or #N for the scene at index N. Absent: the default scene, else the first.",
          "type": "string",
          "minLength": 1
        },
        "up_axis": {
          "$ref": "#/definitions/source_up_axis"
        },
        "normals_smoothing_angle_deg": {
          "description": "The largest angle between two faces that share a smoothed normal, wherever the import generates or recalculates normals.",
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "default": 60
        },
        "generate_lods": {
          "description": "Whether each geometry with one LOD gets generated LODs, simplified from LOD 0. A geometry with authored LODs keeps them.",
          "type": "boolean",
          "default": false
        },
        "lod_levels": {
          "description": "The LODs generated after LOD 0, when generate_lods is on.",
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "default": 3
        },
        "lod_reduction_percent": {
          "description": "The triangles each generated LOD removes, in percent of the previous LOD's, when generate_lods is on.",
          "type": "number",
          "minimum": 1,
          "maximum": 99,
          "default": 50
        },
        "import_lights": {
          "type": "boolean",
          "default": true
        },
        "import_cameras": {
          "type": "boolean",
          "default": true
        },
        "light_intensity_scale": {
          "description": "The factor every imported light's intensity is multiplied by.",
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "material_remap": {
          "$ref": "#/definitions/material_remap"
        },
        "geometry_defaults": {
          "$ref": "#/definitions/geometry_import_defaults"
        },
        "bake_transforms": {
          "type": "boolean"
        },
        "normals_policy": {
          "enum": ["none", "preserve", "generate", "recalculate"]
        },
        "tangents_policy": {
          "enum": ["none", "preserve", "generate", "recalculate"]
        },
        "node_pruning": {
          "enum": ["keep", "drop-empty"]
        },
        "texture_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/texture_settings"
          }
        },
        "compile": {
          "type": "boolean"
        },
        "compile_mode": {
          "$ref": "#/definitions/script_compile_mode"
        },
        "script_storage": {
          "$ref": "#/definitions/script_storage_mode"
        },
        "target_scene_virtual_path": {
          "type": "string"
        },
        "bindings": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object"
            }
          ]
        },
        "instance_bindings": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "A script sidecar's script parameter changes of the scene's instances; only with inline bindings."
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        },
        "source_key": {
          "$ref": "#/definitions/source_key"
        }
      },
      "additionalProperties": false
    },
    "script_compile_mode": {
      "enum": ["debug", "optimized"]
    },
    "script_storage_mode": {
      "enum": ["embedded", "external"]
    },
    "texture_intent": {
      "enum": [
        "albedo",
        "normal",
        "roughness",
        "metallic",
        "ao",
        "emissive",
        "opacity",
        "orm",
        "hdr_env",
        "hdr-env",
        "hdr_probe",
        "hdr-probe",
        "data",
        "height"
      ]
    },
    "color_space": {
      "enum": ["srgb", "linear"]
    },
    "texture_format": {
      "enum": [
        "rgba8",
        "rgba8_srgb",
        "rgba8-srgb",
        "rgba8_unorm",
        "rgba8_unorm_srgb",
        "bc7",
        "bc7_srgb",
        "bc7-srgb",
        "bc7_unorm",
        "bc7_unorm_srgb",
        "rgba16f",
        "rgba32f"
      ]
    },
    "texture_preset": {
      "enum": [
        "albedo",
        "albedo-srgb",
        "albedo-linear",
        "normal",
        "normal-bc7",
        "roughness",
        "metallic",
        "ao",
        "orm",
        "orm-bc7",
        "emissive",
        "ui",
        "hdr-env",
        "hdr-env-16f",
        "hdr-env-32f",
        "hdr-probe",
        "data",
        "height"
      ]
    },
    "mip_policy": {
      "enum": ["none", "full", "max"]
    },
    "mip_filter": {
      "enum": ["box", "kaiser", "lanczos"]
    },
    "bc7_quality": {
      "enum": ["none", "fast", "default", "high"]
    },
    "packing_policy": {
      "enum": ["d3d12", "tight"]
    },
    "cube_layout": {
      "enum": ["auto", "hstrip", "vstrip", "hcross", "vcross"]
    },
    "hdr_handling": {
      "enum": ["error", "tonemap", "auto", "keep", "float"]
    },
    "source_up_axis": {
      "description": "The up axis an FBX source is read in; the import always produces Oxygen's +Z up. from-file takes the file's axes, or FBX's default (right-handed Y up) when they are incomplete; y and z read the source as right-handed Y up or Z up whatever the file states. A glTF source is Y up by specification and ignores it.",
      "enum": ["from-file", "y", "z"],
      "default": "from-file"
    },
    "material_remap": {
      "description": "Source materials replaced by existing materials: a material's name in the import to the reference of the material its surfaces use instead: an absolute virtual path in another mount or a path relative to the folder of the model. A replaced material is not produced.",
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "oxygen.reference.schema.json#/definitions/reference"
          },
          {
            "pattern": "\\.omat$"
          }
        ]
      }
    },
    "geometry_import_defaults": {
      "description": "Asset defaults written into the model's geometries, by geometry anchor (the geometry's storage name).",
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lod_policy": {
            "description": "The geometry's default LOD policy; absent takes the import's rule.",
            "$ref": "oxygen.lod-policy.schema.json#/definitions/lod_policy"
          },
          "surfaces": {
            "description": "Surface defaults by surface ID; an absent value takes the scene schema's default.",
            "type": "object",
            "propertyNames": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "visible": {
                  "type": "boolean"
                },
                "casts_shadows": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "cooked_context_roots": {
      "type": "array",
      "description": "Ordered resolver-only cooked sources, loose cooked roots or pak files, relative to the manifest or absolute. Later sources have higher priority.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Explicit cooked root identity. All jobs writing one root must agree; new physical generations require fresh identities."
    }
  }
}
