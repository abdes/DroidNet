{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Import Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional self-reference to this schema file."
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "thread_pool_size": {
      "type": "integer",
      "minimum": 1
    },
    "max_in_flight_jobs": {
      "type": "integer",
      "minimum": 1
    },
    "job_admission_capacity": {
      "type": "integer",
      "minimum": 1
    },
    "concurrency": {
      "type": "object",
      "properties": {
        "texture": {
          "$ref": "#/definitions/concurrency_item"
        },
        "buffer": {
          "$ref": "#/definitions/concurrency_item"
        },
        "material": {
          "$ref": "#/definitions/concurrency_item"
        },
        "mesh_build": {
          "$ref": "#/definitions/concurrency_item"
        },
        "geometry": {
          "$ref": "#/definitions/concurrency_item"
        },
        "scene": {
          "$ref": "#/definitions/concurrency_item"
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "$ref": "#/definitions/defaults_settings"
    },
    "layout": {
      "$ref": "#/definitions/layout_settings"
    },
    "output": {
      "type": "string"
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/job_item"
      }
    },
    "source_key": {
      "$ref": "#/definitions/source_key"
    }
  },
  "required": ["jobs"],
  "definitions": {
    "concurrency_item": {
      "type": "object",
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1
        },
        "queue_capacity": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["workers", "queue_capacity"],
      "additionalProperties": false
    },
    "job_item": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/job_settings"
        },
        {
          "required": ["type"]
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "model"
              }
            }
          },
          "then": {
            "required": ["record"],
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "record",
                "output",
                "layout",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "texture-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "sources",
                "output",
                "layout",
                "name",
                "virtual_path",
                "verbose",
                "intent",
                "color_space",
                "output_format",
                "data_format",
                "preset",
                "mip_policy",
                "mip_filter",
                "bc7_quality",
                "packing_policy",
                "cube_layout",
                "hdr_handling",
                "exposure_ev",
                "max_mips",
                "max_size",
                "cube_face_size",
                "flip_y",
                "flip_normal_green",
                "renormalize",
                "bake_hdr",
                "force_rgba",
                "cubemap",
                "equirect_to_cube",
                "content_hashing",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "buffer-container"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "output",
                "layout",
                "name",
                "content_hashing",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "material-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "output",
                "layout",
                "name",
                "virtual_path",
                "content_hashing",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "physics-material-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "output",
                "layout",
                "name",
                "virtual_path",
                "content_hashing",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "collision-shape-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "output",
                "layout",
                "name",
                "virtual_path",
                "content_hashing",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "geometry-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "output",
                "layout",
                "name",
                "virtual_path",
                "content_hashing",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scene-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "output",
                "layout",
                "name",
                "virtual_path",
                "content_hashing",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["script-sidecar", "physics-sidecar"]
              }
            }
          },
          "then": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": ["source", "target_scene_virtual_path"]
                  },
                  {
                    "required": ["bindings", "target_scene_virtual_path"]
                  }
                ]
              }
            ]
          },
          "else": {
            "if": {
              "properties": {
                "type": {
                  "const": "model"
                }
              }
            },
            "else": {
              "required": ["source"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "script-sidecar"
              }
            }
          },
          "then": {
            "properties": {
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "physics-sidecar"
              }
            }
          },
          "then": {
            "properties": {
              "bindings": {
                "type": "object"
              }
            },
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "bindings",
                "target_scene_virtual_path",
                "output",
                "layout",
                "name",
                "verbose",
                "content_hashing",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            }
          },
          "then": {
            "required": ["id", "source"],
            "propertyNames": {
              "enum": [
                "id",
                "type",
                "source",
                "virtual_path",
                "depends_on",
                "output",
                "layout",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        }
      ]
    },
    "defaults_settings": {
      "type": "object",
      "properties": {
        "texture": {
          "$ref": "#/definitions/texture_settings"
        },
        "scene": {
          "$ref": "#/definitions/scene_settings"
        },
        "script": {
          "$ref": "#/definitions/script_settings"
        },
        "scripting_sidecar": {
          "$ref": "#/definitions/scripting_sidecar_settings"
        },
        "physics_sidecar": {
          "$ref": "#/definitions/physics_sidecar_settings"
        },
        "buffer_container": {
          "$ref": "#/definitions/buffer_container_settings"
        },
        "material_descriptor": {
          "$ref": "#/definitions/material_descriptor_settings"
        },
        "physics_material_descriptor": {
          "$ref": "#/definitions/physics_material_descriptor_settings"
        },
        "collision_shape_descriptor": {
          "$ref": "#/definitions/collision_shape_descriptor_settings"
        },
        "geometry_descriptor": {
          "$ref": "#/definitions/geometry_descriptor_settings"
        },
        "scene_descriptor": {
          "$ref": "#/definitions/scene_descriptor_settings"
        },
        "input": {
          "$ref": "#/definitions/input_settings"
        },
        "layout": {
          "$ref": "#/definitions/layout_settings"
        },
        "source_key": {
          "$ref": "#/definitions/source_key"
        }
      },
      "additionalProperties": false
    },
    "layout_settings": {
      "type": "object",
      "properties": {
        "virtual_mount_root": {
          "type": "string"
        },
        "resources_dir": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "input_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "texture_settings": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "layer": {
                "type": "integer",
                "minimum": 0
              },
              "mip": {
                "type": "integer",
                "minimum": 0
              },
              "slice": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["file"],
            "additionalProperties": false
          }
        },
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "intent": {
          "$ref": "#/definitions/texture_intent"
        },
        "color_space": {
          "$ref": "#/definitions/color_space"
        },
        "output_format": {
          "$ref": "#/definitions/texture_format"
        },
        "data_format": {
          "$ref": "#/definitions/texture_format"
        },
        "preset": {
          "$ref": "#/definitions/texture_preset"
        },
        "mip_policy": {
          "$ref": "#/definitions/mip_policy"
        },
        "mip_filter": {
          "$ref": "#/definitions/mip_filter"
        },
        "bc7_quality": {
          "$ref": "#/definitions/bc7_quality"
        },
        "packing_policy": {
          "$ref": "#/definitions/packing_policy"
        },
        "cube_layout": {
          "$ref": "#/definitions/cube_layout"
        },
        "hdr_handling": {
          "$ref": "#/definitions/hdr_handling"
        },
        "exposure_ev": {
          "type": "number"
        },
        "max_mips": {
          "type": "integer",
          "minimum": 1
        },
        "max_size": {
          "description": "The largest width or height of the stored texture; a larger source drops its largest mips. Absent: the source size.",
          "type": "integer",
          "minimum": 1
        },
        "cube_face_size": {
          "type": "integer",
          "minimum": 1
        },
        "flip_y": {
          "type": "boolean"
        },
        "flip_normal_green": {
          "type": "boolean"
        },
        "renormalize": {
          "type": "boolean"
        },
        "bake_hdr": {
          "type": "boolean"
        },
        "force_rgba": {
          "type": "boolean"
        },
        "cubemap": {
          "type": "boolean"
        },
        "equirect_to_cube": {
          "type": "boolean"
        },
        "content_hashing": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "scene_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "content_hashing": {
          "type": "boolean"
        },
        "content_flags": {
          "type": "object",
          "properties": {
            "textures": {
              "type": "boolean"
            },
            "materials": {
              "type": "boolean"
            },
            "geometry": {
              "type": "boolean"
            },
            "scene": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "unit_policy": {
          "enum": ["normalize", "preserve", "custom"]
        },
        "unit_scale": {
          "type": "number",
          "minimum": 0.0001
        },
        "gltf_omitted_light_range_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4096
        },
        "gltf_scene": {
          "description": "The glTF scene imported as the model scene: its name, or #N for the scene at index N. Absent: the default scene, else the first.",
          "type": "string",
          "minLength": 1
        },
        "up_axis": {
          "$ref": "#/definitions/source_up_axis"
        },
        "normals_smoothing_angle_deg": {
          "description": "The largest angle between two faces that share a smoothed normal, wherever the import generates or recalculates normals.",
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "default": 60
        },
        "import_lights": {
          "type": "boolean",
          "default": true
        },
        "import_cameras": {
          "type": "boolean",
          "default": true
        },
        "light_intensity_scale": {
          "description": "The factor every imported light's intensity is multiplied by.",
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "material_remap": {
          "$ref": "#/definitions/material_remap"
        },
        "geometry_defaults": {
          "$ref": "#/definitions/geometry_import_defaults"
        },
        "bake_transforms": {
          "type": "boolean"
        },
        "normals_policy": {
          "enum": ["none", "preserve", "generate", "recalculate"]
        },
        "tangents_policy": {
          "enum": ["none", "preserve", "generate", "recalculate"]
        },
        "node_pruning": {
          "enum": ["keep", "drop-empty"]
        },
        "texture_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/texture_settings"
          }
        }
      },
      "additionalProperties": false
    },
    "script_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "content_hashing": {
          "type": "boolean"
        },
        "compile": {
          "type": "boolean"
        },
        "compile_mode": {
          "$ref": "#/definitions/script_compile_mode"
        },
        "script_storage": {
          "$ref": "#/definitions/script_storage_mode"
        },
        "source_root": {
          "type": "string",
          "minLength": 1,
          "description": "Authoring root for external script source paths, relative to this manifest."
        }
      },
      "additionalProperties": false
    },
    "scripting_sidecar_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "content_hashing": {
          "type": "boolean"
        },
        "physics_backend": {
          "type": "string",
          "enum": ["jolt", "physx", "none"]
        },
        "target_scene_virtual_path": {
          "type": "string"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "physics_sidecar_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "content_hashing": {
          "type": "boolean"
        },
        "target_scene_virtual_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "material_descriptor_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content_hashing": {
          "type": "boolean"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "physics_material_descriptor_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content_hashing": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "collision_shape_descriptor_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content_hashing": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "buffer_container_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content_hashing": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "geometry_descriptor_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content_hashing": {
          "type": "boolean"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "scene_descriptor_settings": {
      "type": "object",
      "description": "Scene-descriptor jobs consume authored scene descriptors matching the current native version; legacy descriptors must be updated and re-cooked before import.",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content_hashing": {
          "type": "boolean"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "job_settings": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "texture",
            "texture-descriptor",
            "buffer-container",
            "material-descriptor",
            "physics-material-descriptor",
            "collision-shape-descriptor",
            "geometry-descriptor",
            "scene-descriptor",
            "fbx",
            "gltf",
            "model",
            "script",
            "script-sidecar",
            "physics-sidecar",
            "input"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1,
          "description": "A model job's model import record (oxygen.model-import.schema.json), resolved as job sources are: against the manifest root, or beside the manifest."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "layer": {
                "type": "integer",
                "minimum": 0
              },
              "mip": {
                "type": "integer",
                "minimum": 0
              },
              "slice": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["file"],
            "additionalProperties": false
          }
        },
        "output": {
          "type": "string"
        },
        "virtual_path": {
          "type": "string",
          "minLength": 1,
          "description": "Identity of the asset a single-asset job cooks, whose descriptor is written at this virtual path, or of the container a container job cooks, whose products are named under it: an input source (`/Content/Input/Player.input/Jump.oiact`) or a model, whose identity ends in its source file's extension (`/Content/Ship/Ship.glb/Paint.omat`). Required for material, geometry, scene, script, texture, physics material, collision shape, input, glTF and FBX jobs, and refused on the others."
        },
        "name": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/definitions/layout_settings"
        },
        "verbose": {
          "type": "boolean"
        },
        "intent": {
          "$ref": "#/definitions/texture_intent"
        },
        "color_space": {
          "$ref": "#/definitions/color_space"
        },
        "output_format": {
          "$ref": "#/definitions/texture_format"
        },
        "data_format": {
          "$ref": "#/definitions/texture_format"
        },
        "preset": {
          "$ref": "#/definitions/texture_preset"
        },
        "mip_policy": {
          "$ref": "#/definitions/mip_policy"
        },
        "mip_filter": {
          "$ref": "#/definitions/mip_filter"
        },
        "bc7_quality": {
          "$ref": "#/definitions/bc7_quality"
        },
        "packing_policy": {
          "$ref": "#/definitions/packing_policy"
        },
        "cube_layout": {
          "$ref": "#/definitions/cube_layout"
        },
        "hdr_handling": {
          "$ref": "#/definitions/hdr_handling"
        },
        "exposure_ev": {
          "type": "number"
        },
        "max_mips": {
          "type": "integer",
          "minimum": 1
        },
        "max_size": {
          "description": "The largest width or height of the stored texture; a larger source drops its largest mips. Absent: the source size.",
          "type": "integer",
          "minimum": 1
        },
        "cube_face_size": {
          "type": "integer",
          "minimum": 1
        },
        "flip_y": {
          "type": "boolean"
        },
        "flip_normal_green": {
          "type": "boolean"
        },
        "renormalize": {
          "type": "boolean"
        },
        "bake_hdr": {
          "type": "boolean"
        },
        "force_rgba": {
          "type": "boolean"
        },
        "cubemap": {
          "type": "boolean"
        },
        "equirect_to_cube": {
          "type": "boolean"
        },
        "content_hashing": {
          "type": "boolean"
        },
        "content_flags": {
          "type": "object",
          "properties": {
            "textures": {
              "type": "boolean"
            },
            "materials": {
              "type": "boolean"
            },
            "geometry": {
              "type": "boolean"
            },
            "scene": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "unit_policy": {
          "enum": ["normalize", "preserve", "custom"]
        },
        "unit_scale": {
          "type": "number",
          "minimum": 0.0001
        },
        "gltf_omitted_light_range_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4096
        },
        "gltf_scene": {
          "description": "The glTF scene imported as the model scene: its name, or #N for the scene at index N. Absent: the default scene, else the first.",
          "type": "string",
          "minLength": 1
        },
        "up_axis": {
          "$ref": "#/definitions/source_up_axis"
        },
        "normals_smoothing_angle_deg": {
          "description": "The largest angle between two faces that share a smoothed normal, wherever the import generates or recalculates normals.",
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "default": 60
        },
        "import_lights": {
          "type": "boolean",
          "default": true
        },
        "import_cameras": {
          "type": "boolean",
          "default": true
        },
        "light_intensity_scale": {
          "description": "The factor every imported light's intensity is multiplied by.",
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "material_remap": {
          "$ref": "#/definitions/material_remap"
        },
        "geometry_defaults": {
          "$ref": "#/definitions/geometry_import_defaults"
        },
        "bake_transforms": {
          "type": "boolean"
        },
        "normals_policy": {
          "enum": ["none", "preserve", "generate", "recalculate"]
        },
        "tangents_policy": {
          "enum": ["none", "preserve", "generate", "recalculate"]
        },
        "node_pruning": {
          "enum": ["keep", "drop-empty"]
        },
        "texture_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/texture_settings"
          }
        },
        "compile": {
          "type": "boolean"
        },
        "compile_mode": {
          "$ref": "#/definitions/script_compile_mode"
        },
        "script_storage": {
          "$ref": "#/definitions/script_storage_mode"
        },
        "target_scene_virtual_path": {
          "type": "string"
        },
        "bindings": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object"
            }
          ]
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        },
        "source_root": {
          "type": "string",
          "minLength": 1,
          "description": "Authoring root for external script source paths, relative to this manifest."
        },
        "source_key": {
          "$ref": "#/definitions/source_key"
        }
      },
      "additionalProperties": false
    },
    "script_compile_mode": {
      "enum": ["debug", "optimized"]
    },
    "script_storage_mode": {
      "enum": ["embedded", "external"]
    },
    "texture_intent": {
      "enum": [
        "albedo",
        "normal",
        "roughness",
        "metallic",
        "ao",
        "emissive",
        "opacity",
        "orm",
        "hdr_env",
        "hdr-env",
        "hdr_probe",
        "hdr-probe",
        "data",
        "height"
      ]
    },
    "color_space": {
      "enum": ["srgb", "linear"]
    },
    "texture_format": {
      "enum": [
        "rgba8",
        "rgba8_srgb",
        "rgba8-srgb",
        "rgba8_unorm",
        "rgba8_unorm_srgb",
        "bc7",
        "bc7_srgb",
        "bc7-srgb",
        "bc7_unorm",
        "bc7_unorm_srgb",
        "rgba16f",
        "rgba32f"
      ]
    },
    "texture_preset": {
      "enum": [
        "albedo",
        "albedo-srgb",
        "albedo-linear",
        "normal",
        "normal-bc7",
        "roughness",
        "metallic",
        "ao",
        "orm",
        "orm-bc7",
        "emissive",
        "ui",
        "hdr-env",
        "hdr-env-16f",
        "hdr-env-32f",
        "hdr-probe",
        "data",
        "height"
      ]
    },
    "mip_policy": {
      "enum": ["none", "full", "max"]
    },
    "mip_filter": {
      "enum": ["box", "kaiser", "lanczos"]
    },
    "bc7_quality": {
      "enum": ["none", "fast", "default", "high"]
    },
    "packing_policy": {
      "enum": ["d3d12", "tight"]
    },
    "cube_layout": {
      "enum": ["auto", "hstrip", "vstrip", "hcross", "vcross"]
    },
    "hdr_handling": {
      "enum": ["error", "tonemap", "auto", "keep", "float"]
    },
    "source_up_axis": {
      "description": "The up axis an FBX source is read in; the import always produces Oxygen's +Z up. from-file takes the file's axes, or FBX's default (right-handed Y up) when they are incomplete; y and z read the source as right-handed Y up or Z up whatever the file states. A glTF source is Y up by specification and ignores it.",
      "enum": ["from-file", "y", "z"],
      "default": "from-file"
    },
    "material_remap": {
      "description": "Source materials replaced by existing materials: a material's name in the import to the virtual path of the material its surfaces use instead. A replaced material is not produced.",
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "geometry_import_defaults": {
      "description": "Asset defaults written into the model's geometries, by geometry anchor (the geometry's storage name).",
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lod_policy": {
            "description": "The geometry's default LOD policy; absent takes the import's rule.",
            "$ref": "oxygen.lod-policy.schema.json#/definitions/lod_policy"
          },
          "surfaces": {
            "description": "Surface defaults by surface ID; an absent value takes the scene schema's default.",
            "type": "object",
            "propertyNames": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "visible": {
                  "type": "boolean"
                },
                "casts_shadows": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "cooked_context_roots": {
      "type": "array",
      "description": "Ordered resolver-only cooked sources, loose cooked roots or pak files, relative to the manifest or absolute. Later sources have higher priority.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Explicit cooked root identity. All jobs writing one root must agree; new physical generations require fresh identities."
    }
  }
}
