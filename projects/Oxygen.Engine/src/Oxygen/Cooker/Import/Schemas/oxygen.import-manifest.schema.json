{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Import Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional self-reference to this schema file."
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "thread_pool_size": {
      "description": "Worker threads of the import's CPU work pool. Default: the processor count.",
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "max_in_flight_jobs": {
      "description": "Jobs processed at once. Default: the processor count.",
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "job_admission_capacity": {
      "description": "Jobs admitted and not yet finished; further jobs are held back until one finishes.",
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "default": 64
    },
    "max_source_bytes": {
      "description": "The most bytes a job reads from one source file or range; a larger source fails its job with import.source_too_large. Default: the import service's limit.",
      "type": "integer",
      "minimum": 1
    },
    "concurrency": {
      "description": "Each pipeline's workers and queue capacity; an unset value takes its default.",
      "type": "object",
      "properties": {
        "texture": {
          "description": "The texture pipeline.",
          "allOf": [
            {
              "$ref": "#/definitions/concurrency_item"
            }
          ],
          "properties": {
            "workers": {
              "default": 2
            },
            "queue_capacity": {
              "default": 64
            }
          }
        },
        "buffer": {
          "description": "The buffer pipeline.",
          "allOf": [
            {
              "$ref": "#/definitions/concurrency_item"
            }
          ],
          "properties": {
            "workers": {
              "default": 2
            },
            "queue_capacity": {
              "default": 64
            }
          }
        },
        "material": {
          "description": "The material pipeline.",
          "allOf": [
            {
              "$ref": "#/definitions/concurrency_item"
            }
          ],
          "properties": {
            "workers": {
              "default": 2
            },
            "queue_capacity": {
              "default": 64
            }
          }
        },
        "mesh_build": {
          "description": "The mesh build pipeline.",
          "allOf": [
            {
              "$ref": "#/definitions/concurrency_item"
            }
          ],
          "properties": {
            "workers": {
              "default": 2
            },
            "queue_capacity": {
              "default": 32
            }
          }
        },
        "geometry": {
          "description": "The geometry pipeline.",
          "allOf": [
            {
              "$ref": "#/definitions/concurrency_item"
            }
          ],
          "properties": {
            "workers": {
              "default": 1
            },
            "queue_capacity": {
              "default": 16
            }
          }
        },
        "scene": {
          "description": "The scene pipeline.",
          "allOf": [
            {
              "$ref": "#/definitions/concurrency_item"
            }
          ],
          "properties": {
            "workers": {
              "default": 1
            },
            "queue_capacity": {
              "default": 8
            }
          }
        }
      },
      "additionalProperties": false
    },
    "defaults": {
      "$ref": "#/definitions/defaults_settings"
    },
    "project_root": {
      "description": "The project root, relative to this manifest's folder: relative mount folders, the project's .mounts.json and relative job sources belong to it. Default: this manifest's folder.",
      "type": "string",
      "minLength": 1
    },
    "mounts": {
      "description": "The committed source mounts. A path is relative to the project root; a mount without one is a placeholder that a .mounts.json binds.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/mount_declaration"
      }
    },
    "output": {
      "description": "The cooked root, relative to this manifest's folder.",
      "type": "string"
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/job_item"
      }
    },
    "source_key": {
      "$ref": "#/definitions/source_key"
    }
  },
  "required": ["schema_version", "jobs"],
  "definitions": {
    "mount_declaration": {
      "type": "object",
      "properties": {
        "name": {
          "description": "The mount name: the first segment of every mount path in it. The mount table checks it (mount.name_invalid).",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "Source, a folder of source files, or Cooked, a cooked source: a loose cooked root or a .pak file. The mount table checks it (mount.kind_unknown).",
          "type": "string",
          "default": "Source"
        },
        "path": {
          "description": "The mount's folder (a loose cooked root or a .pak file for a Cooked mount), relative to the project root.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "concurrency_item": {
      "type": "object",
      "properties": {
        "workers": {
          "description": "Worker coroutines of the pipeline.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "queue_capacity": {
          "description": "Bounded capacity of the pipeline's work queues.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "job_item": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions/job_settings"
        },
        {
          "required": ["type"]
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["gltf", "fbx"]
              }
            }
          },
          "then": {
            "$ref": "#/definitions/model_job_keys"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "model"
              }
            }
          },
          "then": {
            "required": ["virtual_path"],
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "virtual_path",
                "output",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "texture-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "derived_from",
                "sources",
                "output",
                "name",
                "virtual_path",
                "verbose",
                "intent",
                "color_space",
                "output_format",
                "data_format",
                "preset",
                "mip_policy",
                "mip_filter",
                "bc7_quality",
                "packing_policy",
                "cube_layout",
                "hdr_handling",
                "exposure_ev",
                "max_mips",
                "max_size",
                "cube_face_size",
                "flip_y",
                "flip_normal_green",
                "renormalize",
                "bake_hdr",
                "force_rgba",
                "cubemap",
                "equirect_to_cube",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "buffer-container"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "derived_from",
                "output",
                "name",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "material-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "derived_from",
                "output",
                "name",
                "virtual_path",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "physics-material-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "derived_from",
                "output",
                "name",
                "virtual_path",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "collision-shape-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "derived_from",
                "output",
                "name",
                "virtual_path",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "geometry-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "derived_from",
                "output",
                "name",
                "virtual_path",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scene-descriptor"
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "derived_from",
                "output",
                "name",
                "virtual_path",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["script-sidecar", "physics-sidecar"]
              }
            }
          },
          "then": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": ["source", "target_scene_virtual_path"]
                  },
                  {
                    "required": ["bindings", "target_scene_virtual_path"]
                  }
                ]
              }
            ]
          },
          "else": {
            "if": {
              "properties": {
                "type": {
                  "const": "model"
                }
              }
            },
            "else": {
              "required": ["source"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "script-sidecar"
              }
            }
          },
          "then": {
            "properties": {
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "instance_bindings": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "physics-sidecar"
              }
            }
          },
          "then": {
            "properties": {
              "bindings": {
                "type": "object"
              }
            },
            "propertyNames": {
              "enum": [
                "id",
                "depends_on",
                "type",
                "source",
                "derived_from",
                "bindings",
                "target_scene_virtual_path",
                "output",
                "name",
                "verbose",
                "physics_backend",
                "source_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            }
          },
          "then": {
            "required": ["id", "source"],
            "propertyNames": {
              "enum": [
                "id",
                "type",
                "source",
                "derived_from",
                "virtual_path",
                "depends_on",
                "output",
                "cooked_context_roots",
                "source_key"
              ]
            }
          }
        }
      ]
    },
    "defaults_settings": {
      "type": "object",
      "properties": {
        "texture": {
          "$ref": "#/definitions/texture_settings"
        },
        "scene": {
          "$ref": "#/definitions/scene_settings"
        },
        "script": {
          "$ref": "#/definitions/script_settings"
        },
        "scripting_sidecar": {
          "$ref": "#/definitions/scripting_sidecar_settings"
        },
        "physics_sidecar": {
          "$ref": "#/definitions/physics_sidecar_settings"
        },
        "buffer_container": {
          "$ref": "#/definitions/buffer_container_settings"
        },
        "material_descriptor": {
          "$ref": "#/definitions/material_descriptor_settings"
        },
        "physics_material_descriptor": {
          "$ref": "#/definitions/physics_material_descriptor_settings"
        },
        "collision_shape_descriptor": {
          "$ref": "#/definitions/collision_shape_descriptor_settings"
        },
        "geometry_descriptor": {
          "$ref": "#/definitions/geometry_descriptor_settings"
        },
        "scene_descriptor": {
          "$ref": "#/definitions/scene_descriptor_settings"
        },
        "input": {
          "$ref": "#/definitions/input_settings"
        },
        "source_key": {
          "$ref": "#/definitions/source_key"
        }
      },
      "additionalProperties": false
    },
    "input_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "texture_settings": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "layer": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "mip": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "slice": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "required": ["file"],
            "additionalProperties": false
          }
        },
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "intent": {
          "$ref": "#/definitions/texture_intent"
        },
        "color_space": {
          "$ref": "#/definitions/color_space"
        },
        "output_format": {
          "$ref": "#/definitions/texture_format"
        },
        "data_format": {
          "$ref": "#/definitions/texture_format"
        },
        "preset": {
          "$ref": "#/definitions/texture_preset"
        },
        "mip_policy": {
          "$ref": "#/definitions/mip_policy"
        },
        "mip_filter": {
          "$ref": "#/definitions/mip_filter"
        },
        "bc7_quality": {
          "$ref": "#/definitions/bc7_quality"
        },
        "packing_policy": {
          "$ref": "#/definitions/packing_policy"
        },
        "cube_layout": {
          "$ref": "#/definitions/cube_layout"
        },
        "hdr_handling": {
          "$ref": "#/definitions/hdr_handling"
        },
        "exposure_ev": {
          "type": "number"
        },
        "max_mips": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_size": {
          "description": "The largest width or height of the stored texture; a larger source drops its largest mips. Absent: the source size.",
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "cube_face_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "flip_y": {
          "type": "boolean"
        },
        "flip_normal_green": {
          "type": "boolean"
        },
        "renormalize": {
          "type": "boolean"
        },
        "bake_hdr": {
          "type": "boolean"
        },
        "force_rgba": {
          "type": "boolean"
        },
        "cubemap": {
          "type": "boolean"
        },
        "equirect_to_cube": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "scene_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "content_flags": {
          "type": "object",
          "properties": {
            "textures": {
              "type": "boolean"
            },
            "materials": {
              "type": "boolean"
            },
            "geometry": {
              "type": "boolean"
            },
            "scene": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "unit_policy": {
          "enum": ["normalize", "preserve", "custom"]
        },
        "unit_scale": {
          "type": "number",
          "minimum": 0.0001
        },
        "omitted_light_range_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 4096
        },
        "gltf_scene": {
          "description": "The glTF scene imported as the model scene: its name, or #N for the scene at index N. Absent: the default scene, else the first.",
          "type": "string",
          "minLength": 1
        },
        "up_axis": {
          "$ref": "#/definitions/source_up_axis"
        },
        "normals_smoothing_angle_deg": {
          "description": "The largest angle between two faces that share a smoothed normal, wherever the import generates or recalculates normals.",
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "default": 60
        },
        "generate_lods": {
          "description": "Whether each geometry with one LOD gets generated LODs, simplified from LOD 0. A geometry with authored LODs keeps them.",
          "type": "boolean",
          "default": false
        },
        "lod_levels": {
          "description": "The LODs generated after LOD 0, when generate_lods is on.",
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "default": 3
        },
        "lod_reduction_percent": {
          "description": "The triangles each generated LOD removes, in percent of the previous LOD's, when generate_lods is on.",
          "type": "number",
          "minimum": 1,
          "maximum": 99,
          "default": 50
        },
        "import_lights": {
          "type": "boolean",
          "default": true
        },
        "import_cameras": {
          "type": "boolean",
          "default": true
        },
        "light_intensity_scale": {
          "description": "The factor every imported light's intensity is multiplied by.",
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "material_remap": {
          "$ref": "#/definitions/material_remap"
        },
        "geometry_defaults": {
          "$ref": "#/definitions/geometry_import_defaults"
        },
        "bake_transforms": {
          "type": "boolean"
        },
        "normals_policy": {
          "enum": ["none", "preserve", "generate", "recalculate"]
        },
        "tangents_policy": {
          "enum": ["none", "preserve", "generate", "recalculate"]
        },
        "node_pruning": {
          "enum": ["keep", "drop-empty"]
        },
        "texture_overrides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/texture_settings"
          }
        }
      },
      "additionalProperties": false
    },
    "script_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "compile": {
          "type": "boolean"
        },
        "compile_mode": {
          "$ref": "#/definitions/script_compile_mode"
        },
        "script_storage": {
          "$ref": "#/definitions/script_storage_mode"
        }
      },
      "additionalProperties": false
    },
    "scripting_sidecar_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "target_scene_virtual_path": {
          "type": "string"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "physics_sidecar_settings": {
      "type": "object",
      "properties": {
        "physics_backend": {
          "type": "string",
          "enum": ["jolt", "physx", "none"]
        },
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verbose": {
          "type": "boolean"
        },
        "target_scene_virtual_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "material_descriptor_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "physics_material_descriptor_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "collision_shape_descriptor_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "buffer_container_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "geometry_descriptor_settings": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "scene_descriptor_settings": {
      "type": "object",
      "description": "Scene-descriptor jobs consume authored scene descriptors matching the current native version; legacy descriptors must be updated and re-cooked before import.",
      "properties": {
        "output": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cooked_context_roots": {
          "$ref": "#/definitions/cooked_context_roots"
        }
      },
      "additionalProperties": false
    },
    "model_job_keys": {
      "description": "The keys of a gltf or fbx job, and so of a model import record's settings, which are that job's without the keys the record and its publisher own.",
      "propertyNames": {
        "enum": [
          "bake_hdr",
          "bake_transforms",
          "bc7_quality",
          "color_space",
          "content_flags",
          "cooked_context_roots",
          "cube_face_size",
          "cube_layout",
          "cubemap",
          "data_format",
          "depends_on",
          "equirect_to_cube",
          "exposure_ev",
          "flip_normal_green",
          "flip_y",
          "force_rgba",
          "generate_lods",
          "geometry_defaults",
