{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Physics Material Descriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "oxygen.name.schema.json#/definitions/segment"
    },
    "static_friction": {
      "type": "number",
      "minimum": 0.0
    },
    "dynamic_friction": {
      "type": "number",
      "minimum": 0.0
    },
    "restitution": {
      "type": "number",
      "minimum": 0.0
    },
    "density": {
      "type": "number",
      "exclusiveMinimum": 0.0
    },
    "combine_mode_friction": {
      "$ref": "#/definitions/combine_mode"
    },
    "combine_mode_restitution": {
      "$ref": "#/definitions/combine_mode"
    }
  },
  "definitions": {
    "combine_mode": {
      "enum": ["average", "min", "max", "multiply"]
    }
  }
}
