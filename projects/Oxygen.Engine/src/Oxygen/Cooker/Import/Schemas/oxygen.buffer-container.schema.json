{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Buffer Container Descriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "oxygen.name.schema.json#/definitions/segment"
    },
    "buffers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/buffer_descriptor"
      }
    }
  },
  "required": ["buffers"],
  "definitions": {
    "buffer_view_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "oxygen.name.schema.json#/definitions/segment"
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "element_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "element_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": ["name"],
      "allOf": [
        {
          "not": {
            "properties": {
              "name": {
                "const": "__all__"
              }
            },
            "required": ["name"]
          }
        },
        {
          "oneOf": [
            {
              "required": ["byte_offset", "byte_length"],
              "not": {
                "anyOf": [
                  {
                    "required": ["element_offset"]
                  },
                  {
                    "required": ["element_count"]
                  }
                ]
              }
            },
            {
              "required": ["element_offset", "element_count"],
              "not": {
                "anyOf": [
                  {
                    "required": ["byte_offset"]
                  },
                  {
                    "required": ["byte_length"]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "buffer_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "virtual_path": {
          "allOf": [
            { "$ref": "oxygen.reference.schema.json#/definitions/reference" },
            { "pattern": "\\.obuf$" }
          ]
        },
        "usage_flags": {
          "description": "BufferResource usage flags: the defined bits, with at most one update frequency.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "element_stride": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "element_format": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "alignment": {
          "description": "Alignment of the payload in the data file: a power of two, up to the pak payload alignment.",
          "enum": [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096]
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/buffer_view_descriptor"
          },
          "uniqueItems": true
        }
      },
      "required": ["source", "virtual_path"],
      "allOf": [
        {
          "if": {
            "properties": {
              "element_format": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["element_format"]
          },
          "then": {
            "properties": {
              "element_stride": {
                "type": "integer",
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "element_stride": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["element_stride"]
          },
          "then": {
            "properties": {
              "element_format": {
                "type": "integer",
                "maximum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "element_stride": {
                "type": "integer",
                "const": 0
              }
            },
            "required": ["element_stride"]
          },
          "then": {
            "properties": {
              "element_format": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["element_format"]
          }
        }
      ]
    }
  }
}
