                        "auto_exposure_target_luminance": { "x-editor-label": "Target Luminance", "x-editor-group": "Auto Exposure", "x-editor-renderer": "numberbox", "x-editor-step": 0.01 },
                        "auto_exposure_spot_meter_radius": { "x-editor-label": "Spot Radius", "x-editor-group": "Auto Exposure", "x-editor-renderer": "numberbox", "x-editor-step": 0.01 },
                        "bloom_intensity": { "x-editor-label": "Intensity", "x-editor-group": "Bloom", "x-editor-renderer": "numberbox", "x-editor-step": 0.01 },
                        "bloom_threshold": { "x-editor-label": "Threshold", "x-editor-group": "Bloom", "x-editor-renderer": "numberbox", "x-editor-step": 0.01 },
                        "saturation": { "x-editor-label": "Saturation", "x-editor-group": "Color Grading", "x-editor-renderer": "numberbox", "x-editor-step": 0.01 },
                        "contrast": { "x-editor-label": "Contrast", "x-editor-group": "Color Grading", "x-editor-renderer": "numberbox", "x-editor-step": 0.01 },
                        "vignette_intensity": { "x-editor-label": "Vignette", "x-editor-group": "Color Grading", "x-editor-renderer": "numberbox", "x-editor-step": 0.01 },
