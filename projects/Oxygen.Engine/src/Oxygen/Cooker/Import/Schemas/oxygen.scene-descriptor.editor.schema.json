{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://oxygen.editor/schemas/oxygen.scene-descriptor.editor.schema.json",
    "$ref": "oxygen.scene-descriptor.schema.json",
    "title": "Oxygen Scene Descriptor (editor overlay)",
    "description": "Editor metadata layered on top of the engine scene schema. Adds x-editor-* annotations only; introduces no constraints.",
    "properties": {
        "$schema": {
            "x-editor-label": "Schema",
            "x-editor-group": "Document",
            "x-editor-order": 0,
            "x-editor-renderer": "readonly"
        },
        "version": {
            "x-editor-label": "Version",
            "x-editor-group": "Document",
            "x-editor-order": 1,
            "x-editor-renderer": "readonly"
        },
        "name": {
            "x-editor-label": "Name",
            "x-editor-group": "Document",
            "x-editor-order": 2,
            "x-editor-renderer": "text"
        },
        "content_hashing": {
            "x-editor-label": "Content Hashing",
            "x-editor-group": "Document",
            "x-editor-order": 3,
            "x-editor-renderer": "toggle"
        },
        "nodes": {
            "x-editor-label": "Scene Nodes",
            "x-editor-group": "Scene",
            "x-editor-order": 10,
            "x-editor-renderer": "scene-tree"
        },
        "renderables": {
            "x-editor-label": "Renderables",
            "x-editor-group": "Scene",
            "x-editor-order": 20,
            "x-editor-renderer": "component-list"
        },
        "cameras": {
            "x-editor-label": "Cameras",
            "x-editor-group": "Scene",
            "x-editor-order": 30,
            "x-editor-renderer": "component-list"
        },
        "lights": {
            "x-editor-label": "Lights",
            "x-editor-group": "Scene",
            "x-editor-order": 40,
            "x-editor-renderer": "component-list"
        },
        "environment": {
            "x-editor-label": "Environment",
            "x-editor-group": "Scene",
            "x-editor-order": 50,
            "x-editor-renderer": "environment-editor"
        },
        "local_fog_volumes": {
            "x-editor-label": "Local Fog Volumes",
            "x-editor-group": "Scene",
            "x-editor-order": 60,
            "x-editor-renderer": "component-list"
        },
        "references": {
            "x-editor-label": "References",
            "x-editor-group": "Scene",
            "x-editor-order": 70,
            "x-editor-renderer": "asset-reference-list"
        }
