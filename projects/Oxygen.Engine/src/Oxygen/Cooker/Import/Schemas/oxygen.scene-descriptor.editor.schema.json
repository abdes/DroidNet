                "fov_y": {
                    "x-editor-label": "Field of View",
                    "x-editor-group": "Projection",
                    "x-editor-order": 0,
                    "x-editor-renderer": "numberbox",
                    "x-editor-step": 0.1,
                    "x-editor-unit": "deg"
                },
                "aspect_ratio": {
                    "x-editor-label": "Aspect Ratio",
                    "x-editor-group": "Projection",
                    "x-editor-order": 10,
