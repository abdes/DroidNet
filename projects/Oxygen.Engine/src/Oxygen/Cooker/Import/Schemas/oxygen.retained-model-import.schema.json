{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen retained model import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_root",
    "recipe",
    "material_slot_provenance",
    "published_generation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "content_root": { "type": "string", "minLength": 1 },
    "recipe": { "type": "object" },
    "material_slot_provenance": { "type": "object" },
    "published_generation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "index_sha256"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "index_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    }
  }
}
