{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen native source analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "producer_version", "complete", "jobs"],
  "properties": {
    "version": {
      "const": 1
    },
    "producer_version": {
      "type": "string"
    },
    "complete": {
      "type": "boolean"
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/job"
      }
    }
  },
  "definitions": {
    "logical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["virtual_path", "kind", "object_path", "required"],
      "properties": {
        "virtual_path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "asset",
            "material",
            "geometry",
            "scene",
            "texture",
            "buffer",
            "script",
            "input-action",
            "input-mapping-context",
            "physics-scene"
          ]
        },
        "object_path": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required"],
      "properties": {
        "path": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "max_bytes", "sha256"],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "is_directory",
        "is_symlink",
        "last_modified_seconds",
        "last_modified_nanoseconds"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "is_directory": {
          "type": "boolean"
        },
        "is_symlink": {
          "type": "boolean"
        },
        "last_modified_seconds": {
          "type": "integer"
        },
        "last_modified_nanoseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999999
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "metadata", "reads"],
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "metadata": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/metadata"
            }
          ]
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/read"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message", "source_path", "object_path"],
      "properties": {
        "severity": {
          "enum": ["Info", "Warning", "Error", "Unknown"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "object_path": {
          "type": "string"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "axis": {
      "enum": ["+X", "-X", "+Y", "-Y", "+Z", "-Z", "unknown"]
    },
    "model_scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "selector",
        "is_default",
        "root_count",
        "node_count"
      ],
      "properties": {
        "index": {
          "$ref": "#/definitions/count"
        },
        "name": {
          "description": "The authored name; empty when the scene has none.",
          "type": "string"
        },
        "selector": {
          "description": "What the gltf_scene import setting names this scene by: its name, or #N when the name is empty, starts with # or is shared.",
          "type": "string",
          "minLength": 1
        },
        "is_default": {
          "description": "Whether an import without a chosen scene takes this one.",
          "type": "boolean"
        },
        "root_count": {
          "$ref": "#/definitions/count"
        },
        "node_count": {
          "description": "The distinct nodes reachable from the scene's roots.",
          "$ref": "#/definitions/count"
        }
      }
    },
    "model": {
      "description": "What a model source holds, from its metadata parse.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_meters",
        "right",
        "up",
        "front",
        "left_handed",
        "node_count",
        "mesh_count",
        "scenes",
        "materials",
        "textures"
      ],
      "properties": {
        "unit_meters": {
          "description": "Metres per source unit; null when the file does not state its unit.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "right": {
          "$ref": "#/definitions/axis"
        },
        "up": {
          "$ref": "#/definitions/axis"
        },
        "front": {
          "$ref": "#/definitions/axis"
        },
        "left_handed": {
          "description": "Null when the file's axes are not a valid basis.",
          "type": ["boolean", "null"]
        },
        "node_count": {
          "$ref": "#/definitions/count"
        },
        "mesh_count": {
          "$ref": "#/definitions/count"
        },
        "scenes": {
          "description": "The file's scenes; empty for a format with one root (FBX).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/model_scene"
          }
        },
        "materials": {
          "description": "The names the import gives the materials it produces.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "textures": {
          "description": "The names the import gives the textures it produces.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "job_type",
        "source_path",
        "complete",
        "outputs",
        "references",
        "files",
        "observations",
        "diagnostics",
        "accessed_paths"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "job_type": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/logical"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/logical"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/file"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/observation"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/diagnostic"
          }
        },
        "accessed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model": {
          "$ref": "#/definitions/model"
        }
      }
    }
  }
}
