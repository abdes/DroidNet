{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oxygen-engine.org/schemas/oxygen.lod-policy.schema.json",
  "title": "Oxygen LOD Policy",
  "description": "The JSON spelling of a geometry LOD policy, the scene schema's lod-policy value type, shared by the descriptors and reports that carry one.",
  "definitions": {
    "lod_thresholds": {
      "description": "LOD boundaries: boundary i lies between LOD i and LOD i + 1. Distance thresholds never decrease and screen-space errors never increase. A geometry has at most 8 LODs.",
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "lod_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "fixed"
            },
            "lod_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "required": ["type", "lod_index"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "distance"
            },
            "thresholds": {
              "$ref": "#/definitions/lod_thresholds"
            },
            "hysteresis_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.99
            }
          },
          "required": ["type", "thresholds", "hysteresis_ratio"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "screen_space_error"
            },
            "enter_finer_sse": {
              "$ref": "#/definitions/lod_thresholds"
            },
            "exit_coarser_sse": {
              "$ref": "#/definitions/lod_thresholds"
            }
          },
          "required": ["type", "enter_finer_sse", "exit_coarser_sse"]
        }
      ]
    }
  }
}
