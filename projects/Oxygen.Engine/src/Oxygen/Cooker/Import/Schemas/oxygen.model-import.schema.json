{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oxygen-engine.org/schemas/oxygen.model-import.schema.json",
  "title": "Oxygen model import record",
  "description": "A model's import state: what to import and what earlier imports established. It is the model's authored file: it lives in the model's mount at <model identity>.import.json, which is the model's identity, never repeated in the file. The editor and the ImportTool share it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "settings", "source_identity"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "description": "The primary source file, a file reference from the record: relative within the model's mount, the mount path of a file in another mount.",
      "$ref": "oxygen.reference.schema.json#/definitions/reference"
    },
    "settings": {
      "description": "The model import settings: the settings of a gltf or fbx import manifest job, without the keys the record and its publisher own. The cooker also checks them as that job (import.model_record_invalid).",
      "allOf": [
        {
          "$ref": "oxygen.import-manifest.schema.json#/definitions/job_settings"
        },
        {
          "$ref": "oxygen.import-manifest.schema.json#/definitions/model_job_keys"
        },
        {
          "not": {
            "anyOf": [
              { "required": ["id"] },
              { "required": ["type"] },
              { "required": ["source"] },
              { "required": ["virtual_path"] },
              { "required": ["depends_on"] },
              { "required": ["output"] },
              { "required": ["cooked_context_roots"] },
              { "required": ["source_key"] },
              { "required": ["surface_provenance"] }
            ]
          }
        }
      ]
    },
    "source_identity": {
      "description": "From which node and surface IDs are derived; never changes.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "surface_provenance": {
      "description": "The surface provenance; its identity is the record's source identity.",
      "$ref": "oxygen.surface-provenance.schema.json"
    },
    "node_continuity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor", "continues"],
        "properties": {
          "anchor": { "type": "string", "minLength": 1 },
          "continues": { "type": "string", "minLength": 1 }
        }
      }
    },
    "published_nodes": {
      "description": "The anchor and ID of each node the last import emitted.",
      "$ref": "#/definitions/nodes"
    },
    "new_nodes": {
      "description": "The published nodes whose anchor the publication before the last did not emit.",
      "$ref": "#/definitions/nodes"
    },
    "vanished_nodes": {
      "description": "The nodes earlier publications emitted whose ID the last import did not emit, kept until an import emits their ID again.",
      "$ref": "#/definitions/nodes"
    },
    "source_fingerprint": {
      "description": "The files the last import read: the primary source, and every other file relative to the primary's folder.",
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256", "files"],
      "properties": {
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/digest" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "size": { "type": "integer", "minimum": 0 },
              "sha256": { "$ref": "#/definitions/digest" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor", "node_id"],
        "properties": {
          "anchor": { "type": "string", "minLength": 1 },
          "node_id": { "$ref": "#/definitions/key" }
        }
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
