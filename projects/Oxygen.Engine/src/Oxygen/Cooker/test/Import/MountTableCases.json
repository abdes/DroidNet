      ],
      "mounts": [
        {
          "name": "Content",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": "committed",
          "folder": "ws/proj/Content",
          "role": "Own"
        },
        {
          "name": "Showcase",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": "committed",
          "folder": "Media/Showcase",
          "role": "Shared"
        }
      ],
      "codes": []
    },
    {
