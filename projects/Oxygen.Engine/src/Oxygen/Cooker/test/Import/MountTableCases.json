{
  "$comment": "How a mount table is resolved from a committed declaration and the .mounts.json hierarchy. The engine (SourceMounts_test.cpp) and the editor (MountTableCasesTests) both run every case, so the two readers cannot drift. Paths are relative to a case folder whose own .mounts.json has \"root\": true; ${temp} in a path is that folder. A library is built from its recipe by each harness's own fixture writer: path, kind (loose or pak), roots (the mounts its virtual paths start with; a loose root only), external_script (a script with an external source under its first root) and format (current, or unsupported: a version this build cannot read). Mounts compare by name; codes compare as sets.",
  "version": 1,
  "cases": [
    {
      "name": "committed relative path",
      "folders": ["ws/proj/Content"],
      "declarations": [
        { "name": "Content", "kind": "Source", "path": "Content" }
      ],
      "mounts": [
        {
          "name": "Content",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": "committed",
          "folder": "ws/proj/Content",
          "role": "Own"
        }
      ],
      "codes": []
    },
    {
      "name": "committed path outside the project root",
      "folders": ["ws/proj/Content", "Media/Showcase"],
      "declarations": [
        { "name": "Content", "kind": "Source", "path": "Content" },
        { "name": "Showcase", "kind": "Source", "path": "../../Media/Showcase" }
      ],
      "mounts": [
        {
          "name": "Content",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": "committed",
          "folder": "ws/proj/Content",
          "role": "Own"
        },
        {
          "name": "Showcase",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": "committed",
          "folder": "Media/Showcase",
          "role": "Shared"
        }
      ],
      "codes": []
    },
    {
      "name": "placeholder nothing binds",
      "folders": [],
      "declarations": [{ "name": "Studio", "kind": "Source" }],
      "mounts": [
        {
          "name": "Studio",
          "kind": "Source",
          "scope": "declared",
          "state": "Unbound",
          "origin": "none",
          "role": "Shared"
        }
      ],
      "codes": ["mount.unbound"]
    },
    {
      "name": "the project's file overrides a committed path",
      "folders": ["ws/proj/Showcase", "E/Showcase"],
      "mounts_files": {
        "ws/proj": {
          "version": 1,
          "mounts": { "Showcase": "${temp}/E/Showcase" }
        }
      },
      "declarations": [
        { "name": "Showcase", "kind": "Source", "path": "Showcase" }
      ],
      "mounts": [
        {
          "name": "Showcase",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": ".mounts.json",
          "origin_file": "ws/proj/.mounts.json",
          "folder": "E/Showcase",
          "role": "Shared"
        }
      ],
      "codes": []
    },
    {
      "name": "the project's file binds a placeholder and adds a local mount",
      "folders": ["D/Studio", "D/Scratch"],
      "mounts_files": {
        "ws/proj": {
          "version": 1,
          "mounts": {
            "Studio": "${temp}/D/Studio",
            "Scratch": "${temp}/D/Scratch"
          }
        }
      },
      "declarations": [{ "name": "Studio", "kind": "Source" }],
      "mounts": [
        {
          "name": "Studio",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": ".mounts.json",
          "origin_file": "ws/proj/.mounts.json",
          "folder": "D/Studio",
          "role": "Shared"
        },
        {
          "name": "Scratch",
          "kind": "Source",
          "scope": "local",
          "state": "Bound",
          "origin": ".mounts.json",
          "origin_file": "ws/proj/.mounts.json",
          "folder": "D/Scratch",
          "role": "Shared"
        }
      ],
      "codes": []
    },
    {
      "name": "a parent file binds a placeholder",
      "folders": ["D/Studio"],
      "mounts_files": {
        "ws": { "version": 1, "mounts": { "Studio": "${temp}/D/Studio" } }
      },
      "declarations": [{ "name": "Studio", "kind": "Source" }],
      "mounts": [
        {
          "name": "Studio",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": ".mounts.json",
          "origin_file": "ws/.mounts.json",
          "folder": "D/Studio",
          "role": "Shared"
        }
      ],
      "codes": []
    },
