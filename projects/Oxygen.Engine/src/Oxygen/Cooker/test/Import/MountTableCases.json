      "declarations": [{ "name": "Studio", "kind": "Source" }],
      "mounts": [
        {
          "name": "Studio",
          "kind": "Source",
          "scope": "declared",
          "state": "Bound",
          "origin": ".mounts.json",
          "origin_file": "ws/proj/.mounts.json",
          "folder": "ws/Shared",
          "role": "Shared"
        }
      ],
      "codes": []
    },
    {
      "name": "a bound folder that does not exist is missing",
      "folders": [],
