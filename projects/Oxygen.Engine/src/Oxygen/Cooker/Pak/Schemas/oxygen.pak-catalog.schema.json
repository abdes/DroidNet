{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Pak Catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "source_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "content_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mount": {
      "description": "The pak's one mount: every entry's virtual path lies under this mount name.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
      "maxLength": 255
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "Material",
              "Geometry",
              "Scene",
              "Script",
              "InputAction",
              "InputMappingContext",
              "PhysicsMaterial",
              "CollisionShape",
              "PhysicsScene"
            ]
          },
          "descriptor_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "transitive_resource_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "asset_key",
          "asset_type",
          "descriptor_digest",
          "transitive_resource_digest"
        ]
      }
    },
    "deleted": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "bases": {
      "description": "Patch baseline: the exact layers the patch applies to, lowest first.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/base"
      }
    },
    "dependencies": {
      "description": "The mounts whose assets and textures the pak references without containing them, with what it requires of each.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/dependency"
      }
    }
  },
  "required": [
    "schema_version",
    "source_key",
    "content_version",
    "catalog_digest",
    "mount",
    "entries",
    "deleted",
    "bases",
    "dependencies"
  ],
  "definitions": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "content_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["source_key", "content_version", "catalog_digest"]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mount": {
          "description": "The mount's name.",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "maxLength": 255
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "asset"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Material",
                      "Geometry",
                      "Scene",
                      "Script",
                      "InputAction",
                      "InputMappingContext",
                      "PhysicsMaterial",
                      "CollisionShape",
                      "PhysicsScene"
                    ]
                  }
                },
                "required": ["kind", "key", "type"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "texture"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                },
                "required": ["kind", "key"]
              }
            ]
          }
        }
      },
      "required": ["mount", "requirements"]
    }
  }
}
