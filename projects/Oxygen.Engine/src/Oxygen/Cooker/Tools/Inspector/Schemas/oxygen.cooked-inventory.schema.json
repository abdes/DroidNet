{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen verified cooked inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_key",
    "index_size",
    "index_sha256",
    "files",
    "assets",
    "resources",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_key": {
      "type": "string",
      "format": "uuid"
    },
    "index_size": {
      "type": "integer",
      "minimum": 256
    },
    "index_sha256": {
      "$ref": "#/definitions/digest"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "size", "file_kind", "sha256"],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "file_kind": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 12
          },
          "sha256": {
            "description": "The file's SHA-256; all zero for a resource data file, whose resources are verified one by one against their table rows.",
            "$ref": "#/definitions/digest"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_key",
          "asset_type",
          "virtual_path",
          "descriptor_relative_path"
        ],
        "properties": {
          "asset_key": {
            "type": "string",
            "minLength": 1
          },
          "asset_type": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "virtual_path": {
            "type": "string",
            "minLength": 1
          },
          "descriptor_relative_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "virtual_path",
          "descriptor_relative_path",
          "resource_index"
        ],
        "properties": {
          "kind": { "const": "texture" },
          "virtual_path": { "type": "string", "pattern": "^/" },
          "descriptor_relative_path": { "type": "string", "minLength": 1 },
          "resource_index": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 4294967294
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "reason"],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "missing",
              "unexpected",
              "size_mismatch",
              "digest_mismatch",
              "linked_path",
              "not_regular",
              "malformed_table",
              "resource_out_of_bounds",
              "resource_digest_mismatch",
              "format_version"
            ]
          },
          "resource_row": {
            "description": "The table row of the resource a resource_* reason is about, in the data file relative_path names.",
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
