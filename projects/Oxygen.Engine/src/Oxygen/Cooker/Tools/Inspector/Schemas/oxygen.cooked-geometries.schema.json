{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oxygen-engine.org/schemas/oxygen.cooked-geometries.schema.json",
  "title": "Oxygen Cooked Geometry Material Slots",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "geometries"],
  "properties": {
    "schema_version": { "const": 1 },
    "geometries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["geometry_asset_key", "layout_revision", "slots"],
        "properties": {
          "geometry_asset_key": { "$ref": "#/definitions/nonNilKey" },
          "layout_revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot_id", "display_name", "bindings"],
              "properties": {
                "slot_id": { "$ref": "#/definitions/nonNilKey" },
                "display_name": { "type": "string" },
                "bindings": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lod_index",
                      "submesh_index",
                      "default_material_key"
                    ],
                    "properties": {
                      "lod_index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "submesh_index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "default_material_key": { "$ref": "#/definitions/key" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nonNilKey": {
      "allOf": [
        { "$ref": "#/definitions/key" },
        { "not": { "const": "00000000-0000-0000-0000-000000000000" } }
      ]
    }
  }
}
