static const uint EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET = 80u;
static const uint EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE = 16u;
static const uint EXPOSURE_STATUS_COMPOSITION_INPUT_OFFSET = 128u;
static const uint EXPOSURE_STATUS_COMPOSITION_INPUT_MAXIMUM_PRE_EXPOSED_RGB_OFFSET = 128u;
static const uint EXPOSURE_STATUS_COMPOSITION_INPUT_FLAGS_OFFSET = 132u;
static const uint EXPOSURE_STATUS_COMPOSITION_INPUT_CHECKED_PIXELS_OFFSET = 136u;
static const uint EXPOSURE_STATUS_COMPOSITION_INPUT_RESERVED_OFFSET = 140u;
static const uint EXPOSURE_STATUS_OPAQUE_AP_ERROR_OFFSET = 144u;
static const uint EXPOSURE_STATUS_OPAQUE_AP_ERROR_RGB_RELATIVE_OFFSET = 144u;
static const uint EXPOSURE_STATUS_OPAQUE_AP_ERROR_RGB_ABSOLUTE_OFFSET = 148u;
static const uint EXPOSURE_STATUS_OPAQUE_AP_ERROR_VALID_OFFSET = 152u;
static const uint EXPOSURE_STATUS_OPAQUE_AP_ERROR_RESERVED_OFFSET = 156u;
static const uint EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET = 160u;
static const uint EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE = 32u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_OFFSET = 256u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CURRENT_RGB_RELATIVE_OFFSET = 256u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CURRENT_RGB_ABSOLUTE_OFFSET = 260u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CURRENT_COVERAGE_RELATIVE_OFFSET = 264u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CURRENT_COVERAGE_ABSOLUTE_OFFSET = 268u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CANDIDATE_RGB_RELATIVE_OFFSET = 272u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CANDIDATE_RGB_ABSOLUTE_OFFSET = 276u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CANDIDATE_COVERAGE_RELATIVE_OFFSET = 280u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CANDIDATE_COVERAGE_ABSOLUTE_OFFSET = 284u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CANDIDATE_PRE_EXPOSURE_OFFSET = 288u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_CHECKED_PRODUCTS_OFFSET = 292u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_FLAGS_OFFSET = 296u;
static const uint EXPOSURE_STATUS_SCENE_ERROR_RESERVED_OFFSET = 300u;
static const uint EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET = 304u;
static const uint EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE = 16u;
static const uint EXPOSURE_STATUS_CONSUMER_INPUTS_OFFSET = 352u;
static const uint EXPOSURE_STATUS_CONSUMER_INPUTS_TRANSLUCENT_RGB_MAX_OFFSET = 352u;
static const uint EXPOSURE_STATUS_CONSUMER_INPUTS_HEIGHT_FOG_RGB_MAX_OFFSET = 356u;
static const uint EXPOSURE_STATUS_CONSUMER_INPUTS_FLAGS_OFFSET = 360u;
static const uint EXPOSURE_STATUS_CONSUMER_INPUTS_SKY_RGB_GAIN_MAX_OFFSET = 364u;
static const uint EXPOSURE_STATUS_PRODUCT_REFERENCE_RGB_MAX_OFFSET = 368u;
static const uint EXPOSURE_STATUS_PRODUCT_RANGE_RESERVED_OFFSET = 380u;

static ExposureStatusStorage LoadExposureStatusStorage(ByteAddressBuffer buffer, uint base)
{
    ExposureStatusStorage value;
    value.completed = LoadExposureCompletedStatus(buffer, base + EXPOSURE_STATUS_COMPLETED_OFFSET);
    value.producer_errors[0] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 0u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE);
    value.producer_errors[1] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 1u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE);
    value.producer_errors[2] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 2u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE);
    value.composition_input = LoadHdrCompositionInputData(buffer, base + EXPOSURE_STATUS_COMPOSITION_INPUT_OFFSET);
    value.opaque_ap_error = LoadHdrOpaqueApErrorData(buffer, base + EXPOSURE_STATUS_OPAQUE_AP_ERROR_OFFSET);
    value.filter_gradients[0] = LoadHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 0u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE);
    value.filter_gradients[1] = LoadHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 1u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE);
    value.filter_gradients[2] = LoadHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 2u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE);
    value.scene_error = LoadHdrSceneErrorData(buffer, base + EXPOSURE_STATUS_SCENE_ERROR_OFFSET);
    value.candidate_errors[0] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 0u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE);
    value.candidate_errors[1] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 1u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE);
    value.candidate_errors[2] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 2u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE);
    value.consumer_inputs = LoadHdrConsumerInputData(buffer, base + EXPOSURE_STATUS_CONSUMER_INPUTS_OFFSET);
    value.product_reference_rgb_max = asfloat(buffer.Load3(base + EXPOSURE_STATUS_PRODUCT_REFERENCE_RGB_MAX_OFFSET));
    value.product_range_reserved = buffer.Load(base + EXPOSURE_STATUS_PRODUCT_RANGE_RESERVED_OFFSET);
    return value;
}

static ExposureStatusStorage LoadExposureStatusStorage(RWByteAddressBuffer buffer, uint base)
{
    ExposureStatusStorage value;
    value.completed = LoadExposureCompletedStatus(buffer, base + EXPOSURE_STATUS_COMPLETED_OFFSET);
    value.producer_errors[0] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 0u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE);
    value.producer_errors[1] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 1u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE);
    value.producer_errors[2] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 2u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE);
    value.composition_input = LoadHdrCompositionInputData(buffer, base + EXPOSURE_STATUS_COMPOSITION_INPUT_OFFSET);
    value.opaque_ap_error = LoadHdrOpaqueApErrorData(buffer, base + EXPOSURE_STATUS_OPAQUE_AP_ERROR_OFFSET);
    value.filter_gradients[0] = LoadHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 0u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE);
    value.filter_gradients[1] = LoadHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 1u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE);
    value.filter_gradients[2] = LoadHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 2u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE);
    value.scene_error = LoadHdrSceneErrorData(buffer, base + EXPOSURE_STATUS_SCENE_ERROR_OFFSET);
    value.candidate_errors[0] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 0u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE);
    value.candidate_errors[1] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 1u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE);
    value.candidate_errors[2] = LoadHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 2u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE);
    value.consumer_inputs = LoadHdrConsumerInputData(buffer, base + EXPOSURE_STATUS_CONSUMER_INPUTS_OFFSET);
    value.product_reference_rgb_max = asfloat(buffer.Load3(base + EXPOSURE_STATUS_PRODUCT_REFERENCE_RGB_MAX_OFFSET));
    value.product_range_reserved = buffer.Load(base + EXPOSURE_STATUS_PRODUCT_RANGE_RESERVED_OFFSET);
    return value;
}

static void StoreExposureStatusStorage(RWByteAddressBuffer buffer, uint base, ExposureStatusStorage value)
{
    StoreExposureCompletedStatus(buffer, base + EXPOSURE_STATUS_COMPLETED_OFFSET, value.completed);
    StoreHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 0u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE, value.producer_errors[0]);
    StoreHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 1u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE, value.producer_errors[1]);
    StoreHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_PRODUCER_ERRORS_OFFSET + 2u * EXPOSURE_STATUS_PRODUCER_ERRORS_STRIDE, value.producer_errors[2]);
    StoreHdrCompositionInputData(buffer, base + EXPOSURE_STATUS_COMPOSITION_INPUT_OFFSET, value.composition_input);
    StoreHdrOpaqueApErrorData(buffer, base + EXPOSURE_STATUS_OPAQUE_AP_ERROR_OFFSET, value.opaque_ap_error);
    StoreHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 0u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE, value.filter_gradients[0]);
    StoreHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 1u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE, value.filter_gradients[1]);
    StoreHdrFilterGradientData(buffer, base + EXPOSURE_STATUS_FILTER_GRADIENTS_OFFSET + 2u * EXPOSURE_STATUS_FILTER_GRADIENTS_STRIDE, value.filter_gradients[2]);
    StoreHdrSceneErrorData(buffer, base + EXPOSURE_STATUS_SCENE_ERROR_OFFSET, value.scene_error);
    StoreHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 0u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE, value.candidate_errors[0]);
    StoreHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 1u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE, value.candidate_errors[1]);
    StoreHdrErrorBoundsData(buffer, base + EXPOSURE_STATUS_CANDIDATE_ERRORS_OFFSET + 2u * EXPOSURE_STATUS_CANDIDATE_ERRORS_STRIDE, value.candidate_errors[2]);
    StoreHdrConsumerInputData(buffer, base + EXPOSURE_STATUS_CONSUMER_INPUTS_OFFSET, value.consumer_inputs);
    buffer.Store3(base + EXPOSURE_STATUS_PRODUCT_REFERENCE_RGB_MAX_OFFSET, asuint(value.product_reference_rgb_max));
    buffer.Store(base + EXPOSURE_STATUS_PRODUCT_RANGE_RESERVED_OFFSET, value.product_range_reserved);
}

#endif // OXYGEN_GENERATED_VORTEX_CONTRACTS_VIEW_GENERATED_EXPOSURECONTRACTS_HLSLI
