// GPU-only reference gradient maxima for linear-clamp sampling.
struct HdrFilterGradientData
{
    // Scene-referred maximum adjacent differences.
    float3 rgb;
    // Recorded=1, invalid input/interval=2.
    uint flags;
    float3 transmittance;
    uint checked_texels;
};

// Byte offsets of HdrFilterGradientData in a byte-address buffer.
static const uint HDR_FILTER_GRADIENT_SIZE = 32u;
static const uint HDR_FILTER_GRADIENT_RGB_OFFSET = 0u;
static const uint HDR_FILTER_GRADIENT_FLAGS_OFFSET = 12u;
static const uint HDR_FILTER_GRADIENT_TRANSMITTANCE_OFFSET = 16u;
static const uint HDR_FILTER_GRADIENT_CHECKED_TEXELS_OFFSET = 28u;

static HdrFilterGradientData LoadHdrFilterGradientData(ByteAddressBuffer buffer, uint base)
{
    HdrFilterGradientData value;
    value.rgb = asfloat(buffer.Load3(base + HDR_FILTER_GRADIENT_RGB_OFFSET));
    value.flags = buffer.Load(base + HDR_FILTER_GRADIENT_FLAGS_OFFSET);
    value.transmittance = asfloat(buffer.Load3(base + HDR_FILTER_GRADIENT_TRANSMITTANCE_OFFSET));
    value.checked_texels = buffer.Load(base + HDR_FILTER_GRADIENT_CHECKED_TEXELS_OFFSET);
    return value;
}

static HdrFilterGradientData LoadHdrFilterGradientData(RWByteAddressBuffer buffer, uint base)
{
    HdrFilterGradientData value;
    value.rgb = asfloat(buffer.Load3(base + HDR_FILTER_GRADIENT_RGB_OFFSET));
    value.flags = buffer.Load(base + HDR_FILTER_GRADIENT_FLAGS_OFFSET);
    value.transmittance = asfloat(buffer.Load3(base + HDR_FILTER_GRADIENT_TRANSMITTANCE_OFFSET));
    value.checked_texels = buffer.Load(base + HDR_FILTER_GRADIENT_CHECKED_TEXELS_OFFSET);
    return value;
}

static void StoreHdrFilterGradientData(RWByteAddressBuffer buffer, uint base, HdrFilterGradientData value)
{
    buffer.Store3(base + HDR_FILTER_GRADIENT_RGB_OFFSET, asuint(value.rgb));
    buffer.Store(base + HDR_FILTER_GRADIENT_FLAGS_OFFSET, value.flags);
    buffer.Store3(base + HDR_FILTER_GRADIENT_TRANSMITTANCE_OFFSET, asuint(value.transmittance));
    buffer.Store(base + HDR_FILTER_GRADIENT_CHECKED_TEXELS_OFFSET, value.checked_texels);
}

// Whole-scene affine bounds before the final resolve. RGB is scene
// referred; coverage is dimensionless. Candidate bounds include
// prospective upstream stores, but exclude the final store checked by
// scene admission.
struct HdrSceneErrorData
{
    float current_rgb_relative;
    float current_rgb_absolute;
    float current_coverage_relative;
    float current_coverage_absolute;
    float candidate_rgb_relative;
    float candidate_rgb_absolute;
    float candidate_coverage_relative;
    float candidate_coverage_absolute;
    float candidate_pre_exposure;
    uint checked_products;
    // Complete current=1, complete candidate=2.
    uint flags;
    uint reserved;
};

// Byte offsets of HdrSceneErrorData in a byte-address buffer.
static const uint HDR_SCENE_ERROR_SIZE = 48u;
static const uint HDR_SCENE_ERROR_CURRENT_RGB_RELATIVE_OFFSET = 0u;
static const uint HDR_SCENE_ERROR_CURRENT_RGB_ABSOLUTE_OFFSET = 4u;
static const uint HDR_SCENE_ERROR_CURRENT_COVERAGE_RELATIVE_OFFSET = 8u;
static const uint HDR_SCENE_ERROR_CURRENT_COVERAGE_ABSOLUTE_OFFSET = 12u;
static const uint HDR_SCENE_ERROR_CANDIDATE_RGB_RELATIVE_OFFSET = 16u;
static const uint HDR_SCENE_ERROR_CANDIDATE_RGB_ABSOLUTE_OFFSET = 20u;
static const uint HDR_SCENE_ERROR_CANDIDATE_COVERAGE_RELATIVE_OFFSET = 24u;
static const uint HDR_SCENE_ERROR_CANDIDATE_COVERAGE_ABSOLUTE_OFFSET = 28u;
static const uint HDR_SCENE_ERROR_CANDIDATE_PRE_EXPOSURE_OFFSET = 32u;
static const uint HDR_SCENE_ERROR_CHECKED_PRODUCTS_OFFSET = 36u;
static const uint HDR_SCENE_ERROR_FLAGS_OFFSET = 40u;
static const uint HDR_SCENE_ERROR_RESERVED_OFFSET = 44u;

static HdrSceneErrorData LoadHdrSceneErrorData(ByteAddressBuffer buffer, uint base)
{
    HdrSceneErrorData value;
    value.current_rgb_relative = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CURRENT_RGB_RELATIVE_OFFSET));
    value.current_rgb_absolute = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CURRENT_RGB_ABSOLUTE_OFFSET));
    value.current_coverage_relative = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CURRENT_COVERAGE_RELATIVE_OFFSET));
    value.current_coverage_absolute = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CURRENT_COVERAGE_ABSOLUTE_OFFSET));
    value.candidate_rgb_relative = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_RGB_RELATIVE_OFFSET));
    value.candidate_rgb_absolute = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_RGB_ABSOLUTE_OFFSET));
    value.candidate_coverage_relative = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_COVERAGE_RELATIVE_OFFSET));
    value.candidate_coverage_absolute = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_COVERAGE_ABSOLUTE_OFFSET));
    value.candidate_pre_exposure = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_PRE_EXPOSURE_OFFSET));
    value.checked_products = buffer.Load(base + HDR_SCENE_ERROR_CHECKED_PRODUCTS_OFFSET);
    value.flags = buffer.Load(base + HDR_SCENE_ERROR_FLAGS_OFFSET);
    value.reserved = buffer.Load(base + HDR_SCENE_ERROR_RESERVED_OFFSET);
    return value;
}

static HdrSceneErrorData LoadHdrSceneErrorData(RWByteAddressBuffer buffer, uint base)
{
    HdrSceneErrorData value;
    value.current_rgb_relative = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CURRENT_RGB_RELATIVE_OFFSET));
    value.current_rgb_absolute = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CURRENT_RGB_ABSOLUTE_OFFSET));
    value.current_coverage_relative = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CURRENT_COVERAGE_RELATIVE_OFFSET));
    value.current_coverage_absolute = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CURRENT_COVERAGE_ABSOLUTE_OFFSET));
    value.candidate_rgb_relative = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_RGB_RELATIVE_OFFSET));
    value.candidate_rgb_absolute = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_RGB_ABSOLUTE_OFFSET));
    value.candidate_coverage_relative = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_COVERAGE_RELATIVE_OFFSET));
    value.candidate_coverage_absolute = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_COVERAGE_ABSOLUTE_OFFSET));
    value.candidate_pre_exposure = asfloat(buffer.Load(base + HDR_SCENE_ERROR_CANDIDATE_PRE_EXPOSURE_OFFSET));
    value.checked_products = buffer.Load(base + HDR_SCENE_ERROR_CHECKED_PRODUCTS_OFFSET);
    value.flags = buffer.Load(base + HDR_SCENE_ERROR_FLAGS_OFFSET);
    value.reserved = buffer.Load(base + HDR_SCENE_ERROR_RESERVED_OFFSET);
    return value;
}

static void StoreHdrSceneErrorData(RWByteAddressBuffer buffer, uint base, HdrSceneErrorData value)
{
    buffer.Store(base + HDR_SCENE_ERROR_CURRENT_RGB_RELATIVE_OFFSET, asuint(value.current_rgb_relative));
    buffer.Store(base + HDR_SCENE_ERROR_CURRENT_RGB_ABSOLUTE_OFFSET, asuint(value.current_rgb_absolute));
    buffer.Store(base + HDR_SCENE_ERROR_CURRENT_COVERAGE_RELATIVE_OFFSET, asuint(value.current_coverage_relative));
    buffer.Store(base + HDR_SCENE_ERROR_CURRENT_COVERAGE_ABSOLUTE_OFFSET, asuint(value.current_coverage_absolute));
    buffer.Store(base + HDR_SCENE_ERROR_CANDIDATE_RGB_RELATIVE_OFFSET, asuint(value.candidate_rgb_relative));
    buffer.Store(base + HDR_SCENE_ERROR_CANDIDATE_RGB_ABSOLUTE_OFFSET, asuint(value.candidate_rgb_absolute));
    buffer.Store(base + HDR_SCENE_ERROR_CANDIDATE_COVERAGE_RELATIVE_OFFSET, asuint(value.candidate_coverage_relative));
    buffer.Store(base + HDR_SCENE_ERROR_CANDIDATE_COVERAGE_ABSOLUTE_OFFSET, asuint(value.candidate_coverage_absolute));
    buffer.Store(base + HDR_SCENE_ERROR_CANDIDATE_PRE_EXPOSURE_OFFSET, asuint(value.candidate_pre_exposure));
    buffer.Store(base + HDR_SCENE_ERROR_CHECKED_PRODUCTS_OFFSET, value.checked_products);
    buffer.Store(base + HDR_SCENE_ERROR_FLAGS_OFFSET, value.flags);
    buffer.Store(base + HDR_SCENE_ERROR_RESERVED_OFFSET, value.reserved);
}

// Shader-observed nonnegative inputs before AP/fog attenuation, in scene units.
struct HdrConsumerInputData
{
    float translucent_rgb_max;
    float height_fog_rgb_max;
    // Translucency/height=1/2; invalid inputs=4/8; sky/opaque
    // AP/translucent AP consumers=16/32/64; invalid sky gain=128.
    uint flags;
    float sky_rgb_gain_max;
};

// Byte offsets of HdrConsumerInputData in a byte-address buffer.
static const uint HDR_CONSUMER_INPUT_SIZE = 16u;
static const uint HDR_CONSUMER_INPUT_TRANSLUCENT_RGB_MAX_OFFSET = 0u;
static const uint HDR_CONSUMER_INPUT_HEIGHT_FOG_RGB_MAX_OFFSET = 4u;
static const uint HDR_CONSUMER_INPUT_FLAGS_OFFSET = 8u;
static const uint HDR_CONSUMER_INPUT_SKY_RGB_GAIN_MAX_OFFSET = 12u;

static HdrConsumerInputData LoadHdrConsumerInputData(ByteAddressBuffer buffer, uint base)
{
    HdrConsumerInputData value;
    value.translucent_rgb_max = asfloat(buffer.Load(base + HDR_CONSUMER_INPUT_TRANSLUCENT_RGB_MAX_OFFSET));
    value.height_fog_rgb_max = asfloat(buffer.Load(base + HDR_CONSUMER_INPUT_HEIGHT_FOG_RGB_MAX_OFFSET));
    value.flags = buffer.Load(base + HDR_CONSUMER_INPUT_FLAGS_OFFSET);
    value.sky_rgb_gain_max = asfloat(buffer.Load(base + HDR_CONSUMER_INPUT_SKY_RGB_GAIN_MAX_OFFSET));
    return value;
}

static HdrConsumerInputData LoadHdrConsumerInputData(RWByteAddressBuffer buffer, uint base)
{
    HdrConsumerInputData value;
    value.translucent_rgb_max = asfloat(buffer.Load(base + HDR_CONSUMER_INPUT_TRANSLUCENT_RGB_MAX_OFFSET));
    value.height_fog_rgb_max = asfloat(buffer.Load(base + HDR_CONSUMER_INPUT_HEIGHT_FOG_RGB_MAX_OFFSET));
    value.flags = buffer.Load(base + HDR_CONSUMER_INPUT_FLAGS_OFFSET);
    value.sky_rgb_gain_max = asfloat(buffer.Load(base + HDR_CONSUMER_INPUT_SKY_RGB_GAIN_MAX_OFFSET));
    return value;
}

static void StoreHdrConsumerInputData(RWByteAddressBuffer buffer, uint base, HdrConsumerInputData value)
{
    buffer.Store(base + HDR_CONSUMER_INPUT_TRANSLUCENT_RGB_MAX_OFFSET, asuint(value.translucent_rgb_max));
    buffer.Store(base + HDR_CONSUMER_INPUT_HEIGHT_FOG_RGB_MAX_OFFSET, asuint(value.height_fog_rgb_max));
    buffer.Store(base + HDR_CONSUMER_INPUT_FLAGS_OFFSET, value.flags);
    buffer.Store(base + HDR_CONSUMER_INPUT_SKY_RGB_GAIN_MAX_OFFSET, asuint(value.sky_rgb_gain_max));
}

// The readback prefix stays non-numerical; the tail remains GPU-owned.
struct ExposureStatusStorage
{
    ExposureCompletedStatus completed;
    // Sky view, AP, fog.
    HdrErrorBoundsData producer_errors[3];
    HdrCompositionInputData composition_input;
    HdrOpaqueApErrorData opaque_ap_error;
    // Sky, AP, fog.
    HdrFilterGradientData filter_gradients[3];
    HdrSceneErrorData scene_error;
    // Prospective stores at the selected candidate P, including
    // retained error: sky, AP, fog.
    HdrErrorBoundsData candidate_errors[3];
    HdrConsumerInputData consumer_inputs;
    // Scene-referred reference RGB maxima for sky, AP and fog, respectively.
    float3 product_reference_rgb_max;
    uint product_range_reserved;
};

// Byte offsets of ExposureStatusStorage in a byte-address buffer.
static const uint EXPOSURE_STATUS_SIZE = 384u;
static const uint EXPOSURE_STATUS_COMPLETED_OFFSET = 0u;
static const uint EXPOSURE_STATUS_COMPLETED_VIEW_STATE_IDENTITY_OFFSET = 0u;
static const uint EXPOSURE_STATUS_COMPLETED_FRAME_SEQUENCE_OFFSET = 8u;
static const uint EXPOSURE_STATUS_COMPLETED_SETTINGS_REVISION_OFFSET = 16u;
static const uint EXPOSURE_STATUS_COMPLETED_REQUESTED_GENERATION_OFFSET = 24u;
static const uint EXPOSURE_STATUS_COMPLETED_APPLIED_GENERATION_OFFSET = 32u;
static const uint EXPOSURE_STATUS_COMPLETED_PRODUCT_LAYOUT_REVISION_OFFSET = 40u;
static const uint EXPOSURE_STATUS_COMPLETED_FLAGS_OFFSET = 48u;
static const uint EXPOSURE_STATUS_COMPLETED_FIRST_FAILURE_PRODUCT_OFFSET = 52u;
static const uint EXPOSURE_STATUS_COMPLETED_FIRST_FAILURE_KIND_OFFSET = 56u;
