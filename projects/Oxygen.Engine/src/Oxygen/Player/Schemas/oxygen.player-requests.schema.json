{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "oxygen.player-requests.schema.json",
  "title": "Oxygen player request",
  "description": "One request line a launcher sends to Oxygen.Player on its diagnostics pipe.",
  "type": "object",
  "required": ["request"],
  "properties": {
    "request": {
      "enum": [
        "play",
        "pause",
        "resume",
        "step",
        "end_session",
        "stop",
        "stats"
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "request": { "const": "play" } } },
      "then": {
        "additionalProperties": false,
        "properties": {
          "request": true,
          "scene": {
            "description": "Scene virtual path; the launch file's scene when omitted.",
            "type": "string",
            "pattern": "^/.+"
          }
        }
      }
    },
    {
      "if": { "properties": { "request": { "const": "step" } } },
      "then": {
        "additionalProperties": false,
        "properties": {
          "request": true,
          "frames": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": { "properties": { "request": { "const": "stats" } } },
      "then": {
        "additionalProperties": false,
        "required": ["gpu_work"],
        "properties": {
          "request": true,
          "gpu_work": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request": { "enum": ["pause", "resume", "end_session", "stop"] }
        }
      },
      "then": {
        "additionalProperties": false,
        "properties": {
          "request": true
        }
      }
    }
  ]
}
