{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "oxygen.player-events.schema.json",
  "title": "Oxygen player event",
  "description": "One event Oxygen.Player publishes to the control server's event log: its topic and data. The envelope (seq, frame) and the log and command topics belong to the control server.",
  "type": "object",
  "required": ["topic", "data"],
  "properties": {
    "topic": {
      "enum": ["lifecycle", "diagnostic", "gpu_work", "stats"]
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "topic": {
            "const": "lifecycle"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state"],
            "properties": {
              "state": {
                "description": "stopping means the engine is shutting down.",
                "enum": [
                  "session_started",
                  "scene_loaded",
                  "scene_failed",
                  "paused",
                  "resumed",
                  "session_ended",
                  "stopping"
                ]
              },
              "scene": {
                "description": "The session's scene virtual path.",
                "type": "string"
              },
              "message": {
                "description": "Why the scene failed.",
                "type": "string"
              },
              "code": {
                "description": "The code of a refused scene, such as player.model_scene.",
                "type": "string"
              },
              "issues": {
                "description": "Records of the scene that could not be applied.",
                "type": "array",
                "items": {
                  "$ref": "#/definitions/issue"
                }
              },
              "camera": {
                "description": "The camera a loaded scene is viewed through.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "diagnostic"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "description": "A script diagnostic, as oxygen.script-diagnostic.schema.json.",
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "gpu_work"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/definitions/gpu_work_summary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "topic": {
            "const": "stats"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fps"],
            "properties": {
              "fps": {
                "description": "Frames per second, whole, sampled a few times a second.",
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scene", "message"],
      "properties": {
        "code": {
          "description": "The issue's code, such as scene.instance.change_unresolved.",
          "type": "string"
        },
        "scene": {
          "description": "Asset key of the scene the record belongs to.",
          "type": "string"
        },
        "node_index": {
          "type": "integer",
          "minimum": 0
        },
        "node_path": {
          "description": "Node IDs below the instance root node_index names, shallowest first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        }
      }
    },
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["avg_ms", "max_ms"],
      "properties": {
        "avg_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "time", "items"],
      "properties": {
        "bucket": {
          "enum": [
            "visibility",
            "depth_prepass",
            "shadows",
            "base_pass",
            "lighting",
            "environment",
            "translucency",
            "post_process",
            "overlays",
            "composition",
            "background",
            "other"
          ]
        },
        "time": {
          "$ref": "#/definitions/stat"
        },
        "items": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "time"],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "time": {
                "$ref": "#/definitions/stat"
              }
            }
          }
        }
      }
    },
    "gpu_work_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "last_frame",
        "window_ms",
        "valid_frames",
        "invalid_frames",
        "frame_gpu",
        "idle",
        "views",
        "frame_work",
        "frame_work_time",
        "frame_gpu_history_ms"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "last_frame": {
          "type": "integer",
          "minimum": 0
        },
        "window_ms": {
          "type": "number",
          "minimum": 0
        },
        "valid_frames": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_frames": {
          "type": "integer",
          "minimum": 0
        },
        "frame_gpu": {
          "$ref": "#/definitions/stat"
        },
        "idle": {
          "$ref": "#/definitions/stat"
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view_id", "name", "time", "groups"],
            "properties": {
              "view_id": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string"
              },
              "time": {
                "$ref": "#/definitions/stat"
              },
              "groups": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/group"
                }
              }
            }
          }
        },
        "frame_work": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/group"
          }
        },
        "frame_work_time": {
          "$ref": "#/definitions/stat"
        },
        "frame_gpu_history_ms": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": false
}
