+        for (size_t pixel = 0; pixel < first.size(); ++pixel) {
+          for (unsigned channel = 0; channel < 3; ++channel) {
+            EXPECT_NEAR(first[pixel][channel] / first_domain.pre_exposure,
+              second[pixel][channel] / second_domain.pre_exposure, 1.0e-5F);
+          }
