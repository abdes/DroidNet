+  }
+  EXPECT_EQ(HeapAllocationFailure::RejectedCount(), before);
+  EXPECT_EQ(total_created_count_, 8);
+  EXPECT_TRUE(pool_->AcquireCommandList(QueueRole::kGraphics, "reused"));
+  EXPECT_EQ(total_created_count_, 8);
+}
+#endif
