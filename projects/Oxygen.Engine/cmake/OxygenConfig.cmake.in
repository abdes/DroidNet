@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(OXYGEN_SDK_ROOT "${PACKAGE_PREFIX_DIR}")
set(OXYGEN_RUNTIME_DIR "${OXYGEN_SDK_ROOT}/@OXYGEN_INSTALL_BIN@")
set(OXYGEN_DATA_DIR "${OXYGEN_SDK_ROOT}/@OXYGEN_INSTALL_DATA@")
set(OXYGEN_AVAILABLE_MODULES "@OXYGEN_INSTALLED_MODULES@")
# The dependency configs are generated from the resolved Conan graph and made
# relative when the SDK is assembled. No Conan installation is needed here.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/OxygenDependencies.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/OxygenDependencies.cmake")
elseif("@OXYGEN_BUILD_FULL_ENGINE@" STREQUAL "FALSE")
  # A parent may install the bounded reusable modules while providing their
  # dependencies itself. Preserve that ownership and declare the public edges.
  if("Oxygen.Base" IN_LIST OXYGEN_AVAILABLE_MODULES)
    find_dependency(fmt CONFIG)
  endif()
  if("Oxygen.OxCo" IN_LIST OXYGEN_AVAILABLE_MODULES)
    find_dependency(asio CONFIG)
  endif()
  if("Oxygen.Clap" IN_LIST OXYGEN_AVAILABLE_MODULES)
    find_dependency(magic_enum CONFIG)
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OxygenTargets.cmake")
foreach(_component IN LISTS Oxygen_FIND_COMPONENTS)
  if("Oxygen.${_component}" IN_LIST OXYGEN_AVAILABLE_MODULES)
    set(Oxygen_${_component}_FOUND TRUE)
  else()
    set(Oxygen_${_component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(Oxygen)
