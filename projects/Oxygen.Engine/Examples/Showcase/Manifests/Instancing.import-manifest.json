{
  "$schema": "oxygen.import-manifest.schema.json",
  "schema_version": 2,
  "project_root": "..",
  "mounts": [
    {
      "name": "Showcase",
      "kind": "Source",
      "path": "Content"
    }
  ],
  "max_in_flight_jobs": 1,
  "jobs": [
    {
      "id": "/Showcase/Scenes/Instancing/MatInstanced.omat",
      "type": "material-descriptor",
      "source": "/Showcase/Scenes/Instancing/MatInstanced.omat.json",
      "virtual_path": "/Showcase/Scenes/Instancing/MatInstanced.omat",
      "name": "MatInstanced"
    },
    {
      "id": "/Showcase/Scenes/Instancing/GeoInstancedCube.ogeo",
      "type": "geometry-descriptor",
      "source": "/Showcase/Scenes/Instancing/GeoInstancedCube.ogeo.json",
      "virtual_path": "/Showcase/Scenes/Instancing/GeoInstancedCube.ogeo",
      "name": "GeoInstancedCube",
      "depends_on": ["/Showcase/Scenes/Instancing/MatInstanced.omat"]
    },
    {
      "id": "/Showcase/Scenes/Instancing/Ground.omat",
      "type": "material-descriptor",
      "source": "/Showcase/Scenes/Instancing/Ground.omat.json",
      "virtual_path": "/Showcase/Scenes/Instancing/Ground.omat",
      "name": "Ground"
    },
    {
      "id": "/Showcase/Scenes/Instancing/InstancingTestScene.oscene",
      "type": "scene-descriptor",
      "source": "/Showcase/Scenes/Instancing/InstancingTestScene.scene.json",
      "virtual_path": "/Showcase/Scenes/Instancing/InstancingTestScene.oscene",
      "name": "InstancingTestScene",
      "depends_on": [
        "/Showcase/Scenes/Instancing/GeoInstancedCube.ogeo",
        "/Showcase/Scenes/Instancing/Ground.omat"
      ]
    }
  ]
}
