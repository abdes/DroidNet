{
  "$schema": "oxygen.import-manifest.schema.json",
  "version": 1,
  "project_root": "..",
  "mounts": [
    {
      "name": "Showcase",
      "kind": "Source",
      "path": "Content"
    }
  ],
  "max_in_flight_jobs": 1,
  "jobs": [
    {
      "id": "/Showcase/Models/Lantern.glb",
      "type": "model",
      "virtual_path": "/Showcase/Models/Lantern.glb"
    },
    {
      "id": "/Showcase/Scenes/Lantern/Sky.otex",
      "type": "texture-descriptor",
      "source": "/Showcase/Scenes/Lantern/Sky.otex.json",
      "virtual_path": "/Showcase/Scenes/Lantern/Sky.otex",
      "name": "Sky"
    },
    {
      "id": "/Showcase/Scenes/Lantern/Lantern.oscene",
      "type": "scene-descriptor",
      "source": "/Showcase/Scenes/Lantern/Lantern.scene.json",
      "virtual_path": "/Showcase/Scenes/Lantern/Lantern.oscene",
      "name": "Lantern",
      "depends_on": [
        "/Showcase/Models/Lantern.glb",
        "/Showcase/Scenes/Lantern/Sky.otex"
      ]
    }
  ]
}
