{
  "version": 1,
  "max_in_flight_jobs": 1,
  "output": "../../.cooked/main",
  "jobs": [
    {
      "id": "material.MatInstanced",
      "type": "material-descriptor",
      "source": "./MatInstanced.material.json",
      "virtual_path": "/.cooked/Materials/MatInstanced.omat",
      "name": "MatInstanced",
      "content_hashing": true
    },
    {
      "id": "geometry.GeoInstancedCube",
      "type": "geometry-descriptor",
      "source": "./GeoInstancedCube.geometry.json",
      "virtual_path": "/.cooked/Geometry/GeoInstancedCube.ogeo",
      "name": "GeoInstancedCube",
      "content_hashing": true,
      "depends_on": ["material.MatInstanced"]
    },
    {
      "id": "scene.InstancingTestScene",
      "type": "scene-descriptor",
      "source": "./InstancingTestScene.scene.json",
      "virtual_path": "/.cooked/Scenes/InstancingTestScene.oscene",
      "name": "InstancingTestScene",
      "content_hashing": true,
      "depends_on": ["geometry.GeoInstancedCube"]
    }
  ]
}
