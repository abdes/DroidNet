{
  "version": 1,
  "max_in_flight_jobs": 1,
  "output": "../../.cooked/main",
  "jobs": [
    {
      "id": "material.ScriptedCubeMat",
      "type": "material-descriptor",
      "source": "./ScriptedCubeMat.material.json",
      "virtual_path": "/.cooked/Materials/ScriptedCubeMat.omat",
      "name": "ScriptedCubeMat",
      "content_hashing": true
    },
    {
      "id": "material.CompanionOrbMat",
      "type": "material-descriptor",
      "source": "./CompanionOrbMat.material.json",
      "virtual_path": "/.cooked/Materials/CompanionOrbMat.omat",
      "name": "CompanionOrbMat",
      "content_hashing": true
    },
    {
      "id": "script.OrbitShapesScript",
      "type": "script",
      "source": "./orbit-shapes.lua",
      "virtual_path": "/.cooked/Scripts/orbit-shapes.oscript",
      "name": "OrbitShapesScript",
      "compile": false,
      "script_storage": "external",
      "content_hashing": true
    },
    {
      "id": "script.TimeOfDayScript",
      "type": "script",
      "source": "./day-night.lua",
      "virtual_path": "/.cooked/Scripts/day-night.oscript",
      "name": "TimeOfDayScript",
      "compile": false,
      "script_storage": "external",
      "content_hashing": true
    },
    {
      "id": "input.multi_script_scene",
      "type": "input",
      "source": "./multi_script_scene.input.json"
    },
    {
      "id": "scene.multi_script_scene",
      "type": "scene-descriptor",
      "source": "./multi_script_scene.scene.json",
      "virtual_path": "/.cooked/Scenes/multi_script_scene.oscene",
      "name": "multi_script_scene",
      "content_hashing": true,
      "depends_on": [
        "material.ScriptedCubeMat",
        "material.CompanionOrbMat",
        "script.OrbitShapesScript",
        "script.TimeOfDayScript",
        "input.multi_script_scene"
      ]
    },
    {
      "id": "script-sidecar.multi_script_scene",
      "type": "script-sidecar",
      "name": "multi_script_scene_script_sidecar",
      "target_scene_virtual_path": "/.cooked/Scenes/multi_script_scene.oscene",
      "content_hashing": true,
      "depends_on": [
        "scene.multi_script_scene",
        "script.OrbitShapesScript",
        "material.ScriptedCubeMat",
        "material.CompanionOrbMat",
        "script.TimeOfDayScript",
        "input.multi_script_scene"
      ],
      "bindings": [
        {
          "node_index": 1,
          "slot_id": "OrbitShapesScript",
          "script_virtual_path": "/.cooked/Scripts/orbit-shapes.oscript",
          "execution_order": 0,
          "params": [
            {
              "key": "speed",
              "type": "float",
              "value": 1.6
            },
            {
              "key": "bounce_amplitude",
              "type": "float",
              "value": 0.45
            },
            {
              "key": "host_material",
              "type": "asset",
              "value": "/.cooked/Materials/ScriptedCubeMat.omat"
            },
            {
              "key": "orb_material",
              "type": "asset",
              "value": "/.cooked/Materials/CompanionOrbMat.omat"
            },
            {
              "key": "speed_up",
              "type": "asset",
              "value": "/.cooked/Input/RotateSpeedUpAction.oiact"
            },
            {
              "key": "speed_down",
              "type": "asset",
              "value": "/.cooked/Input/RotateSpeedDownAction.oiact"
            },
            {
              "key": "stop",
              "type": "asset",
              "value": "/.cooked/Input/RotateStopAction.oiact"
            },
            {
              "key": "invert",
              "type": "asset",
              "value": "/.cooked/Input/RotateInvertAction.oiact"
            },
            {
              "key": "cycle_shape",
              "type": "asset",
              "value": "/.cooked/Input/CycleShapeAction.oiact"
            },
            {
              "key": "spawn_orb",
              "type": "asset",
              "value": "/.cooked/Input/SpawnOrbAction.oiact"
            },
            {
              "key": "pulse_scale",
              "type": "asset",
              "value": "/.cooked/Input/PulseScaleAction.oiact"
            }
          ]
        },
        {
          "node_index": 4,
          "slot_id": "TimeOfDayScript",
          "script_virtual_path": "/.cooked/Scripts/day-night.oscript",
          "execution_order": 1,
          "params": [
            {
              "key": "day_duration_seconds",
              "type": "float",
              "value": 60.0
            }
          ]
        }
      ]
    }
  ],
  "defaults": {
    "script": {
      "source_root": "../.."
    }
  }
}
