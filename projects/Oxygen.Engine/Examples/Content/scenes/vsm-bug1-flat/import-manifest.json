{
  "version": 1,
  "max_in_flight_jobs": 1,
  "output": "../../.cooked/main",
  "jobs": [
    {
      "id": "material.floor_default",
      "type": "material-descriptor",
      "source": "./floor_default.material.json",
      "virtual_path": "/.cooked/Materials/floor_default.omat",
      "name": "floor_default",
      "content_hashing": true
    },
    {
      "id": "material.cube_red",
      "type": "material-descriptor",
      "source": "./cube_red.material.json",
      "virtual_path": "/.cooked/Materials/cube_red.omat",
      "name": "cube_red",
      "content_hashing": true
    },
    {
      "id": "geometry.floor",
      "type": "geometry-descriptor",
      "source": "./floor.geometry.json",
      "virtual_path": "/.cooked/Geometry/floor.ogeo",
      "name": "floor",
      "content_hashing": true,
      "depends_on": ["material.floor_default"]
    },
    {
      "id": "geometry.cube",
      "type": "geometry-descriptor",
      "source": "./cube.geometry.json",
      "virtual_path": "/.cooked/Geometry/cube.ogeo",
      "name": "cube",
      "content_hashing": true,
      "depends_on": ["material.cube_red"]
    },
    {
      "id": "scene.vsm_bug1_large_plane",
      "type": "scene-descriptor",
      "source": "./VsmBug1LargePlane.scene.json",
      "virtual_path": "/.cooked/Scenes/VsmBug1LargePlane.oscene",
      "name": "VsmBug1LargePlane",
      "content_hashing": true,
      "depends_on": ["geometry.floor"]
    },
    {
      "id": "scene.vsm_bug1_large_thin_cube",
      "type": "scene-descriptor",
      "source": "./VsmBug1LargeThinCube.scene.json",
      "virtual_path": "/.cooked/Scenes/VsmBug1LargeThinCube.oscene",
      "name": "VsmBug1LargeThinCube",
      "content_hashing": true,
      "depends_on": ["geometry.cube"]
    }
  ]
}
