{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oxygen showcase source inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assets"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "archive": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": ["url"]
          },
          {
            "required": ["archive"]
          }
        ]
      }
    }
  }
}
