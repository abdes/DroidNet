{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Oxygen Content model sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "source": { "type": "string", "minLength": 1 },
          "virtual_path": {
            "type": "string",
            "pattern": "^/.+",
            "description": "The model's identity: the virtual path of its source file, ending in its extension; its products are named under it. Default: /.cooked/Models/<name><extension>."
          }
        }
      }
    }
  }
}
