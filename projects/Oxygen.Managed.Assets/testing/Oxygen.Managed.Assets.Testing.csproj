<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <Title>Oxygen Managed Assets Testing</Title>
        <Description>Test kit of Oxygen.Managed.Assets: writers of small loose cooked indexes and paks, for the tests of the modules that read cooked content.</Description>
        <PackageTags>oxygen;managed;assets;testing</PackageTags>
        <PackageReleaseNotes>Initial version.</PackageReleaseNotes>
        <RootNamespace>Oxygen.Managed.Assets.Testing</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Assets\src\Oxygen.Managed.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\src\Oxygen.Managed.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.cooked-inventory.schema.json" LogicalName="oxygen.cooked-inventory.schema.json" />
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.import-report.schema.json" LogicalName="oxygen.import-report.schema.json" />
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.cooked-dependencies.schema.json" LogicalName="oxygen.cooked-dependencies.schema.json" />
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.cooked-geometries.schema.json" LogicalName="oxygen.cooked-geometries.schema.json" />
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.cooked-scripts.schema.json" LogicalName="oxygen.cooked-scripts.schema.json" />
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.source-analysis.schema.json" LogicalName="oxygen.source-analysis.schema.json" />
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.asset-key-map.schema.json" LogicalName="oxygen.asset-key-map.schema.json" />
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.script-diagnostic.schema.json" LogicalName="oxygen.script-diagnostic.schema.json" />
        <EmbeddedResource Include="$(OxygenSdkSchemasDir)\oxygen.surface-provenance.schema.json" LogicalName="oxygen.surface-provenance.schema.json" />
    </ItemGroup>

</Project>
