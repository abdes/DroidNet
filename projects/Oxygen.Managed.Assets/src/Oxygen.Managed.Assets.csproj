<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net9.0-windows10.0.26100.0</TargetFrameworks>

        <RootNamespace>Oxygen.Managed.Assets</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>

        <Title>Oxygen Managed Assets</Title>
        <Description>Oxygen managed authoring models, asset references, discovery and current native cooked-index metadata. Runtime import, cooking and integrity verification are owned by Oxygen.Cooker and Oxygen.Content.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>oxygen;gameengine;assets;pipeline;editor</PackageTags>
        <PackageReleaseNotes>Initial version.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JsonSchema.Net" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="System.Reactive" />



    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Cooker\Import\Schemas\oxygen.material-descriptor.schema.json"
                          LogicalName="oxygen.material-descriptor.schema.json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\src\Oxygen.Managed.Core.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Storage\src\Storage.csproj" />
    </ItemGroup>

</Project>
