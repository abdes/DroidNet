<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentBrowser.Shell.ContentBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assets="using:Oxygen.Editor.ContentBrowser.Panes.Assets"
    xmlns:browser="using:Oxygen.Editor.ContentBrowser"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.ContentBrowser.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:router="using:DroidNet.Routing.WinUI"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  ReSharper disable Xaml.PathError  -->
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.ContentBrowser/Styles/GridSplitterStyles.xaml" />
                <!--  ReSharper restore Xaml.PathError  -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Navigation and query: history, location, search and filters, view and details pane.  -->
        <Grid Padding="0,2,4,2" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="120" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Background="Transparent" Orientation="Horizontal">
                <AppBarButton
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Icon="Back"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                    Label="Back"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="Back" />
                <AppBarButton
                    Command="{x:Bind ViewModel.GoForwardCommand}"
                    Icon="Forward"
                    IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                    Label="Forward"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="Forward" />
                <AppBarButton
                    Command="{x:Bind ViewModel.GoUpCommand}"
                    Icon="Up"
                    IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"
                    Label="Up"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="Up to the parent folder" />
                <AppBarButton
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Icon="Refresh"
                    Label="Refresh"
                    LabelPosition="Collapsed"
                    ToolTipService.ToolTip="Refresh" />
            </StackPanel>

            <Border
                Grid.Column="1"
                MinHeight="32"
                Padding="6,2"
                VerticalAlignment="Center"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <BreadcrumbBar
                    x:Name="Breadcrumbs"
                    ItemClicked="BreadcrumbBar_ItemClicked"
                    ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="local:BreadcrumbEntry">
                            <TextBlock Text="{x:Bind Label}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
            </Border>

            <assets:AssetQueryView Grid.Column="2" ViewModel="{x:Bind ViewModel.Query}" />

            <dnc:ToolBar
                Grid.Column="3"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                OverflowButtonVisibility="Collapsed">
                <dnc:ToolBarToggleButton
                    x:Name="TilesViewButton"
                    Click="OnViewButtonClicked"
                    Label="Tiles"
                    Tag="Tiles"
                    ToolTipService.ToolTip="Tiles">
                    <dnc:ToolBarToggleButton.Icon>
                        <FontIconSource Glyph="&#xECA5;" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
                <dnc:ToolBarToggleButton
                    x:Name="ListViewButton"
                    Click="OnViewButtonClicked"
                    Label="List"
                    Tag="List"
                    ToolTipService.ToolTip="List">
                    <dnc:ToolBarToggleButton.Icon>
                        <FontIconSource Glyph="&#xE8FD;" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
                <dnc:ToolBarToggleButton
                    x:Name="DetailsViewButton"
                    Click="OnViewButtonClicked"
                    Label="Details"
                    Tag="Details"
                    ToolTipService.ToolTip="Details: sortable columns">
                    <dnc:ToolBarToggleButton.Icon>
                        <FontIconSource Glyph="&#xE8A9;" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
                <dnc:ToolBarSeparator />
                <dnc:ToolBarToggleButton
                    IsChecked="{x:Bind ViewModel.Presentation.IsDetailsPaneOpen, Mode=TwoWay}"
                    Label="Details pane"
                    ToolTipService.ToolTip="Show or hide the details pane">
                    <dnc:ToolBarToggleButton.Icon>
                        <FontIconSource Glyph="&#xE946;" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
            </dnc:ToolBar>
        </Grid>

        <!--  Active filters as removable chips.  -->
        <Grid
            Grid.Row="1"
            Padding="8,0,8,6"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.Query.HasActiveFilters, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Query.ActiveFilters, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="browser:AssetFilterOption">
                        <Button
                            Padding="10,2,6,2"
                            AutomationProperties.Name="{x:Bind Label}"
                            Command="{x:Bind RemoveCommand}"
                            CornerRadius="12"
                            ToolTipService.ToolTip="Remove this filter">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" />
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <HyperlinkButton
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{x:Bind ViewModel.Query.ClearFiltersCommand}"
                Content="Clear all" />
        </Grid>

        <!--  Sources, results and the optional details pane.  -->
        <Grid Grid.Row="2">
            <!--
                The sources column has a fixed width that only the splitter changes: an Auto column would follow
                whichever tree rows are realized and resize the pane while scrolling. Long names trim instead.
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="240"
                    MinWidth="160"
                    MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{x:Bind local:ContentBrowserView.DetailsPaneWidth(ViewModel.Presentation.IsDetailsPaneOpen), Mode=OneWay}" />
            </Grid.ColumnDefinitions>

            <router:RouterOutlet
                Grid.Column="0"
                Outlet="left"
                ViewModel="{x:Bind ViewModel.LeftPaneViewModel, Mode=OneWay}"
                VmToViewConverter="{x:Bind ViewModel.VmToViewConverter}" />

            <controls:GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Auto"
                Style="{StaticResource InvisibleGridSplitterStyle}" />

            <router:RouterOutlet
                Grid.Column="2"
                Outlet="right"
                ViewModel="{x:Bind ViewModel.RightPaneViewModel, Mode=OneWay}"
                VmToViewConverter="{x:Bind ViewModel.VmToViewConverter}" />

            <controls:GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Left"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Auto"
                Style="{StaticResource InvisibleGridSplitterStyle}"
                Visibility="{x:Bind ViewModel.Presentation.IsDetailsPaneOpen, Mode=OneWay}" />

            <Border
                Grid.Column="4"
                Margin="0,0,4,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.Presentation.IsDetailsPaneOpen, Mode=OneWay}">
                <assets:AssetDetailsView ViewModel="{x:Bind ViewModel.Details, Mode=OneWay}" />
            </Border>
        </Grid>

        <!--  Footer: result counts and whether the current location is authored or read-only.  -->
        <Grid
            Grid.Row="3"
            Padding="10,3"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Right"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SourceDescription, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
