<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentBrowser.Panes.Assets.AssetDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:identity="using:Oxygen.Editor.ContentBrowser.AssetIdentity"
    xmlns:localcvt="using:Oxygen.Editor.ContentBrowser.Panes.Assets.Converters">

    <UserControl.Resources>
        <localcvt:AssetTypeToIconConverter x:Key="AssetTypeToIconConverter" />
        <localcvt:AssetTypeToBrushConverter x:Key="AssetTypeToBrushConverter" />
        <localcvt:StatusToneToBrushConverter x:Key="StatusToneToBrushConverter" />
        <localcvt:MaterialPreviewColorToBrushConverter x:Key="MaterialPreviewColorToBrushConverter" />

        <DataTemplate x:Key="FactTemplate" x:DataType="identity:AssetInformationFact">
            <Grid Margin="0,3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Label}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Column="1"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Value}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="12" Spacing="10">
            <!--  Preview: a material's base colour, or the type glyph until rendered thumbnails exist.  -->
            <Grid
                Height="150"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{x:Bind ViewModel.IsSingle, Mode=OneWay}">
                <Border
                    Margin="16"
                    Background="{x:Bind ViewModel.Row.BaseColor, Mode=OneWay, Converter={StaticResource MaterialPreviewColorToBrushConverter}}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.Row.HasSwatch, Mode=OneWay, FallbackValue=Collapsed}" />
                <Viewbox
                    MaxWidth="64"
                    MaxHeight="64"
                    Visibility="{x:Bind ViewModel.Row.HasGlyph, Mode=OneWay, FallbackValue=Collapsed}">
                    <FontIcon Foreground="{x:Bind ViewModel.Row.Kind, Mode=OneWay, Converter={StaticResource AssetTypeToBrushConverter}}" Glyph="{x:Bind ViewModel.Row.Kind, Mode=OneWay, Converter={StaticResource AssetTypeToIconConverter}}" />
                </Viewbox>
            </Grid>

            <TextBlock
                IsTextSelectionEnabled="True"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextWrapping="Wrap" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsSingle, Mode=OneWay}">
                <Ellipse
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{x:Bind ViewModel.Row.StatusTone, Mode=OneWay, Converter={StaticResource StatusToneToBrushConverter}}" />
                <TextBlock Text="{x:Bind ViewModel.Row.StatusText, Mode=OneWay}" />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                TextWrapping="Wrap" />

            <ItemsControl ItemTemplate="{StaticResource FactTemplate}" ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}" />

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsMultiple, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Selected" />
                <ItemsControl ItemTemplate="{StaticResource FactTemplate}" ItemsSource="{x:Bind ViewModel.SelectedItems, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <Button Command="{x:Bind ViewModel.LocateCommand}" ToolTipService.ToolTip="Show the asset's file in File Explorer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xEC50;" />
                        <TextBlock Text="Locate" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.CopyPathCommand}" ToolTipService.ToolTip="Copy the logical path of each selected asset">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        <TextBlock Text="Copy path" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
