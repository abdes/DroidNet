<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentBrowser.Panes.Assets.Layouts.TilesLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:identity="using:Oxygen.Editor.ContentBrowser.AssetIdentity"
    xmlns:localcvt="using:Oxygen.Editor.ContentBrowser.Panes.Assets.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <localcvt:AssetTypeToIconConverter x:Key="AssetTypeToIconConverter" />
        <localcvt:AssetTypeToBrushConverter x:Key="AssetTypeToBrushConverter" />
        <localcvt:StatusToneToBrushConverter x:Key="StatusToneToBrushConverter" />
        <localcvt:MaterialPreviewColorToBrushConverter x:Key="MaterialPreviewColorToBrushConverter" />

        <!--  Tile: preview (material swatch or type glyph), then name, type and status.  -->
        <DataTemplate x:Key="GameAssetTemplate" x:DataType="identity:AssetBrowserRow">
            <Grid
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind Item.DisplayName, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6,6,0,0">
                    <Border
                        Margin="12"
                        Background="{x:Bind BaseColor, Mode=OneWay, Converter={StaticResource MaterialPreviewColorToBrushConverter}}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{x:Bind HasSwatch, Mode=OneWay}" />
                    <Viewbox
                        MaxWidth="56"
                        MaxHeight="56"
                        Margin="16"
                        Visibility="{x:Bind HasGlyph, Mode=OneWay}">
                        <FontIcon Foreground="{x:Bind Kind, Mode=OneWay, Converter={StaticResource AssetTypeToBrushConverter}}" Glyph="{x:Bind Kind, Mode=OneWay, Converter={StaticResource AssetTypeToIconConverter}}" />
                    </Viewbox>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Padding="10,6,10,8"
                    Spacing="1">
                    <TextBlock
                        MaxLines="1"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Item.DisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind Item.DisplayName, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Item.TypeDisplayName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{x:Bind StatusTone, Mode=OneWay, Converter={StaticResource StatusToneToBrushConverter}}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Item.PrimaryBadgeTooltip, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasBuiltinCatalogNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.BuiltinCatalogNotice, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RetryBuiltinCatalogCommand}" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>
        <GridView
            x:Name="BasicGridView"
            Grid.Row="1"
            Padding="8,4"
            AutomationProperties.Name="Assets"
            ItemTemplate="{StaticResource GameAssetTemplate}"
            ItemsSource="{x:Bind ViewModel.Assets}"
            SelectionMode="Extended">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>
        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Loading assets…"
            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
        <StackPanel
            Grid.Row="1"
            MaxWidth="380"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <TextBlock
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                TextAlignment="Center" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.Query.ClearAllCommand}"
                Content="{x:Bind ViewModel.Query.ClearQueryLabel, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ClearQueryVisibility, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.BrowseSourceCommand}"
                Content="Browse source content"
                Visibility="{x:Bind ViewModel.BrowseSourceVisibility, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
