<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentBrowser.Panes.Assets.Layouts.TilesLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:assets="using:Oxygen.Editor.ContentBrowser.Panes.Assets"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:identity="using:Oxygen.Editor.ContentBrowser.AssetIdentity"
    xmlns:localcvt="using:Oxygen.Editor.ContentBrowser.Panes.Assets.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Converters for icon glyphs and per-asset-type brushes  -->
        <localcvt:AssetTypeToIconConverter x:Key="AssetTypeToIconConverter" />
        <localcvt:AssetTypeToBrushConverter x:Key="AssetTypeToBrushConverter" />

        <!--  Tile template: card with icon area, colored separator line, and details area  -->
        <DataTemplate x:Key="GameAssetTemplate" x:DataType="identity:AssetBrowserRow">
            <Grid Width="180">
                <ToolTipService.ToolTip>
                    <ToolTip MaxWidth="432">
                        <assets:AssetInformationView ViewModel="{x:Bind Item.Information, Mode=OneWay}" />
                    </ToolTip>
                </ToolTipService.ToolTip>
                <Border CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140" />
                            <RowDefinition Height="2" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Top preview/icon area  -->
                        <Grid Grid.Row="0">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="48"
                                Glyph="{x:Bind Item.Kind, Mode=OneWay, Converter={StaticResource AssetTypeToIconConverter}}" />
                        </Grid>

                        <!--  Colored separator line per asset type  -->
                        <Border
                            Grid.Row="1"
                            Height="2"
                            Background="{x:Bind Item.Kind, Mode=OneWay, Converter={StaticResource AssetTypeToBrushConverter}}" />

                        <!--  Details  -->
                        <StackPanel Grid.Row="2" Padding="12,8,12,12">
                            <TextBlock
                                MaxLines="1"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Item.DisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <StackPanel
                                Margin="0,2,0,0"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    MaxLines="1"
                                    Opacity="0.8"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Item.PrimaryBadge, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind Item.PrimaryBadgeTooltip, Mode=OneWay}" />
                                <TextBlock
                                    MaxLines="1"
                                    Opacity="0.8"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Item.DerivedBadge, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind Item.DerivedBadge, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasBuiltinCatalogNotice, Mode=OneWay}"
            Message="{x:Bind ViewModel.BuiltinCatalogNotice, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RetryBuiltinCatalogCommand}" Content="Retry" />
            </InfoBar.ActionButton>
        </InfoBar>
        <GridView
            x:Name="BasicGridView"
            Grid.Row="1"
            DoubleTapped="GridView_DoubleTapped"
            IsItemClickEnabled="True"
            ItemTemplate="{StaticResource GameAssetTemplate}"
            ItemsSource="{x:Bind ViewModel.Assets}"
            PointerPressed="GridView_PointerPressed"
            SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=OneWay}"
            SelectionChanged="GridView_SelectionChanged"
            SelectionMode="Single">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="8" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>
        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Loading assets…"
            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
        <StackPanel
            Grid.Row="1"
            MaxWidth="380"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
            <TextBlock
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                TextAlignment="Center" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.Query.ClearAllCommand}"
                Content="{x:Bind ViewModel.Query.ClearQueryLabel, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ClearQueryVisibility, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.BrowseSourceCommand}"
                Content="Browse source content"
                Visibility="{x:Bind ViewModel.BrowseSourceVisibility, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
