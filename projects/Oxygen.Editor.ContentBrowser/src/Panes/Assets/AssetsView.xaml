<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentBrowser.AssetsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:browser="using:Oxygen.Editor.ContentBrowser"
    xmlns:controls="using:DroidNet.Routing.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.ContentBrowser"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <!--
        Command row: creation and pipeline menus keep their labels; asset commands are icons in Scene
        Explorer's order. When the row is narrow, path commands overflow first, then the asset commands,
        then Cook; New and Import stay visible longest. Everything also appears in the item context menu.
    -->
    <Border
        x:Name="ResultsRoot"
        Margin="0,0,4,4"
        Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <dnc:ToolBar Background="Transparent">
                    <dnc:ToolBarButton dnc:ToolBar.OverflowPriority="4" Label="New">
                        <dnc:ToolBarButton.Icon>
                            <SymbolIconSource Symbol="Add" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    AccessKey="D"
                                    AutomationProperties.AutomationId="InnerNavigationToolbarNewFolderButton"
                                    Command="{x:Bind ViewModel.CreateFolderCommand}"
                                    Text="Folder"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.CreateFolderToolTip, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    AccessKey="F"
                                    Command="{x:Bind ViewModel.CreateNewSceneWithPromptCommand}"
                                    Text="Scene">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    AccessKey="M"
                                    Click="OnCreateMaterialClicked"
                                    Text="Material">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </dnc:ToolBarButton.Flyout>
                    </dnc:ToolBarButton>

                    <dnc:ToolBarButton dnc:ToolBar.OverflowPriority="4" Label="Import">
                        <dnc:ToolBarButton.Icon>
                            <SymbolIconSource Symbol="Import" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ImportModelCommand}" Text="Source model…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF158;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ImportTextureCommand}" Text="Texture or image…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB9F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.ReimportSelectedSourceCommand}"
                                    Text="Reimport"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.ReimportToolTip, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Refresh" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.ShowImportSourceCommand}"
                                    Text="Show import source"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.ShowImportSourceToolTip, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="OpenFile" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </dnc:ToolBarButton.Flyout>
                    </dnc:ToolBarButton>

                    <dnc:ToolBarButton dnc:ToolBar.OverflowPriority="3" Label="Cook">
                        <dnc:ToolBarButton.Icon>
                            <SymbolIconSource Symbol="Sync" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.CookSelectedAssetCommand}"
                                    Text="Cook selected"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.CookSelectedToolTip, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.CookSelectedFolderCommand}"
                                    Text="Cook current folder"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.CookFolderToolTip, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.CookProjectCommand}"
                                    Text="Cook project"
                                    ToolTipService.ToolTip="Cook every authored asset in the project.">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8F1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.InspectCookedOutputCommand}"
                                    Text="Inspect published output"
                                    ToolTipService.ToolTip="Open the cooked output of the selection or folder, read-only.">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE721;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.ValidateCookedOutputCommand}"
                                    Text="Validate published output"
                                    ToolTipService.ToolTip="Check the cooked output of the selection or folder.">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem
                                    IsChecked="{x:Bind ViewModel.CookRuns.IsAutomaticCookingPaused, Mode=TwoWay}"
                                    Text="Pause automatic cooking"
                                    ToolTipService.ToolTip="Stop cooking after each Save until resumed." />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ShowCookingJobsCommand}" Text="Show cooking jobs">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE9D5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </dnc:ToolBarButton.Flyout>
                    </dnc:ToolBarButton>

                    <dnc:ToolBarSeparator />

                    <dnc:ToolBarButton
                        dnc:ToolBar.OverflowPriority="2"
                        Command="{x:Bind ViewModel.RenameSelectedCommand}"
                        Label="Rename"
                        ToolBarLabelPosition="Collapsed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RenameToolTip, Mode=OneWay}">
                        <dnc:ToolBarButton.Icon>
                            <SymbolIconSource Symbol="Rename" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F2" ScopeOwner="{x:Bind ResultsRoot}" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarButton
                        dnc:ToolBar.OverflowPriority="2"
                        Command="{x:Bind ViewModel.CutSelectedCommand}"
                        Label="Cut"
                        ToolBarLabelPosition="Collapsed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CutToolTip, Mode=OneWay}">
                        <dnc:ToolBarButton.Icon>
                            <SymbolIconSource Symbol="Cut" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="X"
                                Modifiers="Control"
                                ScopeOwner="{x:Bind ResultsRoot}" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarButton
                        dnc:ToolBar.OverflowPriority="2"
                        Command="{x:Bind ViewModel.CopySelectedCommand}"
                        Label="Copy"
                        ToolBarLabelPosition="Collapsed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CopyToolTip, Mode=OneWay}">
                        <dnc:ToolBarButton.Icon>
                            <SymbolIconSource Symbol="Copy" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="C"
                                Modifiers="Control"
                                ScopeOwner="{x:Bind ResultsRoot}" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarButton
                        dnc:ToolBar.OverflowPriority="2"
                        Command="{x:Bind ViewModel.PasteCommand}"
                        Label="Paste"
                        ToolBarLabelPosition="Collapsed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PasteToolTip, Mode=OneWay}">
                        <dnc:ToolBarButton.Icon>
                            <SymbolIconSource Symbol="Paste" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="V"
                                Modifiers="Control"
                                ScopeOwner="{x:Bind ResultsRoot}" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarButton
                        dnc:ToolBar.OverflowPriority="2"
                        Command="{x:Bind ViewModel.DuplicateSelectedCommand}"
                        Label="Duplicate"
                        ToolBarLabelPosition="Collapsed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DuplicateToolTip, Mode=OneWay}">
                        <dnc:ToolBarButton.Icon>
                            <FontIconSource Glyph="&#xF413;" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="D"
                                Modifiers="Control"
                                ScopeOwner="{x:Bind ResultsRoot}" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarButton
                        dnc:ToolBar.OverflowPriority="2"
                        Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                        Label="Delete"
                        ToolBarLabelPosition="Collapsed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.DeleteToolTip, Mode=OneWay}">
                        <dnc:ToolBarButton.Icon>
                            <SymbolIconSource Symbol="Delete" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind ResultsRoot}" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                    </dnc:ToolBarButton>

                    <dnc:ToolBarSeparator />

                    <dnc:ToolBarButton
                        dnc:ToolBar.OverflowPriority="1"
                        Command="{x:Bind ViewModel.CopyPathCommand}"
                        Label="Copy path"
                        ToolBarLabelPosition="Collapsed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CopyPathToolTip, Mode=OneWay}">
                        <dnc:ToolBarButton.Icon>
                            <FontIconSource Glyph="&#xE8C8;" />
                        </dnc:ToolBarButton.Icon>
                        <dnc:ToolBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator
                                Key="C"
                                Modifiers="Control,Shift"
                                ScopeOwner="{x:Bind ResultsRoot}" />
                        </dnc:ToolBarButton.KeyboardAccelerators>
                    </dnc:ToolBarButton>
                    <dnc:ToolBarButton
                        dnc:ToolBar.OverflowPriority="1"
                        Command="{x:Bind ViewModel.ShowInFileExplorerCommand}"
                        Label="Show in File Explorer"
                        ToolBarLabelPosition="Collapsed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ShowInFileExplorerToolTip, Mode=OneWay}">
                        <dnc:ToolBarButton.Icon>
                            <FontIconSource Glyph="&#xEC50;" />
                        </dnc:ToolBarButton.Icon>
                    </dnc:ToolBarButton>
                </dnc:ToolBar>

                <!--  Tile size applies to Tiles only.  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.Presentation.IsTilesView, Mode=OneWay}">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE91B;" />
                    <Slider
                        Width="96"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Tile size"
                        Maximum="{x:Bind browser:AssetBrowserPresentation.MaxTileSize}"
                        Minimum="{x:Bind browser:AssetBrowserPresentation.MinTileSize}"
                        StepFrequency="8"
                        ToolTipService.ToolTip="Tile size"
                        Value="{x:Bind ViewModel.Presentation.TileSize, Mode=TwoWay}" />
                </StackPanel>

                <DropDownButton
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Sort"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Sort results">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                        <TextBlock Text="{x:Bind ViewModel.Presentation.SortLabel, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.Presentation.OrderByCommand}"
                                CommandParameter="{x:Bind browser:AssetSortField.Name}"
                                GroupName="SortField"
                                IsChecked="{x:Bind local:AssetsView.IsSortField(ViewModel.Presentation.SortField, 'Name'), Mode=OneWay}"
                                Text="Name" />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.Presentation.OrderByCommand}"
                                CommandParameter="{x:Bind browser:AssetSortField.Type}"
                                GroupName="SortField"
                                IsChecked="{x:Bind local:AssetsView.IsSortField(ViewModel.Presentation.SortField, 'Type'), Mode=OneWay}"
                                Text="Type" />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.Presentation.OrderByCommand}"
                                CommandParameter="{x:Bind browser:AssetSortField.Status}"
                                GroupName="SortField"
                                IsChecked="{x:Bind local:AssetsView.IsSortField(ViewModel.Presentation.SortField, 'Status'), Mode=OneWay}"
                                Text="Status" />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.Presentation.OrderByCommand}"
                                CommandParameter="{x:Bind browser:AssetSortField.Location}"
                                GroupName="SortField"
                                IsChecked="{x:Bind local:AssetsView.IsSortField(ViewModel.Presentation.SortField, 'Location'), Mode=OneWay}"
                                Text="Location" />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.Presentation.OrderByCommand}"
                                CommandParameter="{x:Bind browser:AssetSortField.Size}"
                                GroupName="SortField"
                                IsChecked="{x:Bind local:AssetsView.IsSortField(ViewModel.Presentation.SortField, 'Size'), Mode=OneWay}"
                                Text="Size" />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.Presentation.OrderByCommand}"
                                CommandParameter="{x:Bind browser:AssetSortField.Modified}"
                                GroupName="SortField"
                                IsChecked="{x:Bind local:AssetsView.IsSortField(ViewModel.Presentation.SortField, 'Modified'), Mode=OneWay}"
                                Text="Modified" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.Presentation.OrderAscendingCommand}"
                                GroupName="SortDirection"
                                IsChecked="{x:Bind local:AssetsView.IsAscending(ViewModel.Presentation.SortDescending), Mode=OneWay}"
                                Text="Ascending" />
                            <RadioMenuFlyoutItem
                                Command="{x:Bind ViewModel.Presentation.OrderDescendingCommand}"
                                GroupName="SortDirection"
                                IsChecked="{x:Bind ViewModel.Presentation.SortDescending, Mode=OneWay}"
                                Text="Descending" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <muxc:InfoBar
                Title="{x:Bind ViewModel.OperationResultTitle, Mode=OneWay}"
                Grid.Row="1"
                Margin="8,0,8,8"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsOperationResultVisible, Mode=TwoWay}"
                Message="{x:Bind ViewModel.OperationResultMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.OperationResultSeverity, Mode=OneWay}">
                <muxc:InfoBar.ActionButton>
                    <Button
                        Command="{x:Bind ViewModel.UndoRelocationCommand}"
                        Content="Undo"
                        ToolTipService.ToolTip="Restore the previous names, locations and references."
                        Visibility="{x:Bind ViewModel.IsUndoAvailable, Mode=OneWay}" />
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>

            <!--  The context menu mirrors the toolbar for the right-clicked selection or the folder.  -->
            <Grid Grid.Row="2" Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.OpenSelectedCommand}"
                            KeyboardAcceleratorTextOverride="Enter"
                            Text="Open"
                            ToolTipService.ToolTip="{x:Bind ViewModel.OpenToolTip, Mode=OneWay}" />
                        <MenuFlyoutSubItem Text="New">
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.CreateFolderCommand}"
                                Text="Folder"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CreateFolderToolTip, Mode=OneWay}" />
                            <MenuFlyoutItem Command="{x:Bind ViewModel.CreateNewSceneWithPromptCommand}" Text="Scene" />
                            <MenuFlyoutItem Click="OnCreateMaterialClicked" Text="Material" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.RenameSelectedCommand}"
                            KeyboardAcceleratorTextOverride="F2"
                            Text="Rename"
                            ToolTipService.ToolTip="{x:Bind ViewModel.RenameToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Rename" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.CutSelectedCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+X"
                            Text="Cut"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CutToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Cut" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.CopySelectedCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+C"
                            Text="Copy"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CopyToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Copy" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.PasteCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+V"
                            Text="Paste"
                            ToolTipService.ToolTip="{x:Bind ViewModel.PasteToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Paste" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.DuplicateSelectedCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+D"
                            Text="Duplicate"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DuplicateToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xF413;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                            KeyboardAcceleratorTextOverride="Del"
                            Text="Delete"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DeleteToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.RenameOutputGroupCommand}"
                            Text="Rename output group…"
                            ToolTipService.ToolTip="{x:Bind ViewModel.RenameOutputGroupToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8F4;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.FindReferencesCommand}"
                            Text="Find references"
                            ToolTipService.ToolTip="{x:Bind ViewModel.FindReferencesToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE71B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.CopyPathCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                            Text="Copy path"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CopyPathToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.ShowInFileExplorerCommand}"
                            Text="Show in File Explorer"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ShowInFileExplorerToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC50;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.CookSelectedAssetCommand}"
                            Text="Cook selected"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CookSelectedToolTip, Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.ReimportSelectedSourceCommand}"
                            Text="Reimport"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ReimportToolTip, Mode=OneWay}" />
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.ShowImportSourceCommand}"
                            Text="Show import source"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ShowImportSourceToolTip, Mode=OneWay}" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <controls:RouterOutlet
                    Outlet="assets"
                    ViewModel="{x:Bind ViewModel.LayoutViewModel, Mode=OneWay}"
                    VmToViewConverter="{x:Bind ViewModel.VmToViewConverter}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
