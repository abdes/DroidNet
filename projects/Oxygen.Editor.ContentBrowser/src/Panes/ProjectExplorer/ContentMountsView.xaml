<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentBrowser.ProjectExplorer.ContentMountsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oxygen.Editor.ContentBrowser.ProjectExplorer">

    <UserControl.Resources>
        <Style x:Key="MountRowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <!--  The dialog is opened wide (MaxWidth 760); this width keeps every column readable inside it.  -->
    <StackPanel MinWidth="600" Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Mounts expose folders through stable virtual paths. Unmounting removes the registration, never the files."
            TextWrapping="Wrap" />

        <!--  Current mounts: virtual name, backing path, kind, rename and unmount.  -->
        <ItemsControl AutomationProperties.Name="Content mounts" ItemsSource="{x:Bind ViewModel.Mounts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ContentMountRow">
                    <Grid
                        Margin="0,0,0,4"
                        Padding="10,6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="12"
                        CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEDA2;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind IsNotRenaming, Mode=OneWay}" />
                            <TextBox
                                AutomationProperties.Name="Rename mount"
                                Text="{x:Bind NameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind IsRenaming, Mode=OneWay}" />
                            <TextBlock
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind Path}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Path}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind KindLabel}" />
                        <Button
                            Grid.Column="3"
                            AutomationProperties.Name="{x:Bind RenameToolTip, Mode=OneWay}"
                            Command="{x:Bind RenameCommand}"
                            Style="{StaticResource MountRowButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind RenameToolTip, Mode=OneWay}"
                            Visibility="{x:Bind HasActions}">
                            <Grid>
                                <FontIcon
                                    FontSize="14"
                                    Glyph="&#xE70F;"
                                    Visibility="{x:Bind IsNotRenaming, Mode=OneWay}" />
                                <FontIcon
                                    FontSize="14"
                                    Glyph="&#xE73E;"
                                    Visibility="{x:Bind IsRenaming, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            Grid.Column="4"
                            AutomationProperties.Name="{x:Bind UnmountToolTip, Mode=OneWay}"
                            Command="{x:Bind UnmountCommand}"
                            Style="{StaticResource MountRowButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind UnmountToolTip, Mode=OneWay}"
                            Visibility="{x:Bind HasActions}">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Add a mount: a known derived location, or any local folder with its virtual name.  -->
        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Add a mount" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                MinWidth="150"
                Header="Location"
                ItemsSource="{x:Bind ViewModel.Kinds}"
                SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}" />
            <TextBox
                Grid.Column="1"
                Header="Mount point name"
                PlaceholderText="Environment library"
                Text="{x:Bind ViewModel.NewMountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsLocalFolder, Mode=OneWay}" />
            <TextBox
                Grid.Column="2"
                Header="Folder path"
                PlaceholderText="D:/Studio/Assets"
                Text="{x:Bind ViewModel.NewMountPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind ViewModel.IsLocalFolder, Mode=OneWay}" />
            <Button
                Grid.Column="3"
                Width="32"
                Height="32"
                Padding="0"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Browse for a folder"
                Command="{x:Bind ViewModel.BrowseCommand}"
                ToolTipService.ToolTip="Browse for a folder"
                Visibility="{x:Bind ViewModel.IsLocalFolder, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xED25;" />
            </Button>
        </Grid>
        <InfoBar
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />
        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.AddMountCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
                <TextBlock Text="Add mount" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
