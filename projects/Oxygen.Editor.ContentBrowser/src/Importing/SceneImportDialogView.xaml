<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.ContentBrowser.Importing.SceneImportDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oxygen.Editor.ContentBrowser.Importing"
    x:DataType="local:SceneImportDialogViewModel">
    <StackPanel
        MinWidth="360"
        MaxWidth="520"
        Spacing="12">
        <TextBlock
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.SourceName, Mode=OneWay}"
            TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind ViewModel.SourcePath, Mode=OneWay}" />
        <TextBox
            AutomationProperties.AutomationId="ModelImportName"
            Header="Name"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                AutomationProperties.AutomationId="ModelImportDestination"
                Header="Destination"
                Text="{x:Bind ViewModel.DestinationFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.BrowseDestinationCommand}"
                Content="Browse" />
        </Grid>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.SourceLocation, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Cooking progress and messages appear in Cooking."
            TextWrapping="Wrap" />
        <InfoBar
            Title="{x:Bind ViewModel.ReplacementTitle, Mode=OneWay}"
            AutomationProperties.AutomationId="ModelImportCollision"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasCollision, Mode=OneWay}"
            Message="{x:Bind ViewModel.ReplacementMessage, Mode=OneWay}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="ModelImportReviewReplacement"
                    Command="{x:Bind ViewModel.ReviewReplacementCommand}"
                    Content="Review replacement"
                    Visibility="{x:Bind ViewModel.ReplacementChoiceVisibility, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>
        <TextBlock
            AutomationProperties.AutomationId="ModelImportError"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.Error, Mode=OneWay}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
