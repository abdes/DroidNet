<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0-windows10.0.26100.0</TargetFrameworks>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Oxygen.Editor.Runtime.Tests</RootNamespace>
        <AssemblyName>Oxygen.Editor.Runtime.Tests</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\src\Oxygen.Editor.Runtime.csproj" />
        <ProjectReference Include="..\..\Oxygen.Editor.ContentPipeline\src\Oxygen.Editor.ContentPipeline.csproj" />
        <ProjectReference Include="..\testhost\Oxygen.Editor.Runtime.ManagedBoundaryProbe.csproj" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="ErrorLog" />
        <PackageReference Include="Moq" />
        <Compile Include="..\..\Oxygen.Editor.Interop\test\NativeDllSearchPath.cs" Link="NativeDllSearchPath.cs" />
    </ItemGroup>
    <Target Name="CopyManagedBoundaryProbe" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <MSBuild Projects="..\testhost\Oxygen.Editor.Runtime.ManagedBoundaryProbe.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)" RemoveProperties="BuildingInsideVisualStudio;BuildingSolutionFile;CurrentSolutionConfigurationContents;ErrorLog" />
        <MSBuild Projects="..\testhost\Oxygen.Editor.Runtime.ManagedBoundaryProbe.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform);TargetFramework=$(TargetFramework)" RemoveProperties="BuildingInsideVisualStudio;BuildingSolutionFile;CurrentSolutionConfigurationContents;ErrorLog">
            <Output TaskParameter="TargetOutputs" ItemName="_ManagedBoundaryProbeAssembly" />
        </MSBuild>
        <PropertyGroup>
            <_ManagedBoundaryProbeDirectory>@(_ManagedBoundaryProbeAssembly->'%(RootDir)%(Directory)')</_ManagedBoundaryProbeDirectory>
        </PropertyGroup>
        <ItemGroup>
            <_ManagedBoundaryProbeFiles Include="$(_ManagedBoundaryProbeDirectory)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_ManagedBoundaryProbeFiles)" DestinationFiles="@(_ManagedBoundaryProbeFiles->'$(OutDir)ManagedBoundaryProbe\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
</Project>
