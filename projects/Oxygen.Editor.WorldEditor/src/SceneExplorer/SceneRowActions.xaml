<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.SceneExplorer.SceneRowActions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="ActionsControl"
    IsTabStop="False">
    <!--
        Two fixed slots that never collapse (interaction contract): column widths are constants, and
        visibility of the button content is switched without touching layout, so a neighbouring icon,
        the label or the row geometry cannot shift when a state changes or the pointer moves.
        Slot 0 = Show in Editor (eye), slot 1 = Lock. Passive by default; content is the only hit
        target and the grid itself does not intercept row input.
    -->
    <UserControl.Resources>
        <Style
            x:Key="RowSlotButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Slots" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <Button
            x:Name="EyeButton"
            Grid.Column="0"
            AutomationProperties.Name="Show in Editor"
            Command="{Binding CommandOwner.ToggleEditorHiddenCommand, ElementName=ActionsControl}"
            CommandParameter="{Binding}"
            Style="{StaticResource RowSlotButtonStyle}"
            ToolTipService.ToolTip="Show or hide in the editing viewports"
            Visibility="Collapsed">
            <FontIcon
                x:Name="EyeGlyph"
                FontFamily="Segoe Fluent Icons"
                FontSize="14"
                Glyph="{Binding EditorVisibilityGlyph}" />
        </Button>
        <Button
            x:Name="LockButton"
            Grid.Column="1"
            AutomationProperties.Name="Lock"
            Command="{Binding CommandOwner.ToggleEditorLockedCommand, ElementName=ActionsControl}"
            CommandParameter="{Binding}"
            Style="{StaticResource RowSlotButtonStyle}"
            ToolTipService.ToolTip="Lock or unlock for editing"
            Visibility="Collapsed">
            <FontIcon
                x:Name="LockGlyph"
                FontFamily="Segoe Fluent Icons"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Glyph="{Binding EditorLockGlyph}" />
        </Button>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="EyeStates">
                <VisualState x:Name="EyeQuiet" />
                <VisualState x:Name="EyeAffordance">
                    <VisualState.Setters>
                        <Setter Target="EyeButton.Visibility" Value="Visible" />
                        <Setter Target="EyeButton.Opacity" Value="0.6" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="EyePinned">
                    <VisualState.Setters>
                        <Setter Target="EyeButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="LockStates">
                <VisualState x:Name="LockQuiet" />
                <VisualState x:Name="LockAffordance">
                    <VisualState.Setters>
                        <Setter Target="LockButton.Visibility" Value="Visible" />
                        <Setter Target="LockButton.Opacity" Value="0.6" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LockPinned">
                    <VisualState.Setters>
                        <Setter Target="LockButton.Visibility" Value="Visible" />
                        <Setter Target="LockGlyph.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="InputStates">
                <VisualState x:Name="Passive" />
                <VisualState x:Name="Interactive">
                    <VisualState.Setters>
                        <Setter Target="EyeButton.IsHitTestVisible" Value="True" />
                        <Setter Target="EyeButton.IsTabStop" Value="True" />
                        <Setter Target="LockButton.IsHitTestVisible" Value="True" />
                        <Setter Target="LockButton.IsTabStop" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
