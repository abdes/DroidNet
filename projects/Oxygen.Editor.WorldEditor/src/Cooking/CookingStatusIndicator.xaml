<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Cooking.CookingStatusIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid>
        <FontIcon
            x:Name="StatusIcon"
            FontFamily="{ThemeResource SymbolThemeFontFamily}"
            FontSize="14" />
        <Border
            x:Name="StatusPill"
            Padding="8,2"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <TextBlock x:Name="StatusLabel" FontSize="12" />
        </Border>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeverityStates">
                <VisualState x:Name="Neutral">
                    <VisualState.Setters>
                        <Setter Target="StatusIcon.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Setter Target="StatusPill.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Critical">
                    <VisualState.Setters>
                        <Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="StatusPill.Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Caution">
                    <VisualState.Setters>
                        <Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="StatusPill.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="StatusPill.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
