<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Cooking.CookingPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:console="using:DroidNet.Controls.OutputConsole"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.World.Cooking"
    xmlns:snapshots="using:Oxygen.Editor.ContentPipeline.Snapshots"
    x:Name="Root"
    Background="{ThemeResource LayerFillColorDefaultBrush}">
    <UserControl.Resources>
        <Thickness x:Key="ExpanderHeaderPadding">10,0,10,0</Thickness>
        <Style x:Key="CookSection" TargetType="Expander">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CookListItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="CookAssetItem"
            BasedOn="{StaticResource CookListItem}"
            TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <DataTemplate x:Key="CookRunTemplate" x:DataType="local:CookingRunViewModel">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:CookingStatusIndicator
                    Margin="0,4,0,0"
                    VerticalAlignment="Top"
                    State="{x:Bind Snapshot.State, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Name}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Context}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CookAssetTemplate" x:DataType="local:CookingAssetViewModel">
            <Grid AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:CookingStatusIndicator
                    Caption="{x:Bind Status, Mode=OneWay}"
                    Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                    IsReused="{x:Bind IsReused, Mode=OneWay}"
                    State="{x:Bind IndicatorState, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    MaxWidth="220"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Name}" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Kind}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CookIssueTemplate" x:DataType="local:CookingIssueViewModel">
            <InfoBar
                Margin="0,2"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Message}"
                Severity="{x:Bind Severity}">
                <InfoBar.ActionButton>
                    <HyperlinkButton
                        Click="GoToPropertyClicked"
                        Content="{x:Bind ActionLabel}"
                        Visibility="{x:Bind ActionVisibility}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </DataTemplate>
        <DataTemplate x:Key="CookIssueGroupTemplate" x:DataType="local:CookingIssueGroup">
            <Expander
                Margin="0,0,0,6"
                Header="{x:Bind Header, Mode=OneWay}"
                IsExpanded="True"
                Style="{StaticResource CookSection}">
                <ItemsControl ItemTemplate="{StaticResource CookIssueTemplate}" ItemsSource="{x:Bind Issues}" />
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="UnsavedCookDocumentTemplate" x:DataType="snapshots:CookDocumentState">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind DisplayName}"
                    TextTrimming="CharacterEllipsis" />
                <HyperlinkButton
                    Grid.Column="1"
                    Padding="4,2"
                    Click="OpenDocumentClicked"
                    Content="Open" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="SplitRoot" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="RunColumn"
                Width="220"
                MinWidth="150" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="RunSidebar" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <dnc:ToolBar
                x:Name="RunListToolbar"
                AutomationProperties.Name="Cooking list options"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsCompact="True">
                <dnc:ToolBarToggleButton
                    x:Name="ShowAllButton"
                    AutomationProperties.Name="Show all cooks"
                    IsChecked="{x:Bind ViewModel.ShowAll, Mode=TwoWay}"
                    Label="Show all"
                    ToolTipService.ToolTip="Include successful automatic cooks">
                    <dnc:ToolBarToggleButton.Icon>
                        <SymbolIconSource Symbol="AllApps" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
            </dnc:ToolBar>
            <ComboBox
                x:Name="NarrowRunPicker"
                Grid.Row="1"
                Margin="8,0"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Selected cooking operation"
                ItemTemplate="{StaticResource CookRunTemplate}"
                ItemsSource="{x:Bind ViewModel.Runs}"
                PlaceholderText="Select a cook"
                SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}"
                Visibility="Collapsed" />
            <ListView
                x:Name="RunList"
                Grid.Row="2"
                AutomationProperties.Name="Cooking operations"
                ItemContainerStyle="{StaticResource CookListItem}"
                ItemTemplate="{StaticResource CookRunTemplate}"
                ItemsSource="{x:Bind ViewModel.Runs}"
                SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}"
                SelectionMode="Single" />
        </Grid>
        <ctk:GridSplitter
            x:Name="RunSplitter"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />
        <TextBlock
            x:Name="EmptyMessage"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No cooks yet"
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        <Grid
            x:Name="RunDetails"
            Grid.RowSpan="2"
            Grid.Column="2"
            Padding="8,4,8,6"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="RunHeader"
                ColumnSpacing="8"
                SizeChanged="OnHeaderSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="RunTitle"
                    MaxWidth="320"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.SelectedRun.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SelectedRun.Title, Mode=OneWay}" />
                <local:CookingStatusIndicator
                    x:Name="RunStatus"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    ShowLabel="True"
                    State="{x:Bind ViewModel.SelectedRun.Snapshot.State, Mode=OneWay}" />
                <Button
                    x:Name="RetryButton"
                    Grid.Column="2"
                    MinHeight="28"
                    Padding="8,3"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="Retry"
                    Visibility="{x:Bind ViewModel.SelectedRun.RetryVisibility, Mode=OneWay}" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="3"
                    MinHeight="28"
                    Padding="8,3"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Content="Cancel"
                    IsEnabled="{x:Bind ViewModel.SelectedRun.CanCancel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.SelectedRun.CancelVisibility, Mode=OneWay}" />
            </Grid>
            <ProgressBar
                Grid.Row="1"
                MinHeight="2"
                IsIndeterminate="{x:Bind ViewModel.SelectedRun.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.SelectedRun.ProgressVisibility, Mode=OneWay}" />
            <ScrollViewer
                x:Name="DetailsScroller"
                Grid.Row="2"
                AutomationProperties.Name="Cook details"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                IsVerticalScrollChainingEnabled="True"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="0,0,6,4" Spacing="6">
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.ActionError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ActionErrorVisibility, Mode=OneWay}" />
                    <ItemsControl
                        x:Name="IssueGroups"
                        ItemTemplate="{StaticResource CookIssueGroupTemplate}"
                        ItemsSource="{x:Bind ViewModel.SelectedRun.IssueGroups, Mode=OneWay}" />
                    <InfoBar
                        Title="Unsaved documents"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.SelectedRun.NeedsSave, Mode=OneWay}"
                        Severity="Warning">
                        <StackPanel Spacing="4">
                            <ItemsControl ItemTemplate="{StaticResource UnsavedCookDocumentTemplate}" ItemsSource="{x:Bind ViewModel.SelectedRun.UnsavedDocuments, Mode=OneWay}" />
                            <Button
                                MinHeight="28"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Command="{x:Bind ViewModel.SaveListedAndCookCommand}"
                                Content="Save listed &amp; Cook" />
                        </StackPanel>
                    </InfoBar>
                    <Expander
                        x:Name="OutputSection"
                        Header="Output"
                        IsExpanded="{x:Bind ViewModel.SelectedRun.IsOutputExpanded, Mode=TwoWay}"
                        Style="{StaticResource CookSection}">
                        <console:OutputConsoleView
                            x:Name="CookOutput"
                            MinHeight="160"
                            AutomationProperties.Name="Selected cook messages"
                            FollowTail="{x:Bind ViewModel.SelectedRun.FollowTail, Mode=TwoWay}"
                            IsScrollEnabled="False"
                            ItemsSource="{x:Bind ViewModel.SelectedRun.Output, Mode=OneWay}"
                            ToolbarVisibility="Collapsed"
                            WordWrap="True" />
                    </Expander>
                    <Expander
                        x:Name="AssetsSection"
                        Header="Assets"
                        IsExpanded="{x:Bind ViewModel.SelectedRun.IsAssetsExpanded, Mode=TwoWay}"
                        Style="{StaticResource CookSection}">
                        <ListView
                            x:Name="CookAssets"
                            MinHeight="120"
                            AutomationProperties.Name="Assets in the selected cook"
                            ItemContainerStyle="{StaticResource CookAssetItem}"
                            ItemTemplate="{StaticResource CookAssetTemplate}"
                            ItemsSource="{x:Bind ViewModel.SelectedRun.Assets, Mode=OneWay}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
