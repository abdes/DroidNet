<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.Environment.ExposureCompensationCurveEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:local="using:Oxygen.Editor.World.Inspector">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.WorldEditor/Inspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="6">
        <Polyline
            Height="36"
            HorizontalAlignment="Stretch"
            Points="{x:Bind local:InspectorCurvePresentation.CreatePoints(ViewModel.Curve), Mode=OneWay}"
            Stretch="Fill"
            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
            StrokeThickness="2" />
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Metered EV100" />
            <TextBlock Grid.Column="1" Text="Compensation EV" />
        </Grid>
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Keys, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <editorcontrols:PropertyItemsLayout Spacing="4" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:ExposureCompensationKeyViewModel">
                    <Grid ColumnSpacing="6" DataContext="{x:Bind}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <controls:NumberBox
                            AutomationProperties.Name="Metered EV100"
                            EditSessionCompleted="OnEditCompleted"
                            EditSessionStarted="OnEditStarted"
                            LabelPosition="None"
                            Mask="~.###"
                            NumberValue="{x:Bind MeteredEv, Mode=TwoWay}"
                            Tag="MeteredEv"
                            Validate="OnKeyValidate" />
                        <controls:NumberBox
                            Grid.Column="1"
                            AutomationProperties.Name="Compensation EV"
                            EditSessionCompleted="OnEditCompleted"
                            EditSessionStarted="OnEditStarted"
                            LabelPosition="None"
                            Mask="~.###"
                            NumberValue="{x:Bind CompensationEv, Mode=TwoWay}"
                            Tag="CompensationEv"
                            Validate="OnKeyValidate" />
                        <Button
                            Grid.Column="2"
                            Padding="0"
                            Click="OnRemoveKey"
                            ToolTipService.ToolTip="Remove curve key">
                            <FontIcon Glyph="&#xE738;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <Button
            HorizontalAlignment="Left"
            Command="{x:Bind ViewModel.AddKeyCommand}"
            Content="Add key" />
        <TextBlock
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.Diagnostic.Message, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Diagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
    </StackPanel>
</UserControl>
