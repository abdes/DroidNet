<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.Environment.BackgroundSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:fields="using:Oxygen.Editor.World.Inspector.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.WorldEditor/Inspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource QuietInspectorAction}" TargetType="Button" />
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        x:Name="BackgroundSection"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Description="Fallback color when atmosphere rendering is disabled."
        Header="Background"
        HeaderIcon="{ui:FontIcon Glyph='&#xE790;'}"
        IsExpanded="True"
        Tag="Environment">
        <editorcontrols:PropertiesExpander.HeaderActions>
            <Button
                x:Name="ResetBackgroundButton"
                AutomationProperties.Name="Reset Background"
                Click="ResetBackground_Click"
                IsEnabled="{x:Bind ViewModel.EditOwner.IsInputEnabled, Mode=OneWay}"
                ToolTipService.ToolTip="Reset background color">
                <FontIcon FontSize="14" Glyph="&#xE777;" />
            </Button>
        </editorcontrols:PropertiesExpander.HeaderActions>
        <editorcontrols:PropertiesExpander.Items>
            <fields:InspectorRgbField
                x:Name="BackgroundColorCard"
                Blue="{x:Bind ViewModel.BackgroundB, Mode=TwoWay}"
                ChannelAutomationName="Color, linear RGB"
                ColorPicked="OnRgbColorPicked"
                EditOwner="{x:Bind ViewModel.EditOwner, Mode=OneWay}"
                EditSessionCompleted="VectorEditCompleted"
                EditSessionStarted="VectorEditStarted"
                ErrorText="{x:Bind ViewModel.BackgroundRDiagnostic.Message, Mode=OneWay}"
                FontSize="14"
                Green="{x:Bind ViewModel.BackgroundG, Mode=TwoWay}"
                HasError="{x:Bind ViewModel.BackgroundRDiagnostic.HasError, Mode=OneWay}"
                Label="Color"
                PickerAutomationName="Pick background color"
                Qualifier="Linear RGB"
                Red="{x:Bind ViewModel.BackgroundR, Mode=TwoWay}"
                Tag="BackgroundColor" />
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
