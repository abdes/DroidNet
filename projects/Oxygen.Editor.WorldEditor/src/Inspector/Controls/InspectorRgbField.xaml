<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.Controls.InspectorRgbField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.WorldEditor/Inspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SwatchBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertyCard
        x:Name="Card"
        HorizontalContentAlignment="Stretch"
        EditorMinimumWidth="248"
        FontSize="{x:Bind FontSize, Mode=OneWay}"
        IsCompound="True"
        Layout="Stacked"
        PropertyName="{x:Bind Label, Mode=OneWay}"
        Qualifier="{x:Bind Qualifier, Mode=OneWay}">
        <StackPanel Spacing="{x:Bind DiagnosticSpacing, Mode=OneWay}">
            <controls:VectorBox
                x:Name="Channels"
                Padding="0"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind ChannelAutomationName, Mode=OneWay}"
                ComponentLabelPosition="Left"
                ComponentMask="{x:Bind ComponentMask, Mode=OneWay}"
                Dimension="3"
                EditSessionCompleted="OnVectorEditCompleted"
                EditSessionStarted="OnVectorEditStarted"
                HorizontalValueAlignment="Right"
                LabelPosition="None"
                Tag="{Binding Tag, ElementName=Root}"
                XIsIndeterminate="{x:Bind RedIsMixed, Mode=OneWay}"
                XValue="{x:Bind Red, Mode=TwoWay}"
                YIsIndeterminate="{x:Bind GreenIsMixed, Mode=OneWay}"
                YValue="{x:Bind Green, Mode=TwoWay}"
                ZIsIndeterminate="{x:Bind BlueIsMixed, Mode=OneWay}"
                ZValue="{x:Bind Blue, Mode=TwoWay}" />
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ErrorText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
        </StackPanel>
    </editorcontrols:PropertyCard>
</UserControl>
