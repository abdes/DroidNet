<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.Scripting.ScriptingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:ctkcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:local="using:Oxygen.Editor.World.Inspector.Scripting"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.WorldEditor/Inspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ctkcvt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <ctkcvt:BoolToVisibilityConverter
                x:Key="InverseBoolToVisibility"
                FalseValue="Visible"
                TrueValue="Collapsed" />

            <Style x:Key="ScriptFieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ScriptIconButton" TargetType="Button">
                <Setter Property="Padding" Value="6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!--  Every field: override marker, label, editor, reset.  -->
            <DataTemplate x:Key="ToggleField" x:DataType="local:ScriptParameterFieldViewModel">
                <Grid
                    Padding="0,2"
                    ColumnSpacing="6"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ScriptFieldLabel}"
                        Text="{x:Bind Label}" />
                    <ToggleSwitch
                        Grid.Column="2"
                        AutomationProperties.Name="{x:Bind Label}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        IsOn="{x:Bind BoolValue, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Reset to default"
                        Command="{x:Bind ResetCommand}"
                        Content="{ui:FontIcon Glyph='&#xE777;',
                                              FontSize=12}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource ScriptIconButton}"
                        ToolTipService.ToolTip="Reset to default"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NumberField" x:DataType="local:ScriptParameterFieldViewModel">
                <Grid
                    Padding="0,2"
                    ColumnSpacing="6"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <controls:NumberBox
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Bind Label}"
                        EditSessionCompleted="OnFieldNumberCompleted"
                        EditSessionStarted="OnFieldNumberStarted"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Label="{x:Bind Label}"
                        LabelPosition="Left"
                        LabelSpacing="6"
                        LabelWidth="120"
                        Mask="{x:Bind NumberMask}"
                        NumberValue="{x:Bind NumberValue, Mode=TwoWay}"
                        Style="{StaticResource SceneNumberBoxStyle}"
                        Unit="{x:Bind Unit}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Reset to default"
                        Command="{x:Bind ResetCommand}"
                        Content="{ui:FontIcon Glyph='&#xE777;',
                                              FontSize=12}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource ScriptIconButton}"
                        ToolTipService.ToolTip="Reset to default"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ChoiceField" x:DataType="local:ScriptParameterFieldViewModel">
                <Grid
                    Padding="0,2"
                    ColumnSpacing="6"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ScriptFieldLabel}"
                        Text="{x:Bind Label}" />
                    <ComboBox
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind Label}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        ItemsSource="{x:Bind Options}"
                        SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}" />
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Reset to default"
                        Command="{x:Bind ResetCommand}"
                        Content="{ui:FontIcon Glyph='&#xE777;',
                                              FontSize=12}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource ScriptIconButton}"
                        ToolTipService.ToolTip="Reset to default"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="TextField" x:DataType="local:ScriptParameterFieldViewModel">
                <Grid
                    Padding="0,2"
                    ColumnSpacing="6"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ScriptFieldLabel}"
                        Text="{x:Bind Label}" />
                    <TextBox
                        Grid.Column="2"
                        AutomationProperties.Name="{x:Bind Label}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        MaxLength="59"
                        Text="{x:Bind TextValue, Mode=TwoWay}" />
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Reset to default"
                        Command="{x:Bind ResetCommand}"
                        Content="{ui:FontIcon Glyph='&#xE777;',
                                              FontSize=12}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource ScriptIconButton}"
                        ToolTipService.ToolTip="Reset to default"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ErrorText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="VectorField" x:DataType="local:ScriptParameterFieldViewModel">
                <Grid
                    Padding="0,2"
                    ColumnSpacing="6"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ScriptFieldLabel}"
                        Text="{x:Bind Label}" />
                    <controls:VectorBox
                        Grid.Column="2"
                        Padding="0"
                        AutomationProperties.Name="{x:Bind Label}"
                        CompactComponentLabels="True"
                        ComponentLabelPosition="Left"
                        ComponentMask="{x:Bind NumberMask}"
                        Dimension="{x:Bind Dimension}"
                        EditSessionCompleted="OnVectorCompleted"
                        EditSessionStarted="OnVectorStarted"
                        HorizontalValueAlignment="Right"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        LabelPosition="None"
                        WValue="{x:Bind W, Mode=TwoWay}"
                        XValue="{x:Bind X, Mode=TwoWay}"
                        YValue="{x:Bind Y, Mode=TwoWay}"
                        ZValue="{x:Bind Z, Mode=TwoWay}" />
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Reset to default"
                        Command="{x:Bind ResetCommand}"
                        Content="{ui:FontIcon Glyph='&#xE777;',
                                              FontSize=12}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource ScriptIconButton}"
                        ToolTipService.ToolTip="Reset to default"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ColorField" x:DataType="local:ScriptParameterFieldViewModel">
                <Grid
                    Padding="0,2"
                    ColumnSpacing="6"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ScriptFieldLabel}"
                        Text="{x:Bind Label}" />
                    <!--  Script colors are linear, like every color the engine reads.  -->
                    <controls:ColorBox
                        Grid.Column="2"
                        Alpha="{x:Bind W, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Bind Label}"
                        Blue="{x:Bind Z, Mode=TwoWay}"
                        EditSessionCompleted="OnColorCompleted"
                        EditSessionStarted="OnColorStarted"
                        Encoding="Linear"
                        Green="{x:Bind Y, Mode=TwoWay}"
                        HasAlpha="{x:Bind HasAlpha}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        PickerAutomationName="Pick a color"
                        Red="{x:Bind X, Mode=TwoWay}" />
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Reset to default"
                        Command="{x:Bind ResetCommand}"
                        Content="{ui:FontIcon Glyph='&#xE777;',
                                              FontSize=12}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource ScriptIconButton}"
                        ToolTipService.ToolTip="Reset to default"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AssetField" x:DataType="local:ScriptParameterFieldViewModel">
                <Grid
                    Padding="0,2"
                    ColumnSpacing="6"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ScriptFieldLabel}"
                        Text="{x:Bind Label}" />
                    <ComboBox
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind Label}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        ItemsSource="{x:Bind AssetChoices}"
                        PlaceholderText="None"
                        SelectedItem="{x:Bind SelectedAsset, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ScriptAssetChoice">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Path}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Clear"
                        Command="{x:Bind ResetCommand}"
                        Content="{ui:FontIcon Glyph='&#xE711;',
                                              FontSize=12}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource ScriptIconButton}"
                        ToolTipService.ToolTip="Clear"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ReferenceText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind IsReferenceMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NodeField" x:DataType="local:ScriptParameterFieldViewModel">
                <Grid
                    Padding="0,2"
                    ColumnSpacing="6"
                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Rectangle
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind ShowsOverrideMarker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <Rectangle
                        Fill="{ThemeResource SystemFillColorCriticalBrush}"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="{x:Bind IsReferenceMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ScriptFieldLabel}"
                        Text="{x:Bind Label}" />
                    <DropDownButton
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AllowDrop="True"
                        AutomationProperties.Name="{x:Bind Label}"
                        DragOver="OnNodeDragOver"
                        Drop="OnNodeDrop"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        ToolTipService.ToolTip="Pick a node, or drag one here from the Scene Explorer">
                        <TextBlock Text="{x:Bind ReferenceText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <DropDownButton.Flyout>
                            <Flyout Opening="OnNodeFlyoutOpening" Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="280" Spacing="6">
                                    <TextBox
                                        AutomationProperties.Name="Search nodes"
                                        PlaceholderText="Search nodes"
                                        Text="{x:Bind NodeQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ListView
                                        MaxHeight="280"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnNodeChosen"
                                        ItemsSource="{x:Bind NodeChoices}"
                                        SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:ScriptNodeChoice">
                                                <StackPanel Padding="0,2">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Path}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Clear"
                        Command="{x:Bind ResetCommand}"
                        Content="{ui:FontIcon Glyph='&#xE711;',
                                              FontSize=12}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource ScriptIconButton}"
                        ToolTipService.ToolTip="Clear"
                        Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ErrorText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <local:ScriptFieldTemplateSelector
                x:Key="FieldTemplates"
                Asset="{StaticResource AssetField}"
                Choice="{StaticResource ChoiceField}"
                Node="{StaticResource NodeField}"
                Number="{StaticResource NumberField}"
                Text="{StaticResource TextField}"
                Toggle="{StaticResource ToggleField}"
                Vector="{StaticResource VectorField}"
                Color="{StaticResource ColorField}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <editorcontrols:PropertiesExpander
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE943;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}"
        Tag="Scripting;Scripts;Script slots;Parameters;Execution order">
        <editorcontrols:PropertiesExpander.Items>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SelectionMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasSelectionMessage, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No scripts yet. Add a slot and pick a script for it."
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoSlots, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Slots}" Visibility="{x:Bind ViewModel.ShowsSlots, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ScriptSlotCardViewModel">
                        <Border
                            Padding="10"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="6">
                                <!--  Header: script name, problems badge, order and removal.  -->
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <HyperlinkButton
                                        Grid.Column="1"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Show problems"
                                        Command="{x:Bind OpenProblemCommand}"
                                        ToolTipService.ToolTip="{x:Bind BadgeToolTip, Mode=OneWay}"
                                        Visibility="{x:Bind HasBadge, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Glyph="&#xEA39;"
                                                Visibility="{x:Bind BadgeIsError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE7BA;"
                                                Visibility="{x:Bind BadgeIsError, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBlock FontSize="12" Text="{x:Bind BadgeText, Mode=OneWay}" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Move up"
                                        Command="{x:Bind MoveUpCommand}"
                                        Content="{ui:FontIcon Glyph='&#xE70E;',
                                                              FontSize=12}"
                                        IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                        Style="{StaticResource ScriptIconButton}"
                                        ToolTipService.ToolTip="Move up" />
                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="Move down"
                                        Command="{x:Bind MoveDownCommand}"
                                        Content="{ui:FontIcon Glyph='&#xE70D;',
                                                              FontSize=12}"
                                        IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                        Style="{StaticResource ScriptIconButton}"
                                        ToolTipService.ToolTip="Move down" />
                                    <Button
                                        Grid.Column="4"
                                        AutomationProperties.Name="Remove slot"
                                        Command="{x:Bind RemoveCommand}"
                                        Content="{ui:FontIcon Glyph='&#xE74D;',
                                                              FontSize=12}"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                        Style="{StaticResource ScriptIconButton}"
                                        ToolTipService.ToolTip="Remove slot" />
                                </Grid>

                                <!--  Script: picker, New Script and Edit.  -->
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="123" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ScriptFieldLabel}" Text="Script" />
                                    <ComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Script"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                        ItemsSource="{x:Bind ScriptChoices}"
                                        PlaceholderText="Pick a script"
                                        SelectedItem="{x:Bind SelectedScript, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:ScriptAssetChoice">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Path}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="New Script"
                                        Command="{x:Bind NewScriptCommand}"
                                        Content="{ui:FontIcon Glyph='&#xE710;',
                                                              FontSize=12}"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                        Style="{StaticResource ScriptIconButton}"
                                        ToolTipService.ToolTip="New Script" />
                                    <Border
                                        Grid.Column="3"
                                        Background="Transparent"
                                        ToolTipService.ToolTip="{x:Bind EditToolTip, Mode=OneWay}">
                                        <Button
                                            AutomationProperties.HelpText="{x:Bind EditToolTip, Mode=OneWay}"
                                            AutomationProperties.Name="Edit script"
                                            Command="{x:Bind EditScriptCommand}"
                                            Content="{ui:FontIcon Glyph='&#xE70F;',
                                                                  FontSize=12}"
                                            IsEnabled="{x:Bind CanEditScript, Mode=OneWay}"
                                            Style="{StaticResource ScriptIconButton}" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind MissingScriptText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind IsScriptMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                <controls:NumberBox
                                    AutomationProperties.Name="Execution order"
                                    EditSessionCompleted="OnOrderCompleted"
                                    EditSessionStarted="OnOrderStarted"
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                    Label="Execution order"
                                    LabelPosition="Left"
                                    LabelSpacing="6"
                                    LabelWidth="123"
                                    Mask="~."
                                    NumberValue="{x:Bind ExecutionOrder, Mode=TwoWay}"
                                    Style="{StaticResource SceneNumberBoxStyle}"
                                    ToolTipService.ToolTip="Scripts with a lower order run earlier, across all nodes." />

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Notice, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemTemplateSelector="{StaticResource FieldTemplates}" ItemsSource="{x:Bind Fields}" />

                                <Border
                                    Padding="8"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="4"
                                    Visibility="{x:Bind HasStaleValues, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE7BA;" />
                                            <TextBlock FontWeight="SemiBold" Text="Not declared by the script" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="The cook fails until these values are removed."
                                            TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{x:Bind StaleValues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ScriptStaleValueViewModel">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="111" />
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Style="{StaticResource ScriptFieldLabel}"
                                                            Text="{x:Bind Name}"
                                                            ToolTipService.ToolTip="{x:Bind Name}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource ScriptFieldLabel}"
                                                            Text="{x:Bind TypeText}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Style="{StaticResource ScriptFieldLabel}"
                                                            Text="{x:Bind ValueText}"
                                                            ToolTipService.ToolTip="{x:Bind ValueText}" />
                                                        <Button
                                                            Grid.Column="3"
                                                            AutomationProperties.Name="Remove value"
                                                            Command="{x:Bind RemoveCommand}"
                                                            Content="{ui:FontIcon Glyph='&#xE711;',
                                                                                  FontSize=12}"
                                                            IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                            Style="{StaticResource ScriptIconButton}"
                                                            ToolTipService.ToolTip="Remove value" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button
                                            HorizontalAlignment="Right"
                                            Command="{x:Bind RemoveStaleCommand}"
                                            Content="Remove all"
                                            IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                            Visibility="{x:Bind CanRemoveAllStale, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.AddSlotCommand}"
                IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowsSlots, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="Add script slot" />
                </StackPanel>
            </Button>
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
