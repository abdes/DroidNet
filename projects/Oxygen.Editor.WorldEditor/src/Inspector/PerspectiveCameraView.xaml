<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.PerspectiveCameraView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <editorcontrols:PropertiesExpander
        Padding="2"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE714;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <editorcontrols:PropertyCard HorizontalContentAlignment="Stretch" PropertyName="Projection">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <controls:NumberBox
                            EditSessionCompleted="NumberEditCompleted"
                            EditSessionStarted="NumberEditStarted"
                            Label="FOV"
                            LabelPosition="Left"
                            Mask="~.###"
                            NumberValue="{x:Bind ViewModel.FieldOfView, Mode=TwoWay}"
                            Tag="FieldOfView" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.FieldOfViewDiagnostic.Message, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.FieldOfViewDiagnostic.Visibility, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <controls:NumberBox
                            EditSessionCompleted="NumberEditCompleted"
                            EditSessionStarted="NumberEditStarted"
                            Label="Aspect"
                            LabelPosition="Left"
                            Mask="~.###"
                            NumberValue="{x:Bind ViewModel.AspectRatio, Mode=TwoWay}"
                            Tag="AspectRatio" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.AspectRatioDiagnostic.Message, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.AspectRatioDiagnostic.Visibility, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard HorizontalContentAlignment="Stretch" PropertyName="Clipping">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <controls:NumberBox
                            EditSessionCompleted="NumberEditCompleted"
                            EditSessionStarted="NumberEditStarted"
                            Label="Near"
                            LabelPosition="Left"
                            Mask="~.###"
                            NumberValue="{x:Bind ViewModel.NearPlane, Mode=TwoWay}"
                            Tag="NearPlane" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.NearPlaneDiagnostic.Message, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.NearPlaneDiagnostic.Visibility, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <controls:NumberBox
                            EditSessionCompleted="NumberEditCompleted"
                            EditSessionStarted="NumberEditStarted"
                            Label="Far"
                            LabelPosition="Left"
                            Mask="~.###"
                            NumberValue="{x:Bind ViewModel.FarPlane, Mode=TwoWay}"
                            Tag="FarPlane" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.FarPlaneDiagnostic.Message, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.FarPlaneDiagnostic.Visibility, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </editorcontrols:PropertyCard>
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
