                                    Visibility="{x:Bind ViewModel.ContrastDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard HorizontalContentAlignment="Stretch" PropertyName="Vignette">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.VignetteIntensity, Mode=TwoWay}"
                                    Tag="VignetteIntensity" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.VignetteIntensityDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.VignetteIntensityDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                    </editorcontrols:PropertiesExpander.Items>
                </editorcontrols:PropertiesExpander>
                <editorcontrols:PropertiesExpander
                    x:Name="BackgroundSection"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Description="Fallback color when atmosphere rendering is disabled."
                    Header="Background"
                    HeaderIcon="{ui:FontIcon Glyph='&#xE790;'}"
                    IsExpanded="True"
                    Tag="Environment">
                    <editorcontrols:PropertiesExpander.HeaderActions>
                        <Button
                            x:Name="ResetBackgroundButton"
                            AutomationProperties.Name="Reset Background"
                            Click="ResetBackground_Click"
                            IsEnabled="{x:Bind ViewModel.IsInputEnabled, Mode=OneWay}"
                            ToolTipService.ToolTip="Reset background color">
                            <FontIcon FontSize="14" Glyph="&#xE777;" />
                        </Button>
                    </editorcontrols:PropertiesExpander.HeaderActions>
                    <editorcontrols:PropertiesExpander.Items>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            EditorMinimumWidth="248"
                            IsCompound="True"
                            Layout="Stacked"
                            PropertyName="Color"
                            Qualifier="Linear RGB">
                            <editorcontrols:PropertyCard.LeadingContent>
                                <Button
                                    x:Name="BackgroundSwatch"
                                    AutomationProperties.Name="Pick background color"
                                    Style="{StaticResource InspectorColorSwatchStyle}"
                                    ToolTipService.ToolTip="Pick background color">
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker
                                                ColorChanged="BackgroundPicker_ColorChanged"
                                                IsAlphaEnabled="False"
                                                IsColorChannelTextInputVisible="True"
                                                IsHexInputVisible="True"
                                                Loaded="ColorPickerLoaded"
                                                Color="{x:Bind local:InspectorRgbPresentation.ToDisplayColor(ViewModel.BackgroundColor), Mode=OneWay}" />
                                        </Flyout>
                                    </Button.Flyout>
                                    <Border
                                        Width="20"
                                        Height="24"
                                        Background="{x:Bind local:InspectorRgbPresentation.ToBrush(ViewModel.BackgroundColor), Mode=OneWay}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                </Button>
                            </editorcontrols:PropertyCard.LeadingContent>
                            <StackPanel Spacing="4">
                                <controls:VectorBox
                                    x:Name="BackgroundChannels"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Color, linear RGB"
                                    ComponentLabelPosition="Left"
                                    ComponentMask="~.###"
                                    Dimension="3"
                                    EditSessionCompleted="VectorEditCompleted"
                                    EditSessionStarted="VectorEditStarted"
                                    HorizontalValueAlignment="Right"
                                    LabelPosition="None"
                                    Style="{StaticResource SceneVectorBoxStyle}"
                                    Tag="BackgroundColor"
                                    XValue="{x:Bind ViewModel.BackgroundR, Mode=TwoWay}"
                                    YValue="{x:Bind ViewModel.BackgroundG, Mode=TwoWay}"
                                    ZValue="{x:Bind ViewModel.BackgroundB, Mode=TwoWay}" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.BackgroundRDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.BackgroundRDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                    </editorcontrols:PropertiesExpander.Items>
                </editorcontrols:PropertiesExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
