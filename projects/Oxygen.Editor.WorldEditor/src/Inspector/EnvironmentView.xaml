<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.EnvironmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:ctkcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:local="using:Oxygen.Editor.World.Inspector"
    xmlns:seg="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ctkcvt:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style BasedOn="{StaticResource QuietInspectorAction}" TargetType="Button" />
            <Style
                x:Key="SourceReferenceAction"
                BasedOn="{StaticResource QuietInspectorAction}"
                TargetType="Button">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ScopeItemStyle" TargetType="seg:SegmentedItem">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="27" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="seg:SegmentedItem">
                            <Border
                                x:Name="ScopeBackground"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="4">
                                <ContentPresenter
                                    x:Name="ScopeContent"
                                    HorizontalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ScopeBackground.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="ScopeBackground.Background" Value="{StaticResource SceneScopeSelectionBrush}" />
                                                <Setter Target="ScopeContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="ScopeBackground.Background" Value="{StaticResource SceneScopeSelectionBrush}" />
                                                <Setter Target="ScopeContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="ScopeBackground.Background" Value="{StaticResource SceneScopeSelectionBrush}" />
                                                <Setter Target="ScopeContent.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="8,0,8,8" Spacing="6">
            <Grid Margin="4,2,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,0,8,0"
                    FontSize="18"
                    Glyph="&#xE81E;" />
                <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.SceneName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Scene" />
            </Grid>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ScenePropertySearchBox"
                    Grid.ColumnSpan="2"
                    MinHeight="30"
                    Padding="30,4,32,4"
                    FontSize="12"
                    PlaceholderText="Find a scene property…" />
                <FontIcon
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left"
                    FontSize="14"
                    Glyph="&#xE721;"
                    IsHitTestVisible="False" />
                <Button
                    x:Name="ClearPropertySearchButton"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ClearScenePropertySearch_Click"
                    ToolTipService.ToolTip="Clear property search"
                    Visibility="Collapsed">
                    <FontIcon Glyph="&#xE894;" />
                </Button>
            </Grid>
            <seg:Segmented
                x:Name="ScenePropertyScopeSelector"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource ScopeItemStyle}"
                SelectedIndex="0"
                SelectionChanged="ScenePropertyScope_Changed">
                <seg:Segmented.Template>
                    <ControlTemplate TargetType="seg:Segmented">
                        <ItemsPresenter />
                    </ControlTemplate>
                </seg:Segmented.Template>
                <seg:Segmented.ItemsPanel>
                    <ItemsPanelTemplate>
                        <seg:EqualPanel Spacing="3" />
                    </ItemsPanelTemplate>
                </seg:Segmented.ItemsPanel>
                <seg:SegmentedItem Content="All" />
                <seg:SegmentedItem Content="Environment" />
                <seg:SegmentedItem Content="Post-processing" />
            </seg:Segmented>
        </StackPanel>
        <ScrollViewer
            x:Name="ScenePropertyScroll"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="SceneSections"
                Margin="8,0"
                Spacing="8">
                <TextBlock
                    x:Name="EnvironmentHeading"
                    Margin="4,10,4,2"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Environment" />
                <TextBlock
                    x:Name="NoScenePropertyMatches"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No scene properties match this search."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <editorcontrols:PropertiesExpander
                    x:Name="SkyAtmosphereSection"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Description="Atmospheric sky and aerial perspective authored on the scene."
                    Header="Sky Atmosphere"
                    HeaderIcon="{ui:FontIcon Glyph='&#xE753;'}"
                    IsExpanded="True"
                    Tag="Environment">
                    <editorcontrols:PropertiesExpander.Items>
                        <editorcontrols:PropertyCard HorizontalContentAlignment="Stretch" PropertyName="Enabled">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AtmosphereEnabled, Mode=TwoWay}" Tag="AtmosphereEnabled" />
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard HorizontalContentAlignment="Stretch" PropertyName="Sun Disk">
                            <ToggleSwitch
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.SunDiskEnabled, Mode=TwoWay}"
                                Tag="SunDiskEnabled" />
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Planet Radius"
                            Qualifier="km"
                            Tag="planet_radius_meters">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    LabelPosition="None"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.PlanetRadiusKm, Mode=TwoWay}"
                                    Tag="PlanetRadiusKm" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.PlanetRadiusKmDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.PlanetRadiusKmDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Atmosphere Height"
                            Qualifier="km"
                            Tag="atmosphere_height_meters">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    LabelPosition="None"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.AtmosphereHeightKm, Mode=TwoWay}"
                                    Tag="AtmosphereHeightKm" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.AtmosphereHeightKmDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.AtmosphereHeightKmDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            EditorMinimumWidth="248"
                            IsCompound="True"
                            Layout="Stacked"
                            PropertyName="Ground Albedo"
                            Qualifier="Linear RGB"
                            Tag="ground_albedo_rgb">
                            <editorcontrols:PropertyCard.LeadingContent>
                                <Button
                                    x:Name="GroundAlbedoSwatch"
                                    AutomationProperties.Name="Pick ground albedo color"
                                    Style="{StaticResource InspectorColorSwatchStyle}"
                                    ToolTipService.ToolTip="Pick ground albedo color">
                                    <Button.Flyout>
                                        <Flyout>
                                            <ColorPicker
                                                ColorChanged="GroundAlbedoPicker_ColorChanged"
                                                IsAlphaEnabled="False"
                                                Loaded="ColorPickerLoaded"
                                                Tag="GroundAlbedo"
                                                Color="{x:Bind local:InspectorRgbPresentation.ToDisplayColor(ViewModel.GroundAlbedoColor), Mode=OneWay}" />
                                        </Flyout>
                                    </Button.Flyout>
                                    <Border
                                        Width="20"
                                        Height="24"
                                        Background="{x:Bind local:InspectorRgbPresentation.ToBrush(ViewModel.GroundAlbedoColor), Mode=OneWay}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3" />
                                </Button>
                            </editorcontrols:PropertyCard.LeadingContent>
                            <StackPanel Spacing="4">
                                <controls:VectorBox
                                    x:Name="GroundAlbedoChannels"
                                    AutomationProperties.Name="Ground Albedo, linear RGB"
                                    ComponentLabelPosition="Left"
                                    Dimension="3"
                                    EditSessionCompleted="VectorEditCompleted"
                                    EditSessionStarted="VectorEditStarted"
                                    Tag="GroundAlbedo"
                                    XValue="{x:Bind ViewModel.GroundAlbedoR, Mode=TwoWay}"
                                    YValue="{x:Bind ViewModel.GroundAlbedoG, Mode=TwoWay}"
                                    ZValue="{x:Bind ViewModel.GroundAlbedoB, Mode=TwoWay}" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.GroundAlbedoRDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.GroundAlbedoRDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Rayleigh Height"
                            Qualifier="km"
                            Tag="rayleigh_scale_height_meters">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    LabelPosition="None"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.RayleighScaleHeightKm, Mode=TwoWay}"
                                    Tag="RayleighScaleHeightKm" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.RayleighScaleHeightKmDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.RayleighScaleHeightKmDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Mie Height"
                            Qualifier="km"
                            Tag="mie_scale_height_meters">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    LabelPosition="None"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.MieScaleHeightKm, Mode=TwoWay}"
                                    Tag="MieScaleHeightKm" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.MieScaleHeightKmDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.MieScaleHeightKmDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard HorizontalContentAlignment="Stretch" PropertyName="Mie Anisotropy">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.MieAnisotropy, Mode=TwoWay}"
                                    Tag="MieAnisotropy" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.MieAnisotropyDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.MieAnisotropyDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            EditorMinimumWidth="248"
                            IsCompound="True"
                            Layout="Stacked"
                            PropertyName="Sky Luminance"
                            Qualifier="RGB ×"
                            Tag="sky_luminance_factor_rgb">
                            <StackPanel Spacing="2">
                                <controls:VectorBox
                                    x:Name="SkyLuminanceChannels"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Sky luminance, RGB multiplier"
                                    ComponentLabelPosition="Left"
                                    ComponentMask="~.###"
                                    Dimension="3"
                                    EditSessionCompleted="VectorEditCompleted"
                                    EditSessionStarted="VectorEditStarted"
                                    LabelPosition="None"
                                    Tag="SkyLuminance"
                                    XValue="{x:Bind ViewModel.SkyLuminanceR, Mode=TwoWay}"
                                    YValue="{x:Bind ViewModel.SkyLuminanceG, Mode=TwoWay}"
                                    ZValue="{x:Bind ViewModel.SkyLuminanceB, Mode=TwoWay}" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.SkyLuminanceRDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.SkyLuminanceRDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Distance scale"
                            Tag="Aerial Distance aerial_perspective_distance_scale">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.AerialPerspectiveDistanceScale, Mode=TwoWay}"
                                    Tag="AerialPerspectiveDistanceScale" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.AerialPerspectiveDistanceScaleDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.AerialPerspectiveDistanceScaleDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Scattering strength"
                            Tag="Aerial Strength aerial_scattering_strength">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.AerialScatteringStrength, Mode=TwoWay}"
                                    Tag="AerialScatteringStrength" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.AerialScatteringStrengthDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.AerialScatteringStrengthDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            x:Name="AerialStartCard"
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Start distance"
                            Qualifier="m"
                            Tag="Aerial Start aerial_perspective_start_depth_meters">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    x:Name="AerialStartInput"
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    LabelPosition="None"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.AerialPerspectiveStartDepthMeters, Mode=TwoWay}"
                                    Tag="AerialPerspectiveStartDepthMeters"
                                    Validate="AerialStartValidate" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.AerialPerspectiveStartDepthMetersDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.AerialPerspectiveStartDepthMetersDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Height fog contribution"
                            Tag="Height Fog height_fog_contribution">
                            <StackPanel Spacing="2">
                                <controls:NumberBox
                                    EditSessionCompleted="NumberEditCompleted"
                                    EditSessionStarted="NumberEditStarted"
                                    Mask="~.###"
                                    NumberValue="{x:Bind ViewModel.HeightFogContribution, Mode=TwoWay}"
                                    Tag="HeightFogContribution" />
                                <TextBlock
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind ViewModel.HeightFogContributionDiagnostic.Message, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.HeightFogContributionDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                            </StackPanel>
                        </editorcontrols:PropertyCard>
                    </editorcontrols:PropertiesExpander.Items>
                </editorcontrols:PropertiesExpander>
                <editorcontrols:PropertiesExpander
                    x:Name="AtmosphereLightsSection"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Description="Primary and secondary directional light sources."
                    Header="Atmosphere Lights"
                    HeaderIcon="{ui:FontIcon Glyph='&#xE706;'}"
                    IsExpanded="True"
                    Tag="Environment">
                    <editorcontrols:PropertiesExpander.HeaderActions>
                        <Button
                            AutomationProperties.Name="Reset atmosphere lights"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ResetAtmosphereSources_Click"
                            ToolTipService.ToolTip="Reset atmosphere lights">
                            <FontIcon FontSize="14" Glyph="&#xE777;" />
                        </Button>
                    </editorcontrols:PropertiesExpander.HeaderActions>
                    <editorcontrols:PropertiesExpander.Items>
                        <editorcontrols:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            PropertyName="Sources"
                            Style="{StaticResource ContentOnlyPropertyCard}"
                            Tag="Sun Binding Sun Reference atmosphere_light_slot azimuth elevation direction angular diameter disk luminance transmittance primary secondary">
                            <Grid ColumnSpacing="5" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.ColumnSpan="3" Text="Primary" />
                                <ComboBox
                                    Grid.Row="1"
                                    MinHeight="32"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Primary atmosphere source"
                                    DisplayMemberPath="DisplayName"
                                    FontSize="14"
                                    ItemsSource="{x:Bind ViewModel.SunOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSun, Mode=TwoWay}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Inspect primary atmosphere source"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="InspectPrimarySource_Click"
                                    IsEnabled="{x:Bind ViewModel.HasPrimaryAtmosphereSource, Mode=OneWay}"
                                    Style="{StaticResource SourceReferenceAction}"
                                    ToolTipService.ToolTip="Inspect the primary atmosphere light">
                                    <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.ClearSunCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasPrimaryAtmosphereSource, Mode=OneWay}"
                                    Style="{StaticResource SourceReferenceAction}"
                                    ToolTipService.ToolTip="Clear Primary assignment">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                </Button>
                                <Expander
                                    x:Name="PrimarySourceDisclosure"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="Direction &amp; atmosphere"
                                    IsExpanded="False"
                                    Style="{StaticResource QuietDisclosure}"
                                    Visibility="{x:Bind ViewModel.HasPrimaryAtmosphereSource, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <local:AtmosphereSourceView DataContext="{x:Bind ViewModel.PrimaryAtmosphereSource, Mode=OneWay}" />
                                </Expander>
                                <Border
                                    x:Name="SourceSeparator"
                                    Grid.Row="3"
                                    Grid.ColumnSpan="3"
                                    Height="1"
                                    Margin="0,4"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.ColumnSpan="3"
                                    Text="Secondary" />
                                <ComboBox
                                    Grid.Row="5"
                                    MinHeight="32"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Secondary atmosphere source"
                                    DisplayMemberPath="DisplayName"
                                    FontSize="14"
                                    ItemsSource="{x:Bind ViewModel.SecondarySunOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSecondarySun, Mode=TwoWay}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <Button
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Inspect secondary atmosphere source"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="InspectSecondarySource_Click"
                                    IsEnabled="{x:Bind ViewModel.HasSecondaryAtmosphereSource, Mode=OneWay}"
                                    Style="{StaticResource SourceReferenceAction}"
                                    ToolTipService.ToolTip="Inspect the secondary atmosphere light">
                                    <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                                </Button>
                                <Button
                                    Grid.Row="5"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.ClearSecondarySunCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasSecondaryAtmosphereSource, Mode=OneWay}"
                                    Style="{StaticResource SourceReferenceAction}"
                                    ToolTipService.ToolTip="Clear Secondary assignment">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                </Button>
                                <Expander
                                    x:Name="SecondarySourceDisclosure"
                                    Grid.Row="6"
                                    Grid.ColumnSpan="3"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="Direction &amp; atmosphere"
                                    IsExpanded="False"
                                    Style="{StaticResource QuietDisclosure}"
                                    Visibility="{x:Bind ViewModel.HasSecondaryAtmosphereSource, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <local:AtmosphereSourceView DataContext="{x:Bind ViewModel.SecondaryAtmosphereSource, Mode=OneWay}" />
                                </Expander>
                                <TextBlock
                                    Grid.Row="7"
                                    Grid.ColumnSpan="3"
                                    AutomationProperties.LiveSetting="Polite"
