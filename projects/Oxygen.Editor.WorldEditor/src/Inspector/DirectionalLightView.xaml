<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.DirectionalLightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:local="using:Oxygen.Editor.World.Inspector"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE706;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <editorcontrols:PropertyCard
                EditorMinimumWidth="248"
                IsCompound="True"
                Layout="Stacked"
                PropertyName="Color"
                Qualifier="Linear RGB">
                <editorcontrols:PropertyCard.LeadingContent>
                    <Button Style="{StaticResource InspectorColorSwatchStyle}" ToolTipService.ToolTip="Pick light color">
                        <Button.Flyout>
                            <Flyout>
                                <ColorPicker
                                    ColorChanged="ColorPicker_ColorChanged"
                                    IsAlphaEnabled="False"
                                    IsColorChannelTextInputVisible="True"
                                    IsHexInputVisible="True"
                                    Loaded="ColorPickerLoaded"
                                    Color="{x:Bind local:InspectorRgbPresentation.ToDisplayColor(ViewModel.ColorValue), Mode=OneWay}" />
                            </Flyout>
                        </Button.Flyout>
                        <Border
                            Width="20"
                            Height="24"
                            Background="{x:Bind local:InspectorRgbPresentation.ToBrush(ViewModel.ColorValue), Mode=OneWay}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="2" />
                    </Button>
                </editorcontrols:PropertyCard.LeadingContent>
                <StackPanel Spacing="4">
                    <controls:VectorBox
                        x:Name="ColorChannels"
                        AutomationProperties.Name="Color, linear RGB"
                        ComponentLabelPosition="Left"
                        ComponentMask="~.###"
                        EditSessionCompleted="VectorEditCompleted"
                        EditSessionStarted="VectorEditStarted"
                        LabelPosition="None"
                        Tag="Color"
                        XValue="{x:Bind ViewModel.ColorR, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.ColorG, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.ColorB, Mode=TwoWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.ColorRDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ColorRDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Illuminance" Qualifier="lux">
                <StackPanel Spacing="2">
                    <controls:NumberBox
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        LabelPosition="None"
                        Mask="~.###"
                        NumberValue="{x:Bind ViewModel.IntensityLux, Mode=TwoWay}"
                        Tag="IntensityLux" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.IntensityLuxDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IntensityLuxDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Angular diameter" Qualifier="rad">
                <StackPanel Spacing="2">
                    <controls:NumberBox
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        LabelPosition="None"
                        Mask="~.####"
                        NumberValue="{x:Bind ViewModel.AngularDiameterDegrees, Mode=TwoWay}"
                        Tag="AngularSizeRadians" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.AngularSizeRadiansDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.AngularSizeRadiansDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Azimuth" Qualifier="°">
                <StackPanel Spacing="2">
                    <controls:NumberBox
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        LabelPosition="None"
                        Mask="~.#"
                        NumberValue="{x:Bind ViewModel.SunAzimuth, Mode=TwoWay}"
                        Tag="SunAzimuth" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.SunAzimuthDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.SunAzimuthDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Elevation" Qualifier="°">
                <StackPanel Spacing="2">
                    <controls:NumberBox
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        LabelPosition="None"
                        Mask="~.#"
                        NumberValue="{x:Bind ViewModel.SunElevation, Mode=TwoWay}"
                        Tag="SunElevation" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.SunElevationDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.SunElevationDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Source assignment">
                <StackPanel Spacing="4">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.AtmosphereSlotOptions}"
                        SelectedItem="{x:Bind ViewModel.AtmosphereSlot, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.AtmosphereSlotDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.AtmosphereSlotDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Per-pixel transmittance">
                <ToggleSwitch AutomationProperties.Name="Per-pixel transmittance" IsOn="{x:Bind ViewModel.UsePerPixelAtmosphereTransmittance, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard
                EditorMinimumWidth="248"
                IsCompound="True"
                Layout="Stacked"
                PropertyName="Disk luminance scale"
                Qualifier="RGB ×">
                <StackPanel Spacing="4">
                    <controls:VectorBox
                        x:Name="DiskScaleChannels"
                        AutomationProperties.Name="Disk luminance scale, RGB ×"
                        ComponentLabelPosition="Left"
                        ComponentMask="~.###"
                        EditSessionCompleted="VectorEditCompleted"
                        EditSessionStarted="VectorEditStarted"
                        LabelPosition="None"
                        Tag="DiskScale"
                        XValue="{x:Bind ViewModel.DiskScaleR, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.DiskScaleG, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.DiskScaleB, Mode=TwoWay}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.AtmosphereDiskLuminanceScaleRgbDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.AtmosphereDiskLuminanceScaleRgbDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Affects world">
                <ToggleSwitch AutomationProperties.Name="Affects world" IsOn="{x:Bind ViewModel.AffectsWorld, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard
                HorizontalContentAlignment="Stretch"
                PropertyName="Exposure"
                Qualifier="EV">
                <StackPanel Spacing="2">
                    <controls:NumberBox
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        LabelPosition="None"
                        Mask="~.###"
                        NumberValue="{x:Bind ViewModel.ExposureCompensation, Mode=TwoWay}"
                        Tag="ExposureCompensation" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.ExposureCompensationDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ExposureCompensationDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>

            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Shadows" />
                <editorcontrols:PropertyCard PropertyName="Cast shadows">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CastsShadows, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <editorcontrols:PropertyCard PropertyName="Contact shadows">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ContactShadows, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <editorcontrols:PropertyCard PropertyName="Resolution">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ShadowResolutionOptions}"
                        SelectedItem="{x:Bind ViewModel.ShadowResolutionHint, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <editorcontrols:PropertyCard PropertyName="Depth bias" Qualifier="">
                    <StackPanel Spacing="2">
                        <controls:NumberBox
                            EditSessionCompleted="NumberEditCompleted"
                            EditSessionStarted="NumberEditStarted"
                            LabelPosition="None"
                            Mask="~.####"
                            NumberValue="{x:Bind ViewModel.ShadowBias, Mode=TwoWay}"
                            Tag="ShadowBias" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.ShadowBiasDiagnostic.Message, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.ShadowBiasDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                    </StackPanel>
                </editorcontrols:PropertyCard>
                <editorcontrols:PropertyCard PropertyName="Normal bias" Qualifier="">
                    <StackPanel Spacing="2">
                        <controls:NumberBox
                            EditSessionCompleted="NumberEditCompleted"
                            EditSessionStarted="NumberEditStarted"
                            LabelPosition="None"
                            Mask="~.####"
                            NumberValue="{x:Bind ViewModel.ShadowNormalBias, Mode=TwoWay}"
                            Tag="ShadowNormalBias" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.ShadowNormalBiasDiagnostic.Message, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.ShadowNormalBiasDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                    </StackPanel>
                </editorcontrols:PropertyCard>
            </StackPanel>


            <Expander Header="Cascaded shadows" Style="{StaticResource QuietDisclosure}">
                <StackPanel Spacing="4">
                    <editorcontrols:PropertyCard PropertyName="Split mode">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.SplitModeOptions}"
                            SelectedItem="{x:Bind ViewModel.SplitMode, Mode=TwoWay}" />
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Cascade count" Qualifier="">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="#."
                                NumberValue="{x:Bind ViewModel.CascadeCount, Mode=TwoWay}"
                                Tag="CascadeCount" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.CascadeCountDiagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.CascadeCountDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Maximum distance" Qualifier="m">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="~.###"
                                NumberValue="{x:Bind ViewModel.MaxShadowDistance, Mode=TwoWay}"
                                Tag="MaxShadowDistance" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.MaxShadowDistanceDiagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.MaxShadowDistanceDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Distribution exponent" Qualifier="">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="~.###"
                                NumberValue="{x:Bind ViewModel.DistributionExponent, Mode=TwoWay}"
                                Tag="DistributionExponent" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.DistributionExponentDiagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.DistributionExponentDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Cascade 1 distance" Qualifier="m">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="~.###"
                                NumberValue="{x:Bind ViewModel.CascadeDistance1, Mode=TwoWay}"
                                Tag="CascadeDistance1" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.CascadeDistance1Diagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.CascadeDistance1Diagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Cascade 2 distance" Qualifier="m">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="~.###"
                                NumberValue="{x:Bind ViewModel.CascadeDistance2, Mode=TwoWay}"
                                Tag="CascadeDistance2" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.CascadeDistance2Diagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.CascadeDistance2Diagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Cascade 3 distance" Qualifier="m">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="~.###"
                                NumberValue="{x:Bind ViewModel.CascadeDistance3, Mode=TwoWay}"
                                Tag="CascadeDistance3" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.CascadeDistance3Diagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.CascadeDistance3Diagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Cascade 4 distance" Qualifier="m">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="~.###"
                                NumberValue="{x:Bind ViewModel.CascadeDistance4, Mode=TwoWay}"
                                Tag="CascadeDistance4" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.CascadeDistance4Diagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.CascadeDistance4Diagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                </StackPanel>
            </Expander>


            <Expander Header="Cascade blending" Style="{StaticResource QuietDisclosure}">
                <StackPanel Spacing="4">
                    <editorcontrols:PropertyCard PropertyName="Transition fraction" Qualifier="">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="~.###"
                                NumberValue="{x:Bind ViewModel.TransitionFraction, Mode=TwoWay}"
                                Tag="TransitionFraction" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.TransitionFractionDiagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.TransitionFractionDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Fade-out fraction" Qualifier="">
                        <StackPanel Spacing="2">
                            <controls:NumberBox
                                EditSessionCompleted="NumberEditCompleted"
                                EditSessionStarted="NumberEditStarted"
                                LabelPosition="None"
                                Mask="~.###"
                                NumberValue="{x:Bind ViewModel.DistanceFadeoutFraction, Mode=TwoWay}"
                                Tag="DistanceFadeoutFraction" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.DistanceFadeoutFractionDiagnostic.Message, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.DistanceFadeoutFractionDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                        </StackPanel>
                    </editorcontrols:PropertyCard>
                </StackPanel>
            </Expander>

        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
