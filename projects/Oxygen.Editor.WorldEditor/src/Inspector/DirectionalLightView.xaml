<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.DirectionalLightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:fields="using:Oxygen.Editor.World.Inspector.Controls"
    xmlns:local="using:Oxygen.Editor.World.Inspector"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE706;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <fields:InspectorRgbField
                x:Name="ColorField"
                Blue="{x:Bind ViewModel.ColorB, Mode=TwoWay}"
                ChannelAutomationName="Color, linear RGB"
                ColorPicked="OnRgbColorPicked"
                EditOwner="{x:Bind ViewModel, Mode=OneWay}"
                EditSessionCompleted="VectorEditCompleted"
                EditSessionStarted="VectorEditStarted"
                ErrorText="{x:Bind ViewModel.ColorRDiagnostic.Message, Mode=OneWay}"
                FontSize="14"
                Green="{x:Bind ViewModel.ColorG, Mode=TwoWay}"
                HasError="{x:Bind ViewModel.ColorRDiagnostic.HasError, Mode=OneWay}"
                Label="Color"
                PickerAutomationName="Pick light color"
                Qualifier="Linear RGB"
                Red="{x:Bind ViewModel.ColorR, Mode=TwoWay}"
                Tag="Color" />
            <editorcontrols:InspectorNumberField
                CardStyle="{StaticResource ScenePropertyCardStyle}"
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.IntensityLuxDiagnostic.Message, Mode=OneWay}"
                FontSize="14"
                HasError="{x:Bind ViewModel.IntensityLuxDiagnostic.HasError, Mode=OneWay}"
                Label="Illuminance"
                NumberStyle="{StaticResource SceneNumberBoxStyle}"
                NumberValue="{x:Bind ViewModel.IntensityLux, Mode=TwoWay}"
                Qualifier="lux"
                Tag="IntensityLux" />
            <editorcontrols:InspectorNumberField
                CardStyle="{StaticResource ScenePropertyCardStyle}"
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.AngularSizeRadiansDiagnostic.Message, Mode=OneWay}"
                FontSize="14"
                HasError="{x:Bind ViewModel.AngularSizeRadiansDiagnostic.HasError, Mode=OneWay}"
                Label="Angular diameter"
                Mask="~.####"
                NumberStyle="{StaticResource SceneNumberBoxStyle}"
                NumberValue="{x:Bind ViewModel.AngularDiameterDegrees, Mode=TwoWay}"
                Qualifier="rad"
                Tag="AngularSizeRadians" />
            <editorcontrols:InspectorNumberField
                CardStyle="{StaticResource ScenePropertyCardStyle}"
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.SunAzimuthDiagnostic.Message, Mode=OneWay}"
                FontSize="14"
                HasError="{x:Bind ViewModel.SunAzimuthDiagnostic.HasError, Mode=OneWay}"
                Label="Azimuth"
                Mask="~.#"
                NumberStyle="{StaticResource SceneNumberBoxStyle}"
                NumberValue="{x:Bind ViewModel.SunAzimuth, Mode=TwoWay}"
                Qualifier="°"
                Tag="SunAzimuth" />
            <editorcontrols:InspectorNumberField
                CardStyle="{StaticResource ScenePropertyCardStyle}"
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.SunElevationDiagnostic.Message, Mode=OneWay}"
                FontSize="14"
                HasError="{x:Bind ViewModel.SunElevationDiagnostic.HasError, Mode=OneWay}"
                Label="Elevation"
                Mask="~.#"
                NumberStyle="{StaticResource SceneNumberBoxStyle}"
                NumberValue="{x:Bind ViewModel.SunElevation, Mode=TwoWay}"
                Qualifier="°"
                Tag="SunElevation" />
            <editorcontrols:PropertyCard PropertyName="Source assignment">
                <StackPanel Spacing="4">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.AtmosphereSlotOptions}"
                        SelectedItem="{x:Bind ViewModel.AtmosphereSlot, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.AtmosphereSlotDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.AtmosphereSlotDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Per-pixel transmittance">
                <ToggleSwitch AutomationProperties.Name="Per-pixel transmittance" IsOn="{x:Bind ViewModel.UsePerPixelAtmosphereTransmittance, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
            <fields:InspectorRgbField
                x:Name="DiskScaleField"
                Blue="{x:Bind ViewModel.DiskScaleB, Mode=TwoWay}"
                ChannelAutomationName="Disk luminance scale, RGB ×"
                EditSessionCompleted="VectorEditCompleted"
                EditSessionStarted="VectorEditStarted"
                ErrorText="{x:Bind ViewModel.AtmosphereDiskLuminanceScaleRgbDiagnostic.Message, Mode=OneWay}"
                FontSize="14"
                Green="{x:Bind ViewModel.DiskScaleG, Mode=TwoWay}"
                HasError="{x:Bind ViewModel.AtmosphereDiskLuminanceScaleRgbDiagnostic.HasError, Mode=OneWay}"
                IsMultiplier="True"
                Label="Disk luminance scale"
                Qualifier="RGB ×"
                Red="{x:Bind ViewModel.DiskScaleR, Mode=TwoWay}"
                Tag="DiskScale" />
            <editorcontrols:PropertyCard PropertyName="Affects world">
                <ToggleSwitch AutomationProperties.Name="Affects world" IsOn="{x:Bind ViewModel.AffectsWorld, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
            <editorcontrols:InspectorNumberField
                CardStyle="{StaticResource ScenePropertyCardStyle}"
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.ExposureCompensationDiagnostic.Message, Mode=OneWay}"
                FontSize="14"
                HasError="{x:Bind ViewModel.ExposureCompensationDiagnostic.HasError, Mode=OneWay}"
                Label="Exposure"
                NumberStyle="{StaticResource SceneNumberBoxStyle}"
                NumberValue="{x:Bind ViewModel.ExposureCompensation, Mode=TwoWay}"
                Qualifier="EV"
                Tag="ExposureCompensation" />

            <StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Shadows" />
                <editorcontrols:PropertyCard PropertyName="Cast shadows">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.CastsShadows, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <editorcontrols:PropertyCard PropertyName="Contact shadows">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ContactShadows, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <editorcontrols:PropertyCard PropertyName="Resolution">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.ShadowResolutionOptions}"
                        SelectedItem="{x:Bind ViewModel.ShadowResolutionHint, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <editorcontrols:InspectorNumberField
                    CardStyle="{StaticResource ScenePropertyCardStyle}"
                    EditSessionCompleted="NumberEditCompleted"
                    EditSessionStarted="NumberEditStarted"
                    ErrorText="{x:Bind ViewModel.ShadowBiasDiagnostic.Message, Mode=OneWay}"
                    FontSize="14"
                    HasError="{x:Bind ViewModel.ShadowBiasDiagnostic.HasError, Mode=OneWay}"
                    Label="Depth bias"
                    Mask="~.####"
                    NumberStyle="{StaticResource SceneNumberBoxStyle}"
                    NumberValue="{x:Bind ViewModel.ShadowBias, Mode=TwoWay}"
                    Tag="ShadowBias" />
                <editorcontrols:InspectorNumberField
                    CardStyle="{StaticResource ScenePropertyCardStyle}"
                    EditSessionCompleted="NumberEditCompleted"
                    EditSessionStarted="NumberEditStarted"
                    ErrorText="{x:Bind ViewModel.ShadowNormalBiasDiagnostic.Message, Mode=OneWay}"
                    FontSize="14"
                    HasError="{x:Bind ViewModel.ShadowNormalBiasDiagnostic.HasError, Mode=OneWay}"
                    Label="Normal bias"
                    Mask="~.####"
                    NumberStyle="{StaticResource SceneNumberBoxStyle}"
                    NumberValue="{x:Bind ViewModel.ShadowNormalBias, Mode=TwoWay}"
                    Tag="ShadowNormalBias" />
            </StackPanel>


            <Expander Header="Cascaded shadows" Style="{StaticResource QuietDisclosure}">
                <StackPanel Spacing="4">
                    <editorcontrols:PropertyCard PropertyName="Split mode">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.SplitModeOptions}"
                            SelectedItem="{x:Bind ViewModel.SplitMode, Mode=TwoWay}" />
                    </editorcontrols:PropertyCard>
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.CascadeCountDiagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.CascadeCountDiagnostic.HasError, Mode=OneWay}"
                        Label="Cascade count"
                        Mask="#."
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.CascadeCount, Mode=TwoWay}"
                        Tag="CascadeCount" />
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.MaxShadowDistanceDiagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.MaxShadowDistanceDiagnostic.HasError, Mode=OneWay}"
                        Label="Maximum distance"
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.MaxShadowDistance, Mode=TwoWay}"
                        Qualifier="m"
                        Tag="MaxShadowDistance" />
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.DistributionExponentDiagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.DistributionExponentDiagnostic.HasError, Mode=OneWay}"
                        Label="Distribution exponent"
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.DistributionExponent, Mode=TwoWay}"
                        Tag="DistributionExponent" />
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.CascadeDistance1Diagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.CascadeDistance1Diagnostic.HasError, Mode=OneWay}"
                        Label="Cascade 1 distance"
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.CascadeDistance1, Mode=TwoWay}"
                        Qualifier="m"
                        Tag="CascadeDistance1" />
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.CascadeDistance2Diagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.CascadeDistance2Diagnostic.HasError, Mode=OneWay}"
                        Label="Cascade 2 distance"
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.CascadeDistance2, Mode=TwoWay}"
                        Qualifier="m"
                        Tag="CascadeDistance2" />
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.CascadeDistance3Diagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.CascadeDistance3Diagnostic.HasError, Mode=OneWay}"
                        Label="Cascade 3 distance"
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.CascadeDistance3, Mode=TwoWay}"
                        Qualifier="m"
                        Tag="CascadeDistance3" />
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.CascadeDistance4Diagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.CascadeDistance4Diagnostic.HasError, Mode=OneWay}"
                        Label="Cascade 4 distance"
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.CascadeDistance4, Mode=TwoWay}"
                        Qualifier="m"
                        Tag="CascadeDistance4" />
                </StackPanel>
            </Expander>


            <Expander Header="Cascade blending" Style="{StaticResource QuietDisclosure}">
                <StackPanel Spacing="4">
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.TransitionFractionDiagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.TransitionFractionDiagnostic.HasError, Mode=OneWay}"
                        Label="Transition fraction"
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.TransitionFraction, Mode=TwoWay}"
                        Tag="TransitionFraction" />
                    <editorcontrols:InspectorNumberField
                        CardStyle="{StaticResource ScenePropertyCardStyle}"
                        EditSessionCompleted="NumberEditCompleted"
                        EditSessionStarted="NumberEditStarted"
                        ErrorText="{x:Bind ViewModel.DistanceFadeoutFractionDiagnostic.Message, Mode=OneWay}"
                        FontSize="14"
                        HasError="{x:Bind ViewModel.DistanceFadeoutFractionDiagnostic.HasError, Mode=OneWay}"
                        Label="Fade-out fraction"
                        NumberStyle="{StaticResource SceneNumberBoxStyle}"
                        NumberValue="{x:Bind ViewModel.DistanceFadeoutFraction, Mode=TwoWay}"
                        Tag="DistanceFadeoutFraction" />
                </StackPanel>
            </Expander>

        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
