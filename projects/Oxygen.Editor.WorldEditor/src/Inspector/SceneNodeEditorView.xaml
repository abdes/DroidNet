<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.Inspector.SceneNodeEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:ctkcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:local="using:Oxygen.Editor.World.Inspector"
    x:Name="Root"
    KeyboardAcceleratorPlacementMode="Hidden"
    SizeChanged="OnInspectorSizeChanged">
    <UserControl.Resources>
        <ctkcvt:BoolToVisibilityConverter x:Key="HasSelectionToVisibilityConverter" />
        <local:ComponentToGlyphConverter x:Key="ComponentToGlyphConverter" />
    </UserControl.Resources>
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Z"
            Invoked="UndoInvoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Y"
            Invoked="RedoInvoked"
            Modifiers="Control" />
    </UserControl.KeyboardAccelerators>
    <Grid Padding="4">
        <Grid.Resources>
            <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
        </Grid.Resources>
        <TextBlock
            Margin="10,40"
            VerticalAlignment="Top"
            FontStyle="Italic"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="Open a scene to view and edit its properties"
            TextAlignment="Center"
            TextWrapping="WrapWholeWords"
            Visibility="{x:Bind ViewModel.HasInspectorContent, Mode=OneWay, Converter={StaticResource HasSelectionToVisibilityConverter}, ConverterParameter=True}" />
        <Grid Visibility="{x:Bind ViewModel.HasInspectorContent, Mode=OneWay, Converter={StaticResource HasSelectionToVisibilityConverter}, ConverterParameter=False}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                Title="{x:Bind ViewModel.PendingLiveSyncTitle, Mode=OneWay}"
                Margin="4,0,4,6"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasPendingLiveSyncEdits, Mode=OneWay}"
                Message="{x:Bind ViewModel.PendingLiveSyncMessage, Mode=OneWay}"
                Severity="Warning"
                Visibility="{x:Bind ViewModel.HasPendingLiveSyncEdits, Mode=OneWay, Converter={StaticResource HasSelectionToVisibilityConverter}, ConverterParameter=False}" />
            <Border
                x:Name="CompactNodeHeader"
                Grid.Row="1"
                Margin="0,0,0,4"
                Padding="4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource HasSelectionToVisibilityConverter}, ConverterParameter=False}">
                <StackPanel>
                    <Grid>
                        <local:SceneNodeDetailsView
                            x:Name="NodeDetails"
                            AllComponentsRequested="OnAllComponentsRequested"
                            HistoryRoot="{x:Bind ViewModel, Mode=OneWay}"
                            IsAllComponentsSelected="{x:Bind ViewModel.IsAllComponentsSelected, Mode=OneWay}"
                            LoggerFactory="{x:Bind ViewModel.LoggerFactory}"
                            Node="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
                            SelectedComponent="{x:Bind ViewModel.SelectedComponent, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSingleItemSelected, Mode=OneWay, Converter={StaticResource HasSelectionToVisibilityConverter}, ConverterParameter=False}" />
                        <Grid MinHeight="32" Visibility="{x:Bind ViewModel.HasMultipleItems, Mode=OneWay, Converter={StaticResource HasSelectionToVisibilityConverter}, ConverterParameter=False}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel.ItemsCount, Mode=OneWay}" />
                                <Run Text=" objects" />
                            </TextBlock>
                            <controls:ToolBar
                                Grid.Column="1"
                                Background="Transparent"
                                IsCompact="True">
                                <controls:ToolBarToggleButton
                                    x:Name="MultiAllComponentsButton"
                                    AutomationProperties.Name="All components"
                                    Checked="OnAllComponentsChanged"
                                    IsChecked="{x:Bind ViewModel.IsAllComponentsSelected, Mode=OneWay}"
                                    Label="All components"
                                    ToolBarLabelPosition="Collapsed"
                                    ToolTipService.ToolTip="Show all component properties"
                                    Unchecked="OnAllComponentsChanged">
                                    <controls:ToolBarToggleButton.Icon>
                                        <SymbolIconSource Symbol="AllApps" />
                                    </controls:ToolBarToggleButton.Icon>
                                </controls:ToolBarToggleButton>
                            </controls:ToolBar>
                        </Grid>
                    </Grid>
                    <ScrollViewer
                        x:Name="ComponentScroll"
                        MaxHeight="128"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        PreviewKeyDown="OnComponentsKeyDown"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsRepeater x:Name="ComponentSelector" ItemsSource="{x:Bind ViewModel.ComponentFilters}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:InspectorComponentFilter">
                                    <Grid ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                                        <ToggleButton
                                            Height="32"
                                            Padding="6,2"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            AutomationProperties.HelpText="{x:Bind UnavailableReason, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind Label}"
                                            Checked="OnComponentFilterChanged"
                                            IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                            IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Unchecked="OnComponentFilterChanged">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon FontSize="14" Glyph="{x:Bind ComponentType, Converter={StaticResource ComponentToGlyphConverter}}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Label}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind StatusLabel, Mode=OneWay}" />
                                            </Grid>
                                        </ToggleButton>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <TextBlock
                Grid.Row="2"
                Margin="8,4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.UnavailableComponentEditorMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasUnavailableComponentEditor, Mode=OneWay, Converter={StaticResource HasSelectionToVisibilityConverter}, ConverterParameter=False}" />
            <ScrollViewer
                x:Name="PropertyScroll"
                Grid.Row="3"
                Padding="4,0,4,4"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsRepeater
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.PropertyEditors}"
                    TabFocusNavigation="Local">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:IDetailsSection">
                            <ContentPresenter Content="{x:Bind Converter={StaticResource VmToViewConverter}}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
