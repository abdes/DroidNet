<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.World.SceneEditor.SceneEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Oxygen.Editor.LevelEditor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:editors="using:Oxygen.Editor.World.Documents"
    xmlns:local="using:Oxygen.Editor.World.SceneEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:menus="using:DroidNet.Controls.Menus"
    xmlns:seg="using:CommunityToolkit.WinUI.Controls"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <!--  Align the selected camera with the focused pane (Unity's Align With View).  -->
        <KeyboardAccelerator
            Key="F"
            Invoked="OnAlignCameraToViewInvoked"
            Modifiers="Control,Shift" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <local:LoggingVerbositySegmentIndexConverter x:Key="VerbosityIndexConverter" />
        <local:IntFloatConverter x:Key="IntFloatConverter" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!--  Top app bar  -->
            <RowDefinition Height="Auto" />
            <!--  Editor area  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top app bar refactored to use ToolBar controls  -->
        <dnc:ToolBar
            Grid.Row="0"
            Margin="4,4,4,0"
            Padding="6"
            VerticalAlignment="Top">
            <!--  Primary toolbar items  -->
            <dnc:ToolBarButton
                x:Name="SaveButton"
                Command="{x:Bind ViewModel.SaveCommand}"
                Label="Save"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Save (Ctrl+S)">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE105;" />
                </dnc:ToolBarButton.Icon>
                <dnc:ToolBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </dnc:ToolBarButton.KeyboardAccelerators>
            </dnc:ToolBarButton>

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.CookCurrentSceneCommand}"
                Label="Cook scene"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Cook scene">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE895;" />
                </dnc:ToolBarButton.Icon>
            </dnc:ToolBarButton>

            <dnc:ToolBarSeparator />

            <dnc:ToolBarElementHost>
                <menus:MenuButton
                    AutomationProperties.Name="Add"
                    Chrome="Transparent"
                    MenuSource="{x:Bind ViewModel.QuickAddMenu, Mode=OneWay}"
                    ToolTipService.ToolTip="Add a node in front of the focused viewport">
                    <menus:MenuButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock VerticalAlignment="Center" Text="Add" />
                        </StackPanel>
                    </menus:MenuButton.Content>
                </menus:MenuButton>
            </dnc:ToolBarElementHost>

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.BrowseToAssetCommand}"
                Label="Browse to asset"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Browse to the selection's assets (Ctrl+B)">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE8B7;" />
                </dnc:ToolBarButton.Icon>
                <dnc:ToolBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="B" Modifiers="Control" />
                </dnc:ToolBarButton.KeyboardAccelerators>
            </dnc:ToolBarButton>

            <dnc:ToolBarButton
                Command="{x:Bind ViewModel.SelectEnvironmentCommand}"
                Label="Environment"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Scene environment: sky, sun and atmosphere">
                <dnc:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE909;" />
                </dnc:ToolBarButton.Icon>
            </dnc:ToolBarButton>

            <!--  Spacer for center content (if needed)  -->
            <dnc:ToolBarElementHost>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal" />
            </dnc:ToolBarElementHost>

            <!--  Secondary toolbar items  -->
            <dnc:ToolBar.SecondaryItems>
                <dnc:ToolBarButton
                    x:Name="SettingsButton"
                    Label="Settings"
                    ToolBarLabelPosition="Collapsed">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE713;" />
                    </dnc:ToolBarButton.Icon>
                    <dnc:ToolBarButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="260" Padding="12">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Engine" />
                                <ToggleSwitch
                                    Header="VSync"
                                    IsOn="{x:Bind ViewModel.PreviewSettings.VSyncEnabled, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Wait for the display's refresh before showing each frame." />
                                <ToggleSwitch Header="Limit frame rate" IsOn="{x:Bind ViewModel.PreviewSettings.FrameRateCapEnabled, Mode=TwoWay}" />
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <Slider
                                        Width="160"
                                        IsEnabled="{x:Bind ViewModel.PreviewSettings.FrameRateCapEnabled, Mode=OneWay}"
                                        LargeChange="10"
                                        Maximum="{x:Bind ViewModel.PreviewSettings.MaxFrameRateCap, Mode=OneWay}"
                                        Minimum="1"
                                        SmallChange="1"
                                        Value="{x:Bind ViewModel.PreviewSettings.FrameRateCap, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PreviewSettings.FrameRateCap, Mode=OneWay}" />
                                </StackPanel>
                                <ToggleSwitch
                                    Margin="0,8,0,0"
                                    Header="Render idle viewports"
                                    IsOn="{x:Bind ViewModel.PreviewSettings.AlwaysRenderPanes, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Render every viewport each frame, not only the ones whose view changed." />
                                <TextBlock Margin="0,10,0,8" Text="Native engine log verbosity:" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <seg:Segmented
                                        x:Name="LogVerbositySegmented"
                                        HorizontalAlignment="Left"
                                        SelectedIndex="{x:Bind ViewModel.PreviewSettings.LoggingVerbosity, Mode=TwoWay, Converter={StaticResource VerbosityIndexConverter}}"
                                        SelectionMode="Single">
                                        <seg:SegmentedItem Content="E" ToolTipService.ToolTip="Error (ERR)" />
                                        <seg:SegmentedItem Content="W" ToolTipService.ToolTip="Warning (WARN)" />
                                        <seg:SegmentedItem Content="I" ToolTipService.ToolTip="Information (INF)" />
                                        <seg:SegmentedItem Content="V" ToolTipService.ToolTip="Verbose" />
                                    </seg:Segmented>
                                    <dnc:NumberBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalValueAlignment="Right"
                                        Mask="#.#"
                                        Multiplier="1"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.LoggingVerbosity, Mode=TwoWay, Converter={StaticResource IntFloatConverter}}"
                                        WithPadding="False" />
                                </Grid>
                                <TextBlock
                                    Margin="0,16,0,4"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Ground grid" />
                                <ToggleSwitch
                                    Header="Show grid"
                                    IsOn="{x:Bind ViewModel.PreviewSettings.GroundGrid.Enabled, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Show the ground grid in every viewport. A viewport's own grid toggle still hides it there." />
                                <ToggleSwitch
                                    Header="Smooth motion"
                                    IsOn="{x:Bind ViewModel.PreviewSettings.GroundGrid.SmoothMotion, Mode=TwoWay}"
                                    ToolTipService.ToolTip="Ease the grid after the camera instead of snapping cell by cell." />
                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="Spacing"
                                        ToolTipService.ToolTip="Distance between adjacent grid lines, in world units." />
                                    <dnc:NumberBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Spacing"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.###"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.Spacing, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        Text="Major lines every"
                                        ToolTipService.ToolTip="How many cells lie between major lines." />
                                    <dnc:NumberBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Major lines every"
                                        HorizontalValueAlignment="Right"
                                        Mask="~."
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.MajorEvery, Mode=TwoWay, Converter={StaticResource IntFloatConverter}}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        Text="Line thickness"
                                        ToolTipService.ToolTip="Minor line thickness, as a fraction of a cell." />
                                    <dnc:NumberBox
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Line thickness"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.###"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.LineThickness, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="3"
                                        VerticalAlignment="Center"
                                        Text="Major thickness"
                                        ToolTipService.ToolTip="Major line thickness, as a fraction of a cell." />
                                    <dnc:NumberBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Major thickness"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.###"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.MajorThickness, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="4"
                                        VerticalAlignment="Center"
                                        Text="Axis thickness"
                                        ToolTipService.ToolTip="Axis line thickness, as a fraction of a cell." />
                                    <dnc:NumberBox
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Axis thickness"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.###"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.AxisThickness, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="5"
                                        VerticalAlignment="Center"
                                        Text="Fade start"
                                        ToolTipService.ToolTip="Distance from the camera at which the grid starts to fade, in world units." />
                                    <dnc:NumberBox
                                        Grid.Row="5"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Fade start"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.#"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.FadeStart, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="6"
                                        VerticalAlignment="Center"
                                        Text="Fade power"
                                        ToolTipService.ToolTip="How sharply the grid fades with distance." />
                                    <dnc:NumberBox
                                        Grid.Row="6"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Fade power"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.##"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.FadePower, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="7"
                                        VerticalAlignment="Center"
                                        Text="Horizon boost"
                                        ToolTipService.ToolTip="How much the lines brighten toward the horizon." />
                                    <dnc:NumberBox
                                        Grid.Row="7"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Horizon boost"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.##"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.HorizonBoost, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="8"
                                        VerticalAlignment="Center"
                                        Text="Origin X"
                                        ToolTipService.ToolTip="X coordinate of the grid origin on the ground plane." />
                                    <dnc:NumberBox
                                        Grid.Row="8"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Origin X"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.##"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.OriginX, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="9"
                                        VerticalAlignment="Center"
                                        Text="Origin Y"
                                        ToolTipService.ToolTip="Y coordinate of the grid origin on the ground plane." />
                                    <dnc:NumberBox
                                        Grid.Row="9"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Origin Y"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.##"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.OriginY, Mode=TwoWay}"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="10"
                                        VerticalAlignment="Center"
                                        Text="Smooth motion time"
                                        ToolTipService.ToolTip="How long the grid takes to ease after the camera, in seconds." />
                                    <dnc:NumberBox
                                        Grid.Row="10"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Smooth motion time"
                                        HorizontalValueAlignment="Right"
                                        Mask="~.##"
                                        NumberValue="{x:Bind ViewModel.PreviewSettings.GroundGrid.SmoothTime, Mode=TwoWay}"
                                        WithPadding="False" />
                                </Grid>
                                <TextBlock Margin="0,10,0,4" Text="Colors" />
                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Minor lines" />
                                    <Button
                                        Grid.Column="1"
                                        Height="24"
                                        Padding="2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Minor lines color">
                                        <Border CornerRadius="2">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.MinorColor, Mode=OneWay}" />
                                            </Border.Background>
                                        </Border>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    IsAlphaEnabled="True"
                                                    IsMoreButtonVisible="False"
                                                    Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.MinorColor, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        Text="Major lines" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Height="24"
                                        Padding="2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Major lines color">
                                        <Border CornerRadius="2">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.MajorColor, Mode=OneWay}" />
                                            </Border.Background>
                                        </Border>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    IsAlphaEnabled="True"
                                                    IsMoreButtonVisible="False"
                                                    Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.MajorColor, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock
                                        Grid.Row="2"
                                        VerticalAlignment="Center"
                                        Text="X axis" />
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Height="24"
                                        Padding="2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="X axis color">
                                        <Border CornerRadius="2">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.AxisColorX, Mode=OneWay}" />
                                            </Border.Background>
                                        </Border>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    IsAlphaEnabled="True"
                                                    IsMoreButtonVisible="False"
                                                    Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.AxisColorX, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock
                                        Grid.Row="3"
                                        VerticalAlignment="Center"
                                        Text="Y axis" />
                                    <Button
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Height="24"
                                        Padding="2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Y axis color">
                                        <Border CornerRadius="2">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.AxisColorY, Mode=OneWay}" />
                                            </Border.Background>
                                        </Border>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    IsAlphaEnabled="True"
                                                    IsMoreButtonVisible="False"
                                                    Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.AxisColorY, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock
                                        Grid.Row="4"
                                        VerticalAlignment="Center"
                                        Text="Origin" />
                                    <Button
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Height="24"
                                        Padding="2"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="Origin color">
                                        <Border CornerRadius="2">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.OriginColor, Mode=OneWay}" />
                                            </Border.Background>
                                        </Border>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker
                                                    IsAlphaEnabled="True"
                                                    IsMoreButtonVisible="False"
                                                    Color="{x:Bind ViewModel.PreviewSettings.GroundGrid.OriginColor, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <Button
                                    Margin="0,12,0,0"
                                    Command="{x:Bind ViewModel.PreviewSettings.GroundGrid.ResetToDefaultsCommand}"
                                    Content="Reset grid to defaults" />
                            </StackPanel>
                        </Flyout>
                    </dnc:ToolBarButton.Flyout>
                </dnc:ToolBarButton>
            </dnc:ToolBar.SecondaryItems>
        </dnc:ToolBar>

        <!--  Viewports will be added here dynamically inside the viewport grid  -->
        <Grid
            x:Name="ViewportGrid"
            Grid.Row="1"
            ColumnSpacing="5"
            RowSpacing="5" />
    </Grid>
</UserControl>
