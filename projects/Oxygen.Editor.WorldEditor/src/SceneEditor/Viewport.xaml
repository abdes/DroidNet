<UserControl
    x:Class="Oxygen.Editor.LevelEditor.Viewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Oxygen.Editor.LevelEditor"
    xmlns:ctkcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="True"
    SizeChanged="OnSizeChanged"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ctkcvt:BoolToVisibilityConverter
            x:Key="BoolNegationToVisibilityConverter"
            FalseValue="Visible"
            TrueValue="Collapsed" />

        <!--  The HUD floats over the render, so its colors follow the render, not the app theme.  -->
        <SolidColorBrush x:Key="HudChipBrush" Color="#E6263540" />
        <SolidColorBrush x:Key="HudChipBorderBrush" Color="#33D7E8ED" />
        <SolidColorBrush x:Key="HudForegroundBrush" Color="#FFEDF4F7" />
        <SolidColorBrush x:Key="HudMutedForegroundBrush" Color="#FFB2C4CF" />
        <SolidColorBrush x:Key="FocusedViewportBorderBrush" Color="{ThemeResource SystemAccentColor}" />
        <SolidColorBrush x:Key="HudRejectedBorderBrush" Color="#FFE5484D" />
        <SolidColorBrush
            x:Key="MarqueeFillBrush"
            Opacity="0.15"
            Color="{ThemeResource SystemAccentColor}" />

        <!--
            DropDownButton's default style lives only in its theme dictionary; this keyed
            style sets properties over it without BasedOn.
        -->
        <Style x:Key="HudDropDownStyle" TargetType="DropDownButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="Background" Value="{StaticResource HudChipBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HudChipBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HudForegroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style
            x:Key="HudIconButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource HudChipBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HudChipBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HudForegroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="HudGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="FlyoutSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,12,8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FlyoutHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,4,8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FlyoutFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style
            x:Key="FlyoutRowButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="FlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Padding" Value="6,2,6,8" />
            <Setter Property="MaxHeight" Value="640" />
        </Style>

        <!--  One flyout choice: a check mark when current, the label and an optional description.  -->
        <DataTemplate x:Key="OptionTemplate" x:DataType="controls:ViewportOption">
            <Button
                Click="OnFlyoutChoiceClick"
                Command="{x:Bind ChooseCommand}"
                Style="{StaticResource FlyoutRowButtonStyle}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="13" Text="{x:Bind Label}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Description}"
                            Visibility="{x:Bind HasDescription}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!--  An orthographic direction: a compact tile in a three-column grid.  -->
        <DataTemplate x:Key="TileOptionTemplate" x:DataType="controls:ViewportOption">
            <Grid>
                <Button
                    HorizontalAlignment="Stretch"
                    Click="OnFlyoutChoiceClick"
                    Command="{x:Bind ChooseCommand}"
                    Content="{x:Bind Label}"
                    FontSize="12" />
                <Border
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsSelected, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OptionGroupTemplate" x:DataType="controls:ViewportOptionGroup">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource FlyoutSectionHeaderStyle}"
                    Text="{x:Bind Title}"
                    Visibility="{x:Bind HasTitle}" />
                <ItemsControl ItemTemplate="{StaticResource OptionTemplate}" ItemsSource="{x:Bind Options}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LayoutOptionTemplate" x:DataType="controls:ViewportLayoutOption">
            <Grid ToolTipService.ToolTip="{x:Bind Label}">
                <Button
                    Width="64"
                    Padding="4,6"
                    AutomationProperties.Name="{x:Bind Label}"
                    Click="OnFlyoutChoiceClick"
                    Command="{x:Bind ChooseCommand}">
                    <StackPanel Spacing="4">
                        <controls:ViewportLayoutPictogram HorizontalAlignment="Center" Layout="{x:Bind Layout}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Text="{x:Bind Label}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Border
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsSelected, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LayoutGroupTemplate" x:DataType="controls:ViewportLayoutGroup">
            <StackPanel>
                <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="{x:Bind Title}" />
                <ItemsRepeater
                    Margin="8,0"
                    ItemTemplate="{StaticResource LayoutOptionTemplate}"
                    ItemsSource="{x:Bind Options}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="4" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <SwapChainPanel x:Name="SwapChainPanel" Canvas.ZIndex="0" />

        <!--  Marquee selection, drawn while a left-drag selects.  -->
        <Canvas Canvas.ZIndex="50" IsHitTestVisible="False">
            <Rectangle
                x:Name="MarqueeRectangle"
                Fill="{StaticResource MarqueeFillBrush}"
                Stroke="{StaticResource FocusedViewportBorderBrush}"
                StrokeThickness="1"
                Visibility="Collapsed" />

            <!--  Gizmo drag feedback: a dashed tether from the pivot to the pointer and the applied value.  -->
            <Line
                x:Name="GizmoTether"
                Stroke="{StaticResource HudForegroundBrush}"
                StrokeDashArray="3,3"
                StrokeThickness="1"
                Visibility="Collapsed" />
            <Border
                x:Name="GizmoChip"
                Padding="8,4"
                Background="{StaticResource HudChipBrush}"
                BorderBrush="{StaticResource HudChipBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
                <TextBlock FontSize="11" Foreground="{StaticResource HudForegroundBrush}">
                    <Run x:Name="GizmoChipText" FontFamily="Consolas" />
                    <Run Text="  " />
                    <Run Foreground="{StaticResource HudMutedForegroundBrush}" Text="Esc cancel" />
                </TextBlock>
            </Border>
        </Canvas>

        <!--  Tool rail: the focused pane's transform tools.  -->
        <StackPanel
            x:Name="ToolRail"
            Margin="8,52,8,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Canvas.ZIndex="100"
            Spacing="4"
            Visibility="{x:Bind ViewModel.IsFocused, Mode=OneWay}">
            <Grid>
                <Button
                    AutomationProperties.Name="Select tool"
                    Command="{x:Bind ViewModel.TransformTools.UseSelectToolCommand, Mode=OneWay}"
                    Style="{StaticResource HudIconButtonStyle}"
                    ToolTipService.ToolTip="Select (Q)">
                    <FontIcon Glyph="&#xE7C9;" Style="{StaticResource HudGlyphStyle}" />
                </Button>
                <Border
                    BorderBrush="{StaticResource FocusedViewportBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.TransformTools.IsSelectTool, Mode=OneWay, FallbackValue=Collapsed}" />
            </Grid>
            <Grid>
                <Button
                    AutomationProperties.Name="Move tool"
                    Command="{x:Bind ViewModel.TransformTools.UseMoveToolCommand, Mode=OneWay}"
                    Style="{StaticResource HudIconButtonStyle}"
                    ToolTipService.ToolTip="Move (W)">
                    <FontIcon Glyph="&#xE7C2;" Style="{StaticResource HudGlyphStyle}" />
                </Button>
                <Border
                    BorderBrush="{StaticResource FocusedViewportBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.TransformTools.IsMoveTool, Mode=OneWay, FallbackValue=Collapsed}" />
            </Grid>
            <Grid>
                <Button
                    AutomationProperties.Name="Rotate tool"
                    Command="{x:Bind ViewModel.TransformTools.UseRotateToolCommand, Mode=OneWay}"
                    Style="{StaticResource HudIconButtonStyle}"
                    ToolTipService.ToolTip="Rotate (E)">
                    <FontIcon Glyph="&#xE7AD;" Style="{StaticResource HudGlyphStyle}" />
                </Button>
                <Border
                    BorderBrush="{StaticResource FocusedViewportBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.TransformTools.IsRotateTool, Mode=OneWay, FallbackValue=Collapsed}" />
            </Grid>
            <Grid>
                <Button
                    AutomationProperties.Name="Scale tool"
                    Command="{x:Bind ViewModel.TransformTools.UseScaleToolCommand, Mode=OneWay}"
                    Style="{StaticResource HudIconButtonStyle}"
                    ToolTipService.ToolTip="Scale (R)">
                    <FontIcon Glyph="&#xE740;" Style="{StaticResource HudGlyphStyle}" />
                </Button>
                <Border
                    BorderBrush="{StaticResource FocusedViewportBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind ViewModel.TransformTools.IsScaleTool, Mode=OneWay, FallbackValue=Collapsed}" />
            </Grid>
            <Border
                Height="1"
                Margin="4,2"
                Background="{StaticResource HudChipBorderBrush}" />
            <Button
                AutomationProperties.Name="Frame selection"
                Click="OnFrameSelectionClick"
                Style="{StaticResource HudIconButtonStyle}"
                ToolTipService.ToolTip="Frame selection (F) · Shift+F frames all">
                <FontIcon Glyph="&#xE71E;" Style="{StaticResource HudGlyphStyle}" />
            </Button>
        </StackPanel>

        <!--  HUD row  -->
        <Grid
            Margin="8"
            VerticalAlignment="Top"
            Canvas.ZIndex="100"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  View camera  -->
            <DropDownButton
                AutomationProperties.Name="View camera"
                Style="{StaticResource HudDropDownStyle}"
                ToolTipService.ToolTip="View camera: navigation mode, direction and lens">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE714;" Style="{StaticResource HudGlyphStyle}" />
                    <TextBlock
                        x:Name="CameraLabel"
                        MaxWidth="140"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.CameraMenuLabel, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout
                        x:Name="CameraFlyout"
                        FlyoutPresenterStyle="{StaticResource FlyoutPresenterStyle}"
                        Opening="OnCameraFlyoutOpening"
                        Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="288">
                            <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="Perspective" />
                            <ItemsControl ItemTemplate="{StaticResource OptionTemplate}" ItemsSource="{x:Bind ViewModel.PerspectiveModes, Mode=OneWay}" />

                            <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="Orthographic" />
                            <ItemsRepeater
                                Margin="8,0"
                                ItemTemplate="{StaticResource TileOptionTemplate}"
                                ItemsSource="{x:Bind ViewModel.OrthographicViews, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MaximumRowsOrColumns="3"
                                        MinColumnSpacing="4"
                                        MinItemWidth="80"
                                        MinRowSpacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>

                            <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="Fly speed" />
                            <Grid Margin="8,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Fly speed"
                                    Maximum="50"
                                    Minimum="1"
                                    StepFrequency="0.5"
                                    Value="{x:Bind ViewModel.FlySpeed, Mode=TwoWay}" />
                                <dnc:NumberBox
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalValueAlignment="Right"
                                    Mask="{x:Bind ViewModel.MovementSpeedField.Mask}"
                                    Multiplier="{x:Bind ViewModel.MovementSpeedField.Multiplier}"
                                    NumberValue="{x:Bind ViewModel.MovementSpeedField.NumberValue, Mode=TwoWay}"
                                    Tag="{x:Bind ViewModel.MovementSpeedField}"
                                    Validate="OnCameraNumberBoxValidate"
                                    WithPadding="False" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource FlyoutFieldLabelStyle}"
                                    Text="m/s" />
                            </Grid>
                            <TextBlock Style="{StaticResource FlyoutHintStyle}" Text="Fly: right-drag to look, WASD to move, Q/E down and up, Shift for speed." />

                            <StackPanel Visibility="{x:Bind ViewModel.IsPerspectiveView, Mode=OneWay}">
                                <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="Lens" />
                                <Grid Margin="8,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FlyoutFieldLabelStyle}" Text="Vertical field of view" />
                                    <dnc:NumberBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalValueAlignment="Right"
                                        Mask="{x:Bind ViewModel.FieldOfViewField.Mask}"
                                        Multiplier="{x:Bind ViewModel.FieldOfViewField.Multiplier}"
                                        NumberValue="{x:Bind ViewModel.FieldOfViewField.NumberValue, Mode=TwoWay}"
                                        Tag="{x:Bind ViewModel.FieldOfViewField}"
                                        Validate="OnCameraNumberBoxValidate"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource FlyoutFieldLabelStyle}"
                                        Text="°" />
                                </Grid>
                            </StackPanel>

                            <Expander
                                Margin="8,8,8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid>
                                        <TextBlock FontSize="12" Text="Clipping" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.ClippingSummary, Mode=OneWay}" />
                                    </Grid>
                                </Expander.Header>
                                <Grid ColumnSpacing="8" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FlyoutFieldLabelStyle}" Text="Near" />
                                    <dnc:NumberBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalValueAlignment="Right"
                                        Mask="{x:Bind ViewModel.NearViewPlaneField.Mask}"
                                        Multiplier="{x:Bind ViewModel.NearViewPlaneField.Multiplier}"
                                        NumberValue="{x:Bind ViewModel.NearViewPlaneField.NumberValue, Mode=TwoWay}"
                                        Tag="{x:Bind ViewModel.NearViewPlaneField}"
                                        Validate="OnCameraNumberBoxValidate"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource FlyoutFieldLabelStyle}"
                                        Text="m" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource FlyoutFieldLabelStyle}"
                                        Text="Far" />
                                    <dnc:NumberBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalValueAlignment="Right"
                                        Mask="{x:Bind ViewModel.FarViewPlaneField.Mask}"
                                        Multiplier="{x:Bind ViewModel.FarViewPlaneField.Multiplier}"
                                        NumberValue="{x:Bind ViewModel.FarViewPlaneField.NumberValue, Mode=TwoWay}"
                                        Tag="{x:Bind ViewModel.FarViewPlaneField}"
                                        Validate="OnCameraNumberBoxValidate"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource FlyoutFieldLabelStyle}"
                                        Text="m" />
                                </Grid>
                            </Expander>
                            <HyperlinkButton
                                Margin="4,4,0,0"
                                Command="{x:Bind ViewModel.ResetLensCommand}"
                                Content="Reset lens"
                                FontSize="12"
                                ToolTipService.ToolTip="Restore field of view and clipping; mode, speed and pose are unchanged" />

                            <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="Scene cameras" />
                            <ItemsControl
                                ItemTemplate="{StaticResource OptionTemplate}"
                                ItemsSource="{x:Bind ViewModel.SceneCameraOptions, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasSceneCameras, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource FlyoutHintStyle}"
                                Text="The scene has no cameras."
                                Visibility="{x:Bind ViewModel.HasSceneCameras, Mode=OneWay, Converter={StaticResource BoolNegationToVisibilityConverter}}" />
                            <Button
                                Margin="8,6,8,0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.TogglePilotCommand}"
                                Content="{x:Bind ViewModel.PilotLabel, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanPilot, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FlyoutHintStyle}" Text="{x:Bind ViewModel.PilotHint, Mode=OneWay}" />
                            <Button
                                Margin="8,8,8,0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.AlignSelectedCameraToViewCommand}"
                                IsEnabled="{x:Bind ViewModel.CanAlignCamera, Mode=OneWay}"
                                ToolTipService.ToolTip="Ctrl+Shift+F">
                                <TextBlock Text="{x:Bind ViewModel.AlignCameraLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <TextBlock Style="{StaticResource FlyoutHintStyle}" Text="{x:Bind ViewModel.AlignCameraDisabledReason, Mode=OneWay}" />

                            <Border
                                Margin="0,12,0,0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <TextBlock Style="{StaticResource FlyoutHintStyle}" Text="Editor viewpoint only · scene cameras are unchanged" />
                            </Border>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--  View mode  -->
            <DropDownButton
                Grid.Column="1"
                AutomationProperties.Name="View mode"
                Style="{StaticResource HudDropDownStyle}"
                ToolTipService.ToolTip="View mode">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE706;" Style="{StaticResource HudGlyphStyle}" />
                    <TextBlock
                        x:Name="ViewModeText"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ViewModeLabel, Mode=OneWay}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout
                        x:Name="ViewModeFlyout"
                        FlyoutPresenterStyle="{StaticResource FlyoutPresenterStyle}"
                        Placement="BottomEdgeAlignedLeft">
                        <ItemsControl
                            Width="232"
                            ItemTemplate="{StaticResource OptionGroupTemplate}"
                            ItemsSource="{x:Bind ViewModel.ViewModeGroups, Mode=OneWay}" />
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--  Show  -->
            <DropDownButton
                x:Name="ShowButton"
                Grid.Column="2"
                AutomationProperties.Name="Show"
                Style="{StaticResource HudDropDownStyle}"
                ToolTipService.ToolTip="Show overlays">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7B3;" Style="{StaticResource HudGlyphStyle}" />
                    <TextBlock
                        x:Name="ShowLabel"
                        VerticalAlignment="Center"
                        Text="Show" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <Flyout FlyoutPresenterStyle="{StaticResource FlyoutPresenterStyle}" Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="200" Padding="8,8,8,0">
                            <CheckBox Content="Grid" IsChecked="{x:Bind ViewModel.ShowGrid, Mode=TwoWay}" />
                            <CheckBox Content="Selection outline" IsChecked="{x:Bind ViewModel.ShowSelectionOutline, Mode=TwoWay}" />
                            <CheckBox Content="Camera preview" IsChecked="{x:Bind ViewModel.ShowCameraPreview, Mode=TwoWay}" />
                            <CheckBox Content="Statistics" IsChecked="{x:Bind ViewModel.ShowStatistics, Mode=TwoWay}" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--  Transform group: space, snapping and increments, in the focused pane.  -->
            <StackPanel
                x:Name="TransformGroup"
                Grid.Column="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="{x:Bind ViewModel.IsFocused, Mode=OneWay}">
                <Button
                    AutomationProperties.Name="Transform space"
                    Command="{x:Bind ViewModel.TransformTools.ToggleSpaceCommand, Mode=OneWay}"
                    Style="{StaticResource HudIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.TransformTools.SpaceToolTip, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.TransformTools.SpaceGlyph, Mode=OneWay}" Style="{StaticResource HudGlyphStyle}" />
                </Button>
                <Grid>
                    <Button
                        AutomationProperties.Name="Snapping"
                        Command="{x:Bind ViewModel.TransformTools.ToggleSnapCommand, Mode=OneWay}"
                        Style="{StaticResource HudIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.TransformTools.SnapToolTip, Mode=OneWay}">
                        <FontIcon Glyph="&#xE80A;" Style="{StaticResource HudGlyphStyle}" />
                    </Button>
                    <Border
                        BorderBrush="{StaticResource FocusedViewportBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind ViewModel.TransformTools.SnapEnabled, Mode=OneWay, FallbackValue=Collapsed}" />
                </Grid>
                <DropDownButton
                    x:Name="TranslationSnapButton"
                    AutomationProperties.Name="Move snap increment"
                    Content="{x:Bind ViewModel.TransformTools.TranslationLabel, Mode=OneWay}"
                    Style="{StaticResource HudDropDownStyle}"
                    ToolTipService.ToolTip="Move snap increment">
                    <DropDownButton.Flyout>
                        <Flyout
                            x:Name="TranslationSnapFlyout"
                            FlyoutPresenterStyle="{StaticResource FlyoutPresenterStyle}"
                            Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="232">
                                <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="Move snap" />
                                <ItemsRepeater
                                    Margin="8,0"
                                    ItemTemplate="{StaticResource TileOptionTemplate}"
                                    ItemsSource="{x:Bind ViewModel.TransformTools.TranslationOptions, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MaximumRowsOrColumns="3"
                                            MinColumnSpacing="4"
                                            MinItemWidth="64"
                                            MinRowSpacing="4" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Grid Margin="8,8,8,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FlyoutFieldLabelStyle}" Text="Custom" />
                                    <dnc:NumberBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalValueAlignment="Right"
                                        Mask="{x:Bind ViewModel.TransformTools.TranslationField.Mask, Mode=OneWay}"
                                        NumberValue="{x:Bind ViewModel.TransformTools.TranslationField.NumberValue, Mode=TwoWay}"
                                        Tag="{x:Bind ViewModel.TransformTools.TranslationField, Mode=OneWay}"
                                        Validate="OnCameraNumberBoxValidate"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource FlyoutFieldLabelStyle}"
                                        Text="m" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton
                    x:Name="RotationSnapButton"
                    AutomationProperties.Name="Rotate snap increment"
                    Content="{x:Bind ViewModel.TransformTools.RotationLabel, Mode=OneWay}"
                    Style="{StaticResource HudDropDownStyle}"
                    ToolTipService.ToolTip="Rotate snap increment">
                    <DropDownButton.Flyout>
                        <Flyout
                            x:Name="RotationSnapFlyout"
                            FlyoutPresenterStyle="{StaticResource FlyoutPresenterStyle}"
                            Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="232">
                                <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="Rotate snap" />
                                <ItemsRepeater
                                    Margin="8,0"
                                    ItemTemplate="{StaticResource TileOptionTemplate}"
                                    ItemsSource="{x:Bind ViewModel.TransformTools.RotationOptions, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MaximumRowsOrColumns="4"
                                            MinColumnSpacing="4"
                                            MinItemWidth="48"
                                            MinRowSpacing="4" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Grid Margin="8,8,8,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FlyoutFieldLabelStyle}" Text="Custom" />
                                    <dnc:NumberBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalValueAlignment="Right"
                                        Mask="{x:Bind ViewModel.TransformTools.RotationField.Mask, Mode=OneWay}"
                                        NumberValue="{x:Bind ViewModel.TransformTools.RotationField.NumberValue, Mode=TwoWay}"
                                        Tag="{x:Bind ViewModel.TransformTools.RotationField, Mode=OneWay}"
                                        Validate="OnCameraNumberBoxValidate"
                                        WithPadding="False" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource FlyoutFieldLabelStyle}"
                                        Text="°" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton
                    x:Name="ScaleSnapButton"
                    AutomationProperties.Name="Scale snap increment"
                    Content="{x:Bind ViewModel.TransformTools.ScaleLabel, Mode=OneWay}"
                    Style="{StaticResource HudDropDownStyle}"
                    ToolTipService.ToolTip="Scale snap increment">
                    <DropDownButton.Flyout>
                        <Flyout
                            x:Name="ScaleSnapFlyout"
                            FlyoutPresenterStyle="{StaticResource FlyoutPresenterStyle}"
                            Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="232">
                                <TextBlock Style="{StaticResource FlyoutSectionHeaderStyle}" Text="Scale snap" />
                                <ItemsRepeater
                                    Margin="8,0"
                                    ItemTemplate="{StaticResource TileOptionTemplate}"
                                    ItemsSource="{x:Bind ViewModel.TransformTools.ScaleOptions, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MaximumRowsOrColumns="3"
                                            MinColumnSpacing="4"
                                            MinItemWidth="64"
                                            MinRowSpacing="4" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <Grid Margin="8,8,8,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FlyoutFieldLabelStyle}" Text="Custom" />
                                    <dnc:NumberBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalValueAlignment="Right"
                                        Mask="{x:Bind ViewModel.TransformTools.ScaleField.Mask, Mode=OneWay}"
                                        NumberValue="{x:Bind ViewModel.TransformTools.ScaleField.NumberValue, Mode=TwoWay}"
                                        Tag="{x:Bind ViewModel.TransformTools.ScaleField, Mode=OneWay}"
                                        Validate="OnCameraNumberBoxValidate"
                                        WithPadding="False" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <!--  Layout  -->
            <Button
                x:Name="LayoutButton"
                Grid.Column="4"
                AutomationProperties.Name="Viewport layout"
                Style="{StaticResource HudIconButtonStyle}"
                ToolTipService.ToolTip="Viewport layout">
                <FontIcon Glyph="&#xF0E2;" Style="{StaticResource HudGlyphStyle}" />
                <Button.Flyout>
                    <Flyout
                        x:Name="LayoutFlyout"
                        FlyoutPresenterStyle="{StaticResource FlyoutPresenterStyle}"
                        Placement="BottomEdgeAlignedRight">
                        <ItemsControl ItemTemplate="{StaticResource LayoutGroupTemplate}" ItemsSource="{x:Bind ViewModel.LayoutGroups, Mode=OneWay}" />
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--  Viewport settings: the controls a narrow pane cannot show  -->
            <Button
                x:Name="SettingsButton"
                Grid.Column="5"
                AutomationProperties.Name="Viewport settings"
                Style="{StaticResource HudIconButtonStyle}"
                ToolTipService.ToolTip="Viewport settings"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE9E9;" Style="{StaticResource HudGlyphStyle}" />
                <Button.Flyout>
                    <MenuFlyout Opening="OnSettingsFlyoutOpening" Placement="BottomEdgeAlignedRight" />
                </Button.Flyout>
            </Button>

            <!--  Maximize / restore  -->
            <Button
                Grid.Column="6"
                AutomationProperties.Name="{x:Bind ViewModel.MaximizeToolTip, Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleMaximizeCommand, Mode=OneWay}"
                Style="{StaticResource HudIconButtonStyle}"
                ToolTipService.ToolTip="{x:Bind ViewModel.MaximizeToolTip, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind ViewModel.MaximizeGlyph, Mode=OneWay}" Style="{StaticResource HudGlyphStyle}" />
            </Button>
        </Grid>

        <!--  Navigation hint: the focused pane, until the user navigates with its camera.  -->
        <Border
            x:Name="GestureHint"
            Margin="8"
            Padding="10,5"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{StaticResource HudChipBrush}"
            BorderBrush="{StaticResource HudChipBorderBrush}"
            BorderThickness="1"
            Canvas.ZIndex="100"
            CornerRadius="4"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.IsGestureHintVisible, Mode=OneWay}">
            <TextBlock
                FontSize="11"
                Foreground="{StaticResource HudMutedForegroundBrush}"
                TextTrimming="CharacterEllipsis">
                <Run
                    FontWeight="SemiBold"
                    Foreground="{StaticResource HudForegroundBrush}"
                    Text="{x:Bind ViewModel.CameraMenuLabel, Mode=OneWay}" />
                <Run Text="  " />
                <Run Text="{x:Bind ViewModel.GestureHint, Mode=OneWay}" />
            </TextBlock>
        </Border>

        <!--  Notice about the last framing request, shown briefly.  -->
        <Border
            Margin="8,8,8,40"
            Padding="10,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{StaticResource HudChipBrush}"
            BorderBrush="{StaticResource HudChipBorderBrush}"
            BorderThickness="1"
            Canvas.ZIndex="100"
            CornerRadius="4"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.IsNoticeVisible, Mode=OneWay}">
            <TextBlock
                FontSize="11"
                Foreground="{StaticResource HudForegroundBrush}"
                Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </Border>

        <!--  Frame statistics  -->
        <Border
            Margin="8"
            Padding="10,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource HudChipBrush}"
            BorderBrush="{StaticResource HudChipBorderBrush}"
            BorderThickness="1"
            Canvas.ZIndex="100"
            CornerRadius="4"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.ShowStatistics, Mode=OneWay}">
            <TextBlock
                FontFamily="Consolas"
                FontSize="11"
                Foreground="{StaticResource HudForegroundBrush}"
                Text="{x:Bind ViewModel.StatisticsText, Mode=OneWay}" />
        </Border>

        <!--  Focus highlight drawn as overlay so it does not affect layout/measure.  -->
        <Border
            BorderBrush="{StaticResource FocusedViewportBorderBrush}"
            BorderThickness="2"
            Canvas.ZIndex="101"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.IsFocused, Mode=OneWay}" />
        <VisualStateManager.VisualStateGroups>
            <!--  The pane's width decides its HUD density; see OnSizeChanged.  -->
            <VisualStateGroup x:Name="DensityStates">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="CameraLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ViewModeText.Visibility" Value="Collapsed" />
                        <Setter Target="ShowLabel.Visibility" Value="Collapsed" />
                        <Setter Target="RotationSnapButton.Visibility" Value="Collapsed" />
                        <Setter Target="ScaleSnapButton.Visibility" Value="Collapsed" />
                        <Setter Target="SettingsButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="CameraLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ViewModeText.Visibility" Value="Collapsed" />
                        <Setter Target="ShowButton.Visibility" Value="Collapsed" />
                        <Setter Target="LayoutButton.Visibility" Value="Collapsed" />
                        <Setter Target="SettingsButton.Visibility" Value="Visible" />
                        <Setter Target="GestureHint.Visibility" Value="Collapsed" />
                        <Setter Target="TransformGroup.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
