<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0-windows10.0.26100.0</TargetFrameworks>
        <RootNamespace>Oxygen.Editor.World.Tests</RootNamespace>
        <AssemblyName>Oxygen.Editor.WorldEditor.UI.Tests</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\..\..\Oxygen.Editor.ContentBrowser\testsupport\AssetStatusFixture.cs" Link="AssetStatusFixture.cs" />
        <ProjectReference Include="..\..\src\Oxygen.Editor.WorldEditor.csproj" />
        <PackageReference Include="Moq" />
        <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <Compile Include="$(ProjectsRoot)\Oxygen.Managed.Core\testsupport\TemporaryNativeArtifacts.cs" Link="TemporaryNativeArtifacts.cs" />
        <Compile Include="$(ProjectsRoot)\Oxygen.Editor.ContentPipeline\testsupport\BuiltinCatalogDiscoveryFixture.cs" Link="BuiltinCatalogDiscoveryFixture.cs" />
        <None Include="$(ProjectsRoot)\Oxygen.Editor.ContentPipeline\tests\Fixtures\BuiltinGeometryCatalog.json" Link="Fixtures\BuiltinGeometryCatalog.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Cooker\Test\Import\Models\static_scalar_triangle.gltf" Link="Fixtures\static_scalar_triangle.gltf" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Cooker\Test\Import\Models\static_scalar_triangle.fbx" Link="Fixtures\static_scalar_triangle.fbx" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)\bin')">
        <None Include="$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)\bin\*.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>
    <Import Project="$(ProjectsRoot)\UITests.Shared\src\UITests.Shared.projitems" Label="Shared" />
</Project>
