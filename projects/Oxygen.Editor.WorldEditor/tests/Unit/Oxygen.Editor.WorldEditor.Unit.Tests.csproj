<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <RootNamespace>Oxygen.Editor.WorldEditor.Unit.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Oxygen.Editor.WorldEditor.csproj" />
      <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Input\testing\Oxygen.Editor.Input.Testing.csproj" />
    </ItemGroup>

    <ItemGroup Condition="Exists('$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)\bin')">
      <None Include="$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)\bin\*.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Moq" />
        <PackageReference Include="Testably.Abstractions.Testing" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="$(MyTopLevelDirectory)projects/Oxygen.Editor.WorldEditor/testsupport/Authoring/SceneAuthoringFixture.cs" Link="Fixtures/SceneAuthoringFixture.cs" />
        <Compile Include="$(MyTopLevelDirectory)projects/Oxygen.Editor.WorldEditor/testsupport/Authoring/SceneTab.cs" Link="Fixtures/SceneTab.cs" />
        <Compile Include="$(MyTopLevelDirectory)projects/Oxygen.Editor.WorldEditor/testsupport/Authoring/SceneTabs.cs" Link="Fixtures/SceneTabs.cs" />
        <Compile Include="$(MyTopLevelDirectory)projects/Oxygen.Editor.WorldEditor/testsupport/Authoring/TestDocumentArea.cs" Link="Fixtures/TestDocumentArea.cs" />
        <Compile Include="$(MyTopLevelDirectory)projects/Oxygen.Editor.WorldEditor/testsupport/Authoring/SceneTestData.cs" Link="Fixtures/SceneTestData.cs" />
    </ItemGroup>
</Project>
