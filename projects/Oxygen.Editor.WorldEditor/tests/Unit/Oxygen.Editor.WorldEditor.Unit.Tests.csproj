<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <RootNamespace>Oxygen.Editor.WorldEditor.Unit.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\Oxygen.Editor.WorldEditor.csproj" />
      <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Input\testing\Oxygen.Editor.Input.Testing.csproj" />
      <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Scripting\testing\Oxygen.Editor.Scripting.Testing.csproj" />
      <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Scenes\testing\Oxygen.Editor.Scenes.Testing.csproj" />
      <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Shell\testing\Oxygen.Editor.Shell.Testing.csproj" />
      <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.ContentPipeline\testing\Oxygen.Editor.ContentPipeline.Testing.csproj" />
      <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Projects\testing\Oxygen.Editor.Projects.Testing.csproj" />
    </ItemGroup>

    <ItemGroup Condition="Exists('$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)\bin')">
      <None Include="$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)\bin\*.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Moq" />
        <PackageReference Include="Testably.Abstractions.Testing" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>
    <ItemGroup>
    </ItemGroup>
</Project>
