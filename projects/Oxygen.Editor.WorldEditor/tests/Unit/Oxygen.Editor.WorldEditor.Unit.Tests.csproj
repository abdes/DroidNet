<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <RootNamespace>Oxygen.Editor.WorldEditor.Unit.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\..\Oxygen.Editor.ContentBrowser\testsupport\AssetStatusFixture.cs" Link="AssetStatusFixture.cs" />
      <ProjectReference Include="..\..\src\Oxygen.Editor.WorldEditor.csproj" />
    </ItemGroup>

    <ItemGroup Condition="Exists('$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)\bin')">
      <None Include="$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)\bin\*.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Moq" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="$(ProjectsRoot)\Oxygen.Editor.ContentPipeline\testsupport\BuiltinCatalogDiscoveryFixture.cs" Link="BuiltinCatalogDiscoveryFixture.cs" />
        <None Include="$(ProjectsRoot)\Oxygen.Editor.ContentPipeline\tests\Fixtures\BuiltinGeometryCatalog.json" Link="Fixtures\BuiltinGeometryCatalog.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="$(MyTopLevelDirectory)projects/Oxygen.Editor.WorldEditor/testsupport/Authoring/SceneAuthoringFixture.cs" Link="Fixtures/SceneAuthoringFixture.cs" />
        <Compile Include="$(MyTopLevelDirectory)projects/Oxygen.Editor.WorldEditor/testsupport/Authoring/SceneTestData.cs" Link="Fixtures/SceneTestData.cs" />
    </ItemGroup>
</Project>
