<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWinUI>true</UseWinUI>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <Title>Oxygen Editor Problems</Title>
        <Description>The Problems panel: the problems of every asset family of the project and of the running scene.</Description>
        <PackageTags>oxygen;gameengine</PackageTags>
        <RootNamespace>Oxygen.Editor.Problems</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="DryIoc.dll" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)/Mvvm/src/Mvvm.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Routing/Routing.Abstractions/src/Routing.Abstractions.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.LivePreview/src/Oxygen.Editor.LivePreview.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Projects/src/Oxygen.Editor.Projects.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Scenes/src/Oxygen.Editor.Scenes.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Scripting/src/Oxygen.Editor.Scripting.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Shell/src/Oxygen.Editor.Shell.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Managed.Assets/src/Oxygen.Managed.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Managed.Core/src/Oxygen.Managed.Core.csproj" />

        <ProjectReference Include="$(ProjectsRoot)/Mvvm.Generators/src/Mvvm.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="$(ProjectsRoot)/Mvvm.Generators.Attributes/src/Mvvm.Generators.Attributes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Oxygen.Editor.Problems.Unit.Tests" />
    </ItemGroup>

</Project>
