<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>

        <RootNamespace>Oxygen.Managed.Core</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>

        <Title>Oxygen Managed Core</Title>
        <Description>Oxygen managed core services and utilities, including extensions to framework classes.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>oxygen;gameengine</PackageTags>
        <PackageReleaseNotes>Initial version.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Testably.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Config\src\Config.csproj" />
    </ItemGroup>

    <!--
        Unicode tables of the virtual path rules: UnicodeTablesGenerator reads the pinned Unicode Character Database,
        which the installed engine SDK ships, at compile time. The compiler reruns it only when a file changes.
    -->
    <PropertyGroup>
        <UnicodeDatabase>$(OxygenSdkDataDir)\unicode\15.1.0</UnicodeDatabase>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Generators\src\Oxygen.Managed.Core.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <AdditionalFiles Include="$(UnicodeDatabase)\DerivedAge.txt;$(UnicodeDatabase)\CaseFolding.txt" Link="Unicode\%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
