<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <RootNamespace>Oxygen.Managed.Core.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\src\Oxygen.Managed.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Moq" />
    </ItemGroup>

    <!-- The case table of the virtual path rules lives beside the engine's VirtualPath.h; both suites run it. -->
    <ItemGroup>
        <None Include="$(ProjectsRoot)\Oxygen.Engine\src\Oxygen\Content\VirtualPathCases.json" Link="VirtualPathCases.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
