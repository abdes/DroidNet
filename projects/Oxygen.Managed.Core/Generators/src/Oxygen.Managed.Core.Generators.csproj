<?xml version="1.0" encoding="utf-8"?>

<!--
    Source generators of Oxygen.Managed.Core. They run inside the compiler, so the project targets
    netstandard2.0 and is referenced as an analyzer, never as an assembly.
-->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>

        <IncludeSymbols>false</IncludeSymbols>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>false</IsPackable>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <DevelopmentDependency>true</DevelopmentDependency>

        <RootNamespace>Oxygen.Managed.Core.Generators</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <Title>Oxygen Managed Core generators</Title>
        <Description>Generates the Unicode tables of the virtual path rules from the pinned Unicode Character Database.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all"
            IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

</Project>
