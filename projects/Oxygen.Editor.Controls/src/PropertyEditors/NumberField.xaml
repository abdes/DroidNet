<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.Controls">
    <!--  The value box's style, merged here so the template resolves it wherever this dictionary is merged.  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Oxygen.Editor.Controls/PropertyEditors/PropertyValueBoxes.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="DefaultNumberFieldStyle" TargetType="local:NumberField">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NumberField">
                    <!--  Feedback sits below the card, so its wrapping text never decides whether the row stacks.  -->
                    <StackPanel Spacing="2">
                        <local:PropertyCard
                            HorizontalContentAlignment="Stretch"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            LabelWidth="{TemplateBinding LabelWidth}"
                            Layout="{TemplateBinding Layout}"
                            OverrideActions="{TemplateBinding OverrideActions}"
                            OverrideState="{TemplateBinding OverrideState}"
                            PropertyName="{TemplateBinding Label}"
                            Qualifier="{TemplateBinding Qualifier}"
                            QualifierGroup="{TemplateBinding QualifierGroup}"
                            ResetCommand="{TemplateBinding ResetCommand}"
                            ResetToolTip="{TemplateBinding ResetToolTip}">
                            <controls:NumberBox
                                x:Name="PART_NumberBox"
                                AutomationProperties.Name="{TemplateBinding Label}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontWeight="{TemplateBinding FontWeight}"
                                IsIndeterminate="{TemplateBinding IsMixed}"
                                LabelPosition="None"
                                Mask="{TemplateBinding Mask}"
                                Prefix="{TemplateBinding Prefix}"
                                Style="{StaticResource PropertyNumberBoxStyle}"
                                Tag="{TemplateBinding Tag}"
                                Unit="{TemplateBinding Unit}" />
                        </local:PropertyCard>
                        <TextBlock
                            x:Name="PART_ErrorText"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{TemplateBinding ErrorText}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="PART_ApplicabilityText"
                            FontSize="12"
                            Text="{TemplateBinding ApplicabilityText}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DefaultNumberFieldStyle}" TargetType="local:NumberField" />
</ResourceDictionary>
