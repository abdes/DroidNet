<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oxygen.Editor.Controls">
    <!--  Each control dictionary merges the shared resources it uses, so it resolves them wherever it is merged.  -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Oxygen.Editor.Controls/Themes/ThemeResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style BasedOn="{StaticResource DefaultPropertyCardStyle}" TargetType="local:PropertyCard" />
    <Style x:Key="DefaultPropertyCardStyle" TargetType="local:PropertyCard">
        <Setter Property="Foreground" Value="{ThemeResource PropertyCardForeground}" />
        <Setter Property="FontSize" Value="{ThemeResource PropertyCardHeaderFontSize}" />
        <Setter Property="LabelWidth" Value="{ThemeResource PropertyCardLabelWidth}" />
        <Setter Property="MinHeight" Value="{ThemeResource PropertyCardMinHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PropertyCard">
                    <!--
                        The override bar sits in the gutter before the row and the reset button at the end of the value,
                        so every row splits label and value alike and marked and unmarked rows stay aligned.
                    -->
                    <Grid x:Name="CardRoot">
                        <Rectangle
                            x:Name="OverrideBar"
                            Width="3"
                            Margin="{ThemeResource PropertyCardOverrideBarMargin}"
                            HorizontalAlignment="Left"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            RadiusX="1"
                            RadiusY="1"
                            Visibility="Collapsed" />
                        <Grid x:Name="RootGrid" Padding="{TemplateBinding Padding}">
                            <Grid
                                x:Name="PropertyHeader"
                                VerticalAlignment="Center"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="PropertyName"
                                    FontSize="{TemplateBinding FontSize}"
                                    Text="{TemplateBinding PropertyName}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{TemplateBinding PropertyName}" />
                                <TextBlock
                                    x:Name="HeaderQualifier"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{TemplateBinding Qualifier}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    x:Name="ValueLeading"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Top"
                                    Content="{TemplateBinding LeadingContent}" />
                                <ContentPresenter
                                    x:Name="PropertyEditor"
                                    Grid.Column="1"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <TextBlock
                                    x:Name="ValueQualifier"
                                    Grid.Column="2"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{TemplateBinding Qualifier}" />
                                <Button
                                    x:Name="ResetButton"
                                    Grid.Column="3"
                                    Margin="4,0,0,0"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{TemplateBinding ResetToolTip}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{TemplateBinding ResetCommand}"
                                    ToolTipService.ToolTip="{TemplateBinding ResetToolTip}"
                                    Visibility="Collapsed">
                                    <FontIcon FontSize="12" Glyph="&#xE777;" />
                                </Button>
                            </Grid>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
