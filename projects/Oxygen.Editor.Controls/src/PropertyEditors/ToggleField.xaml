<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oxygen.Editor.Controls">
    <Style x:Key="DefaultToggleFieldStyle" TargetType="local:ToggleField">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToggleField">
                    <local:PropertyCard
                        HorizontalContentAlignment="Stretch"
                        FontSize="{TemplateBinding FontSize}"
                        OverrideActions="{TemplateBinding OverrideActions}"
                        OverrideState="{TemplateBinding OverrideState}"
                        PropertyName="{TemplateBinding Label}"
                        ResetCommand="{TemplateBinding ResetCommand}"
                        ResetToolTip="{TemplateBinding ResetToolTip}">
                        <ToggleSwitch
                            x:Name="PART_Switch"
                            AutomationProperties.Name="{TemplateBinding Label}"
                            OffContent=""
                            OnContent=""
                            Tag="{TemplateBinding Tag}" />
                    </local:PropertyCard>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DefaultToggleFieldStyle}" TargetType="local:ToggleField" />
</ResourceDictionary>
