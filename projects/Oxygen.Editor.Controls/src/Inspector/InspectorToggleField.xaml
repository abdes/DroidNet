<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.Controls.InspectorToggleField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Oxygen.Editor.Controls"
    x:Name="Root">
    <local:PropertyCard
        x:Name="Card"
        HorizontalContentAlignment="Stretch"
        FontSize="{x:Bind FontSize, Mode=OneWay}"
        OverrideState="{x:Bind OverrideState, Mode=OneWay}"
        PropertyName="{x:Bind Label, Mode=OneWay}"
        ResetCommand="{x:Bind ResetCommand, Mode=OneWay}"
        ResetToolTip="{x:Bind ResetToolTip, Mode=OneWay}">
        <ToggleSwitch
            x:Name="Switch"
            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
            OffContent=""
            OnContent=""
            Tag="{Binding Tag, ElementName=Root}"
            Toggled="OnToggled" />
    </local:PropertyCard>
</UserControl>
