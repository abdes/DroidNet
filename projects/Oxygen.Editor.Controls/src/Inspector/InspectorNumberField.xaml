<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.Controls.InspectorNumberField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.Controls"
    x:Name="Root">
    <!--  Feedback sits below the card, so its wrapping text never decides whether the row stacks.  -->
    <StackPanel Spacing="2">
        <local:PropertyCard
            x:Name="Card"
            HorizontalContentAlignment="Stretch"
            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
            FontSize="{x:Bind FontSize, Mode=OneWay}"
            FontWeight="{x:Bind FontWeight, Mode=OneWay}"
            LabelWidth="{x:Bind LabelWidth, Mode=OneWay}"
            Layout="{x:Bind Layout, Mode=OneWay}"
            PropertyName="{x:Bind Label, Mode=OneWay}"
            Qualifier="{x:Bind Qualifier, Mode=OneWay}"
            QualifierGroup="{x:Bind QualifierGroup, Mode=OneWay}"
            Style="{x:Bind CardStyle, Mode=OneWay}">
            <controls:NumberBox
                x:Name="Number"
                AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                EditSessionCompleted="OnEditSessionCompleted"
                EditSessionStarted="OnEditSessionStarted"
                FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                FontWeight="{x:Bind FontWeight, Mode=OneWay}"
                IsIndeterminate="{x:Bind IsMixed, Mode=OneWay}"
                LabelPosition="None"
                Mask="{x:Bind Mask, Mode=OneWay}"
                NumberValue="{x:Bind NumberValue, Mode=TwoWay}"
                Prefix="{x:Bind Prefix, Mode=OneWay}"
                Style="{x:Bind NumberStyle, Mode=OneWay}"
                Tag="{Binding Tag, ElementName=Root}"
                Unit="{x:Bind Unit, Mode=OneWay}"
                Validate="OnValidate" />
        </local:PropertyCard>
        <TextBlock
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ErrorText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind HasError, Mode=OneWay}" />
        <TextBlock
            FontSize="12"
            Text="{x:Bind ApplicabilityText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind local:InspectorNumberField.CollapsedWhenEmpty(ApplicabilityText), Mode=OneWay}" />
    </StackPanel>
</UserControl>
