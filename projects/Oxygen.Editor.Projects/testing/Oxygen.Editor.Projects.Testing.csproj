<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <Title>Oxygen Editor Projects Testing</Title>
        <Description>Test kit of the Projects module: projects built over any file system, for the tests of the modules that use Projects.</Description>
        <PackageTags>oxygen;editor;projects;testing</PackageTags>
        <PackageReleaseNotes>Initial version.</PackageReleaseNotes>
        <RootNamespace>Oxygen.Editor.Projects.Testing</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Testably.Abstractions.FileSystem.Interface" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Projects\src\Oxygen.Editor.Projects.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\src\Oxygen.Managed.Core.csproj" />
    </ItemGroup>

</Project>
