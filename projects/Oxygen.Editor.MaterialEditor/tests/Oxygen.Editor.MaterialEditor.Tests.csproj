<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>$(DefaultItemExcludes);UI/**</DefaultItemExcludes>

        <RootNamespace>Oxygen.Editor.MaterialEditor.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Moq" />
        <PackageReference Include="Testably.Abstractions.Testing" />
        <ProjectReference Include="..\src\Oxygen.Editor.MaterialEditor.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.ContentPipeline\testing\Oxygen.Editor.ContentPipeline.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\testing\Oxygen.Managed.Core.Testing.csproj" />
    </ItemGroup>

</Project>
