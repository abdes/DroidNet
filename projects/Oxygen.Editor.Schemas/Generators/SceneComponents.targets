<?xml version="1.0" encoding="utf-8"?>

<!--
    Generates code from the engine's scene components schema. A project sets SceneComponentsOutput to what it owns
    (WireIds, PropertyIds or WireTable) before importing this file; SceneComponentsGenerator reads the schema the
    installed engine SDK ships, like every other engine input of the editor, and reports any problem in it as an error
    at its line.
-->
<Project>

    <PropertyGroup>
        <SceneComponentsSchema>$(OxygenSdkSchemasDir)\SceneComponents.yaml</SceneComponentsSchema>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Schemas\Generators\src\Oxygen.Editor.Schemas.Generators.csproj"
            OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <AdditionalFiles Include="$(SceneComponentsSchema)" Link="Schema\%(Filename)%(Extension)" />
        <CompilerVisibleProperty Include="SceneComponentsOutput" />
    </ItemGroup>

    <Target Name="CheckSceneComponentsSchema" BeforeTargets="CoreCompile" Condition="!Exists('$(SceneComponentsSchema)')">
        <Error Text="The scene components schema $(SceneComponentsSchema) is missing: install the engine SDK ($(Configuration)) first." />
    </Target>

</Project>
