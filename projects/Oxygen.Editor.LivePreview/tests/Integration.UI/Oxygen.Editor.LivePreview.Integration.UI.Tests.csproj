<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <RootNamespace>Oxygen.Editor.LivePreview.Integration.UI.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DroidNetTestTier>Integration</DroidNetTestTier>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\Oxygen.Editor.LivePreview.csproj" />
        <PackageReference Include="Moq" />
        <PackageReference Include="Testably.Abstractions" />
        <PackageReference Include="Testably.Abstractions.Testing" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Scenes\testing\Oxygen.Editor.Scenes.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Projects\testing\Oxygen.Editor.Projects.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.ContentPipeline\testing\Oxygen.Editor.ContentPipeline.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\testing\Oxygen.Managed.Core.Testing.csproj" />
        <Compile Include="../TestSupport/Native/*.cs" Link="TestSupport/Native/%(Filename)%(Extension)" />
    </ItemGroup>
    <Import Project="$(ProjectsRoot)/UITests.Shared/src/UITests.Shared.projitems" Label="Shared" />
    <ItemGroup Condition="Exists('$(OxygenSdkDir)/bin')">
        <None Include="$(OxygenSdkDir)/bin/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
