<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <RootNamespace>$(RootNamespace).Coordinates.Tests</RootNamespace>
        <AssemblyName>DroidNet.Coordinates.Tests</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Coordinates\src\Coordinates.csproj" />
    </ItemGroup>

    <Import Project="$(ProjectsRoot)\UITests.Shared\src\UITests.Shared.projitems" Label="Shared" />

    <ItemGroup>
        <PackageReference Include="DryIoc.dll" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    </ItemGroup>

</Project>
