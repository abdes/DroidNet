<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <RootNamespace>Oxygen.Editor.Models.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\src\Oxygen.Editor.Models.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Testably.Abstractions.Testing" />
    </ItemGroup>

    <ItemGroup>
        <!-- The installed engine schemas the module's vocabulary is checked against. -->
        <None Include="$(OxygenSdkSchemasDir)\oxygen.import-manifest.schema.json" Link="Schemas\oxygen.import-manifest.schema.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(OxygenSdkSchemasDir)\oxygen.source-analysis.schema.json" Link="Schemas\oxygen.source-analysis.schema.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
