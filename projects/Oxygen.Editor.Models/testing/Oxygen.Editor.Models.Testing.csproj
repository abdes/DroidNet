<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <Title>Oxygen Editor Models Testing</Title>
        <Description>Test kit of the Models module: the one writer of model import records in the editor's tests.</Description>
        <PackageTags>oxygen;editor;models;testing</PackageTags>
        <PackageReleaseNotes>Initial version.</PackageReleaseNotes>
        <RootNamespace>Oxygen.Editor.Models.Testing</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Testably.Abstractions.FileSystem.Interface" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Models\src\Oxygen.Editor.Models.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Projects\src\Oxygen.Editor.Projects.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\src\Oxygen.Managed.Core.csproj" />
    </ItemGroup>

</Project>
