<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.Cooking.CookingPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:console="using:DroidNet.Controls.OutputConsole"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.Cooking"
    x:Name="Root"
    Background="{ThemeResource LayerFillColorDefaultBrush}">
    <UserControl.Resources>
        <Thickness x:Key="ExpanderHeaderPadding">10,0,10,0</Thickness>
        <Style x:Key="CookListItem" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style
            x:Key="CookAssetItem"
            BasedOn="{StaticResource CookListItem}"
            TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="CookIssueItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <DataTemplate x:Key="CookRunTemplate" x:DataType="local:CookingRunViewModel">
            <Grid ColumnSpacing="8" Loaded="OnRowContentLoaded">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:CookingStatusIndicator
                    Margin="0,4,0,0"
                    VerticalAlignment="Top"
                    State="{x:Bind Snapshot.State, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Name}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Context}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CookAssetTemplate" x:DataType="local:CookingAssetViewModel">
            <Grid
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                ColumnSpacing="8"
                Loaded="OnRowContentLoaded">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <local:CookingStatusIndicator
                    Caption="{x:Bind Status, Mode=OneWay}"
                    Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                    IsReused="{x:Bind IsReused, Mode=OneWay}"
                    State="{x:Bind IndicatorState, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="1"
                    MaxWidth="220"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Name}" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Kind}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CookIssueTemplate" x:DataType="local:CookingIssueViewModel">
            <Grid
                Padding="4,8"
                ColumnSpacing="12"
                RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,2,0,0" VerticalAlignment="Top">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;"
                        Visibility="{x:Bind ErrorVisibility}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;"
                        Visibility="{x:Bind WarningVisibility}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                        Glyph="&#xE946;"
                        Visibility="{x:Bind InfoVisibility}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Caption, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind CaptionVisibility, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Padding="8,1"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Visibility="{x:Bind CountVisibility, Mode=OneWay}">
                        <TextBlock FontSize="12" Text="{x:Bind CountText, Mode=OneWay}" />
                    </Border>
                    <HyperlinkButton
                        Padding="4,0"
                        Click="GoToPropertyClicked"
                        Content="{x:Bind ActionLabel}"
                        Visibility="{x:Bind ActionVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="SplitRoot" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="RunColumn"
                Width="220"
                MinWidth="150" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="RunSidebar" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <dnc:ToolBar
                x:Name="RunListToolbar"
                AutomationProperties.Name="Cooking list options"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsCompact="True">
                <dnc:ToolBarToggleButton
                    x:Name="ShowAllButton"
                    AutomationProperties.Name="Show all cooks"
                    IsChecked="{x:Bind ViewModel.ShowAll, Mode=TwoWay}"
                    Label="Show all"
                    ToolTipService.ToolTip="Include successful automatic cooks">
                    <dnc:ToolBarToggleButton.Icon>
                        <SymbolIconSource Symbol="AllApps" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
            </dnc:ToolBar>
            <ComboBox
                x:Name="NarrowRunPicker"
                Grid.Row="1"
                Margin="8,0"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Selected cooking operation"
                ItemTemplate="{StaticResource CookRunTemplate}"
                ItemsSource="{x:Bind ViewModel.Runs}"
                PlaceholderText="Select a cook"
                SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}"
                Visibility="Collapsed" />
            <ListView
                x:Name="RunList"
                Grid.Row="2"
                AutomationProperties.Name="Cooking operations"
                ItemContainerStyle="{StaticResource CookListItem}"
                ItemTemplate="{StaticResource CookRunTemplate}"
                ItemsSource="{x:Bind ViewModel.Runs}"
                SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}"
                SelectionMode="Single" />
        </Grid>
        <ctk:GridSplitter
            x:Name="RunSplitter"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="4"
            HorizontalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />
        <TextBlock
            x:Name="EmptyMessage"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No cooks yet"
            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />
        <Grid
            x:Name="RunDetails"
            Grid.RowSpan="2"
            Grid.Column="2"
            Padding="8,4,8,6"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.DetailsVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="RunHeader"
                ColumnSpacing="8"
                SizeChanged="OnHeaderSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="RunTitle"
                    MaxWidth="320"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.SelectedRun.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SelectedRun.Title, Mode=OneWay}" />
                <local:CookingStatusIndicator
                    x:Name="RunStatus"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    ShowLabel="True"
                    State="{x:Bind ViewModel.SelectedRun.Snapshot.State, Mode=OneWay}" />
                <Button
                    x:Name="RetryButton"
                    Grid.Column="2"
                    MinHeight="28"
                    Padding="8,3"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="Retry"
                    Visibility="{x:Bind ViewModel.SelectedRun.RetryVisibility, Mode=OneWay}" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="3"
                    MinHeight="28"
                    Padding="8,3"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Content="Cancel"
                    IsEnabled="{x:Bind ViewModel.SelectedRun.CanCancel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.SelectedRun.CancelVisibility, Mode=OneWay}" />
                <Button
                    x:Name="InspectButton"
                    Grid.Column="4"
                    MinHeight="28"
                    Padding="8,3"
                    Command="{x:Bind ViewModel.InspectCommand}"
                    Content="Inspect"
                    ToolTipService.ToolTip="Inspect the currently published output for this cook's scope"
                    Visibility="{x:Bind ViewModel.SelectedRun.InspectVisibility, Mode=OneWay}" />
                <Button
                    x:Name="ShowImportedAssetsButton"
                    Grid.Column="5"
                    MinWidth="28"
                    MinHeight="28"
                    Padding="5,3"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Show imported assets"
                    Command="{x:Bind ViewModel.ShowImportedAssetsCommand}"
                    ToolTipService.ToolTip="Show imported assets in Content Explorer"
                    Visibility="{x:Bind ViewModel.SelectedRun.ShowImportedAssetsVisibility, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                </Button>
            </Grid>
            <ProgressBar
                Grid.Row="1"
                MinHeight="2"
                IsIndeterminate="{x:Bind ViewModel.SelectedRun.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.SelectedRun.ProgressVisibility, Mode=OneWay}" />
            <!--  The details are a fixed layout: the active view takes the remaining height and scrolls by itself, so only its visible rows exist.  -->
            <Grid
                x:Name="DetailsHost"
                Grid.Row="2"
                RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="96" />
                </Grid.RowDefinitions>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ActionError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ActionErrorVisibility, Mode=OneWay}" />
                <StackPanel
                    x:Name="RunSummary"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.SelectedRun.Summary, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="0"
                        Click="ShowIssuesClicked"
                        Content="{x:Bind ViewModel.SelectedRun.WarningSummary, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Visibility="{x:Bind ViewModel.SelectedRun.WarningSummaryVisibility, Mode=OneWay}" />
                </StackPanel>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctk:Segmented
                        x:Name="ViewSwitch"
                        AutomationProperties.Name="Cook details view"
                        SelectedIndex="{x:Bind ViewModel.SelectedRun.ViewIndex, Mode=TwoWay}">
                        <ctk:SegmentedItem Content="Output" />
                        <ctk:SegmentedItem Content="{x:Bind ViewModel.SelectedRun.IssuesLabel, Mode=OneWay}" />
                        <ctk:SegmentedItem Content="{x:Bind ViewModel.SelectedRun.AssetsLabel, Mode=OneWay}" />
                    </ctk:Segmented>
                    <ToggleSwitch
                        x:Name="ShowReusedSwitch"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        IsOn="{x:Bind ViewModel.SelectedRun.ShowReused, Mode=TwoWay}"
                        OffContent="Show reused"
                        OnContent="Show reused"
                        Visibility="{x:Bind ViewModel.SelectedRun.AssetsVisibility, Mode=OneWay}" />
                </Grid>
                <Grid Grid.Row="3">
                    <console:OutputConsoleView
                        x:Name="CookOutput"
                        AutomationProperties.Name="Selected cook messages"
                        FoldDuplicates="True"
                        FollowTail="{x:Bind ViewModel.SelectedRun.FollowTail, Mode=TwoWay}"
                        ItemsSource="{x:Bind ViewModel.SelectedRun.Output, Mode=OneWay}"
                        ToolbarVisibility="Collapsed"
                        Visibility="{x:Bind ViewModel.SelectedRun.OutputVisibility, Mode=OneWay}"
                        WordWrap="False" />
                    <Grid
                        x:Name="IssuesView"
                        SizeChanged="OnIssuesViewSizeChanged"
                        Visibility="{x:Bind ViewModel.SelectedRun.IssuesVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="IssueListColumn" Width="*" />
                            <ColumnDefinition x:Name="IssueDetailsColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="IssueListRow" Height="*" />
                            <RowDefinition x:Name="IssueDetailsRow" Height="*" />
                        </Grid.RowDefinitions>
                        <ListView
                            x:Name="CookIssues"
                            AutomationProperties.Name="Issues in the selected cook"
                            ItemContainerStyle="{StaticResource CookIssueItem}"
                            ItemTemplate="{StaticResource CookIssueTemplate}"
                            ItemsSource="{x:Bind ViewModel.SelectedRun.Issues, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedRun.SelectedIssue, Mode=TwoWay}"
                            SelectionMode="Single" />
                        <Border
                            x:Name="IssueDetails"
                            Padding="12,8"
                            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.SelectedRun.IssueDetailsVisibility, Mode=OneWay}">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Padding="8,0,0,4"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Name" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Path" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Type" />
                                    <Button
                                        x:Name="CopyPlacesButton"
                                        Grid.Column="3"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="Copy the issue and its places"
                                        Click="CopyPlacesClicked"
                                        ToolTipService.ToolTip="Copy the message, count, scope and places">
                                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                                <ListView
                                    x:Name="IssuePlaces"
                                    Grid.Row="1"
                                    AutomationProperties.Name="Places affected by the selected issue"
                                    ItemsSource="{x:Bind ViewModel.SelectedRun.SelectedIssue.Places, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="24" />
                                            <Setter Property="Padding" Value="8,0,0,0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:CookingIssuePlace">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="32" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Display}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Display}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Detail}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Detail}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind KindText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                        <TextBlock
                            Margin="8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No issues in this cook."
                            Visibility="{x:Bind ViewModel.SelectedRun.NoIssuesVisibility, Mode=OneWay}" />
                    </Grid>
                    <ListView
                        x:Name="CookAssets"
                        AutomationProperties.Name="Assets in the selected cook"
                        ItemContainerStyle="{StaticResource CookAssetItem}"
                        ItemTemplate="{StaticResource CookAssetTemplate}"
                        ItemsSource="{x:Bind ViewModel.SelectedRun.Assets, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.SelectedRun.AssetsVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
