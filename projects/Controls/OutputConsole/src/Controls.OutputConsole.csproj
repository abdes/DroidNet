<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
        <IsPackable>true</IsPackable>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

    <RootNamespace>DroidNet.Controls.OutputConsole</RootNamespace>
    <UseWinUI>true</UseWinUI>

    <Title>OutputConsole Control</Title>
    <Description>A virtualized log console control for WinUI 3: a bounded ring buffer fed by Serilog, level and subsystem filters, search with filter and find modes, duplicate folding, a details pane, and copy and save.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>winui;controls;logging;console;virtualized;logview;search</PackageTags>
    <PackageReleaseNotes>Initial preview.</PackageReleaseNotes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DryIoc.dll" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ProjectsRoot)\Controls\ToolBars\src\Controls.ToolBars.csproj" />
  </ItemGroup>
</Project>
