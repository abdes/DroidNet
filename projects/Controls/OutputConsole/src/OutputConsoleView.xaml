<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DroidNet.Controls.OutputConsole.OutputConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dnc="using:DroidNet.Controls"
    xmlns:local="using:DroidNet.Controls.OutputConsole"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="F3" Invoked="OnFindNextAccelerator" />
        <KeyboardAccelerator
            Key="F3"
            Invoked="OnFindPrevAccelerator"
            Modifiers="Shift" />
        <KeyboardAccelerator
            Key="F"
            Invoked="OnFocusSearchAccelerator"
            Modifiers="Control" />
    </UserControl.KeyboardAccelerators>

    <UserControl.Resources>
        <!--  Cascadia Mono ships with Windows 11 and has light weights; Consolas is the fallback.  -->
        <FontFamily x:Key="ConsoleFontFamily">Cascadia Mono, Consolas</FontFamily>
        <x:Double x:Key="ConsoleFontSize">12</x:Double>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Toolbar: filters and search on the left, stream, clipboard and view commands on the right.  -->
        <dnc:ToolBar
            AutomationProperties.Name="Output options"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsCompact="True"
            Visibility="{x:Bind ToolbarVisibility, Mode=OneWay}"
            XYFocusKeyboardNavigation="Enabled">
            <dnc:ToolBarElementHost>
                <DropDownButton x:Name="LevelsDropDown" Content="Levels">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <ToggleMenuFlyoutItem x:Name="LevelVerboseItem" Text="Verbose" />
                            <ToggleMenuFlyoutItem x:Name="LevelDebugItem" Text="Debug" />
                            <ToggleMenuFlyoutItem x:Name="LevelInformationItem" Text="Information" />
                            <ToggleMenuFlyoutItem x:Name="LevelWarningItem" Text="Warning" />
                            <ToggleMenuFlyoutItem x:Name="LevelErrorItem" Text="Error" />
                            <ToggleMenuFlyoutItem x:Name="LevelFatalItem" Text="Fatal" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </dnc:ToolBarElementHost>
            <dnc:ToolBarElementHost>
                <DropDownButton x:Name="SubsystemsDropDown" Content="Subsystems: All">
                    <DropDownButton.Flyout>
                        <!--  Multi-select: stays open while the user checks; every change applies at once.  -->
                        <Flyout x:Name="SubsystemsFlyout" Placement="BottomEdgeAlignedLeft">
                            <StackPanel
                                Width="276"
                                Spacing="4"
                                XYFocusKeyboardNavigation="Enabled">
                                <!--  The right margin keeps every count clear of the list's scroll bar, and aligned.  -->
                                <Grid Margin="0,0,16,0">
                                    <CheckBox
                                        x:Name="AllSubsystemsCheckBox"
                                        Content="All subsystems"
                                        IsThreeState="True" />
                                    <TextBlock
                                        x:Name="AllSubsystemsCount"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <MenuFlyoutSeparator />
                                <ScrollViewer MaxHeight="352" VerticalScrollBarVisibility="Auto">
                                    <StackPanel
                                        x:Name="SubsystemsList"
                                        Margin="0,0,16,0"
                                        XYFocusKeyboardNavigation="Enabled" />
                                </ScrollViewer>
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </dnc:ToolBarElementHost>
            <dnc:ToolBarElementHost>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        MinWidth="220"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search the output"
                        PlaceholderText="Search..."
                        QueryIcon="Find"
                        Text="{x:Bind TextFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleButton
                        x:Name="SearchModeToggle"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Hide lines that don't match"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Hide lines that don't match">
                        <FontIcon FontSize="14" Glyph="&#xE71C;" />
                    </ToggleButton>
                    <StackPanel
                        x:Name="FindNavigation"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="MatchCountText"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="PreviousMatchButton"
                            AutomationProperties.Name="Previous match"
                            Style="{ThemeResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Previous match (Shift+F3)">
                            <FontIcon FontSize="11" Glyph="&#xE70E;" />
                        </Button>
                        <Button
                            x:Name="NextMatchButton"
                            AutomationProperties.Name="Next match"
                            Style="{ThemeResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Next match (F3)">
                            <FontIcon FontSize="11" Glyph="&#xE70D;" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </dnc:ToolBarElementHost>

            <dnc:ToolBar.SecondaryItems>
                <dnc:ToolBarToggleButton
                    x:Name="PauseToggle"
                    IsChecked="{x:Bind IsPaused, Mode=TwoWay}"
                    Label="Pause"
                    ToolTipService.ToolTip="Pause this view; capture continues">
                    <dnc:ToolBarToggleButton.Icon>
                        <SymbolIconSource Symbol="Pause" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
                <dnc:ToolBarToggleButton
                    IsChecked="{x:Bind FollowTail, Mode=TwoWay}"
                    Label="Follow"
                    ToolTipService.ToolTip="Keep the newest line in view">
                    <dnc:ToolBarToggleButton.Icon>
                        <FontIconSource Glyph="&#xE74B;" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
                <dnc:ToolBarToggleButton
                    IsChecked="{x:Bind WordWrap, Mode=TwoWay}"
                    Label="Wrap"
                    ToolTipService.ToolTip="Wrap long lines">
                    <dnc:ToolBarToggleButton.Icon>
                        <SymbolIconSource Symbol="AlignLeft" />
                    </dnc:ToolBarToggleButton.Icon>
                </dnc:ToolBarToggleButton>
                <dnc:ToolBarSeparator />
                <dnc:ToolBarButton
                    x:Name="CopyButton"
                    IsEnabled="False"
                    Label="Copy"
                    ToolBarLabelPosition="Collapsed"
                    ToolTipService.ToolTip="Copy (Ctrl+C)">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE8C8;" />
                    </dnc:ToolBarButton.Icon>
                </dnc:ToolBarButton>
                <dnc:ToolBarButton
                    x:Name="SaveButton"
                    Label="Save"
                    ToolBarLabelPosition="Collapsed"
                    ToolTipService.ToolTip="Save output to a file">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE74E;" />
                    </dnc:ToolBarButton.Icon>
                </dnc:ToolBarButton>
                <dnc:ToolBarButton
                    x:Name="ClearButton"
                    Label="Clear"
                    ToolBarLabelPosition="Collapsed"
                    ToolTipService.ToolTip="Clear the output">
                    <dnc:ToolBarButton.Icon>
                        <SymbolIconSource Symbol="Delete" />
                    </dnc:ToolBarButton.Icon>
                </dnc:ToolBarButton>
                <dnc:ToolBarSeparator />
                <dnc:ToolBarButton
                    Label="View"
                    ToolBarLabelPosition="Collapsed"
                    ToolTipService.ToolTip="View options">
                    <dnc:ToolBarButton.Icon>
                        <FontIconSource Glyph="&#xE890;" />
                    </dnc:ToolBarButton.Icon>
                    <dnc:ToolBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ShowTimestamps, Mode=TwoWay}" Text="Show timestamps" />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind ShowSubsystem, Mode=TwoWay}" Text="Show subsystems" />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind FoldDuplicates, Mode=TwoWay}" Text="Fold repeated lines" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem IsChecked="{x:Bind IsDetailsPaneOpen, Mode=TwoWay}" Text="Show details pane" />
                        </MenuFlyout>
                    </dnc:ToolBarButton.Flyout>
                </dnc:ToolBarButton>
                <dnc:ToolBarElementHost x:Name="BufferContainer">
                    <Button
                        x:Name="BufferButton"
                        Padding="6,4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Output buffer"
                        Style="{ThemeResource SubtleButtonStyle}">
                        <ProgressRing
                            x:Name="BufferRing"
                            Width="16"
                            Height="16"
                            Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                            IsIndeterminate="False"
                            IsTabStop="False" />
                        <Button.Flyout>
                            <Flyout x:Name="BufferFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="308" Spacing="6">
                                    <Grid>
                                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Output buffer" />
                                        <TextBlock
                                            x:Name="BufferPercentText"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="BufferRetainedText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar x:Name="BufferBar" />
                                    <TextBlock
                                        x:Name="BufferHeadroomText"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <MenuFlyoutSeparator />
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Retained by level" />
                                    <VariableSizedWrapGrid
                                        x:Name="BufferLevelCounts"
                                        ItemHeight="24"
                                        ItemWidth="102"
                                        Orientation="Horizontal" />
                                    <MenuFlyoutSeparator />
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="In this view" />
                                    <TextBlock
                                        x:Name="BufferViewText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="BufferPausedText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </dnc:ToolBarElementHost>
            </dnc:ToolBar.SecondaryItems>
        </dnc:ToolBar>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <!--
            Content layer (WinUI layering: commands sit on the base layer, content on one contiguous layer).
            The same surface as WinUI's own content areas: LayerFillColorDefaultBrush with a card stroke.
            The list, the details header and the properties are separated by dividers, never by more fills.
        -->
        <Border
            x:Name="ContentLayer"
            Grid.Row="2"
            Padding="0,4,0,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DetailsRow" Height="0" />
                </Grid.RowDefinitions>

                <!--  Virtualized list  -->
                <ListView
                    x:Name="List"
                    FontFamily="{StaticResource ConsoleFontFamily}"
                    FontSize="{StaticResource ConsoleFontSize}"
                    FontWeight="SemiLight"
                    IsItemClickEnabled="False"
                    KeyboardAcceleratorPlacementMode="Hidden"
                    SelectionMode="Extended">
                    <ListView.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="C"
                            Invoked="OnCopyAccelerator"
                            Modifiers="Control" />
                        <KeyboardAccelerator
                            Key="C"
                            Invoked="OnCopyVisibleAccelerator"
                            Modifiers="Control,Shift" />
                        <KeyboardAccelerator Key="Enter" Invoked="OnShowDetailsAccelerator" />
                        <KeyboardAccelerator Key="Escape" Invoked="OnCloseDetailsAccelerator" />
                    </ListView.KeyboardAccelerators>
                    <ListView.ContextFlyout>
                        <MenuFlyout x:Name="RowMenu">
                            <MenuFlyoutItem
                                x:Name="CopyMenuItem"
                                KeyboardAcceleratorTextOverride="Ctrl+C"
                                Text="Copy">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="CopyMessageMenuItem" Text="Copy message" />
                            <MenuFlyoutItem
                                x:Name="CopyVisibleMenuItem"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                                Text="Copy visible" />
                            <MenuFlyoutItem x:Name="CopyAllMenuItem" Text="Copy all retained" />
                            <MenuFlyoutSeparator x:Name="SubsystemMenuSeparator" />
                            <MenuFlyoutItem x:Name="ShowOnlySubsystemMenuItem" />
                            <MenuFlyoutItem x:Name="HideSubsystemMenuItem" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="ShowDetailsMenuItem"
                                KeyboardAcceleratorTextOverride="Enter"
                                Text="Show details" />
                            <MenuFlyoutItem
                                x:Name="SelectAllMenuItem"
                                KeyboardAcceleratorTextOverride="Ctrl+A"
                                Text="Select all" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemContainerStyle>
                        <!--  WinUI's ListViewItem style sets the UI font on every row; the whole row uses the console font.  -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
                            <Setter Property="FontSize" Value="{StaticResource ConsoleFontSize}" />
                            <Setter Property="FontWeight" Value="SemiLight" />
                            <Setter Property="Padding" Value="4,0,4,0" />
                            <Setter Property="MinHeight" Value="20" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <local:OutputLogRowView />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel VirtualizingStackPanel.VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <ctk:GridSplitter
                    x:Name="DetailsSplitter"
                    Grid.Row="1"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Rows"
                    Visibility="Collapsed" />

                <!--  Details pane  -->
                <Grid
                    x:Name="DetailsPane"
                    Grid.Row="2"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DetailsHeader"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource ConsoleFontFamily}"
                            FontSize="{StaticResource ConsoleFontSize}"
                            FontWeight="SemiLight" />
                        <Button
                            x:Name="CopyDetailsButton"
                            Grid.Column="1"
                            Margin="0,0,4,0"
                            Padding="8,2"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                <TextBlock Text="Copy details" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CloseDetailsButton"
                            Grid.Column="2"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Close details"
                            Style="{ThemeResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Close details (Esc)">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <!--  Message and properties, split by a splitter; DetailsSplitRatio is the message's share of the width.  -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                x:Name="DetailsBodyColumn"
                                Width="3*"
                                MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition
                                x:Name="DetailsPropertiesColumn"
                                Width="2*"
                                MinWidth="160" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer
                            x:Name="DetailsBodyScroller"
                            Padding="12,8"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Auto">
                            <RichTextBlock
                                x:Name="DetailsBody"
                                FontFamily="{StaticResource ConsoleFontFamily}"
                                FontSize="{StaticResource ConsoleFontSize}"
                                FontWeight="SemiLight"
                                IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                        <ctk:GridSplitter
                            Grid.Column="1"
                            Width="6"
                            AutomationProperties.Name="Resize the message and properties"
                            Background="Transparent"
                            ResizeBehavior="PreviousAndNext"
                            ResizeDirection="Columns" />
                        <ScrollViewer
                            Grid.Column="2"
                            Padding="16,8,12,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,0,0,0">
                            <Grid
                                x:Name="DetailsProperties"
                                ColumnSpacing="12"
                                RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <VisualStateManager.VisualStateGroups>
            <!--  With its toolbar the console is a panel and draws its content layer; embedded without it, its host's surface is the layer.  -->
            <VisualStateGroup x:Name="LayerStates">
                <VisualState x:Name="Panel" />
                <VisualState x:Name="Embedded">
                    <VisualState.Setters>
                        <Setter Target="ContentLayer.Background" Value="Transparent" />
                        <Setter Target="ContentLayer.BorderThickness" Value="0" />
                        <Setter Target="ContentLayer.CornerRadius" Value="0" />
                        <Setter Target="ContentLayer.Padding" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
