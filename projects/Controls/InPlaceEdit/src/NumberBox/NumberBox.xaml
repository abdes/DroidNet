<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DroidNet.Controls">

    <Style BasedOn="{StaticResource DefaultNumberBoxStyle}" TargetType="local:NumberBox" />

    <Style x:Key="DefaultNumberBoxStyle" TargetType="local:NumberBox">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,2,8,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NumberBox">
                    <local:CustomGrid
                        x:Name="PartRootGrid"
                        ColumnSpacing="5"
                        RowSpacing="5">
                        <TextBlock
                            x:Name="PartLabelTextBlock"
                            HorizontalAlignment="{TemplateBinding HorizontalLabelAlignment}"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding LabelForeground}"
                            Opacity="0.85"
                            Text="{TemplateBinding Label}"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{TemplateBinding Label}" />
                        <Grid x:Name="PartValueGroup" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="PartValuePrefix"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{TemplateBinding Prefix}" />
                            <Border
                                x:Name="PartBackgroundBorder"
                                Grid.Column="1"
                                Margin="1"
                                Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                BackgroundSizing="OuterBorderEdge"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid ColumnSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="PartCompactLabelTextBlock"
                                        Grid.Column="0"
                                        Margin="8,0,4,0"
                                        VerticalAlignment="Center"
                                        Foreground="{TemplateBinding LabelForeground}"
                                        Opacity="0.85"
                                        Text="{TemplateBinding Label}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="Collapsed" />
                                    <local:NumberBoxValuePanel Grid.Column="1">
                                        <TextBlock
                                            x:Name="PartValueTextBlock"
                                            MinHeight="{TemplateBinding MinHeight}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            FontSize="{TemplateBinding FontSize}"
                                            HorizontalTextAlignment="{Binding Path=HorizontalValueAlignment, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}"
                                            Text="{Binding Path=DisplayText, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}" />
                                        <TextBox
                                            x:Name="PartEditBox"
                                            MinWidth="0"
                                            MinHeight="{TemplateBinding MinHeight}"
                                            Margin="0"
                                            Padding="{TemplateBinding Padding}"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                            BackgroundSizing="OuterBorderEdge"
                                            BorderThickness="0"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            FontSize="{TemplateBinding FontSize}"
                                            InputScope="Number"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False"
                                            TextAlignment="{Binding Path=HorizontalValueAlignment, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </local:NumberBoxValuePanel>
                                </Grid>
                            </Border>
                            <TextBlock
                                x:Name="PartValueQualifier"
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{TemplateBinding Qualifier}" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Hover">
                                    <VisualState.Setters>
                                        <Setter Target="PartValueTextBlock.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Target="PartLabelTextBlock.Opacity" Value="1" />
                                        <Setter Target="PartCompactLabelTextBlock.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PartLabelTextBlock.Opacity" Value="1" />
                                        <Setter Target="PartCompactLabelTextBlock.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ValueStates">
                                <VisualState x:Name="ShowingValidValue" />
                                <VisualState x:Name="ShowingInvalidValue">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartBackgroundBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemFillColorCautionBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PartBackgroundBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.5"
                                            Duration="0:0:0.4" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="EditingValidValue">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartValueTextBlock" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartValueTextBlock" Storyboard.TargetProperty="IsHitTestVisible">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="False" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartEditBox" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="EditingInvalidValue">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartValueTextBlock" Storyboard.TargetProperty="Opacity">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartValueTextBlock" Storyboard.TargetProperty="IsHitTestVisible">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="False" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartEditBox" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartBackgroundBorder" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartBackgroundBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemFillColorCautionBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PartBackgroundBorder" Storyboard.TargetProperty="Margin">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </local:CustomGrid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
