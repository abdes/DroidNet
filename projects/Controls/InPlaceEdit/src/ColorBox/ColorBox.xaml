<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DroidNet.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///DroidNet.Controls.InPlaceEdit/VectorBox/VectorBox.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource DefaultColorBoxStyle}" TargetType="local:ColorBox" />

    <Style x:Key="DefaultColorBoxStyle" TargetType="local:ColorBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  The swatch keeps its gap in its own margin so a hidden picker leaves none.  -->
                        <Button
                            x:Name="PartSwatchButton"
                            Width="32"
                            Height="32"
                            Margin="0,0,4,0"
                            Padding="3"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{TemplateBinding PickerAutomationName}"
                            Background="Transparent"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ToolTipService.ToolTip="{TemplateBinding PickerAutomationName}">
                            <!--  A square swatch: opaque color on the left; with alpha, the right half shows it over a checkerboard.  -->
                            <Grid
                                Width="24"
                                Height="24"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PartSwatchFill" Grid.ColumnSpan="2" />
                                <Grid
                                    x:Name="PartSwatchAlpha"
                                    Grid.Column="1"
                                    Background="White"
                                    Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Fill="#FFCCCCCC" />
                                    <Rectangle
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Fill="#FFCCCCCC" />
                                    <Rectangle Grid.Row="2" Fill="#FFCCCCCC" />
                                    <Rectangle
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Fill="#FFCCCCCC" />
                                    <Border
                                        x:Name="PartSwatchAlphaFill"
                                        Grid.RowSpan="4"
                                        Grid.ColumnSpan="2" />
                                </Grid>
                                <!--  A mixed selection has no single color to show.  -->
                                <TextBlock
                                    x:Name="PartSwatchMixed"
                                    Grid.ColumnSpan="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="–"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <local:VectorBox
                            x:Name="PartChannels"
                            Grid.Column="1"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            CompactComponentLabels="True"
                            ComponentMask="{TemplateBinding ComponentMask}"
                            HorizontalValueAlignment="Right"
                            LabelPosition="None"
                            WIsIndeterminate="{TemplateBinding AlphaIsIndeterminate}"
                            WValue="{Binding Alpha, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=TwoWay}"
                            XIsIndeterminate="{TemplateBinding RedIsIndeterminate}"
                            XValue="{Binding Red, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=TwoWay}"
                            YIsIndeterminate="{TemplateBinding GreenIsIndeterminate}"
                            YValue="{Binding Green, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=TwoWay}"
                            ZIsIndeterminate="{TemplateBinding BlueIsIndeterminate}"
                            ZValue="{Binding Blue, RelativeSource={RelativeSource Mode=TemplatedParent}, Mode=TwoWay}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
