<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DroidNet.Controls.Demo.InPlaceEdit.VectorBoxDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="DemoPanelBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <!--  A property row: caption on the left, vector filling the rest, component labels inside the fields.  -->
        <Style x:Key="RowVectorStyle" TargetType="controls:VectorBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CompactComponentLabels" Value="True" />
            <Setter Property="ComponentLabelPosition" Value="Left" />
            <Setter Property="HorizontalValueAlignment" Value="Right" />
            <Setter Property="LabelPosition" Value="None" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Two, three and four components" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Position" />
                    <controls:VectorBox
                        x:Name="PositionVector"
                        Grid.Column="1"
                        Style="{StaticResource RowVectorStyle}"
                        XValue="{x:Bind ViewModel.PositionX, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.PositionY, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.PositionZ, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Text="Rotation" />
                    <controls:VectorBox
                        x:Name="RotationVector"
                        Grid.Row="1"
                        Grid.Column="1"
                        ComponentMask="###.##°"
                        Style="{StaticResource RowVectorStyle}"
                        XValue="{x:Bind ViewModel.RotationX, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.RotationY, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.RotationZ, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        Text="Scale" />
                    <controls:VectorBox
                        x:Name="ScaleVector"
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource RowVectorStyle}"
                        XValue="{x:Bind ViewModel.ScaleX, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.ScaleY, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.ScaleZ, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="3"
                        VerticalAlignment="Center"
                        Text="Orientation" />
                    <controls:VectorBox
                        x:Name="OrientationVector"
                        Grid.Row="3"
                        Grid.Column="1"
                        ComponentMask="~.###"
                        Dimension="4"
                        Style="{StaticResource RowVectorStyle}"
                        WValue="{x:Bind ViewModel.OrientationW, Mode=TwoWay}"
                        XValue="{x:Bind ViewModel.OrientationX, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.OrientationY, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.OrientationZ, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="4"
                        VerticalAlignment="Center"
                        Text="Tiling" />
                    <controls:VectorBox
                        x:Name="TilingVector"
                        Grid.Row="4"
                        Grid.Column="1"
                        Dimension="2"
                        Style="{StaticResource RowVectorStyle}"
                        XValue="{x:Bind ViewModel.TilingU, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.TilingV, Mode=TwoWay}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Per-component masks (X ~.# m, Y ##.##, Z ~.###)" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <controls:VectorBox
                    x:Name="MixedMaskVector"
                    ComponentLabelPosition="Top"
                    Label="Custom masks"
                    LabelPosition="Top"
                    XValue="{x:Bind ViewModel.MixedMaskX, Mode=TwoWay}"
                    YValue="{x:Bind ViewModel.MixedMaskY, Mode=TwoWay}"
                    ZValue="{x:Bind ViewModel.MixedMaskZ, Mode=TwoWay}" />
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Validation (each component from -180 to 180)" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <controls:VectorBox
                    CompactComponentLabels="True"
                    ComponentLabelPosition="Right"
                    ComponentMask="###.##°"
                    Label="Constrained"
                    LabelPosition="Left"
                    Validate="OnConstrainedValidate"
                    XValue="{x:Bind ViewModel.ConstrainedX, Mode=TwoWay}"
                    YValue="{x:Bind ViewModel.ConstrainedY, Mode=TwoWay}"
                    ZValue="{x:Bind ViewModel.ConstrainedZ, Mode=TwoWay}" />
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Mixed values (multi-selection)" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <StackPanel Spacing="12">
                    <controls:VectorBox
                        CompactComponentLabels="True"
                        ComponentLabelPosition="Left"
                        ComponentMask="~.##"
                        Label="Mixed values"
                        LabelPosition="Left"
                        XIsIndeterminate="{x:Bind ViewModel.IsMixedX, Mode=OneWay}"
                        XValue="{x:Bind ViewModel.MixedX, Mode=TwoWay}"
                        YIsIndeterminate="{x:Bind ViewModel.IsMixedY, Mode=OneWay}"
                        YValue="{x:Bind ViewModel.MixedY, Mode=TwoWay}"
                        ZIsIndeterminate="{x:Bind ViewModel.IsMixedZ, Mode=OneWay}"
                        ZValue="{x:Bind ViewModel.MixedZ, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <ToggleSwitch Header="X mixed" IsOn="{x:Bind ViewModel.IsMixedX, Mode=TwoWay}" />
                        <ToggleSwitch Header="Y mixed" IsOn="{x:Bind ViewModel.IsMixedY, Mode=TwoWay}" />
                        <ToggleSwitch Header="Z mixed" IsOn="{x:Bind ViewModel.IsMixedZ, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Presentation options" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <StackPanel Spacing="16">
                    <controls:VectorBox
                        x:Name="ConfigurableVector"
                        ComponentLabelPosition="None"
                        ComponentMask="~.##"
                        HorizontalValueAlignment="Center"
                        Label="Configurable"
                        LabelPosition="Left"
                        WValue="4"
                        XValue="1"
                        YValue="2"
                        ZValue="3" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButtons
                            Header="Dimension"
                            SelectedIndex="1"
                            SelectionChanged="OnDimensionChanged">
                            <x:String>2</x:String>
                            <x:String>3</x:String>
                            <x:String>4</x:String>
                        </RadioButtons>
                        <RadioButtons
                            Header="Label position"
                            SelectedIndex="0"
                            SelectionChanged="OnLabelPositionChanged">
                            <x:String>Left</x:String>
                            <x:String>Right</x:String>
                            <x:String>Top</x:String>
                            <x:String>Bottom</x:String>
                            <x:String>None</x:String>
                        </RadioButtons>
                        <RadioButtons
                            Header="Component label position"
                            SelectedIndex="4"
                            SelectionChanged="OnComponentLabelPositionChanged">
                            <x:String>Left</x:String>
                            <x:String>Right</x:String>
                            <x:String>Top</x:String>
                            <x:String>Bottom</x:String>
                            <x:String>None</x:String>
                        </RadioButtons>
                        <ToggleSwitch Header="Compact component labels (left or right)" IsOn="{x:Bind ConfigurableVector.CompactComponentLabels, Mode=TwoWay}" />
                        <RadioButtons
                            Header="Value alignment"
                            SelectedIndex="1"
                            SelectionChanged="OnValueAlignmentChanged">
                            <x:String>Left</x:String>
                            <x:String>Center</x:String>
                            <x:String>Right</x:String>
                        </RadioButtons>
                        <RadioButtons
                            Header="Drag multiplier"
                            SelectedIndex="0"
                            SelectionChanged="OnMultiplierChanged">
                            <x:String>1</x:String>
                            <x:String>5</x:String>
                            <x:String>10</x:String>
                        </RadioButtons>
                        <ComboBox
                            Header="Component mask"
                            SelectedIndex="1"
                            SelectionChanged="OnMaskChanged">
                            <x:String>~.#</x:String>
                            <x:String>~.##</x:String>
                            <x:String>###.##</x:String>
                            <x:String>###.#°</x:String>
                            <x:String>~.## m</x:String>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Bound values" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock>
                        <Run FontWeight="Bold" Text="Position:" />
                        <Run Text="{x:Bind ViewModel.PositionX, Mode=OneWay}" /><Run Text=", " /><Run Text="{x:Bind ViewModel.PositionY, Mode=OneWay}" /><Run Text=", " /><Run Text="{x:Bind ViewModel.PositionZ, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock>
                        <Run FontWeight="Bold" Text="Orientation:" />
                        <Run Text="{x:Bind ViewModel.OrientationX, Mode=OneWay}" /><Run Text=", " /><Run Text="{x:Bind ViewModel.OrientationY, Mode=OneWay}" /><Run Text=", " /><Run Text="{x:Bind ViewModel.OrientationZ, Mode=OneWay}" /><Run Text=", " /><Run Text="{x:Bind ViewModel.OrientationW, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock>
                        <Run FontWeight="Bold" Text="Tiling:" />
                        <Run Text="{x:Bind ViewModel.TilingU, Mode=OneWay}" /><Run Text=", " /><Run Text="{x:Bind ViewModel.TilingV, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock>
                        <Run FontWeight="Bold" Text="Constrained:" />
                        <Run Text="{x:Bind ViewModel.ConstrainedX, Mode=OneWay}" /><Run Text=", " /><Run Text="{x:Bind ViewModel.ConstrainedY, Mode=OneWay}" /><Run Text=", " /><Run Text="{x:Bind ViewModel.ConstrainedZ, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
