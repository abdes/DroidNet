<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DroidNet.Controls.Demo.InPlaceEdit.ColorBoxDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="DemoPanelBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Encodings and ranges" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Base color (linear RGBA)" />
                    <controls:ColorBox
                        Grid.Column="1"
                        Alpha="{x:Bind ViewModel.BaseColorAlpha, Mode=TwoWay}"
                        AutomationProperties.Name="Base color, linear RGBA"
                        Blue="{x:Bind ViewModel.BaseColorBlue, Mode=TwoWay}"
                        Encoding="Linear"
                        Green="{x:Bind ViewModel.BaseColorGreen, Mode=TwoWay}"
                        HasAlpha="True"
                        PickerAutomationName="Pick base color"
                        Red="{x:Bind ViewModel.BaseColorRed, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource CaptionStyle}"
                        Text="Emissive (luminance RGB)" />
                    <controls:ColorBox
                        Grid.Row="1"
                        Grid.Column="1"
                        AutomationProperties.Name="Emissive, luminance RGB"
                        Blue="{x:Bind ViewModel.EmissiveBlue, Mode=TwoWay}"
                        ComponentMask="~.##"
                        Encoding="Linear"
                        Green="{x:Bind ViewModel.EmissiveGreen, Mode=TwoWay}"
                        PickerAutomationName="Pick emissive hue"
                        Range="HighDynamicRange"
                        Red="{x:Bind ViewModel.EmissiveRed, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource CaptionStyle}"
                        Text="Highlight (sRGBA, labels on the right)" />
                    <controls:ColorBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Alpha="{x:Bind ViewModel.HighlightAlpha, Mode=TwoWay}"
                        AutomationProperties.Name="Highlight, sRGB"
                        Blue="{x:Bind ViewModel.HighlightBlue, Mode=TwoWay}"
                        ChannelLabelPosition="Right"
                        Green="{x:Bind ViewModel.HighlightGreen, Mode=TwoWay}"
                        HasAlpha="True"
                        PickerAutomationName="Pick highlight color"
                        Red="{x:Bind ViewModel.HighlightRed, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource CaptionStyle}"
                        Text="Light scale (RGB ×)" />
                    <controls:ColorBox
                        Grid.Row="3"
                        Grid.Column="1"
                        AutomationProperties.Name="Light scale, RGB multiplier"
                        Blue="{x:Bind ViewModel.ScaleBlue, Mode=TwoWay}"
                        Encoding="Linear"
                        Green="{x:Bind ViewModel.ScaleGreen, Mode=TwoWay}"
                        IsPickerVisible="False"
                        Range="HighDynamicRange"
                        Red="{x:Bind ViewModel.ScaleRed, Mode=TwoWay}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Mixed values (multi-selection)" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <StackPanel Spacing="12">
                    <controls:ColorBox
                        AutomationProperties.Name="Mixed color"
                        Blue="{x:Bind ViewModel.MixedBlue, Mode=TwoWay}"
                        BlueIsIndeterminate="{x:Bind ViewModel.IsMixed, Mode=OneWay}"
                        Encoding="Linear"
                        Green="{x:Bind ViewModel.MixedGreen, Mode=TwoWay}"
                        Red="{x:Bind ViewModel.MixedRed, Mode=TwoWay}" />
                    <ToggleSwitch Header="Blue differs across the selection" IsOn="{x:Bind ViewModel.IsMixed, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Edit sessions" />
            <Border Style="{StaticResource DemoPanelBorderStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Each pick is one session, however long the drag. This box applies picks itself, as one model edit; Escape cancels a pick."
                            TextWrapping="Wrap" />
                        <controls:ColorBox
                            AutomationProperties.Name="Tint, linear RGB"
                            Blue="{x:Bind ViewModel.TintBlue, Mode=TwoWay}"
                            ColorPicked="OnTintPicked"
                            EditSessionCompleted="OnTintEditCompleted"
                            EditSessionStarted="OnTintEditStarted"
                            Encoding="Linear"
                            Green="{x:Bind ViewModel.TintGreen, Mode=TwoWay}"
                            PickerAutomationName="Pick tint"
                            Red="{x:Bind ViewModel.TintRed, Mode=TwoWay}" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.SessionLog}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
