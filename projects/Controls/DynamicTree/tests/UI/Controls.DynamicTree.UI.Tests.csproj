<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>

        <RootNamespace>$(RootNamespace).Controls.Tests</RootNamespace>
        <AssemblyName>DroidNet.Controls.DynamicTree.UI.Tests</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(ProjectsRoot)\UITests.Shared\tests\TestHostLifecycleTests.cs" Link="TestHostLifecycleTests.cs" />
        <ProjectReference Include="$(ProjectsRoot)\Controls\DynamicTree\src\Controls.DynamicTree.csproj" />
    </ItemGroup>

    <Import Project="$(ProjectsRoot)\UITests.Shared\src\UITests.Shared.projitems" Label="Shared" />

    <ItemGroup>
        <PackageReference Include="Moq" />
    </ItemGroup>

    <!-- Run the actual demo row composition in the shared WinUI test host. -->
    <ItemGroup>
        <Compile Include="$(ProjectsRoot)\Controls\DemoApp\Tree\Model\*.cs" Exclude="$(ProjectsRoot)\Controls\DemoApp\Tree\Model\Scene.cs" Link="Demo\Model\%(Filename)%(Extension)" />
        <Compile Include="$(ProjectsRoot)\Controls\DemoApp\Tree\EntityAdapter.cs" Link="Demo\EntityAdapter.cs" />
        <Compile Include="$(ProjectsRoot)\Controls\DemoApp\Tree\LockStateTo*Converter.cs" Link="Demo\%(Filename)%(Extension)" />
        <Compile Include="$(ProjectsRoot)\Controls\DemoApp\Tree\EntityRowActions.xaml.cs" Link="Demo\EntityRowActions.xaml.cs" />
        <Page Include="$(ProjectsRoot)\Controls\DemoApp\Tree\EntityRowActions.xaml" Link="Demo\EntityRowActions.xaml" />
    </ItemGroup>

</Project>
