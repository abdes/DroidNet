<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="MSTest.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>

        <RootNamespace>$(RootNamespace).Controls.Tests</RootNamespace>
        <AssemblyName>DroidNet.Controls.DynamicTree.Tests</AssemblyName>
        <NoWarn>$(NoWarn);MSTEST0084</NoWarn>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
            <PackageReference Include="Moq" />
            <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Controls\DynamicTree\src\Controls.DynamicTree.csproj" />
    </ItemGroup>

    <!-- Exercise the demo's small domain adapter without depending on the WinUI executable. -->
    <ItemGroup>
        <Compile Include="$(ProjectsRoot)\Controls\DemoApp\Tree\Model\*.cs" Link="Demo\Model\%(Filename)%(Extension)" />
        <Compile Include="$(ProjectsRoot)\Controls\DemoApp\Tree\EntityAdapter.cs" Link="Demo\EntityAdapter.cs" />
        <Compile Include="$(ProjectsRoot)\Controls\DemoApp\Tree\SceneAdapter.cs" Link="Demo\SceneAdapter.cs" />
        <Compile Include="$(ProjectsRoot)\Controls\DemoApp\Tree\Services\*.cs" Link="Demo\Services\%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
