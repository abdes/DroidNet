<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dnc="using:DroidNet.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="TreeDensityStyle" TargetType="dnc:DynamicTree">
        <Setter Property="ItemRowHeight" Value="{ThemeResource ListViewItemMinHeight}" />
        <Setter Property="ItemFontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
    </Style>
</ResourceDictionary>
