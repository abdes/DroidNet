---
UseColor: true

Checks: >
    bugprone-*,
    cppcoreguidelines-*,
    google-build-*,
    google-default-arguments,
    google-explicit-constructor,
    google-global-names-in-headers,
    google-readability-avoid-underscore-in-googletest-name,
    google-runtime-int,
    google-runtime-operator,
    google-upgrade-googletest-case,
    misc-coroutine-hostile-raii,
    misc-definitions-in-headers,
    misc-include-cleaner,
    misc-misplaced-const,
    misc-redundant-expression,
    misc-throw-by-value-catch-by-reference,
    misc-unused-alias-decls,
    misc-unused-using-decls,
    modernize-*,
    performance-*,
    portability-*,
    readability-*,
    -clang-diagnostic-format-security,
    -performance-faster-string-find,
    -portability-avoid-pragma-once,
    -portability-simd-intrinsics,
    -google-readability-todo,
    -readability-identifier-length,
    -readability-convert-member-functions-to-static,
    -readability-function-cognitive-complexity,
    -readability-container-size-empty,
    -cppcoreguidelines-pro-type-union-access,
    -bugprone-assignment-in-if-condition,
    -bugprone-narrowing-conversions,
    -cppcoreguidelines-avoid-c-arrays,
    -cppcoreguidelines-avoid-magic-numbers,
    -cppcoreguidelines-explicit-constructor,
    -cppcoreguidelines-explicit-virtual-functions,
    -cppcoreguidelines-macro-to-enum,
    -cppcoreguidelines-noexcept-destructor,
    -cppcoreguidelines-noexcept-move-operations,
    -cppcoreguidelines-noexcept-swap,
    -cppcoreguidelines-use-default-member-init,
    -cppcoreguidelines-avoid-capturing-lambda-coroutines,
    -cppcoreguidelines-avoid-reference-coroutine-parameters,
    -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
    -cppcoreguidelines-pro-bounds-constant-array-index,
    -cppcoreguidelines-pro-type-static-cast-downcast,
    -performance-enum-size,
    -readability-magic-numbers

CheckOptions:
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: true
  - key: readability-implicit-bool-conversion.AllowIntegerConditions
    value: false
  - key: readability-implicit-bool-conversion.UseUpperCaseLiteralSuffix
    value: true
  - key: cppcoreguidelines-rvalue-reference-param-not-moved.AllowImplicitMove
    value: true
  # LLVM 23's Remove fix can delete required separators after empty {} values.
  - key: readability-trailing-comma.SingleLineCommaPolicy
    value: Ignore
  - key: readability-trailing-comma.MultiLineCommaPolicy
    value: Append
  - key: cppcoreguidelines-avoid-do-while.IgnoreMacros
    value: true
  # Abort-only failures: allocation and log formatting (fmt's format_error and
  # its locale bad_cast) cannot be handled by callers, so noexcept functions
  # that allocate or log stay noexcept.
  - key: bugprone-exception-escape.IgnoredExceptions
    value: 'bad_alloc,bad_array_new_length,format_error,bad_cast'
  # glm spreads each type across internal headers that are not meant to be
  # included directly; include-cleaner cannot map its symbols usefully.
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'glm/.*'

# Matched against resolved header paths, not include spellings. Engine SDK
# headers are analyzed by the engine's own runs.
HeaderFilterRegex: '.*[/\]Oxygen\.Editor\.Interop[/\]src[/\].*'

ExtraArgs:
  - -Wno-inconsistent-dllimport
  - -Wno-format-extra-args
  # Omitting fields that have default member initializers is intended C++20
  # designated-initializer usage, which modernize-use-designated-initializers
  # encourages.
  - -Wno-missing-designated-field-initializers
...
