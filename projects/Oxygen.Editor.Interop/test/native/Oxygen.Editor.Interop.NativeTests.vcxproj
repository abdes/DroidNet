<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet's cross-targeting version query can pass an empty global framework.
     This C++/CLI test library always targets its declared framework. -->
<Project DefaultTargets="Build" TreatAsLocalProperty="TargetFramework" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
