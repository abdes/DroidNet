<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Configurations -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <!-- Global Properties -->
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C9F1A1D1-8E37-4C3D-A6B3-8C2E3B9F4D12}</ProjectGuid>
    <!-- Declare DLL project type early so SDK checks succeed -->
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CLRSupport>NetCore</CLRSupport>
    <!--
      Workaround: The .NET test SDK (Microsoft.NET.Test.Sdk / MSTest) can cause
      test projects to be evaluated with OutputType=Exe, which trips the
      NETSDK1116 check for C++/CLI ("C++/CLI projects targeting .NET Core must be dynamic libraries").
      Setting <_EnablePackageReferencesInVCProjects>true</_EnablePackageReferencesInVCProjects>
      instructs MSBuild to handle PackageReferences in VC projects in a way that keeps
      this project treated as a library (DynamicLibrary) and avoids the NETSDK1116 error.
      If this causes compatibility issues on some older VS/MSBuild installs, an alternative
      is to avoid PackageReference and add explicit <Reference> entries for test assemblies.
    -->
    <_EnablePackageReferencesInVCProjects>true</_EnablePackageReferencesInVCProjects>
    <!-- Ensure .NET SDK sees this as a library and not an EXE (fixes NETSDK1116) -->
    <OutputType>Library</OutputType>
    <!-- Mark as NetCoreCProj so msbuild treats this as a .NET-targeted C++/CLI project -->
    <Keyword>NetCoreCProj</Keyword>
    <RootNamespace>Oxygen.Editor.Interop.NativeTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <!-- C++/CLI .NET Core/5+/6+/7+/8+/9+ -->
    <TargetFramework>net9.0</TargetFramework>
    <ProjectName>Oxygen.Editor.Interop.NativeTests</ProjectName>
    <WindowsTargetPlatformMinVersion>7.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>
  <PropertyGroup>
    <_NativeTestsArtifactsPath Condition="'$(ArtifactsPath)' != ''">$([MSBuild]::EnsureTrailingSlash($(ArtifactsPath)))</_NativeTestsArtifactsPath>
    <_NativeTestsArtifactsPath Condition="'$(_NativeTestsArtifactsPath)' == ''">$([MSBuild]::EnsureTrailingSlash($(MSBuildThisFileDirectory)..\..\..\..\artifacts))</_NativeTestsArtifactsPath>
    <BaseIntermediateOutputPath>$(_NativeTestsArtifactsPath)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- Debug -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CLRSupport>NetCore</CLRSupport>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <!-- Release -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CLRSupport>NetCore</CLRSupport>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <_NativeTestsArtifactsPivot Condition="'$(ArtifactsPivots)' != ''">$(ArtifactsPivots)</_NativeTestsArtifactsPivot>
    <_NativeTestsArtifactsPivot Condition="'$(_NativeTestsArtifactsPivot)' == '' and '$(TargetFramework)' != '' and '$(RuntimeIdentifier)' != ''">$(Configuration)_$(TargetFramework)_$(RuntimeIdentifier)</_NativeTestsArtifactsPivot>
    <_NativeTestsArtifactsPivot Condition="'$(_NativeTestsArtifactsPivot)' == '' and '$(TargetFramework)' != '' and '$(RuntimeIdentifier)' == ''">$(Configuration)_$(TargetFramework)</_NativeTestsArtifactsPivot>
    <_NativeTestsArtifactsPivot Condition="'$(_NativeTestsArtifactsPivot)' == ''">$(Configuration)_$(Platform)</_NativeTestsArtifactsPivot>
    <_NativeTestsOutDir>$(_NativeTestsArtifactsPath)bin\$(MSBuildProjectName)\$(_NativeTestsArtifactsPivot)\</_NativeTestsOutDir>
    <_NativeTestsIntDir>$(_NativeTestsArtifactsPath)obj\$(MSBuildProjectName)\$(_NativeTestsArtifactsPivot)\</_NativeTestsIntDir>
    <InteropBinaryDir>$(_NativeTestsArtifactsPath)bin\Oxygen.Editor.Interop\$(Configuration)_$(TargetFramework)\</InteropBinaryDir>
  </PropertyGroup>
  <!-- Source Files -->
  <ItemGroup>
    <ClCompile Include="$(ProjectsRoot)\Oxygen.Editor.Interop\src\Commands\SetEnvironmentCommand.cpp">
      <CompileAsManaged>false</CompileAsManaged>
    </ClCompile>
    <ClCompile Include="src\EnvironmentCommand_native_test.cpp" />
    <ClCompile Include="src\InputAccumulator_native_test.cpp" />
  </ItemGroup>
  <!-- Intermediate Output -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <OxygenEngineInstallDir>$(ProjectsRoot)\Oxygen.Engine\out\install\$(Configuration)</OxygenEngineInstallDir>
  </PropertyGroup>
  <!-- Debug Settings -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(_NativeTestsOutDir)</OutDir>
    <IntDir>$(_NativeTestsIntDir)</IntDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(_NativeTestsOutDir)</OutDir>
    <IntDir>$(_NativeTestsIntDir)</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>_DEBUG;_WIN32_WINNT=0x0A00;LOGURU_USE_FMTLIB=1;FMT_HEADER_ONLY=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectsRoot)\Oxygen.Editor.Interop\src;$(OxygenEngineInstallDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <UseStandardPreprocessor>true</UseStandardPreprocessor>
      <AdditionalOptions>/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <DisableSpecificWarnings>4793;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(OxygenEngineInstallDir)\lib\Oxygen.Engine.EditorInterface-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Base-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Composition-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Platform-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Input-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Content-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Engine-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Graphics.Common-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Graphics.Direct3D12-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Core-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Scene-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.SceneSync-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Data-d.lib;$(OxygenEngineInstallDir)\lib\Oxygen.Vortex-d.lib;$(InteropBinaryDir)\DroidNet.Oxygen.Editor.Interop.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(OxygenEngineInstallDir)\lib;$(InteropBinaryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <!-- Release Settings -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PreprocessorDefinitions>NDEBUG;_WIN32_WINNT=0x0A00;LOGURU_USE_FMTLIB=1;FMT_HEADER_ONLY=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>
        $(ProjectsRoot)\Oxygen.Editor.Interop\src;
        $(OxygenEngineInstallDir)\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <UseStandardPreprocessor>true</UseStandardPreprocessor>
      <DisableSpecificWarnings>4793;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
    </ClCompile>
    <Link>
      <AdditionalDependencies>
        $(OxygenEngineInstallDir)\lib\Oxygen.Engine.EditorInterface.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Base.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Composition.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Platform.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Input.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Content.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Engine.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Graphics.Common.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Graphics.Direct3D12.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Core.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Scene.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.SceneSync.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Data.lib;
        $(OxygenEngineInstallDir)\lib\Oxygen.Vortex.lib;
        $(InteropBinaryDir)\DroidNet.Oxygen.Editor.Interop.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>
        $(OxygenEngineInstallDir)\lib;
        $(InteropBinaryDir);
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <!-- Reference to your interop project -->
  <ItemGroup>
    <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Interop\src\Oxygen.Editor.Interop.vcxproj">
      <Private>true</Private>
      <LinkLibraryDependencies>true</LinkLibraryDependencies>
      <UseLibraryDependencyInputs>true</UseLibraryDependencyInputs>
    </ProjectReference>
  </ItemGroup>
  <!-- Use package references for MSTest. We keep _EnablePackageReferencesInVCProjects=true so VC++ projects handle PackageReference correctly. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" VersionOverride="3.11.0" />
    <PackageReference Include="MSTest.TestFramework" VersionOverride="3.11.0" />
  </ItemGroup>
  <!-- Ensure consistent System.Diagnostics.DiagnosticSource version across projects to avoid MSB3277 warnings -->
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ItemGroup Condition="Exists('$(OxygenEngineInstallDir)\bin')">
    <OxygenEngineRuntimeDependency Include="$(OxygenEngineInstallDir)\bin\*.dll" />
  </ItemGroup>
  <Target Name="CopyOxygenEngineRuntimeDependencies" AfterTargets="Build" Condition="'@(OxygenEngineRuntimeDependency)' != ''">
    <Copy SourceFiles="@(OxygenEngineRuntimeDependency)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- Debug target to display evaluated properties -->
  <Target Name="ShowProps">
    <Message Text="ConfigurationType=$(ConfigurationType)" Importance="High" />
    <Message Text="CLRSupport=$(CLRSupport)" Importance="High" />
    <Message Text="Keyword=$(Keyword)" Importance="High" />
    <Message Text="IsCPlusPlusCli=$(IsCPlusPlusCli)" Importance="High" />
    <Message Text="TargetFramework=$(TargetFramework)" Importance="High" />
    <Message Text="OutputType=$(OutputType)" Importance="High" />
  </Target>
</Project>
