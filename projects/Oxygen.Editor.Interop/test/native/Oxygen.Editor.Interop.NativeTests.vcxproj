    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <_NativeTestsOutDir>$(ArtifactsPath)\bin\$(MSBuildProjectName)\$(ArtifactsPivots)\</_NativeTestsOutDir>
    <_NativeTestsIntDir>$(ArtifactsPath)\obj\$(MSBuildProjectName)\$(ArtifactsPivots)\</_NativeTestsIntDir>
    <InteropBinaryDir>$(ArtifactsPath)\bin\Oxygen.Editor.Interop\$(Configuration)_$(TargetFramework)\</InteropBinaryDir>
    <RunSettingsFilePath>$(_NativeTestsIntDir)$(MSBuildProjectName).runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <!-- Source Files -->
  <ItemGroup>
    <ClCompile Include="$(ProjectsRoot)\Oxygen.Editor.Interop\src\Commands\SetEnvironmentCommand.cpp">
      <CompileAsManaged>false</CompileAsManaged>
    </ClCompile>
    <ClCompile Include="$(ProjectsRoot)\Oxygen.Editor.Interop\src\EditorModule\SceneAssetRequests.cpp">
