<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!--
      The installed engine SDK is an input of this project that Visual Studio's
      fast up-to-date check cannot see: it tracks compiler and linker inputs, not
      the SDK DLLs hashed into the receipt. Let MSBuild evaluate the project on
      every build; RecordInteropNativeSdk rewrites its headers only when an SDK
      hash changed, so an unchanged SDK costs no recompilation.
    -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <NativeSdkCompileHeader>$(IntDir)NativeSdkCompile.h</NativeSdkCompileHeader>
    <NativeSdkReceiptHeader>$(IntDir)NativeSdkReceipt.h</NativeSdkReceiptHeader>
    <NativeSdkStampFile>$(IntDir)NativeSdkReceipt.stamp</NativeSdkStampFile>
    <NativeSdkRoot>$(OxygenSdkDir)</NativeSdkRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <ForcedIncludeFiles>$(NativeSdkCompileHeader);%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Update="AssemblyInfo.cpp">
      <ForcedIncludeFiles>$(NativeSdkReceiptHeader);$(NativeSdkCompileHeader);%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemGroup>
  <Target Name="_PrepareInteropNativeSdkInputs" BeforeTargets="RecordInteropNativeSdk" Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(NativeSdkStampFile)" Condition="!Exists('$(NativeSdkReceiptHeader)') or !Exists('$(NativeSdkCompileHeader)')" />
    <ItemGroup>
      <_NativeSdkInputs Include="$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)..\tools\Write-NativeSdkReceipt.ps1" />
      <_NativeSdkInputs Include="$(NativeSdkRoot)\bin\*.dll;$(NativeSdkRoot)\include\**\*;$(NativeSdkRoot)\lib\**\*" Condition="Exists('$(NativeSdkRoot)')" />
      <!-- Force RecordInteropNativeSdk to run and produce the missing-SDK error when the SDK directory is absent -->
      <_NativeSdkInputs Include="$(NativeSdkRoot)\__missing_sdk__" Condition="!Exists('$(NativeSdkRoot)')" />
    </ItemGroup>
  </Target>
  <Target Name="RecordInteropNativeSdk" BeforeTargets="ClCompile" DependsOnTargets="_PrepareInteropNativeSdkInputs" Condition="'$(DesignTimeBuild)' != 'true'" Inputs="@(_NativeSdkInputs)" Outputs="$(NativeSdkStampFile)">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\Write-NativeSdkReceipt.ps1&quot; -SdkRoot &quot;$(NativeSdkRoot)&quot; -Configuration &quot;$(Configuration)&quot; -OutputHeader &quot;$(NativeSdkReceiptHeader)&quot; -CompileHeader &quot;$(NativeSdkCompileHeader)&quot;" />
    <Touch Files="$(NativeSdkStampFile)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(NativeSdkReceiptHeader);$(NativeSdkCompileHeader);$(NativeSdkStampFile)" />
    </ItemGroup>
  </Target>
</Project>
