<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!--
      The installed engine SDK is an input of this project. Visual Studio's fast
      up-to-date check sees its headers and import libraries through the
      compiler and linker tracking logs, not the SDK DLLs hashed into the
      receipt: WriteInteropNativeSdkTrackingLogs declares those in a tracking
      log pair, so a changed DLL makes the project out of date.
    -->
    <NativeSdkCompileHeader>$(IntDir)NativeSdkCompile.h</NativeSdkCompileHeader>
    <NativeSdkReceiptHeader>$(IntDir)NativeSdkReceipt.h</NativeSdkReceiptHeader>
    <NativeSdkStampFile>$(IntDir)NativeSdkReceipt.stamp</NativeSdkStampFile>
    <NativeSdkReadTrackingLog>$(TLogLocation)NativeSdkReceipt.read.1.tlog</NativeSdkReadTrackingLog>
    <NativeSdkWriteTrackingLog>$(TLogLocation)NativeSdkReceipt.write.1.tlog</NativeSdkWriteTrackingLog>
    <NativeSdkRoot>$(OxygenSdkDir)</NativeSdkRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <ForcedIncludeFiles>$(NativeSdkCompileHeader);%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Update="AssemblyInfo.cpp">
      <ForcedIncludeFiles>$(NativeSdkReceiptHeader);$(NativeSdkCompileHeader);%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemGroup>
  <Target Name="_PrepareInteropNativeSdkInputs" BeforeTargets="RecordInteropNativeSdk" Condition="'$(DesignTimeBuild)' != 'true'">
    <Delete Files="$(NativeSdkStampFile)" Condition="!Exists('$(NativeSdkReceiptHeader)') or !Exists('$(NativeSdkCompileHeader)')" />
    <ItemGroup>
      <_NativeSdkInputs Include="$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)..\tools\Write-NativeSdkReceipt.ps1" />
      <_NativeSdkInputs Include="$(NativeSdkRoot)\bin\*.dll;$(NativeSdkRoot)\include\**\*;$(NativeSdkRoot)\lib\**\*" Condition="Exists('$(NativeSdkRoot)')" />
      <!-- Force RecordInteropNativeSdk to run and produce the missing-SDK error when the SDK directory is absent -->
      <_NativeSdkInputs Include="$(NativeSdkRoot)\__missing_sdk__" Condition="!Exists('$(NativeSdkRoot)')" />
    </ItemGroup>
  </Target>
  <Target Name="RecordInteropNativeSdk" BeforeTargets="ClCompile" DependsOnTargets="_PrepareInteropNativeSdkInputs" Condition="'$(DesignTimeBuild)' != 'true'" Inputs="@(_NativeSdkInputs)" Outputs="$(NativeSdkStampFile)">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\Write-NativeSdkReceipt.ps1&quot; -SdkRoot &quot;$(NativeSdkRoot)&quot; -Configuration &quot;$(Configuration)&quot; -OutputHeader &quot;$(NativeSdkReceiptHeader)&quot; -CompileHeader &quot;$(NativeSdkCompileHeader)&quot;" />
    <Touch Files="$(NativeSdkStampFile)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(NativeSdkReceiptHeader);$(NativeSdkCompileHeader);$(NativeSdkStampFile)" />
    </ItemGroup>
  </Target>
  <!--
    The receipt's inputs Visual Studio's fast up-to-date check cannot otherwise
    see: the SDK DLLs, this file and the receipt script. A tracking log pair
    names them as the inputs of the stamp, under one root line. Written on every
    build, so a DLL added to the SDK is tracked from that build on.
  -->
  <Target Name="WriteInteropNativeSdkTrackingLogs" AfterTargets="RecordInteropNativeSdk" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_NativeSdkTrackedInputs Include="$(MSBuildThisFileFullPath);$(MSBuildThisFileDirectory)..\tools\Write-NativeSdkReceipt.ps1" />
      <_NativeSdkTrackedInputs Include="$(NativeSdkRoot)\bin\*.dll" Condition="Exists('$(NativeSdkRoot)')" />
    </ItemGroup>
    <PropertyGroup>
      <_NativeSdkTrackingRoot>^$([System.IO.Path]::GetFullPath('$(NativeSdkStampFile)').ToUpperInvariant())</_NativeSdkTrackingRoot>
    </PropertyGroup>
    <WriteLinesToFile File="$(NativeSdkReadTrackingLog)" Lines="$(_NativeSdkTrackingRoot);@(_NativeSdkTrackedInputs->'%(FullPath)'->ToUpperInvariant())" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(NativeSdkWriteTrackingLog)" Lines="$(_NativeSdkTrackingRoot);$([System.IO.Path]::GetFullPath('$(NativeSdkStampFile)').ToUpperInvariant())" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(NativeSdkReadTrackingLog);$(NativeSdkWriteTrackingLog)" />
    </ItemGroup>
  </Target>
</Project>
