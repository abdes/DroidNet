<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <Title>DroidNet Storage</Title>
        <Description>Abstracts document and entity storage and includes implementations for storage providers, including the native filesystem.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>droidnet;storage;filesystem</PackageTags>
        <PackageReleaseNotes>Initial version.</PackageReleaseNotes>
        <RootNamespace>$(RootNamespace).Storage</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DroidNet.Storage.Tests" />
        <InternalsVisibleTo Include="DroidNet.Storage.AtomicWriteProbe" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Testably.Abstractions" />
    </ItemGroup>

</Project>
