<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <UseWinUI>true</UseWinUI>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <Title>Oxygen Editor Composition</Title>
        <Description>The editor's composition root: the registrations of the editor scope and of the workspace window's scope, and the workspace window's view model, which the application host composes.</Description>
        <PackageTags>oxygen;gameengine</PackageTags>
        <RootNamespace>Oxygen.Editor</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="DryIoc.dll" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
        <PackageReference Include="System.Reactive" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)/Aura/src/Aura.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Composition/src/Composition.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Config/src/Config.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Controls/OutputConsole/src/Controls.OutputConsole.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Docking/src/Docking.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Hosting/src/Hosting.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Assets/src/Oxygen.Editor.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.ContentExplorer/src/Oxygen.Editor.ContentExplorer.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.ContentPipeline/src/Oxygen.Editor.ContentPipeline.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.CookedInspector/src/Oxygen.Editor.CookedInspector.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Cooking/src/Oxygen.Editor.Cooking.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Data/src/Oxygen.Editor.Data.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Documents/src/Oxygen.Editor.Documents.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Input/src/Oxygen.Editor.Input.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.LivePreview/src/Oxygen.Editor.LivePreview.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.MaterialEditor/src/Oxygen.Editor.MaterialEditor.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.ModelEditor/src/Oxygen.Editor.ModelEditor.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Materials/src/Oxygen.Editor.Materials.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Output/src/Oxygen.Editor.Output.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Problems/src/Oxygen.Editor.Problems.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.ProjectExplorer/src/Oxygen.Editor.ProjectExplorer.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Projects/src/Oxygen.Editor.Projects.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Routing/src/Oxygen.Editor.Routing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Runtime/src/Oxygen.Editor.Runtime.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.SceneEditor/src/Oxygen.Editor.SceneEditor.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.SceneExplorer/src/Oxygen.Editor.SceneExplorer.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.SceneInspector/src/Oxygen.Editor.SceneInspector.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Scenes/src/Oxygen.Editor.Scenes.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Scripting/src/Oxygen.Editor.Scripting.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Shell/src/Oxygen.Editor.Shell.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Managed.Assets/src/Oxygen.Managed.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Managed.Core/src/Oxygen.Managed.Core.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Routing/Routing.Abstractions/src/Routing.Abstractions.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Routing/Routing.Router/src/Routing.Router.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Routing/Routing.WinUI/src/Routing.WinUI.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Storage/src/Storage.csproj" />

        <ProjectReference Include="$(ProjectsRoot)/Mvvm.Generators/src/Mvvm.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="$(ProjectsRoot)/Mvvm.Generators.Attributes/src/Mvvm.Generators.Attributes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
    </ItemGroup>

</Project>
