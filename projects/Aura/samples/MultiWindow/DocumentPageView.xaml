<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DroidNet.Samples.Aura.MultiWindow.DocumentPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="20" Spacing="12">
        <TextBlock
            FontSize="24"
            FontWeight="SemiBold"
            Text="{x:Bind ViewModel.Document.Title, Mode=OneWay, FallbackValue='No document'}" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Drag a tab onto another window's tab strip to move it there, or outside every window to open it in a new one. This window closes with its last tab; closing it closes its documents."
            TextWrapping="WrapWholeWords" />
        <Button Command="{x:Bind ViewModel.ToggleEditedCommand}" Content="Edit / Save" />
    </StackPanel>
</Page>
