<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.Environment.BackdropSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:pickers="using:Oxygen.Editor.Pickers"
    xmlns:seg="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.SceneInspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        x:Name="BackdropSection"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Description="What shows behind the scene: the atmosphere, a cubemap or a solid color."
        Header="Backdrop"
        HeaderIcon="{ui:FontIcon Glyph='&#xE790;'}"
        IsExpanded="True"
        Tag="Environment">
        <editorcontrols:PropertiesExpander.Items>
            <editorcontrols:PropertyCard
                x:Name="BackdropCard"
                HorizontalContentAlignment="Stretch"
                PropertyName="Show">
                <StackPanel Spacing="4">
                    <seg:Segmented
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Backdrop"
                        IsEnabled="{x:Bind ViewModel.EditOwner.IsInputEnabled, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}"
                        Tag="Backdrop">
                        <seg:SegmentedItem Content="Atmosphere" />
                        <seg:SegmentedItem Content="Cubemap" />
                        <seg:SegmentedItem Content="Solid color" />
                    </seg:Segmented>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="The atmosphere is off: no aerial perspective and no atmospheric tint on the sun."
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsAtmosphereOff, Mode=OneWay, Converter={StaticResource SceneExpandedVisibility}}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.BackdropDiagnostic.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.BackdropDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                </StackPanel>
            </editorcontrols:PropertyCard>
            <StackPanel x:Name="CubemapFields" Spacing="4">
                <editorcontrols:PropertyCard
                    x:Name="CubemapCard"
                    HorizontalContentAlignment="Stretch"
                    PropertyName="Cubemap">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DropDownButton
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.EditOwner.IsInputEnabled, Mode=OneWay}"
                                Tag="Cubemap"
                                ToolTipService.ToolTip="Choose the backdrop cubemap">
                                <TextBlock Text="{x:Bind ViewModel.CubemapDisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <DropDownButton.Flyout>
                                    <Flyout x:Name="CubemapFlyout">
                                        <pickers:AssetPicker
                                            Width="320"
                                            ChoiceInvoked="OnCubemapChoiceInvoked"
                                            EmptyText="Import an image with the Cube shape to list it here."
                                            Model="{x:Bind ViewModel.Cubemaps.Choices}" />
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button
                                Grid.Column="1"
                                Click="ClearCubemap_Click"
                                IsEnabled="{x:Bind ViewModel.EditOwner.IsInputEnabled, Mode=OneWay}"
                                ToolTipService.ToolTip="Clear the backdrop cubemap">
                                <FontIcon Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind ViewModel.CubemapDiagnostic.Message, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.CubemapDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}" />
                    </StackPanel>
                </editorcontrols:PropertyCard>
                <editorcontrols:InspectorNumberField
                    x:Name="RotationCard"
                    CardStyle="{StaticResource ScenePropertyCardStyle}"
                    EditSessionCompleted="NumberEditCompleted"
                    EditSessionStarted="NumberEditStarted"
                    ErrorText="{x:Bind ViewModel.RotationDiagnostic.Message, Mode=OneWay}"
                    FontSize="14"
                    HasError="{x:Bind ViewModel.RotationDiagnostic.HasError, Mode=OneWay}"
                    Label="Rotation"
                    NumberStyle="{StaticResource SceneNumberBoxStyle}"
                    NumberValue="{x:Bind ViewModel.RotationDegrees, Mode=TwoWay}"
                    Tag="SkySphereRotation"
                    Unit="°" />
            </StackPanel>
            <StackPanel x:Name="SolidColorFields" Spacing="4">
                <editorcontrols:InspectorColorField
                    x:Name="SolidColorCard"
                    Blue="{x:Bind ViewModel.SolidColorB, Mode=TwoWay}"
                    ColorPicked="OnRgbColorPicked"
                    EditSessionCompleted="ColorEditCompleted"
                    EditSessionStarted="ColorEditStarted"
                    ErrorText="{x:Bind ViewModel.SolidColorDiagnostic.Message, Mode=OneWay}"
                    FontSize="14"
                    Green="{x:Bind ViewModel.SolidColorG, Mode=TwoWay}"
                    HasError="{x:Bind ViewModel.SolidColorDiagnostic.HasError, Mode=OneWay}"
                    Label="Color"
                    PickerAutomationName="Pick backdrop color"
                    Red="{x:Bind ViewModel.SolidColorR, Mode=TwoWay}"
                    Tag="SolidColor" />
                <editorcontrols:PropertyCard
                    x:Name="SolidColorLightsSceneCard"
                    HorizontalContentAlignment="Stretch"
                    PropertyName="Light the scene with this color">
                    <ToggleSwitch
                        IsEnabled="{x:Bind ViewModel.EditOwner.IsInputEnabled, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.SolidColorLightsScene, Mode=TwoWay}"
                        Tag="SolidColorLightsScene"
                        ToolTipService.ToolTip="On: the sky light captures the color. Off: the color only paints the view." />
                </editorcontrols:PropertyCard>
            </StackPanel>
            <StackPanel x:Name="ToneFields" Spacing="4">
                <editorcontrols:InspectorNumberField
                    x:Name="IlluminanceCard"
                    CardStyle="{StaticResource ScenePropertyCardStyle}"
                    EditSessionCompleted="NumberEditCompleted"
                    EditSessionStarted="NumberEditStarted"
                    ErrorText="{x:Bind ViewModel.IlluminanceDiagnostic.Message, Mode=OneWay}"
                    FontSize="14"
                    HasError="{x:Bind ViewModel.IlluminanceDiagnostic.HasError, Mode=OneWay}"
                    Label="Illuminance"
                    NumberStyle="{StaticResource SceneNumberBoxStyle}"
                    NumberValue="{x:Bind ViewModel.IlluminanceLux, Mode=TwoWay}"
                    Tag="SkySphereIlluminance"
                    ToolTipService.ToolTip="Calibrates the sky to a physical brightness: the illuminance, in lux, it delivers on an upward-facing surface. The cubemap or color is scaled to deliver it, both for what the view shows and for the light a Sky Light set to Capture sky reads, so the sky matches a physical sun. HDR images rarely carry real units: a typical one delivers a few lux while a daylight sun delivers 25,000 to 100,000, so uncalibrated, auto exposure meters the dim sky and burns sunlit surfaces to white. Typical values: clear day 10,000 to 25,000; overcast 1,000 to 10,000; sunset 100 to 1,000; night below 1. 0 uses the image&apos;s own values. Only a float (HDR) cubemap can be measured: an LDR one stays uncalibrated, and the renderer warns."
                    Unit="lux" />
                <editorcontrols:InspectorNumberField
                    x:Name="IntensityCard"
                    CardStyle="{StaticResource ScenePropertyCardStyle}"
                    EditSessionCompleted="NumberEditCompleted"
                    EditSessionStarted="NumberEditStarted"
                    ErrorText="{x:Bind ViewModel.IntensityDiagnostic.Message, Mode=OneWay}"
                    FontSize="14"
                    HasError="{x:Bind ViewModel.IntensityDiagnostic.HasError, Mode=OneWay}"
                    Label="Intensity"
                    NumberStyle="{StaticResource SceneNumberBoxStyle}"
                    NumberValue="{x:Bind ViewModel.IntensityEv, Mode=TwoWay}"
                    Tag="SkySphereIntensity"
                    ToolTipService.ToolTip="Adjusts only what the view shows, in exposure stops (EV): the shown radiance is multiplied by 2 to the power EV, so EV 0 keeps the calibrated sky and each +1 EV doubles it. It never changes the light the sky casts; calibrate brightness with Illuminance. The minimum, EV -16, is effectively off."
                    Unit="EV" />
                <editorcontrols:InspectorColorField
                    x:Name="TintCard"
                    Blue="{x:Bind ViewModel.TintB, Mode=TwoWay}"
                    ColorPicked="OnRgbColorPicked"
                    EditSessionCompleted="ColorEditCompleted"
                    EditSessionStarted="ColorEditStarted"
                    ErrorText="{x:Bind ViewModel.TintDiagnostic.Message, Mode=OneWay}"
                    FontSize="14"
                    Green="{x:Bind ViewModel.TintG, Mode=TwoWay}"
                    HasError="{x:Bind ViewModel.TintDiagnostic.HasError, Mode=OneWay}"
                    Label="Tint"
                    PickerAutomationName="Pick backdrop tint"
                    Red="{x:Bind ViewModel.TintR, Mode=TwoWay}"
                    Tag="SkySphereTint" />
            </StackPanel>
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
