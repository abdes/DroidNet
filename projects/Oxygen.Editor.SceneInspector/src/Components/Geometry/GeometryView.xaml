<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.Components.Geometry.GeometryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:ctkcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:local="using:Oxygen.Editor.SceneInspector.Components.Geometry"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pickers="using:Oxygen.Editor.Pickers"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.SceneInspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ctkcvt:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <DataTemplate x:Key="AssetThumbnailTemplate">
                <Border
                    Width="24"
                    Height="24"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="{Binding}" />
                    </Viewbox>
                </Border>
            </DataTemplate>

            <!--  One surface: a disclosure whose header names it and summarizes its values, over its three rows.  -->
            <DataTemplate x:Key="SurfaceCardTemplate" x:DataType="local:SurfaceCardViewModel">
                <Border Padding="10,2,4,6" Style="{StaticResource InspectorItemCard}">
                    <Grid>
                        <Rectangle
                            Width="3"
                            Margin="-7,6,0,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="{x:Bind editorcontrols:OverrideStates.BarOpacity(OverrideState), Mode=OneWay}"
                            RadiusX="1"
                            RadiusY="1" />
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            Style="{StaticResource QuietDisclosure}">
                            <Expander.Header>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Thumbnail
                                        Width="24"
                                        Height="24"
                                        VerticalAlignment="Center"
                                        Content="{x:Bind MaterialGlyph, Mode=OneWay}"
                                        ContentTemplate="{StaticResource AssetThumbnailTemplate}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Summary, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Summary, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="{x:Bind ResetToolTip, Mode=OneWay}"
                                        Command="{x:Bind ResetCommand}"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                        Style="{StaticResource QuietActionButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind ResetToolTip, Mode=OneWay}"
                                        Visibility="{x:Bind editorcontrols:OverrideStates.ResetVisibility(OverrideState), Mode=OneWay}">
                                        <FontIcon FontSize="12" Glyph="&#xE777;" />
                                    </Button>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Padding="0,4,0,0" Spacing="4">
                                <editorcontrols:PropertyCard
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                    OverrideState="{x:Bind MaterialOverrideState, Mode=OneWay}"
                                    PropertyName="Material"
                                    ResetCommand="{x:Bind ResetMaterialCommand}"
                                    ResetToolTip="{x:Bind MaterialResetToolTip, Mode=OneWay}">
                                    <pickers:AssetPickerButton
                                        AutomationName="Material"
                                        ChoiceInvoked="OnMaterialChoiceInvoked"
                                        Label="{x:Bind MaterialLabel, Mode=OneWay}"
                                        Model="{x:Bind MaterialChoices}"
                                        PickerOpening="OnMaterialPickerOpening" />
                                </editorcontrols:PropertyCard>
                                <editorcontrols:ToggleField
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                    Label="Visible"
                                    OverrideState="{x:Bind VisibleOverrideState, Mode=OneWay}"
                                    ResetCommand="{x:Bind ResetVisibleCommand}"
                                    ResetToolTip="{x:Bind VisibleResetToolTip, Mode=OneWay}"
                                    Value="{x:Bind Visible, Mode=TwoWay}" />
                                <editorcontrols:ToggleField
                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                    Label="Cast shadows"
                                    OverrideState="{x:Bind CastsShadowsOverrideState, Mode=OneWay}"
                                    ResetCommand="{x:Bind ResetCastsShadowsCommand}"
                                    ResetToolTip="{x:Bind CastsShadowsResetToolTip, Mode=OneWay}"
                                    Value="{x:Bind CastsShadows, Mode=TwoWay}" />
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Border>
            </DataTemplate>

            <!--  Changes kept for a lost surface: what they are, a current surface to apply them to, or removal.  -->
            <DataTemplate x:Key="KeptChangesTemplate" x:DataType="local:KeptSurfaceChangesViewModel">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Summary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Summary, Mode=OneWay}" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="120"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Apply to surface"
                        DisplayMemberPath="Name"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        ItemsSource="{x:Bind Targets, Mode=OneWay}"
                        PlaceholderText="Apply to…"
                        SelectedItem="{x:Bind Target, Mode=TwoWay}"
                        ToolTipService.ToolTip="Apply these changes to a surface of the geometry" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Remove these changes"
                        Command="{x:Bind RemoveCommand}"
                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                        Style="{StaticResource QuietActionButtonStyle}"
                        ToolTipService.ToolTip="Remove these changes">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </DataTemplate>
            <!--  A Distance threshold; the first names the unit for all.  -->
            <DataTemplate x:Key="DistanceTransitionTemplate" x:DataType="local:LodTransitionViewModel">
                <editorcontrols:NumberField
                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                    Label="{x:Bind Label}"
                    NumberValue="{x:Bind Distance, Mode=TwoWay}"
                    Qualifier="{x:Bind DistanceUnit}"
                    QualifierGroup="LodDistance"
                    ToolTipService.ToolTip="From this view distance on, in radii of the geometry&apos;s bounding sphere, the coarser LOD shows. Thresholds must not decrease." />
            </DataTemplate>

            <!--  A Screen-space error pair: the error that brings the finer LOD back, and the one that moves to the coarser.  -->
            <DataTemplate x:Key="ErrorTransitionTemplate" x:DataType="local:LodTransitionViewModel">
                <editorcontrols:PropertyCard IsEnabled="{x:Bind CanEdit, Mode=OneWay}" PropertyName="{x:Bind Label}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:NumberBox
                            AutomationProperties.Name="{x:Bind FinerName}"
                            LabelPosition="None"
                            NumberValue="{x:Bind Finer, Mode=TwoWay}"
                            Style="{StaticResource PropertyNumberBoxStyle}"
                            ToolTipService.ToolTip="At or above this screen-space error, the bounding sphere&apos;s projected radius in pixels, the finer LOD shows. Errors must not increase toward coarser LODs." />
                        <controls:NumberBox
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Bind CoarserName}"
                            LabelPosition="None"
                            NumberValue="{x:Bind Coarser, Mode=TwoWay}"
                            Style="{StaticResource PropertyNumberBoxStyle}"
                            ToolTipService.ToolTip="At or below this screen-space error, the coarser LOD shows. Keep it below the finer error so the LOD does not flicker." />
                    </Grid>
                </editorcontrols:PropertyCard>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <editorcontrols:PropertiesExpander
            VerticalAlignment="Top"
            Description="{x:Bind ViewModel.Description, Mode=OneWay}"
            Header="{x:Bind ViewModel.Header, Mode=OneWay}"
            HeaderIcon="{ui:FontIcon Glyph='&#xF158;'}"
            IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
            <editorcontrols:PropertiesExpander.Items>
                <editorcontrols:PropertyCard PropertyName="Asset">
                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:Thumbnail
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Content="{x:Bind ViewModel.AssetThumbnailGlyph, Mode=OneWay}"
                            ContentTemplate="{StaticResource AssetThumbnailTemplate}" />

                        <pickers:AssetPickerButton
                            x:Name="GeometryAssetButton"
                            Grid.Column="1"
                            ChoiceInvoked="OnGeometryChoiceInvoked"
                            Label="{x:Bind ViewModel.AssetButtonLabel, Mode=OneWay}"
                            Model="{x:Bind ViewModel.GeometryChoices}" />
                    </Grid>
                </editorcontrols:PropertyCard>

                <!--  Level of detail: the policy, then its boundaries under a disclosure whose summary names the source.  -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.LevelOfDetail.IsAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <editorcontrols:PropertyCard
                        IsEnabled="{x:Bind ViewModel.LevelOfDetail.CanEdit, Mode=OneWay}"
                        OverrideState="{x:Bind ViewModel.LevelOfDetail.OverrideState, Mode=OneWay}"
                        PropertyName="Level of detail"
                        ResetCommand="{x:Bind ViewModel.LevelOfDetail.ResetCommand}"
                        ResetToolTip="{x:Bind ViewModel.LevelOfDetail.ResetToolTip, Mode=OneWay}">
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Level of detail"
                            ItemsSource="{x:Bind ViewModel.LevelOfDetail.Kinds}"
                            PlaceholderText="Mixed"
                            SelectedIndex="{x:Bind ViewModel.LevelOfDetail.Kind, Mode=TwoWay}"
                            ToolTipService.ToolTip="How the geometry selects its LOD per view: always one LOD, by view distance, or by screen-space error." />
                    </editorcontrols:PropertyCard>
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Thresholds"
                        IsExpanded="{x:Bind ViewModel.LevelOfDetail.IsExpanded, Mode=TwoWay}"
                        Style="{StaticResource QuietDisclosure}">
                        <Expander.Header>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Thresholds" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.LevelOfDetail.Summary, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.LevelOfDetail.Summary, Mode=OneWay}" />
                            </Grid>
                        </Expander.Header>
                        <StackPanel Padding="0,4,0,0" Spacing="4">
                            <editorcontrols:NumberField
                                IsEnabled="{x:Bind ViewModel.LevelOfDetail.CanEdit, Mode=OneWay}"
                                Label="LOD"
                                Mask="#."
                                NumberValue="{x:Bind ViewModel.LevelOfDetail.FixedLod, Mode=TwoWay}"
                                Qualifier="{x:Bind ViewModel.LevelOfDetail.FixedRange, Mode=OneWay}"
                                ToolTipService.ToolTip="The LOD that always shows; 0 is the finest. The engine clamps it if a reimport removes LODs."
                                Visibility="{x:Bind ViewModel.LevelOfDetail.IsFixed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.LevelOfDetail.IsDistance, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemTemplate="{StaticResource DistanceTransitionTemplate}" ItemsSource="{x:Bind ViewModel.LevelOfDetail.Transitions, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <editorcontrols:NumberField
                                    Margin="0,8,0,0"
                                    IsEnabled="{x:Bind ViewModel.LevelOfDetail.CanEdit, Mode=OneWay}"
                                    Label="Hysteresis"
                                    NumberValue="{x:Bind ViewModel.LevelOfDetail.Hysteresis, Mode=TwoWay}"
                                    Qualifier="ratio"
                                    QualifierGroup="LodDistance"
                                    ToolTipService.ToolTip="The band around each threshold, as a ratio of it, within which the current LOD stays: from 0 to 0.99." />
                            </StackPanel>
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.LevelOfDetail.IsScreenSpaceError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <editorcontrols:PropertyCard PropertyName="">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Finer above (px)" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Coarser below (px)" />
                                    </Grid>
                                </editorcontrols:PropertyCard>
                                <ItemsControl ItemTemplate="{StaticResource ErrorTransitionTemplate}" ItemsSource="{x:Bind ViewModel.LevelOfDetail.Transitions, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind ViewModel.LevelOfDetail.ErrorText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.LevelOfDetail.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!--  Surfaces: title and count, then refresh and clear-unresolved.  -->
                <Grid Margin="0,8,0,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Surfaces" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SurfaceCount, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="Refresh surfaces"
                        Command="{x:Bind ViewModel.RefreshSurfacesCommand}"
                        Style="{StaticResource QuietActionButtonStyle}"
                        ToolTipService.ToolTip="Refresh surfaces: read this geometry's surfaces again from its cooked output, for example after a cook or reimport.">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE72C;"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="RefreshSurfacesRotation" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Button
                        Grid.Column="3"
                        AutomationProperties.Name="Remove every kept change"
                        Command="{x:Bind ViewModel.ClearUnresolvedSurfacesCommand}"
                        Style="{StaticResource QuietActionButtonStyle}"
                        ToolTipService.ToolTip="Remove every change kept for a surface this geometry no longer has. Undo restores them."
                        Visibility="{x:Bind ViewModel.HasKeptChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon FontSize="14" Glyph="&#xE894;" />
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="SurfaceNoticeText"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.SurfaceNotice, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasSurfaceNotice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ItemsControl ItemTemplate="{StaticResource SurfaceCardTemplate}" ItemsSource="{x:Bind ViewModel.Surfaces, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Style="{StaticResource InspectorCautionBox}" Visibility="{x:Bind ViewModel.HasKeptChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock FontWeight="SemiBold" Text="Not in this geometry" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="The cook fails until these changes are applied to a surface or removed."
                            TextWrapping="Wrap" />
                        <ItemsControl ItemTemplate="{StaticResource KeptChangesTemplate}" ItemsSource="{x:Bind ViewModel.KeptChanges, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </editorcontrols:PropertiesExpander.Items>
        </editorcontrols:PropertiesExpander>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SurfaceStatus">
                <VisualState x:Name="SurfacesResolved" />
                <VisualState x:Name="SurfacesInError">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsSurfaceInventoryFailed, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SurfaceNoticeText.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SurfaceLoading">
                <VisualState x:Name="SurfacesIdle" />
                <VisualState x:Name="SurfacesLoading">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsSurfaceLoading, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <Storyboard>
                        <DoubleAnimation
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="RefreshSurfacesRotation"
                            Storyboard.TargetProperty="Angle"
                            From="0"
                            To="360"
                            Duration="0:0:1" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
