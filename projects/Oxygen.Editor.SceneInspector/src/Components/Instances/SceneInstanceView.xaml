<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.Components.Instances.SceneInstanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:local="using:Oxygen.Editor.SceneInspector.Components.Instances"
    xmlns:pickers="using:Oxygen.Editor.Pickers"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.SceneInspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <editorcontrols:PropertiesExpander
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE71B;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <!--  Source: the picker swaps it for another model or scene.  -->
            <editorcontrols:PropertyCard PropertyName="Source">
                <pickers:AssetPickerButton
                    AutomationName="Source"
                    ChoiceInvoked="OnSourceChoiceInvoked"
                    IsEnabled="{x:Bind ViewModel.CanSwap, Mode=OneWay}"
                    Label="{x:Bind ViewModel.SourceLabel, Mode=OneWay}"
                    Model="{x:Bind ViewModel.SourceChoices}"
                    PickerOpening="OnSourcePickerOpening"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SourceKind, Mode=OneWay}" />
            </editorcontrols:PropertyCard>

            <!--  Changes: how many, and applying them to the authored scene the instance comes from; a model refuses with the reason.  -->
            <editorcontrols:PropertyCard PropertyName="Changes">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ChangeCount, Mode=OneWay}" />
                    <Grid ToolTipService.ToolTip="{x:Bind ViewModel.ApplyToolTip, Mode=OneWay}">
                        <Button
                            AutomationProperties.HelpText="{x:Bind ViewModel.ApplyToolTip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}"
                            Click="OnApplyClick"
                            Content="{x:Bind ViewModel.ApplyLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </editorcontrols:PropertyCard>

            <!--  Kept changes: changes whose node the source no longer has, each reassigned or removed (scene instances 6.4).  -->
            <InfoBar
                x:Name="KeptChangesBox"
                Title="{x:Bind ViewModel.KeptChangesTitle, Mode=OneWay}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasKeptChanges, Mode=OneWay}"
                Message="{x:Bind ViewModel.KeptChangesMessage, Mode=OneWay}"
                Severity="Warning">
                <StackPanel Margin="0,0,0,8" Spacing="4">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.KeptChangeRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:KeptChangeRow">
                                <Grid Padding="0,2" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Names}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Detail}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Reassign"
                                        Click="OnReassignClick"
                                        Content="Reassign…"
                                        ToolTipService.ToolTip="Point this change at a node the source has" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Remove"
                                        Click="OnRemoveKeptClick"
                                        Content="Remove"
                                        ToolTipService.ToolTip="Remove this change" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Remove all"
                        Click="OnRemoveAllKeptClick"
                        Content="Remove all"
                        IsEnabled="{x:Bind ViewModel.CanEditKeptChanges, Mode=OneWay}"
                        ToolTipService.ToolTip="Remove every kept change of this instance" />
                </StackPanel>
            </InfoBar>

            <!--  Unpack: the instance's nodes become the scene's own.  -->
            <editorcontrols:PropertyCard PropertyName="Unpack">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.Name="Unpack"
                        Click="OnUnpackClick"
                        Content="Unpack"
                        IsEnabled="{x:Bind ViewModel.CanUnpack, Mode=OneWay}"
                        ToolTipService.ToolTip="Make this instance's nodes the scene's own. Instances its source holds stay instances." />
                    <Button
                        AutomationProperties.Name="Unpack completely"
                        Click="OnUnpackCompletelyClick"
                        Content="Unpack completely"
                        IsEnabled="{x:Bind ViewModel.CanUnpack, Mode=OneWay}"
                        ToolTipService.ToolTip="Make this instance's nodes the scene's own, down to the deepest instance." />
                </StackPanel>
            </editorcontrols:PropertyCard>

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="This scene's environment and start state apply only when it runs as a level."
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsPrefab, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
