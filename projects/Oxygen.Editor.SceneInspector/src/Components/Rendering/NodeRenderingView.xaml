<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.Components.Rendering.NodeRenderingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.SceneInspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE7B3;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <editorcontrols:SourceModeField
                Caption="{x:Bind ViewModel.Visibility.Caption, Mode=OneWay}"
                Label="Scene visibility"
                ModeNames="{x:Bind ViewModel.Visibility.ModeNames}"
                OverrideActions="{x:Bind ViewModel.VisibilityOverride}"
                OverrideState="{x:Bind ViewModel.VisibilityOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.VisibilityOverride.ResetCommand}"
                SelectedIndex="{x:Bind ViewModel.Visibility.SelectedIndex, Mode=TwoWay}"
                SourceRequested="{x:Bind ViewModel.Visibility.SelectSource}"
                SourceToolTip="{x:Bind ViewModel.Visibility.SourceToolTip, Mode=OneWay}" />
            <editorcontrols:SourceModeField
                Caption="{x:Bind ViewModel.CastsShadows.Caption, Mode=OneWay}"
                Label="Cast shadows"
                ModeNames="{x:Bind ViewModel.CastsShadows.ModeNames}"
                OverrideActions="{x:Bind ViewModel.CastsShadowsOverride}"
                OverrideState="{x:Bind ViewModel.CastsShadowsOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.CastsShadowsOverride.ResetCommand}"
                SelectedIndex="{x:Bind ViewModel.CastsShadows.SelectedIndex, Mode=TwoWay}"
                SourceRequested="{x:Bind ViewModel.CastsShadows.SelectSource}"
                SourceToolTip="{x:Bind ViewModel.CastsShadows.SourceToolTip, Mode=OneWay}" />
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="Scene.Node.Rendering.Advanced"
                Header="Advanced"
                IsExpanded="False"
                Style="{StaticResource QuietDisclosure}">
                <StackPanel Spacing="4">
                    <editorcontrols:SourceModeField
                        Caption="{x:Bind ViewModel.ReceivesShadows.Caption, Mode=OneWay}"
                        Label="Receive shadows"
                        ModeNames="{x:Bind ViewModel.ReceivesShadows.ModeNames}"
                        OverrideActions="{x:Bind ViewModel.ReceivesShadowsOverride}"
                        OverrideState="{x:Bind ViewModel.ReceivesShadowsOverride.State, Mode=OneWay}"
                        ResetCommand="{x:Bind ViewModel.ReceivesShadowsOverride.ResetCommand}"
                        SelectedIndex="{x:Bind ViewModel.ReceivesShadows.SelectedIndex, Mode=TwoWay}"
                        SourceRequested="{x:Bind ViewModel.ReceivesShadows.SelectSource}"
                        SourceToolTip="{x:Bind ViewModel.ReceivesShadows.SourceToolTip, Mode=OneWay}" />
                    <editorcontrols:ToggleField
                        IsOn="{x:Bind ViewModel.IsStatic, Mode=TwoWay}"
                        Label="Static"
                        OverrideActions="{x:Bind ViewModel.IsStaticOverride}"
                        OverrideState="{x:Bind ViewModel.IsStaticOverride.State, Mode=OneWay}"
                        ResetCommand="{x:Bind ViewModel.IsStaticOverride.ResetCommand}" />
                    <editorcontrols:ToggleField
                        IsOn="{x:Bind ViewModel.IsRayCastingSelectable, Mode=TwoWay}"
                        Label="Ray-cast selectable"
                        OverrideActions="{x:Bind ViewModel.IsRayCastingSelectableOverride}"
                        OverrideState="{x:Bind ViewModel.IsRayCastingSelectableOverride.State, Mode=OneWay}"
                        ResetCommand="{x:Bind ViewModel.IsRayCastingSelectableOverride.ResetCommand}" />
                </StackPanel>
            </Expander>
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
