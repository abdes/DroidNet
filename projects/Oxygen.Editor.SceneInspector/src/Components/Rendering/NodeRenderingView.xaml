<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.Components.Rendering.NodeRenderingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.SceneInspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE7B3;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <editorcontrols:PropertyCard PropertyName="Scene visibility">
                <ToggleSwitch AutomationProperties.Name="Scene visibility" IsOn="{x:Bind ViewModel.IsVisible, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Cast shadows" Visibility="{x:Bind ViewModel.ShowsShadowFlags, Mode=OneWay}">
                <ToggleSwitch AutomationProperties.Name="Cast shadows" IsOn="{x:Bind ViewModel.CastsShadows, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
            <editorcontrols:PropertyCard PropertyName="Receive shadows" Visibility="{x:Bind ViewModel.ShowsShadowFlags, Mode=OneWay}">
                <ToggleSwitch AutomationProperties.Name="Receive shadows" IsOn="{x:Bind ViewModel.ReceivesShadows, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="Scene.Node.Rendering.Advanced"
                Header="Advanced"
                IsExpanded="False"
                Style="{StaticResource QuietDisclosure}">
                <StackPanel Spacing="4">
                    <editorcontrols:PropertyCard PropertyName="Static">
                        <ToggleSwitch AutomationProperties.Name="Static" IsOn="{x:Bind ViewModel.IsStatic, Mode=TwoWay}" />
                    </editorcontrols:PropertyCard>
                    <editorcontrols:PropertyCard PropertyName="Ray-cast selectable">
                        <ToggleSwitch AutomationProperties.Name="Ray-cast selectable" IsOn="{x:Bind ViewModel.IsRayCastingSelectable, Mode=TwoWay}" />
                    </editorcontrols:PropertyCard>
                </StackPanel>
            </Expander>
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
