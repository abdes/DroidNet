<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.Components.Lights.SpotLightView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:Oxygen.Editor.SceneInspector.Components"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:lights="using:Oxygen.Editor.SceneInspector.Components.Lights"
    xmlns:local="using:Oxygen.Editor.SceneInspector"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.SceneInspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE706;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <lights:LocalLightPropertiesView ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            <TextBlock FontWeight="SemiBold" Text="Cone" />
            <editorcontrols:NumberField
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.InnerConeAngleDiagnostic.Message, Mode=OneWay}"
                HasError="{x:Bind ViewModel.InnerConeAngleDiagnostic.HasError, Mode=OneWay}"
                IsMixed="{x:Bind ViewModel.InnerConeAngleRadians.IsMixed, Mode=OneWay}"
                Label="Inner angle"
                Mask="~.#"
                NumberValue="{x:Bind ViewModel.InnerConeAngleDegrees, Mode=TwoWay}"
                OverrideActions="{x:Bind ViewModel.InnerConeAngleOverride}"
                OverrideState="{x:Bind ViewModel.InnerConeAngleOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.InnerConeAngleOverride.ResetCommand}"
                Tag="InnerConeAngleRadians"
                Unit="°" />
            <editorcontrols:NumberField
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.OuterConeAngleDiagnostic.Message, Mode=OneWay}"
                HasError="{x:Bind ViewModel.OuterConeAngleDiagnostic.HasError, Mode=OneWay}"
                IsMixed="{x:Bind ViewModel.OuterConeAngleRadians.IsMixed, Mode=OneWay}"
                Label="Outer angle"
                Mask="~.#"
                NumberValue="{x:Bind ViewModel.OuterConeAngleDegrees, Mode=TwoWay}"
                OverrideActions="{x:Bind ViewModel.OuterConeAngleOverride}"
                OverrideState="{x:Bind ViewModel.OuterConeAngleOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.OuterConeAngleOverride.ResetCommand}"
                Tag="OuterConeAngleRadians"
                Unit="°" />
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
