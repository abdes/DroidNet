<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.Components.Fog.LocalFogVolumeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.SceneInspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE9CA;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <editorcontrols:PropertyCard
                OverrideActions="{x:Bind ViewModel.EnabledOverride}"
                OverrideState="{x:Bind ViewModel.EnabledOverride.State, Mode=OneWay}"
                PropertyName="Enabled"
                ResetCommand="{x:Bind ViewModel.EnabledOverride.ResetCommand}">
                <ToggleSwitch AutomationProperties.Name="Enabled" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
            </editorcontrols:PropertyCard>
            <editorcontrols:NumberField
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.RadialFogExtinctionDiagnostic.Message, Mode=OneWay}"
                HasError="{x:Bind ViewModel.RadialFogExtinctionDiagnostic.HasError, Mode=OneWay}"
                IsMixed="{x:Bind ViewModel.RadialFogExtinction.IsMixed, Mode=OneWay}"
                Label="Density"
                NumberValue="{x:Bind ViewModel.RadialFogExtinction.Number, Mode=TwoWay}"
                OverrideActions="{x:Bind ViewModel.RadialFogExtinctionOverride}"
                OverrideState="{x:Bind ViewModel.RadialFogExtinctionOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.RadialFogExtinctionOverride.ResetCommand}"
                Tag="RadialFogExtinction"
                Unit="1/m" />
            <editorcontrols:NumberField
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.HeightFogExtinctionDiagnostic.Message, Mode=OneWay}"
                HasError="{x:Bind ViewModel.HeightFogExtinctionDiagnostic.HasError, Mode=OneWay}"
                IsMixed="{x:Bind ViewModel.HeightFogExtinction.IsMixed, Mode=OneWay}"
                Label="Height density"
                NumberValue="{x:Bind ViewModel.HeightFogExtinction.Number, Mode=TwoWay}"
                OverrideActions="{x:Bind ViewModel.HeightFogExtinctionOverride}"
                OverrideState="{x:Bind ViewModel.HeightFogExtinctionOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.HeightFogExtinctionOverride.ResetCommand}"
                Tag="HeightFogExtinction"
                Unit="1/m" />
            <editorcontrols:NumberField
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.HeightFogFalloffDiagnostic.Message, Mode=OneWay}"
                HasError="{x:Bind ViewModel.HeightFogFalloffDiagnostic.HasError, Mode=OneWay}"
                IsMixed="{x:Bind ViewModel.HeightFogFalloff.IsMixed, Mode=OneWay}"
                Label="Height falloff"
                NumberValue="{x:Bind ViewModel.HeightFogFalloff.Number, Mode=TwoWay}"
                OverrideActions="{x:Bind ViewModel.HeightFogFalloffOverride}"
                OverrideState="{x:Bind ViewModel.HeightFogFalloffOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.HeightFogFalloffOverride.ResetCommand}"
                Tag="HeightFogFalloff" />
            <editorcontrols:NumberField
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.HeightFogOffsetDiagnostic.Message, Mode=OneWay}"
                HasError="{x:Bind ViewModel.HeightFogOffsetDiagnostic.HasError, Mode=OneWay}"
                IsMixed="{x:Bind ViewModel.HeightFogOffset.IsMixed, Mode=OneWay}"
                Label="Height offset"
                NumberValue="{x:Bind ViewModel.HeightFogOffset.Number, Mode=TwoWay}"
                OverrideActions="{x:Bind ViewModel.HeightFogOffsetOverride}"
                OverrideState="{x:Bind ViewModel.HeightFogOffsetOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.HeightFogOffsetOverride.ResetCommand}"
                Tag="HeightFogOffset"
                Unit="m" />
            <editorcontrols:NumberField
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.FogPhaseGDiagnostic.Message, Mode=OneWay}"
                HasError="{x:Bind ViewModel.FogPhaseGDiagnostic.HasError, Mode=OneWay}"
                IsMixed="{x:Bind ViewModel.FogPhaseG.IsMixed, Mode=OneWay}"
                Label="Phase"
                NumberValue="{x:Bind ViewModel.FogPhaseG.Number, Mode=TwoWay}"
                OverrideActions="{x:Bind ViewModel.FogPhaseGOverride}"
                OverrideState="{x:Bind ViewModel.FogPhaseGOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.FogPhaseGOverride.ResetCommand}"
                Tag="FogPhaseG" />
            <editorcontrols:ColorField
                Blue="{x:Bind ViewModel.AlbedoB, Mode=TwoWay}"
                ColorPicked="OnAlbedoPicked"
                ComponentMask="~.#"
                EditSessionCompleted="ColorEditCompleted"
                EditSessionStarted="ColorEditStarted"
                ErrorText="{x:Bind ViewModel.AlbedoDiagnostic.Message, Mode=OneWay}"
                Green="{x:Bind ViewModel.AlbedoG, Mode=TwoWay}"
                HasError="{x:Bind ViewModel.AlbedoDiagnostic.HasError, Mode=OneWay}"
                Label="Albedo"
                OverrideActions="{x:Bind ViewModel.AlbedoOverride}"
                OverrideState="{x:Bind ViewModel.AlbedoOverride.State, Mode=OneWay}"
                PickerAutomationName="Pick fog albedo color"
                Red="{x:Bind ViewModel.AlbedoR, Mode=TwoWay}"
                ResetCommand="{x:Bind ViewModel.AlbedoOverride.ResetCommand}"
                Tag="Albedo" />
            <editorcontrols:ColorField
                Blue="{x:Bind ViewModel.EmissiveB, Mode=TwoWay}"
                ColorPicked="OnEmissivePicked"
                EditSessionCompleted="ColorEditCompleted"
                EditSessionStarted="ColorEditStarted"
                ErrorText="{x:Bind ViewModel.EmissiveDiagnostic.Message, Mode=OneWay}"
                Green="{x:Bind ViewModel.EmissiveG, Mode=TwoWay}"
                HasError="{x:Bind ViewModel.EmissiveDiagnostic.HasError, Mode=OneWay}"
                Kind="Luminance"
                Label="Emissive"
                OverrideActions="{x:Bind ViewModel.EmissiveOverride}"
                OverrideState="{x:Bind ViewModel.EmissiveOverride.State, Mode=OneWay}"
                PickerAutomationName="Pick fog emissive color"
                Red="{x:Bind ViewModel.EmissiveR, Mode=TwoWay}"
                ResetCommand="{x:Bind ViewModel.EmissiveOverride.ResetCommand}"
                Tag="Emissive" />
            <editorcontrols:NumberField
                EditSessionCompleted="NumberEditCompleted"
                EditSessionStarted="NumberEditStarted"
                ErrorText="{x:Bind ViewModel.SortPriorityDiagnostic.Message, Mode=OneWay}"
                HasError="{x:Bind ViewModel.SortPriorityDiagnostic.HasError, Mode=OneWay}"
                Label="Sort priority"
                Mask="~."
                NumberValue="{x:Bind ViewModel.SortPriority, Mode=TwoWay}"
                OverrideActions="{x:Bind ViewModel.SortPriorityOverride}"
                OverrideState="{x:Bind ViewModel.SortPriorityOverride.State, Mode=OneWay}"
                ResetCommand="{x:Bind ViewModel.SortPriorityOverride.ResetCommand}"
                Tag="SortPriority" />
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
