<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.Components.Transform.TransformView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:ctkcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Oxygen.Editor.SceneInspector/SceneInspectorStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ctkcvt:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
            <!--
                Override VectorBox pointer-over background for this view to be transparent.
                Place the override in ThemeDictionaries so ThemeResource lookup in the control
                will find this view-local theme resource.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="VectorBoxPointerOverBackground" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="VectorBoxPointerOverBackground" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <editorcontrols:PropertiesExpander
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        HorizontalContentAlignment="Stretch"
        Description="{x:Bind ViewModel.Description, Mode=OneWay}"
        Header="{x:Bind ViewModel.Header, Mode=OneWay}"
        HeaderIcon="{ui:FontIcon Glyph='&#xE7AD;'}"
        IsExpanded="{x:Bind ViewModel.IsExpanded, Mode=TwoWay}">
        <editorcontrols:PropertiesExpander.Items>
            <!--  Errors sit below the card, so their wrapping text never decides whether the row stacks.  -->
            <StackPanel Spacing="2">
                <editorcontrols:PropertyCard
                    HorizontalContentAlignment="Stretch"
                    IsCompound="True"
                    IsEnabled="{x:Bind ViewModel.PositionProperty.IsEnabled, Mode=OneWay}"
                    PropertyName="Position"
                    Qualifier="m"
                    QualifierGroup="Transform"
                    Visibility="{x:Bind ViewModel.PositionProperty.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:VectorBox
                        x:Name="PositionBox"
                        AutomationProperties.Name="Position, metres"
                        ComponentLabelPosition="Left"
                        Dimension="3"
                        EditSessionCompleted="PositionBox_EditSessionCompleted"
                        EditSessionStarted="PositionBox_EditSessionStarted"
                        LoggerFactory="{x:Bind ViewModel.LoggerFactory, Mode=OneWay}"
                        Validate="PositionBox_Validate"
                        XIsIndeterminate="{x:Bind ViewModel.PositionXIsIndeterminate, Mode=TwoWay}"
                        XValue="{x:Bind ViewModel.PositionX, Mode=TwoWay}"
                        YIsIndeterminate="{x:Bind ViewModel.PositionYIsIndeterminate, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.PositionY, Mode=TwoWay}"
                        ZIsIndeterminate="{x:Bind ViewModel.PositionZIsIndeterminate, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.PositionZ, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.PositionXDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="X: " /><Run Text="{x:Bind ViewModel.PositionXDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.PositionYDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="Y: " /><Run Text="{x:Bind ViewModel.PositionYDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.PositionZDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="Z: " /><Run Text="{x:Bind ViewModel.PositionZDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <!--  Errors sit below the card, so their wrapping text never decides whether the row stacks.  -->
            <StackPanel Spacing="2">
                <editorcontrols:PropertyCard
                    HorizontalContentAlignment="Stretch"
                    IsCompound="True"
                    IsEnabled="{x:Bind ViewModel.RotationProperty.IsEnabled, Mode=OneWay}"
                    PropertyName="Rotation"
                    Qualifier="°"
                    QualifierGroup="Transform"
                    Visibility="{x:Bind ViewModel.RotationProperty.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:VectorBox
                        x:Name="RotationBox"
                        AutomationProperties.Name="Rotation, degrees"
                        ComponentLabelPosition="Left"
                        Dimension="3"
                        EditSessionCompleted="RotationBox_EditSessionCompleted"
                        EditSessionStarted="RotationBox_EditSessionStarted"
                        LoggerFactory="{x:Bind ViewModel.LoggerFactory, Mode=OneWay}"
                        Validate="RotationBox_Validate"
                        XIsIndeterminate="{x:Bind ViewModel.RotationXIsIndeterminate, Mode=TwoWay}"
                        XValue="{x:Bind ViewModel.RotationX, Mode=TwoWay}"
                        YIsIndeterminate="{x:Bind ViewModel.RotationYIsIndeterminate, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.RotationY, Mode=TwoWay}"
                        ZIsIndeterminate="{x:Bind ViewModel.RotationZIsIndeterminate, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.RotationZ, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.RotationXDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="X: " /><Run Text="{x:Bind ViewModel.RotationXDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.RotationYDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="Y: " /><Run Text="{x:Bind ViewModel.RotationYDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.RotationZDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="Z: " /><Run Text="{x:Bind ViewModel.RotationZDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <!--  Errors sit below the card, so their wrapping text never decides whether the row stacks.  -->
            <StackPanel Spacing="2">
                <editorcontrols:PropertyCard
                    HorizontalContentAlignment="Stretch"
                    IsCompound="True"
                    IsEnabled="{x:Bind ViewModel.ScaleProperty.IsEnabled, Mode=OneWay}"
                    PropertyName="Scale"
                    Qualifier="x"
                    QualifierGroup="Transform"
                    Visibility="{x:Bind ViewModel.ScaleProperty.IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:VectorBox
                        x:Name="ScaleBox"
                        AutomationProperties.Name="Scale, multiplier"
                        ComponentLabelPosition="Left"
                        Dimension="3"
                        EditSessionCompleted="ScaleBox_EditSessionCompleted"
                        EditSessionStarted="ScaleBox_EditSessionStarted"
                        LoggerFactory="{x:Bind ViewModel.LoggerFactory, Mode=OneWay}"
                        Validate="ScaleBox_Validate"
                        XIsIndeterminate="{x:Bind ViewModel.ScaleXIsIndeterminate, Mode=TwoWay}"
                        XValue="{x:Bind ViewModel.ScaleX, Mode=TwoWay}"
                        YIsIndeterminate="{x:Bind ViewModel.ScaleYIsIndeterminate, Mode=TwoWay}"
                        YValue="{x:Bind ViewModel.ScaleY, Mode=TwoWay}"
                        ZIsIndeterminate="{x:Bind ViewModel.ScaleZIsIndeterminate, Mode=TwoWay}"
                        ZValue="{x:Bind ViewModel.ScaleZ, Mode=TwoWay}" />
                </editorcontrols:PropertyCard>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ScaleXDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="X: " /><Run Text="{x:Bind ViewModel.ScaleXDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ScaleYDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="Y: " /><Run Text="{x:Bind ViewModel.ScaleYDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ScaleZDiagnostic.HasError, Mode=OneWay, Converter={StaticResource InspectorDiagnosticVisibility}}">
                    <Run Text="Z: " /><Run Text="{x:Bind ViewModel.ScaleZDiagnostic.Message, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </editorcontrols:PropertiesExpander.Items>
    </editorcontrols:PropertiesExpander>
</UserControl>
