<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Oxygen.Editor.SceneInspector.SceneNodeDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:local="using:Oxygen.Editor.SceneInspector"
    xmlns:menus="using:DroidNet.Controls.Menus"
    xmlns:presentation="using:Oxygen.Editor.SceneInspector.Presentation">
    <UserControl.Resources>
        <presentation:ItemsTypeToIconConverter x:Key="ItemsTypeToIconConverter" />
    </UserControl.Resources>
    <Grid MinHeight="32" ColumnSpacing="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center" Content="{x:Bind ViewModel.NodeType, Mode=OneWay, Converter={StaticResource ItemsTypeToIconConverter}}" />
        <controls:InPlaceEditableLabel
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay}"
            ToolTipService.ToolTip="{x:Bind ViewModel.Name, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsOwned, Mode=OneWay}">
            <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </controls:InPlaceEditableLabel>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsInstanced, Mode=OneWay}">
            <TextBlock
                x:Name="InstancedName"
                Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTipService.ToolTip="{x:Bind ViewModel.Name, Mode=OneWay}" />
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="InstancedOrigin"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Origin, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Origin, Mode=OneWay}" />
                <HyperlinkButton
                    x:Name="SelectInstanceButton"
                    Grid.Column="1"
                    Padding="2,0"
                    AutomationProperties.Name="Select instance"
                    Command="{x:Bind ViewModel.SelectInstanceCommand, Mode=OneWay}"
                    Content="Select instance"
                    FontSize="12"
                    ToolTipService.ToolTip="Select the instance this node comes from" />
                <menus:MenuButton
                    x:Name="ApplyToSourceButton"
                    Grid.Column="2"
                    Padding="4,0"
                    AutomationProperties.Name="Apply to source"
                    Chrome="Transparent"
                    MenuSource="{x:Bind ViewModel.ApplyMenu, Mode=OneWay}"
                    ToolTipService.ToolTip="Apply this node's changes to the scene it comes from"
                    Visibility="{x:Bind ViewModel.CanApply, Mode=OneWay}">
                    <TextBlock FontSize="12" Text="Apply to…" />
                </menus:MenuButton>
            </Grid>
        </StackPanel>
        <controls:ToolBar
            Grid.Column="2"
            Background="Transparent"
            IsCompact="True">
            <controls:ToolBarToggleButton
                x:Name="AllComponentsButton"
                AutomationProperties.Name="All components"
                Checked="OnAllComponentsChanged"
                IsChecked="{x:Bind IsAllComponentsSelected, Mode=OneWay}"
                Label="All components"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="Show all component properties"
                Unchecked="OnAllComponentsChanged">
                <controls:ToolBarToggleButton.Icon>
                    <SymbolIconSource Symbol="AllApps" />
                </controls:ToolBarToggleButton.Icon>
            </controls:ToolBarToggleButton>
            <controls:ToolBarSeparator />
            <controls:ToolBarElementHost>
                <menus:MenuButton
                    AutomationProperties.Name="Add component"
                    Chrome="Transparent"
                    IsEnabled="{x:Bind ViewModel.CanAddComponents, Mode=OneWay}"
                    MenuSource="{x:Bind ViewModel.AddComponentMenu, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.AddComponentToolTip, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </menus:MenuButton>
            </controls:ToolBarElementHost>
            <controls:ToolBarButton
                x:Name="DeleteComponentButton"
                AutomationProperties.Name="Remove selected component"
                Click="OnDeleteComponentClicked"
                IsEnabled="{x:Bind ViewModel.CanDeleteSelectedComponent, Mode=OneWay}"
                Label="Remove component"
                ToolBarLabelPosition="Collapsed"
                ToolTipService.ToolTip="{x:Bind ViewModel.RemoveComponentToolTip, Mode=OneWay}">
                <controls:ToolBarButton.Icon>
                    <FontIconSource Glyph="&#xE74D;" />
                </controls:ToolBarButton.Icon>
            </controls:ToolBarButton>
        </controls:ToolBar>
    </Grid>
</UserControl>
