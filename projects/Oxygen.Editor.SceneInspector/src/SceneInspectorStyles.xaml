<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidNet.Controls"
    xmlns:ctkcvt="using:CommunityToolkit.WinUI.Converters"
    xmlns:editorcontrols="using:Oxygen.Editor.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <ctkcvt:BoolToObjectConverter
        x:Key="SceneDisclosureGlyph"
        FalseValue="&#xE76C;"
        TrueValue="&#xE70D;" />
    <SolidColorBrush
        x:Key="SceneScopeSelectionBrush"
        Opacity="0.25"
        Color="{ThemeResource SystemAccentColor}" />
    <Style
        x:Key="QuietInspectorToggle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!--  A card for one item of a section's list, such as a script slot or a geometry surface.  -->
    <Style x:Key="InspectorItemCard" TargetType="Border">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!--  Values kept for something their source no longer declares, such as a surface lost on reimport.  -->
    <Style x:Key="InspectorCautionBox" TargetType="Border">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!--  The inspector's own value boxes look like the library's property rows; the app merges the keyed styles.  -->
    <Style BasedOn="{StaticResource PropertyVectorBoxStyle}" TargetType="controls:VectorBox" />
    <Style BasedOn="{StaticResource PropertyNumberBoxStyle}" TargetType="controls:NumberBox" />
    <Style x:Key="ContentOnlyPropertyCard" TargetType="editorcontrols:PropertyCard">
        <Setter Property="IsHeaderVisible" Value="False" />
        <Setter Property="Layout" Value="Stacked" />
    </Style>
    <ctkcvt:BoolToVisibilityConverter x:Key="SceneExpandedVisibility" />
    <ctkcvt:BoolToVisibilityConverter x:Key="InspectorDiagnosticVisibility" />
    <ctkcvt:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="QuietDisclosure" TargetType="Expander">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel Spacing="0">
                        <ToggleButton
                            x:Name="ExpanderHeader"
                            MinHeight="32"
                            Padding="1,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                            Style="{StaticResource QuietInspectorToggle}"
                            UseSystemFocusVisuals="True">
                            <ToggleButton.Resources>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource ControlFillColorSecondary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource ControlFillColorTertiary}" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource TextFillColorDisabled}" />
                            </ToggleButton.Resources>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding Header}" />
                                <FontIcon
                                    x:Name="DisclosureChevron"
                                    Grid.Column="1"
                                    FontSize="14"
                                    Glyph="{Binding IsChecked, ElementName=ExpanderHeader, Converter={StaticResource SceneDisclosureGlyph}}" />
                            </Grid>
                        </ToggleButton>
                        <Border x:Name="ExpanderContentClip" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource SceneExpandedVisibility}}">
                            <Border x:Name="ExpanderContent" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource SceneExpandedVisibility}}">
                                <ContentPresenter HorizontalContentAlignment="Stretch" Content="{TemplateBinding Content}" />
                            </Border>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
