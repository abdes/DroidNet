<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <RootNamespace>Oxygen.Editor.SceneInspector.Unit.UI.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DroidNetTestTier>Unit</DroidNetTestTier>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.SceneInspector/src/Oxygen.Editor.SceneInspector.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Assets/testing/Oxygen.Editor.Assets.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.ContentPipeline/testing/Oxygen.Editor.ContentPipeline.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Controls/testing/Oxygen.Editor.Controls.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Input/testing/Oxygen.Editor.Input.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Projects/testing/Oxygen.Editor.Projects.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Scenes/testing/Oxygen.Editor.Scenes.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Scripting/testing/Oxygen.Editor.Scripting.Testing.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Shell/testing/Oxygen.Editor.Shell.Testing.csproj" />
        <PackageReference Include="Moq" />
        <PackageReference Include="Testably.Abstractions.Testing" />
        <Compile Include="../../testsupport/Authoring/SceneAuthoringFixture.cs" Link="TestSupport/SceneAuthoringFixture.cs" />
        <Compile Include="../../testsupport/Authoring/SceneTestData.cs" Link="TestSupport/SceneTestData.cs" />
        <Compile Include="../../testsupport/UI/SceneAuthoringFixture.Views.cs" Link="TestSupport/SceneAuthoringFixture.Views.cs" />
        <Compile Include="../../testsupport/UI/InspectorControls.cs" Link="TestSupport/InspectorControls.cs" />
        <Compile Include="$(MyTopLevelDirectory)projects/UITests.Shared/testsupport/UiTestHosting.cs" Link="Support/UiTestHosting.cs" />
        <Compile Include="$(ProjectsRoot)/UITests.Shared/testsupport/ScaledXamlHost.cs" Link="Support/ScaledXamlHost.cs" />
    </ItemGroup>
    <Import Project="$(ProjectsRoot)/UITests.Shared/src/UITests.Shared.projitems" Label="Shared" />
</Project>
