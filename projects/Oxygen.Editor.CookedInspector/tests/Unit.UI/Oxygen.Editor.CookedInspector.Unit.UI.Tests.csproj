<Project Sdk="MSTest.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <RootNamespace>Oxygen.Editor.CookedInspector.Unit.UI.Tests</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DroidNetTestTier>Unit</DroidNetTestTier>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.CookedInspector/src/Oxygen.Editor.CookedInspector.csproj" />
        <ProjectReference Include="$(ProjectsRoot)/Oxygen.Editor.Projects/testing/Oxygen.Editor.Projects.Testing.csproj" />
        <PackageReference Include="Moq" />
        <PackageReference Include="Testably.Abstractions.Testing" />
        <Compile Include="$(MyTopLevelDirectory)projects/UITests.Shared/testsupport/UiTestHosting.cs" Link="Support/UiTestHosting.cs" />
        <Compile Include="$(ProjectsRoot)/UITests.Shared/tests/TestHostLifecycleTests.cs" Link="TestHostLifecycleTests.cs" />
    </ItemGroup>
    <Import Project="$(ProjectsRoot)/UITests.Shared/src/UITests.Shared.projitems" Label="Shared" />
</Project>
