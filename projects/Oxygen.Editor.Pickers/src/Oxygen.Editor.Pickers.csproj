<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseWinUI>true</UseWinUI>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

        <RootNamespace>Oxygen.Editor.Pickers</RootNamespace>
        <AssemblyName>$(MSBuildProjectName)</AssemblyName>

        <Title>Oxygen editor pickers.</Title>
        <Description>Shared editor pickers: the asset picker every editor module uses, which groups engine, package and content assets.</Description>
        <PackageTags>oxygen;editor;pickers;ui</PackageTags>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(ProjectsRoot)\Controls\DynamicTree\src\Controls.DynamicTree.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Editor.Assets\src\Oxygen.Editor.Assets.csproj" />
        <ProjectReference Include="$(ProjectsRoot)\Oxygen.Managed.Core\src\Oxygen.Managed.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.WindowsAppSDK" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    </ItemGroup>
</Project>
