<?xml version="1.0" encoding="utf-8" ?>

<!--
    NOTE: .targets files are imported late in the build order.

    - Set dependent properties in .targets files, because they'll pick up
      customizations from individual projects.
    - Define targets in .targets files. But remember that this makes overriding
      the target more difficult if the .targets file is imported by an SDK,
      because the user project doesn't have a place to override it by default.

    - Set defaults in .props files for behavior that might be customized in an
      individual project.
    - Avoid setting dependent properties in .props files by reading the value of
      a possibly-customized property, because the customization won't happen
      until the user project.
    - Include items in .props files (conditioned on a property). All properties
      are considered before any item, so user-project property customizations
      will be picked up, and this gives the user project the opportunity to
      Remove or Update any item brought in by the import.
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
         TreatAsLocalProperty="MyTopLevelDirectory;MyToolingDirectory"
         InitialTargets="ValidateDroidNetWindowsBuildTools">

    <Target Name="ValidateDroidNetWindowsBuildTools" BeforeTargets="PrepareForBuild;Restore"
            Condition="'$(OS)' == 'Windows_NT' And '$(DesignTimeBuild)' != 'true'">
        <Error Code="DNBUILD001" Condition="'$([System.Environment]::Is64BitProcess)' != 'True'"
               Text="DroidNet requires 64-bit MSBuild. Use MSBuild\Current\Bin\amd64\MSBuild.exe from the same Visual Studio installation as your x64 developer shell. 32-bit MSBuild is not permitted." />
        <Error Code="DNBUILD002" Condition="'$(PreferredToolArchitecture)' != 'x64'"
               Text="DroidNet requires x64-hosted build tools. Set PreferredToolArchitecture=x64; x86 compiler hosts are not permitted." />
        <Error Code="DNBUILD003" Condition="'$(MSBuildProjectExtension)' == '.vcxproj' And '$(VCToolArchitecture)' != 'Native64Bit'"
               Text="DroidNet requires the x64-hosted MSVC toolset. Initialize vcvars64.bat or a VS developer shell with -arch=x64 -host_arch=x64." />
    </Target>

    <Target Name="WarnDroidNetMsixPackagingOutsideRelease" BeforeTargets="PrepareForBuild"
            Condition="'$(DroidNetMsixPackaging)' == 'true' And '$(Configuration)' != 'Release' And '$(OutputType)' == 'WinExe' And '$(DesignTimeBuild)' != 'true'">
        <Warning Code="DNBUILD004"
                 Text="DroidNetMsixPackaging applies to Release builds only; this $(Configuration) build of $(MSBuildProjectName) stays unpackaged." />
    </Target>

    <!-- Read-only source tree (builds to top-level bin/obj folders) -->
    <PropertyGroup Condition="'$(UseArtifactsOutput)' != 'true'">
        <!-- Only set a custom package output path when the artifacts output layout is not enabled. -->
        <PackageOutputPath>$(MyTopLevelDirectory)bin\Packages\$(Configuration)\</PackageOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UseArtifactsOutput)' == 'true'">
        <!-- With artifacts layout enabled, prefer artifacts package location -->
        <PackageOutputPath>$(ArtifactsPath)\package\$(Configuration)\</PackageOutputPath>
    </PropertyGroup>


    <!-- Solution items consumed by tooling/GenerateSolution.ps1. -->
    <ItemGroup>
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), '.editorconfig'))" />
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), 'settings.xamlstyler'))" />
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), '*.md'))" />
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), 'GlobalUsings*.cs'))" />
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), 'stylecop.json'))" />
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), 'Directory.packages.props'))" />
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), 'Common.props'))" />
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), 'Directory.build.props'))" />
        <SlnGenSolutionItem Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), 'Directory.build.targets'))" />
    </ItemGroup>
    <!-- End Visual Studio solution generator -->

    <!-- Test execution tiers select projects, never hide tests inside an assembly. -->
    <PropertyGroup Condition="'$(IsSlnGen)' == 'true' And '$(DroidNetTestTier)' != ''">
        <DroidNetTestScope Condition="'$(DroidNetTestScope)' == ''">All</DroidNetTestScope>
        <IncludeInSolutionFile Condition="'$(DroidNetTestScope)' != 'All' And '$(DroidNetTestScope)' != '$(DroidNetTestTier)'">false</IncludeInSolutionFile>
    </PropertyGroup>

    <!-- Benchmarks are [ReleaseOnly]; this test always runs, so a Debug run does not end with "zero tests ran". -->
    <ItemGroup Condition="'$(DroidNetTestTier)' == 'Benchmarks'">
        <Compile Include="$(MyTopLevelDirectory)projects/TestHelpers/benchmarks/ReleaseOnlyBuildTests.cs" Link="TestHelpers/ReleaseOnlyBuildTests.cs" />
    </ItemGroup>

    <!--
        Code Quality

        Use StyleCop (https://github.com/DotNetAnalyzers/StyleCopAnalyzers).
        Rules are in .editorconfig, additional options for stylecop analyzers are
        in stylecop.json.

        Enable maximum help from the compiler and IDE.
    -->
    <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
        <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" PrivateAssets="all"
                          Condition="'@(PackageReference->WithMetadataValue('Identity', 'Microsoft.CodeAnalysis.CSharp'))' != ''" />
        <AdditionalFiles Include="$([MSBUILD]::NormalizePath($(MyTopLevelDirectory), 'stylecop.json'))" Link="stylecop.json" />
    </ItemGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <!-- Nullable warnings remain errors; other warnings keep their configured severity. -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>
    <!-- End Code Quality -->

    <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(AccelerateBuildsInVisualStudio)' == '' and '$(UseWinUI)' != 'true'">
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    </PropertyGroup>

    <!-- Package metadata depends on the project's final values. -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <PackageTags>$(CommonTags);$(PackageTags)</PackageTags>
        <_ProjectReadmePath>$(MSBuildProjectDirectory)\..\README.md</_ProjectReadmePath>
        <PackageReadmeFile Condition="Exists('$(_ProjectReadmePath)')">README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <None Include="$(MyTopLevelDirectory)icon.png" Pack="true" PackagePath="/" />
        <None Include="$(MyTopLevelDirectory)LICENSE" Pack="true" PackagePath="/" />
        <None Include="$(_ProjectReadmePath)" Condition="Exists('$(_ProjectReadmePath)')" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!-- Git Versioning -->
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" Condition="!Exists('packages.config')">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <!-- End Git Versioning -->

    <Target Name="PrepareReleaseNotes" BeforeTargets="GenerateNuspec" DependsOnTargets="GetBuildVersion">
        <PropertyGroup>
            <PackageReleaseNotes Condition="'$(RepositoryUrl)'!=''">$(RepositoryUrl)/releases/tag/v$(Version)</PackageReleaseNotes>
        </PropertyGroup>
    </Target>

    <!--
      Visual Studio's fast up-to-date check knows the files a project copies
      from its direct references, not the ones ResolveAssemblyReference copies
      from deeper ones, such as the C++/CLI Interop reached through
      Oxygen.Editor.Runtime. A rebuilt Interop then leaves the editor app "up to
      date" next to a stale copy. Declare every copy-local file built by this
      repository as a copied output, so the check compares it with its source.
    -->
    <Target Name="DeclareRepositoryCopyLocalUpToDateItems"
            BeforeTargets="CollectUpToDateCheckBuiltDesignTime"
            DependsOnTargets="ResolveAssemblyReferences"
            Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(UseArtifactsOutput)' == 'true'">
        <PropertyGroup>
            <_RepositoryArtifactsBin>$([MSBuild]::NormalizeDirectory($(ArtifactsPath), 'bin'))</_RepositoryArtifactsBin>
        </PropertyGroup>
        <ItemGroup>
            <_RepositoryCopyLocal Include="@(ReferenceCopyLocalPaths)"
                                  Condition="$([System.String]::new('%(FullPath)').StartsWith('$(_RepositoryArtifactsBin)', StringComparison.OrdinalIgnoreCase))" />
            <UpToDateCheckBuilt Include="@(_RepositoryCopyLocal->'$(OutDir)%(DestinationSubDirectory)%(Filename)%(Extension)')"
                                Original="%(_RepositoryCopyLocal.FullPath)" />
        </ItemGroup>
    </Target>

    <!--
      Visual Studio intermittently reports "MSB4006: There is a circular
      dependency in the target dependency graph involving target
      GetMrtPackagingOutputs" on WinUI libraries; command-line builds never do.

      Microsoft.Windows.SDK.BuildTools.MSIX (MrtCore.PriGen.targets) hooks
      _MrtCoreUpToDateCheckInput before CollectUpToDateCheckInputDesignTime,
      the fast up-to-date check that only design-time builds run. It depends
      on GetMrtPackagingOutputs, a packaging target that calls itself on every
      transitive project reference and runs its output groups through
      CallTarget, as child builds of the same project. Visual Studio runs the
      design-time builds of all projects concurrently in one build session, so
      a library receives overlapping requests from its own build and from each
      dependent's recursion. They can wait on each other, and the MSBuild
      scheduler reports that wait cycle as MSB4006.

      A library's PRI inputs are its own resources, manifest and PRI payload,
      so collect only those. Content and embedded XAML stay tracked by the
      managed fast up-to-date check. Applications keep the SDK default.

      - https://github.com/microsoft/WindowsAppSDK/issues/3753
        (_MrtCoreUpToDateCheckInput recursively calls GetMrtPackagingOutputs
        during design-time builds; open)
      - https://github.com/microsoft/WindowsAppSDK/issues/1898
        (origin of the MRT Core fast up-to-date check integration)
      - https://learn.microsoft.com/visualstudio/msbuild/errors/msb4006
      - https://github.com/dotnet/msbuild/blob/main/src/Build/BackEnd/Components/Scheduler/SchedulableRequest.cs
        (cross-request circular dependency detection)
    -->
    <PropertyGroup Condition="'$(UseWinUI)' == 'true' and '$(OutputType)' == 'Library'">
        <_MrtCoreUpToDateCheckInputDependsOn>_GetPriFilesFromPayload</_MrtCoreUpToDateCheckInputDependsOn>
    </PropertyGroup>
</Project>
