###############################
# Git Line Endings            #
###############################

# Use LF for text in both the repository and working copies on every OS.
* text=auto eol=lf

# Force batch scripts to always use CRLF line endings so that if a repo is accessed
# in Windows via a file share from Linux, the scripts will work.
*.[cC][mM][dD] text eol=crlf
*.[bB][aA][tT] text eol=crlf

# Force bash scripts to always use LF line endings so that if a repo is accessed
# in Unix via a file share from Windows, the scripts will work.
*.sh text eol=lf

# Preserve the exact bytes of immutable EX07E capture fixtures and source copies.
projects/Oxygen.Engine/design/vortex/plan/baselines/ex07e-20260924/cpu-submission/** -text -diff
projects/Oxygen.Engine/design/vortex/plan/baselines/ex07e-20260924/point-hardware-pcf/** -text -diff
projects/Oxygen.Engine/design/vortex/plan/baselines/ex07e-20260925/cross-view-sharing/** -text -diff

